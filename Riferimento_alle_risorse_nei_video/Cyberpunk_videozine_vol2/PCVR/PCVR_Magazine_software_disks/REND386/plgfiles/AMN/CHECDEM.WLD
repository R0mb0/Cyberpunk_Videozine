worldscale 1.0
hither     10
yon        10000000
start 667,1000,5084 -180,0,0 0
ambient 76

surfacedef white 0x10FA
surfacedef black 0x100A
surfacedef metal 0x26fa

surfacemap met1
surface 1 metal

surfacemap white1
surface 1 white

surfacemap black1
surface 1 black

split 0,200,0 0,1,0   0  #floor split

# Row 1
#object check 1,1,1 0,0,0 0,200,0 0 white1 fixed
object check 1,1,1 0,0,0 150,200,0 0 black1 fixed
