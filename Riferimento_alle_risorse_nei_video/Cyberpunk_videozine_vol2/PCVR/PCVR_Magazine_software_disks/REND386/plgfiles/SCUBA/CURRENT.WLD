#-----------------------------CURRENTS-----------------------------------
#------------------------------------------------------------------------
segment c1=world 0,0,0  0,0,0  
segment c2=world 0,0,0  0,0,0   
segment c3=world 0,0,0  0,0,0  
segment c4=world 0,0,0  0,0,0   
segment c5=world 0,0,0  0,0,0  
segment c6=world 0,0,0  0,0,0   
animation 10    
   state drift   
      do c1=step(20,20,5  x,x,x)[]   
animation 10    
   state drift   
      do c2=step(50,x,-10  x,x,x)[]   
animation 10    
   state drift   
      do c3=step(100,-20,-20  x,x,x)[]   
animation 10    
   state drift   
      do c4=step(200,-100,x  x,x,x)[]   
animation 10    
   state drift   
      do c5=step(500,-500,x  x,x,x)[]   
animation 10    
   state drift   
      do c6=step(10000,-5000,100  x,x,x)[]   
#-------------------------------------------------------------------------
#-------------------------------LEVEL 1-----------------------------------
#-------------------------------------------------------------------------
animation 10     
   state a
      do sensor(x,-30000,x  x,0,x)[exit][]
      do c2=attach(0)[]
      do c1=attach(1)[]    
