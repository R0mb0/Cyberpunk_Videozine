# Splits and associated surfaces:

split 0,0,0  0,1,0      0   # 0  (floor plane)
polyobj 4 marble -10000,0,-10000  -10000,0,10000  10000,0,10000  10000,0,-10000 

split 0,2401,0 0,1,0    12   #    (ceiling plane)
polyobj 4 greypaint 10000,2400,-10000  10000,2400,10000  -10000,2400,10000  -10000,2400,-10000

split 0,0,10000  0,0,1    1
polyobj 4 greyish -10000,0,10000  -10000,2400,10000 10000,2400,10000 10000,0,10000

split 0,0,-10000  0,0,1    2
polyobj 4 greyish -10000,0,-10000  10000,0,-10000 10000,2400,-10000 -10000,2400,-10000

split 0,0,0  1,0,0    3
object wall4 100,47,40 0,90,0 0,30,0  wood
object wall4 80,47,40 0,-90,0 0,30,2000
object al4bet 10,10,0 0,90,0 -2,1000,-3000
endsplits


object tree2 5,5,5 0,0,0 18000,10,10000
object tree1 5,5,5 0,0,0 -18000,10,10000        
object tree2 5,5,5 0,0,0 -18000,10,-10000     
polyobj 4 blue -2000,0,-9999 -2000,2000,-9999 -3500,2000,-9999 -3500,0,-9999
object side 2,1,1 0,-90,0 -10000,0,-10000
object side 2,1,1 0,90,0  10000,0,10000
object vr=vrles  15,10,0  0,0,0  2000,400,9980
object fire 15,15,0 0,180,0 -5000,1500,-9999
object pipe=cylinder 1,13,1  0,0,0  -2000,0,9000
object trek=1701 1,1,1  0,0,0  0,800,0
object vw=vwbug 1.3,1.3,1.3 0,0,0  0,800,0
object tab=table 3,3,3  0,0,0  0,800,5000    
object tab1=table 3,3,3  0,0,0  0,800,5000  
object tab2=table 3,3,3  0,0,0  0,800,5000  
object tab3=table 3,3,3  0,0,0  0,800,5000  
object glass=glass1 .5,.5,.5 0,0,0  -7770,1200,-7770
object glass1 .5,.5,.5 0,30,0 -8030,1200,-8030
object vase 3,1,3 0,0,0  8000,1200,-8000
position tab 8000,800,8000
position trek 8000,1000,8000
position vw -8000,1000,8000
task sculspin 25 trek;0,10,0
task sculspin 25 vw;0,10,0
position tab1 8000,800,-8000
position tab2 -8000,800,8000
position tab3 -8000,800,-8000
# Areas:

area 1,1,0  GroundEast
area -1,1,0 GroundWest
area 0,-1,0 Below
area 0,2401,0 Sky
area 0,0,10001 North
area 0,0,-10001 South
