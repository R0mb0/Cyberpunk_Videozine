# A bench (300 high by 500 wide by 150 deep)
#
# Created by Bernie Roehl, December 1992 (by hand!)

bench 12 8

0 0 0
0 100 0
0 300 0
50 100 0
150 100 0
150 0 0

0 0 500
0 100 500
0 300 500
50 100 500
150 100 500
150 0 500

0x8001 4 5 4 1 0     # right base edge
0x8002 3 3 2 1       # right rest edge
0x8001 4 6 7 10 11   # left base edge
0x8002 3 7 8 9       # left rest edge

0x8003 4 0 2 8 6     # back of bench
0x8004 4 9 8 2 3     # front of rest
0x8005 4 10 9 3 4    # seat
0x8006 4 11 10 4 5   # front of base
