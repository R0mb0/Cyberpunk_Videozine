///////////////////////////////////////////////////////////////////////
//                                                                   //
//  [ SIGNIT ]                                                       //
//                                                                   //
//  Written By:  Ulli Hernando                                       //
//                                                                   //
//  This script is used to send (upload) a signature-file            //
//  via 'A'scii file transfer protocol from within Telix 3.12        //
//  by either a macro-key (for a single key-press) or                //
//  by ALT-G (script executer).   This routine assumes the           //
//  signature-file 'SIG.TXT' is in the Script Directory (TELIX).     //
//                                                                   //
///////////////////////////////////////////////////////////////////////

main()
{
   int result;                     // declare integer for checking
   str up_dir_[64];                // declare temporary upload dir
   up_dir_  = _up_dir;             // retains current upload directory
   _up_dir = _script_dir;          // assumes (SIG.TXT) is in Script Dir.
   result = send('A', "SIG.TXT");  // sends Signature-file (SIG.TXT)
   if (result < 0)                 // check for error in upload
     prints("<Signature Transfer Failed>");
   _up_dir = up_dir_;              // restores original _up_dir
}

