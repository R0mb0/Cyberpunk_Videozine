main()
{
  str cmdline[255];
  str BaudStr[7];
  str PortStr[2];
  str FileList[64];

  itos(get_port(), PortStr);
  itos(get_baud(), BaudStr);

  // get current port number
  strcat(cmdline, "port ");
  strcat(cmdline, PortStr);

  // get current comm. port speed
  strcat(cmdline, " speed ");
  strcat(cmdline, BaudStr);

  // cts handshake, estimate transfer time
  strcat(cmdline, " ha cts est 0 ");
  if (BaudStr == "19200")
    strcat(cmdline, "11000");
  else
    strcat(cmdline, BaudStr);

  strcat(cmdline, " D pL1024 pa8000 sb -y @");

  FileList = _telix_dir;
  strcat(FileList, "tlxum.up");

  strcat(cmdline, FileList);

  run("DSZ", cmdline, 0);
  alarm(2);
}
