BEGIN leftb, mbutton, rightb, mousel, mouser, mouseu, moused, 50, 50

;------------------------------LEFT BUTTON-----------------------------------

leftb:    execute main

;-----------------------------MIDDLE BUTTON----------------------------------

mbutton:  MATCH 13,32,,"Exit",yes,return

;-----------------------------RIGHT BUTTON ----------------------------------

rightb:   match 13,32,,"Exit",no,escape

;------------------------------LEFT MOTION-----------------------------------

mousel:   MATCH 3,1,,"ASDSDDFD",NUL,LEFT
xmousel:  MATCH 1,5,, "Dialing Directory",LEFT,NUL

;------------------------------RIGHT MOTION----------------------------------
mouser:   MATCH 3,1,,"QWERTRYU",NUL,RIGHT
xmouser:  MATCH 1,5,, "Dialing Directory",RIGHT,NUL

;------------------------------UP MOTION-------------------------------------

mouseu:    MATCH 7,26,,"QWERTYU",NUL,UP
xmouseu:   NOTHING
;------------------------------DOWN MOTION-----------------------------------

moused:    MATCH 2,3,,"QWERTYU",NUL,DOWN
xmoused:   NOTHING
;------------------------------MENUS-----------------------------------------

MAIN:   popup 1,1,NORMAL

text "ีออออออออต Telix v3.00 Command Mouse Menu  ฦอออออออออธ"
text "ณ QUIT MENU......Return to command level or on line. ณ"
text "ณ                                                    ณ"
text "ณ              --- Major Functions ---               ณ"
text "ณ Dialing directory..Alt-D  Receive Files......Alt-R ณ"
text "ณ Comm Parameters....Alt-P  Keyboard Macros....Alt-K ณ"
text "ณ Send files.........Alt-S  Queue Redial #s....Alt-Q ณ"
text "ณ Chat mode..........Alt-Y  Jump To DOS Shell..Alt-J ณ"
text "ณ DOS Functions......Alt-F  Scroll Back........Alt-B ณ"
text "ณ cOnfigure Telix....Alt-O  Exit Telix.........Alt-X ณ"
text "ณ Translate Table....Alt-W  Terminal Emulator..Alt-T ณ"
text "ณ                                                    ณ"
text "ณ                                                    ณ"
text "ณ              --- Other Functions ---               ณ"
text "ณ Hang up modem......Alt-H  Run editor.........Alt-A ณ"
text "ณ DOS command........Alt-V  Screen Image.......Alt-I ณ"
text "ณ Local Echo On/Off..Alt-E  Run Script (Go)....Alt-G ณ"
text "ณ Capture Log........Alt-L  Usage Log On/Off...Alt-U ณ"
text "ณ Clear screen.......Alt-C  Send break......Ctrl-End ณ"
text "ณ Add Line Feeds On/Off....................Shift-Tab ณ"
text "ณ Printer log On/Off..........................Ctrl-@ ณ"
text "ณ                                                    ณ"
text "ณ  Left-menu    Middle-yes/select   Right-escape/no  ณ"
text "ณ                                                    ณ"
text "ิออออออออออออออออออออออออออออออออออออออออออออออออออออพ"
select 2,3,50,nul
select 5,3,24,ALTkD
select 6,3,24,ALTkP
select 7,3,24,ALTkS
select 8,3,24,ALTkY
select 9,3,24,ALTkF
select 10,3,24,ALTkO
select 11,3,24,ALTkW
select 5,29,24,ALTkR
select 6,29,24,ALTkK
select 7,29,24,ALTkQ
select 8,29,24,ALTkJ
select 9,29,24,ALTkB
select 10,29,24,ALTkX
select 11,29,24,ALTkT
select 15,3,24,ALTkH
select 16,3,24,ALTkV
select 17,3,24,ALTkE
select 18,3,24,ALTkL
select 19,3,24,ALTkC
select 15,29,24,ALTkA
select 16,29,24,ALTkI
select 17,29,24,ALTkG
select 18,29,24,ALTkU
select 19,29,24,CTRLkEND
select 20,3,50,SHIFTkTAB
select 21,3,50,CTRLkat

pend

;------------------------------KEYS------------------------------------------

NUL:           NOTHING
RETURN:        TYPE 13
ESCAPE:        TYPE 27
CANCEL:        TYPE 27
REVM:      TYPE "R"
LOADM:     TYPE "L"
SAVM:      TYPE "S"
CLRM:      TYPE "C"
EXITM:     TYPE 27
ESCRES:      EXECUTE ESCAPE
EXITY:       EXECUTE YES
EXITN:       EXECUTE NO
EXIT:        EXECUTE NOMOT,ALTkX
NOMOT:      ASSIGN leftb,rightb,mbutton,xmousel,xmouser,xmouseu,xmoused
YES:        TYPE "Y"
NO:         TYPE "N"
F1:            TYPE 0,59
F2:            TYPE 0,60
F3:            TYPE 0,61
F4:            TYPE 0,62
F5:            TYPE 0,63
