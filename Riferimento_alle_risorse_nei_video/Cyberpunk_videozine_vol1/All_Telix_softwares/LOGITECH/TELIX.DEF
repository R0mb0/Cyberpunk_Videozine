CTRLkat:        TYPE 0,3
CTRLkPRTSC:    TYPE 0,114
CTRLkEND:      TYPE 0,117
SHIFTkTAB:     TYPE 0,15

HOME:          TYPE 0,71
END:           TYPE 0,79
ENDHOME:       TYPE 0,79,0,71
BKTB:          TYPE 0,15
