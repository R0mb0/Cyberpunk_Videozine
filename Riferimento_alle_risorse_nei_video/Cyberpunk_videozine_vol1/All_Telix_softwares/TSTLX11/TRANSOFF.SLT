// Vaasa, Finland. All rights reserved.    Sat 26-December-1992
//
// This is to turn off both the incoming and the outgoing
// translation table
//
// To make this script operative you need to compile it applying
// CS transoff
//
// This script is called e.g. by the UNIXHOST.SLT script

main ()
  {
  transtab ("*CLEAR*", 0);   // Clear the incoming translation table
  transtab ("*CLEAR*", 1);   // Clear the outgoing translation table
  prints ("");
  prints ("Translation tables have been set off");
  }
