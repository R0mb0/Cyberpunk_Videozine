// RING.SL? Do the actual calling. Returns no. of BBSes left to call,
//                                 or -1 if fail.
//
// This script is called by the QDIAL script.

// Please look at the comments through the whole file, and modify to
// suit your needs, BEFORE you use it. Then recompile with CS RING.
//-----------------------------------------------------------

// If you have suggestions for improving this script, please suggest
// improvements to me via old-fashioned snail-mail to:

// Author:  Inge Vabekk
//          Hamangskogen 108
//          N-1300 SANDVIKA
//          NORWAY
//          tel. (472) 546 396

str bbs_name[80]               // Name of current BBS (from operator)
   ,help    [80]               // Temporary help string.
   ,display  []="DISPLAY"
   ,change   []="CHANGE"       // Must be set to update display.
   ,global   []="GLOBAL"
   ,logon  [14]="LOGON"        // Logon script
   ,getname  []="GETNAME"      // Script to read NAME.DAT file.
   ,bbsname  []="BNAME"        // Global containing BBS name.
   ,short    []="SHORT"        // Global containing "short" name.
   ,cprot    []="CPROT"        // Global defining current protocol.
   ,lastk    []="LASTK"        // Last key pressed.
   ,prompt   []="PROMPT"       // Global command prompt.
   ,command  []="Command"      // Default command prompt.
   ,read[]="R"
   ,write[]="W"
   ,DialPrfx[]="DIAL"          // Dialfile prefix     
   ,DialSufx[]=".STR"          // Dialfile suffix
   ,DialString[14]="DIAL.STR"  // Dial string file
   ,NextString[14]=""          // Next dial string
   ,NumberStr  [4]             // Number string
   ,DialList  [60]=""          // List of dial strings.
   ,BBS [32] = "FAIL" 
   ,uldir    [64]              // Upload mail directory.
   ,dlfile   [12]              // Download command filename.
   ,ulfile   [12]              // Upload filename.
   ,check     [4]              // Temporary.
   ,kepre     [4]              // Temporary.
   ;

int tmark          // Used for timing.
   ,MaxNumber      // Max. number of BBSes to dial.
   ,LastNumber     // Previously dialled number
   ,BBSnumber      // Dial string number.
   ,oldBBSnumber   // Previous number
   ,voice          // = 1 (TRUE) for voice calls
   ,f              // File handle.
   ,busy, OK, nocarrier, notone  // For tracking.
   ,stat, calling
   ,uls,dls        // Uploads, Downloads.
   ;

//-----------------------------------------------------------
// Script starts here.
//-----------------------------------------------------------

main(int line)
{
int c, i, j, ll, repeat, ring;

  ring = 0;
  chkring(ring);                         // Start tracking phone ring.
  _scr_chk_key = 1;
  call (global,read,bbsname,bbs_name);   // Get the name of the BBS.

  gotoxy (0,line);

// Check the name. If not "CONT", delete old dial strings.

  NextString="DIAL*.STR";
  BBSnumber=0;
  if (strcmpi(bbs_name,"cont")==0)
  { setchrs(DialList,0,0,60);          // Clear dial list.
    while (filefind(NextString,0,DialString)) 
    { NextString = "";                 // For each string found:
      for (i=0; i<4; ++i) setchr(DialString,i,' ');
      i = stoi (DialString);
      itos (i,NumberStr);
      if (i>BBSnumber) BBSnumber = i;
      i = i*2-2;                       // Define place in string.
      setchr(DialList,i,subchr(NumberStr,0));
      setchr(DialList,i+1,subchr(NumberStr,1));
    }
    MaxNumber = BBSnumber*2-2;         // Set highest number.
  }
  else
  { while (filefind(NextString,0,DialString))  fdelete (DialString);
    if (subchr(bbs_name,0)!='@')
      find_number ();
    else
    { subchrs (bbs_name,1,79,bbs_name);// Filename: Remove 1.st char.
      if (!f) fclose(f);
      f = fopen(bbs_name,"r");
      if (f <= 0)
      { printsc ("Tý: ");
        printsc (bbs_name);
        prints (" not found!");
      }
      while (fgets(bbs_name,80,f) > 0) // Read a line.
        find_number ();
      fclose(f);                       // Close the file again.
      f = 0;
    }
  }
  blue();

  if (BBSnumber<1)
  { prints ("Tý: No BBSes found to call (check modem speed settings!)");
    return (0);                        // No BBSes found.    
  }

// Dial the round of files.
//-----------------------------------------------------------

  oldBBSnumber = -99;
  LastNumber = MaxNumber+2;
  while (BBSnumber>0)                  // Until list is exhausted.
  { for (i=0; i<2; ++i)
    { do
      { LastNumber=LastNumber+2;
        if (LastNumber>MaxNumber) LastNumber=0;
        subchrs (DialList,LastNumber,2,check);
        if (check !="") goto proceed;
      } while (LastNumber < MaxNumber);
    }
    return (0);                        // No more dial files.
    
//  Go ahead, dial.

Proceed:
    DialString = DialPrfx;
    strcat(DialString,check);
    strcat(DialString,DialSufx);       // Build dial string name.
    cputs_tr(_mdm_init_str);
    waitfor ("OK",1);
    clear_scr();

    if (!f) fclose(f);
    f = fopen(DialString,"r");
    if (f<=0)
    { printsc ("Tý: FILE OPEN ERROR on file ");
      printsc (DialString);
      prints ("!");
      prints ("I could not open the above file. The reason for this may be");
      prints ("that there are too few file handles, or that several files");
      prints ("have not been properly closed (script aborted?).");
      prints ("");
      prints ("Please exit from Telix and try again. If the error");
      prints ("persists, please call the author:");
      prints ("     Inge Vabekk");
      prints ("     Hamangskogen 108");
      prints ("     N-1300 SANDVIKA");
      prints ("     NORWAY");
      prints ("");
      printsc ("at the ");
      printc ('"');
      printsc ("Non Plus Ultra MBBS");
      printc ('"');
      prints (", tel (472) 46 51 27 or 46 39 56!");
      setchr (DialList,LastNumber,0);  // Error!
      return (-1);
    }
    fgets (help,64,f);                 // Check if we have the
    bbs_name = "Calling ";
    strcat (bbs_name,help);
    strcat (bbs_name,".");

    j=0;
    for (i=0; i<25; ++i)               // download file.
    { c = toupper(subchr(help,i));
      if (c == 0) break;
      if (c >= 'A')
      { if (isalpha(c))
        { setchr (dlfile,j,c);
          if (++j>7) break;            // Max. 8 characters (0-7).
        }
      }
    }
    setchr (dlfile,j,0);               // Name of download file.
    call (global,write,short,dlfile);  // Set name into global.

    j = 0;
    if (!getenv ("XBOARD",uldir)       // Check for XBoard.
    && (j=fopen("XBOARD.DIR","r")) < 1)// If not
    { uldir=_up_dir;                   // defined, build name of
      strcat (uldir,dlfile);           // directory for upload files,
      exec ("CRDIR",uldir);            // and try to create it.
    }
    if (j)                             // XBoard definition on file:     
    { fgets (uldir,64,j);              // Read dir.name.
      fclose (j);
    }

    blue();
    chkring(ring);

    _scr_chk_key = 0;

    for (ll=strlen(help); ll>0; --ll)
    { if (subchr(help,ll) > ' ') break;
      setchr (help,ll,0);
    }
    box (17,8,51,14,2,0,36);
    ll = 17 + (51-17 -ll)/2;           // Center this line (name).
    
    pstraxy ("Press 'ESC' to abort dialing.",20,10,36);
    pstraxy ("Press 'D' to stop dialing",    22,11,36);
    pstraxy (help,                           ll,12,36);
    gotoxy (0,line);
    keyset (27, 0,"@Escape");          // Enable ESCAPE key.
    keyset ('d',0,"@DCHAR");           // Enable "D" key.
    keyset ('D',0,"@DCHAR");

    fgets (help,3,f);                  // Read number of entries.
    repeat = stoi (help);              // Get repeat number.
    fgets (help,80,f);                 // Find protocol.
    check = help;                      // Set protocol
    setchr (check,1,0);                // into global.
    call (global,write,cprot,check);   

    fgets (logon,14,f);                // Find logon script.
    voice = strposi(logon,"VOICE",0)>=0; // Voice?
    fgets (help,80,f);                 // Read dial string.
    fclose (f);                        // Close the file.
    f = 0;

VoiceRedial:
    if (voice)
    { cputs_tr ("+++");                // New init string.
      flushbuf();                      // This seems clumsy, but
      delay(5);
      cputs_tr ("ATL2S7=60^M");        // cputs_tr seems to be buggy...
      flushbuf();
    }
    else
    { if (!is_loaded(logon))           // Load "logon" script
      { load_scr (logon);              // permanently.
        if (!is_loaded(logon))         // Loaded?
        { fdelete (DialString);        // No success:
          setchr (DialList,LastNumber,0);
          --BBSnumber;                 // Count down.
          printsc ("Tý: Logon script '");
          printsc (logon);
          prints ("' not found! Can't call this number!");
          tone (70,200);
          goto nextloop;
        }
        else if (strposi (logon,"LOGON",0) < 0)
        { tone (70,200);
          status_wind ("Tý: Logon script is not LOGON - Proceed at your own risk!",30);
        }
      }
    }

    tmark = timer_start (20);          // Display the box for 2 sec,
    _scr_chk_key = 0;
    if (oldBBSnumber != BBSnumber)
      if (call (getname,2) < 0) goto abort;
    oldBBSnumber = BBSnumber;

    do
    { if (call (global,read,lastk,kepre)>0) // Get the keypress.
        goto checkey;
    } while (!time_up(tmark));

    if (!voice)
    { chkring(ring);                     // Check if phone rings.
      blue();
      ulfile = dlfile;
      BBS = dlfile;                      // Make name of upload
      strcat (ulfile,".UL");
      strcat (dlfile,".DL");             // and download command files.
      dls=uls=0;
      if (filesize(dlfile) < 0)          // Check if command file
      { dls = exec ("HAVEIT$",BBS);      // exists.
        if (dls==255) dls=0;
        blue();
      }
      if (filesize(ulfile) < 0)          // Check for upload file.
      { uls = exec ("DUPECHK$",BBS);     // Call the dupecheck program.
        if (uls==255) uls=0;
        blue();
      }
      call (global,write,prompt,command);// Reset command.
      call (display);
      if (BBSnumber==1) repeat=100;      // One BBS to call: "indefinite"
    }                                    //  repeat.

    track_free (ring);                   // Don't track now.
    ring = 0;
    if (call (global,read,lastk,kepre)>0) // Get the keypress.
      goto checkey;

    ResetKeys();
    call (global,write,"CHANGE","YES");
    call (display);
    clear_scr();
    if (voice)
      j = 0;
    else
    { j = 0;
      if (uls)
      { gotoxy(20,++j);
        printsc ("I'll attempt to upload ");
        printn (uls);
        printsc (" file");
        if (uls!=1) printsc ("s");
      }
      if (dls)
      { if (uls) printsc (", and");
        gotoxy(21,++j);
        printsc ("I'll attempt to download ");
        printn (dls);
        printsc (" file");
        if (dls!=1) printsc ("s");
      }
      if (uls||dls) prints (".");
      j=dial (help,repeat,0);            // Go ahead, dial
    }
    _fore_color = 14;                    // Restore color.
    update_term();

    if (j>0)                             // Succesful call:
    { fdelete(DialString);               // Delete the dial
      setchr (DialList,LastNumber,0);    // string and remove from list.
      --BBSnumber;                       // Count down.
    }
    else if (voice)                      
    { _scr_chk_key = 0;
      waitfor ("OK",1);
      busy      = track ("BUSY",0);
      OK        = track ("OK",0);
      nocarrier = track ("ARRIER",0);
      notone    = track ("O DIAL TON",0);
      
      while (1)
      { if (!calling)                    // Only first time:
        { cputs_tr (_dialpref);
          cputs_tr (help);
          cputs_tr ("^M");
          flushbuf();
          clear_scr();
          i = j = strlen(bbs_name);
          if (i < 30) i = 30;
          ll = 38-i/2;
          box (ll-1,7,i+ll+2,14,2,0,78);
          pstraxy (bbs_name,39-j/2,9,78);
          pstraxy ("Lift off-hook and press ENTER",24,10,78);
          pstraxy ("  when phone starts ringing, ",24,11,78);
          pstraxy ("   or ESC to abort calling.  ",24,12,78);
          gotoxy (0,line);
          calling = 1;
        }

        terminal();                      // Process incoming characters.
        ll = inkey();
        stat=track_hit(0);
        if (stat==busy || stat==notone)
        { cputs_tr ("^M");
          calling = 0;
          status_wind ("Wait, retry...",_dial_pause*10); // Wait.
          continue;
        }
        else if (stat==OK || stat==nocarrier)
          ll=27;

        while (calling && (ll == 27 || ll == 13))
        { calling = 0;
          cputs ("^M");
          if (ll == 13)                    // Enter:
          { clear_scr();
            box (28,8,55,13,2,0,90);
            pstraxy ("  Press ENTER to retry, ",30,10,90);
            pstraxy ("or ESC to abort calling.",30,11,90);
            gotoxy (0,line);
            flushbuf();
            do 
            { ll=inkey();
            } while (ll != 27 && ll != 13);
          }
          if (ll == 27)                  // ESC received?
          { fdelete(DialString);         // Delete the dial
            setchr (DialList,LastNumber,0);// string and remove from list.
            --BBSnumber;                 // Count down.
            goto nextloop;
          }
          else if (ll == 13)             // Enter:
            break;                       // Break out.

          ll = inkey();
        }
      }
    }

nextloop:
    blue();
    chkring(ring);
    _scr_chk_key = 1;
  }
  stop();
  _scr_chk_key = 1;
  for (i=1;i<15;++i)
  { terminal();
    clear_scr();
    pstraxy ("Dialing finished normally.",i*2-1,line+i-1,33);
    tone (i*50,6);
  }
  return (0);

checkey:
//printsc ("Key pressed: ");
//prints (kepre);

  ResetKeys();
  if (kepre=="ESC")
    goto abort;
//else if (kepre=="D")           // Delete this
  else
  { fdelete(DialString);         // dial string from list.
    setchr (DialList,LastNumber,0);
    --BBSnumber;                 // Count down.
    goto nextloop;
  }

abort:
  stop();
  _scr_chk_key = 1;
  for (i=1;i<15;++i)
  { terminal();
    clear_scr();
    pstraxy ("Dialing aborted.",i*2-1,line+i-1,79);
    tone (800-i*50,6);
  }
  return (-1);
}

//-----------------------------------------------------------
// Stop calling
//-----------------------------------------------------------

stop()
{
  blue();                         // exit if ESC pressed.
  cputs_tr ("+++");
  flushbuf();
  delay(5);
  cputs ("ATZ^M");
  flushbuf();
  waitfor ("OK",1);
  blue();                         // exit if ESC pressed.
}

//-----------------------------------------------------------
// Find dial numbers from the BBS name.
//-----------------------------------------------------------

find_number()
{
int c, i, j, result;

  i = -1;
  for (j=0; (c=subchr(bbs_name,j)) > 0; ++j)
  { if (c>' ') setchr (bbs_name,++i,c);
  }
  setchr (bbs_name,++i,0);
  if (i < 2) return (0);

  result = exec ("FINDIAL$",bbs_name);

  if (result<=0)
    clear_scr();
  if (result==0)
  { help = "The BBS name '";
    strcat (help,bbs_name);
    strcat (help,"' was not found.");
    status_wind (help,20);
  }
  else if (result==-1)
    status_wind ("Tý: Phonedir program not found.",30);
  else if (result==-2)
    status_wind ("Tý: Problem opening phone directory!",20);
  else if (result==-3)
    status_wind ("Tý: BBS list was not found.",20);
  else if (result<0)
    status_wind ("Tý: Problem creating intermediate file.",20);
  else  
  { itos (++BBSnumber,NumberStr);
    MaxNumber = BBSnumber*2-2;             // Set highest number.
    setchr(DialList,MaxNumber,subchr(NumberStr,0));
    setchr(DialList,MaxNumber+1,subchr(NumberStr,1));

    DialString = DialPrfx;                 // Dialfile prefix.
    strcat (DialString,NumberStr);         // Add number.
    strcat (DialString,DialSufx);          // Add suffix.
    frename ("DIAL.STR",DialString);       // Rename file.
  }
}

//-----------------------------------------------------------
// Routine to clear the screen and set background to blue.
//-----------------------------------------------------------

blue ()
{
  _back_color = 1;
  _fore_color = 14;
  clear_scr();
  call (display);
}

//-----------------------------------------------------------
// Check for phone ringing.
//-----------------------------------------------------------

chkring(int ring)
{
int i;
  terminal();
  if (ring)                              // Only if tracking:
  { if (track_hit(ring))
    { track_free(ring);
      ring = 0;
      for (i=0; i<3; ++i)
      { tone(800,40);
        tone(600,40);
      }
      box (10,11,62,15,2,0,116); 
      pstraxy ("Tý: Phone rings! Answer, and press ESC to continue!"
      ,13,13,116);
      while (inkeyw() != '^[') ;
    }
  }
  ring = track ("RING",0);               // Track ring again.
}

//-----------------------------------------------------------
// Reset trigger keys.
//-----------------------------------------------------------

ResetKeys()
{
  keyset (27,0,0);                     // Disable ESCAPE key.
  keyset ('d',0,0);                    // Disable "D" key.
  keyset ('D',0,0);
  call (global,write,lastk,"");        // Flush it.
  _scr_chk_key = 1;
}

//-----------------------------------------------------------
// Execute a program.
//-----------------------------------------------------------

exec (str prog,str pram)
{
str line [80];
int i;
  i = run (prog,pram,2);               // Try to run program.
  if (i < 0)
  { line = "Couldn't find or execute '";
    strcat (line,prog);
    strcat (line,".EXE'!");
    tone (80,80);                      // No success:
    status_wind (line,20);
  }
  return (i);
}
