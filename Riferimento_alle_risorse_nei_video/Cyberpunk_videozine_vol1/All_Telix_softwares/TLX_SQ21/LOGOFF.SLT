//-----------------------------------------------------------
// LOGOFF.SL? Toggle Auto Logoff setting.
//
// This script is executed if you press Alt-Q while being online.

// Please look at the comments through the whole file, and modify to
// suit your needs, BEFORE you use it. Then recompile with CS LOGOFF.
//-----------------------------------------------------------

// If you have suggestions for improving this script, please suggest
// improvements to me via old-fashioned snail-mail to:

// Author:  Inge Vabekk
//          Hamangskogen 108
//          N-1300 SANDVIKA
//          NORWAY
//          tel. (472) 546 396

str sline  [20]
   ,global []="GLOBAL"
   ,change []="CHANGE"
   ,logoff []="LOGOF"
   ,display[]="DISPLAY"
   ,read[]="R"                 // To READ from Global script.
   ,write[]="W"                // To WRITE to Global script.
   ;

//-----------------------------------------------------------
// Script starts here.
//-----------------------------------------------------------

main()
{
  if (!call (global,read,logoff,sline))// Nothing defined?
    call (global,write,logoff,"YES");

  else
  { if (strposi (sline,"YES",0) == 0)  // Logoff?
      call (global,write,logoff,"NO"); // Toggle to NO.
    else
      call (global,write,logoff,"YES");// Toggle to YES.
  }
  call (global,write,change,"YES");    // Define CHANGE.
  call (display);

  if (!carrier()) 
  { keyset (0x1000,0,"@Qdial");        // Reset the Alt-Q key.
    prints ("Press Alt-Q again to redial.");
  }
  return (0);
}
