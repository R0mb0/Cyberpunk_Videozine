{ For advanced users= }
{ You can use up to 10 different external protocol programs= }

{XPROT0= Z               { For external protocol with Zmodem }
{XPROG0= GSZ.EXE         { If you want to use GSZ for Zmodem }
{XPRAM0= port 1 pV1 pG15 ha cts  { Parameters for GSZ.EXE }
{XPRAM0= port 2 ha cts   { Parameters for DSZ.EXE }
{XRECV0= rz -m           { Receive parameters for GSZ.EXE }
{XXMIT0= sz              { Transmit parameters for GSZ.EXE }

{ Below is an example only -- set your own parameters }
{ according to the documentation Below is an example only -- set your own parameters }
{XPROT1= K      { If you want to use external protocol with Kermit }
{XPROG1= MSKERMIT.EXE    { if you want to use MS-Kermit }
{XPRAM1= xxxx            { Parameters for MS-KERMIT (see Kermit doc! }
{XRECV1= r               { Receive parameters for Kermit (see docs! }
{XXMIT1= s               { Transmit parameters for KERMIT.EXE }
