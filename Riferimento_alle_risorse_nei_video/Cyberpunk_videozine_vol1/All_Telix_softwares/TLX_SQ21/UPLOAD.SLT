//-----------------------------------------------------------
// UPLOAD.SL? Automatic upload to BBSystems.

str DIR [6] = "CAT";     // Upload log subdirectory.

//-----------------------------------------------------------
// The file <BBS>.UL must be placed in TELIX's program (main)
// directory. The name <BBS> consists of the first 8 (max.) 
// alphabetic characters of the BBS name.
// The following parameters must be defined in this file:

// &:Password for private files (Optional; PCBoard only)
// P:Name for private upload (next file only; MBBS only).
// #:Conference number or name (optional)
// F:Filename to upload.
// D:Description of above file
// D:Description of above file (cont.) 
// D:Description of above file (cont.) 
// #:Conference number or name (optional)
// F:Next file to upload
// D:Description of above file
// D:Description of above file (cont.) 
// D:Description of above file (cont.) 
// etc.

// Example:

// #:XBOARD
// F:GAME1.ZIP
// D:Child's Play part one
// F:GAME2.ZIP
// D:Child's Play part two
// #:Main
// P:Paul Sharp
// F:TXTFND.ZIP
// D:Text finder program

// You may specify as many files as you want. The script attempts
// to upload only the first MAXUP files see the NAME.DAT file).
// The description file is NOT modified (successfully uploaded
// files are NOT deleted from the list). Thus you may run the
// script repeatedly if you want to.

// You may also write as many specification lines as you want for
// each file. However, there are a few things you should know:
// PCBoard systems accept several lines for the description,
// but each line is limited to 45 characters.

// The files to upload must be found either in the upload or down-
// load directory defined in TELIX. If not, you MUST specify a
// directory path with the filenames. The length of a filename
// must not exceed 12 characters.
// There is no check on the line length, so be aware!

// Hint: Define a softkey to start this script.
//-----------------------------------------------------------

// If you have suggestions for improving this script, please suggest
// improvements to me via old-fashioned snail-mail to:

// Author:  Inge Vabekk
//          Hamangskogen 108
//          N-1300 SANDVIKA
//          NORWAY
//          tel. (472) 546 396

str ul_spec    [12]          // Upload specifications.
   ,upload_log [64]          // Name of upload log file.
   ,bbs_type   [24]          // BBS type.
   ,NextConf   [24]          // Next conference.
   ,PrevConf   [24]          // Previous conference.
   ,myprot      [2]          // My protocol.
   ,hisprot     [2]          // His protocol.
   ,input      [80]          // Input line.
   ,file       [64]          // Path and filename.
   ,description[80]          // Description.
   ,username   [80]          // User name.
   ,f0         [64]          // Filename for upload.
   ,f1         [64]          // Next filename.
   ,command    [10]          // Command prompt.
   ,temp        [4]          // Temporary for short strings.
                             // For the Global storage:
   ,global   []="GLOBAL"     // Global script.
   ,join     []="JOINCONF"   // Join Conference script.
   ,PutLine  []="PUTLINE"    // Put Line script.
   ,UpDownF  []="UPDOWNF"    // Upload/Download script.
   ,bbstype  []="BTYPE"      // BBS type.
   ,short    []="SHORT"      // Short BBS name.
   ,Cprot    []="CPROT"      // Current protocol.
   ,Hprot    []="HPROT"      // "His" protocol.
   ,version  []="BBSver"     // PCB version
   ,conf     []="CONF"       // Current conference
   ,ConfList []="CNFLST"     // YES if conference list wanted.
   ,prompt   []="PROMPT"     // Current command prompt.
   ,maxup    []="MAXUP"      // Max no. of files to upload
   ;     

int tol = 300      // timeout limit is 30 seconds.
   ,tmark, stat 
   ,infile         // Input file pointer
   ,fstat          // Input file status:
                   //  0: Description in "description"
                   // >0: Length of filename in f0 or f1
                   // <0: EOF read.
   ,infilemenu     // in file menu if TRUE.
   ,dline          // Description line number
   ,pcb, mbbs, rbbs, opus, fido, crcs    // Possible BBS types
   ,BBSver         // BBS version.
   ,switched       // TRUE if conference switched.
   ,max            // max. no. of files to upload.
   ,protocol       // Must be INT!
   ,Enter=13       // Code for CR (Enter).
   ,t1, t2, t3, t4, t5, t6  // For tracking.
   ;

//-----------------------------------------------------------
// Upload script is entered here.
//-----------------------------------------------------------

main()
{
int d, i, k, l;

  entry();                             // Updates colors & status bar. 

// Check if online.
//-----------------------------------------------------------

  if (!carrier())   
  { tone (150,50);                     // No, failure.
    status_wind ("Tý: YOU CAN ONLY UPLOAD IF YOU'RE ONLINE!",20);
    return(-1);
  }

  newdir (_telix_dir);                 // Move to TELIX dir.

// Find BBS type (Set one logical variable).

  read (bbstype,input);                // Get BBS type.

  mbbs = pcb = rbbs = opus = fido = crcs = 0;
  if      (input == "MBBS") mbbs = 1;
  else if (input == "PCB" ) pcb  = 1;
  else if (input == "RBBS") rbbs = 1;
  else if (input == "OPUS") opus = 1;
  else if (input == "FIDO") fido = 1;
  else if (input == "CRCS") crcs = 1;
  else                                          
  { wrongBBS(input);                   // Doesn't match script!
    return (-1);
  }
  read (version,temp);
  BBSver = subchr (temp,0);            // Get BBS version

  read (short,ul_spec);                // Get the BBS's short name.
  read (prompt,command);               // Get command prompt.
  read (cprot,myprot);                 // Get my and
  protocol = subchr (myprot,0);
  read (hprot,hisprot);                // his protocol character.
  read (conf,PrevConf);                // Get conference.
  if (pcb) NextConf = "Main Board";    // Join Main conference.

// Construct name of upload log and upload spec files.
//-----------------------------------------------------------

  exec ("CRDIR",DIR);                  // Create directory if necessary.
  upload_log = DIR;                    // Set directory.
  strcat (upload_log,"\");
  strcat (upload_log,ul_spec);         // Add BBS name.
  strcat (ul_spec,".UL");              // Add extension.

// Read upload specs.

  infile = fopen (ul_spec,"r");        // Read from upload spec.file.
  if (infile==0) goto done;            // No such file!

// Start uploading.
//-----------------------------------------------------------

  i = fstat = 0;
  read (maxup,temp);
  MAX = stoi (temp);
  while (i < MAX && carrier())         // Upload files            
  { while (!fstat)                     // Make sure a filename has
      filename();                      // been read.
    if (UL()) ++i;                     // If upload OK, count file.
    if (fstat<0) i = MAX;              // Quit if EOF read.
  }
  fclose (infile);                     // Close the specification file.

done:
  if (!carrier()) return (-1);         // Carrier lost...
  fdelete (ul_spec);                   // Delete the upload file.

  if (mbbs && infilemenu)              // In the file menu, MBBS:
  { waitfor (command,2);
    call (PutLine,"Q",Enter);          // Quit.
  }
  else
    flush();
  return (0);
}

//-----------------------------------------------------------
// Routine to check if file exists and perform upload.
//-----------------------------------------------------------    

// The routine returns zero for unsuccessful, and one for a
// successful upload.
// No message is given for files not found!

UL()
{
int ok, error;

  if (filename()) return (0);          // Return if no description.

  if (strchr(f1,0,'\') > 0)
    file = f1;                         // Directory specified.
  else
  { file = _up_dir;                    // Not specified:
    ok = strlen(file)-1;
    if (subchr(file,ok)!='\')          // Append "\" if  
    strcat (file,"\");                 // necessary.
    strcat (file,f1);                  // Build complete filename.
  }
  fnstrip (file,3,f0);                 // Isolate the filename.

  for (ok=0; ok<2; ++ok)  
  { if (filesize(file) > 0) goto found;// File found.
    file = _down_dir;                  // not in that directory;
    strcat (file,f0);                  // try the download dir.
  }
  return (0);                          // No upload.

found:
  fnstrip (file,12,f1);                // Isolate directory.
  flush();                             // Wait a minute!
  if (pcb)
    ok = pcbup();
  else if (mbbs)
    ok = mbbsup();
  else if (rbbs)
    ok = rbbsup();
  else if (opus)
    ok = rbbsup();                     // !!!!!!!!!!!!!!!!!!!!!!
  else if (crcs)                       // REMEMBER TO UPDATE THESE!
    ok = rbbsup();

  return (ok);
}

//-----------------------------------------------------------
// PCBoard upload routine. First line of description must be
// in "description".
//-----------------------------------------------------------

pcbup()
{
int ok, short;
str filespec [10]="Filespec";
str toabort  [10]="to abort";

  setconf ('#');                       // Check conference.
upload:
  terminal();
  input = "U ";
  strcat (input,hisprot);              // ?modem protocol
  strcat (input," ");
  strcat (input,f0);                   // Send file name.

  if (BBSver < 145)
    t1 = track("(-----", 0);           // Enter description.
  else
  { filespec = "name to Up";           // Another text for tracking.
    t1 = track("description",0);       // Enter description now.
  }

  t2 = track("duplicates",0);          // Duplicate name
  t3 = track(command, 0);              // Next command.
  t4 = track(Filespec,0);              // Next filespec?
  t5 = track("disabled upl",0);        // Uploads disabled!
  t6 = track("Please try a",0);        // Wrong PCB version?

  tmark = timer_start (tol);           // Gimme a minute.

  call (PutLine, input, Enter);
  while ((stat=trig()) > 0)            // Answer any questions.
  { if (stat==t2)                      // Duplicate name?
      addname();                       // Add the name to the upload log.

    else if (stat==t4)
      cputs ("^M");                    // No more files.

    else
      break;                           // Other: Break out.
  }
  release();                           // Release timer and tracks.

  if (stat == t5)
    fstat = -1;                        // BBS won't have uploads.
  else if (stat == t6)                 // Wrong PCBoard version?
  { if (BBSver < 145)
    { BBSver = 145;
      setchr (temp,0,BBSver);          // Set new version
      setchr (temp,1,0);
      write (version,temp);            // Inform other scripts.
      goto upload;
    }
    else
      fstat = -1;
  }
  if (stat != t1) return (0);          // Everything but t1 is error.

  t1 = track("? (",0);                 // Enter description.
// Enter a longer description of the file please!
  t2 = track(" please!", 0);
  t3 = track(command,  0);             // Next command.
  t4 = track(filespec, 0);             // Next filespec.
  t5 = 0;
  if (BBSver < 145)
    t5 = track("(A)bort?", 0);         // Ready to start. < 14.5
  else
    toabort = "ts Transfer";           // Ready to start. >= 14.5

// LAST CHANCE!  (Enter) or (S)tart, (G)oodbye after transfer, (A)bort?
// (Ctrl-X) Aborts Transfer >= 14.5
  t6 = track(toabort, 0);

  tmark = timer_start (tol);           // Gimme a minute.

  short = ok = 0;                      // Prepare for error (not OK).
  flush();
  stat=t1;
  do
  { if (stat==t1)                      // Enter description.
    { if (short)                       // Description too short?
      { strcat (description," ...................."); // Add something.
        if (BBSver < 145)
          setchr (description,45,0);   // Limit line to 45 characters.
        else                           // Rev. 14.5 or later:
          setchr (description,48,0);   // Limit line to 48 characters.
        call (PutLine,description,Enter);  // End with CR.
        short = 0;
      }
      else if (fstat)
      { cputs ("^M");                  // End of file spec.
        track_free(t1);                // Trig no more on this.
      }
      else
      { call (PutLine,description,Enter);// Send description.
        if (filename()                 // Next file or description line.
        ||  dline > 95)                // Send max. 96 lines.
        { track_free(t1);
          flush();
          cputs ("^M");
        }
      }
    }
    else if (stat==t2)                 // Longer description wanted!
      short = 1;
  
    else if (stat==t3)                 // Next command?
      break;

    else if (stat==t4                  // Next filespec?
         ||  stat==t5)                 // OK to send?
      cputs ("^M");                    // One more CR.

    else if (stat==t6)                 // OK to send.
    { ok = !call (UpDownF, 1,f1,f0);   // Send file.
      if (ok) 
        addname();                     // OK transfer: Add name
      break;                           // to file list.
    }
  } while ((stat=trig()) > 0);         // Repeat until no trig.

  release();                           // Release timer and tracks.
  if (ok && carrier())                 // No error:
    longwait();                        // Make a LoooNg wait.

  return (ok);                         // Return ok.
}

//-----------------------------------------------------------
// MBBS upload.
//-----------------------------------------------------------

mbbsup()
{
int i,
    pr, b4, nt, na,                    // Track several possible messages
    rn1, rn2, fc, rc, mc, rrc, ds, dd, dn;
  
  input = "";
  if (!infilemenu)                     // NOT in the file menu:
  { strcat (input,"F ");               // So enter file menu.
    infilemenu = 1;                    // We're in the file menu now.
  }

  if (subchr(username,0) > ' ')        // Private upload.
  { strcat (input,"PU ");
    strcat (input,username);           // Send user name.
    call (PutLine,input, Enter);       // Send command.
    input = "";                        // Clear command line.
  }
  else
    strcat (input,"UP ");
  strcat (input,f0);

  pr = track ("(Enter=",0);            // Private? Notice of download?
  dn = track ("=none :",0);            // Directory name
  b4 = track ("lready!",0);            // Exists already!
  nt = track ("ft for that!",0);       // No time left.
  na = track (" to do that!",0);       // Not allowed.
  rn1= track (" receive now",0);       // Start receive.
  rn2= track ("he transfer)",0);       // Start receive.
  fc = track ("File Command",0);       // File command
  rrc= track (" Ref Command",0);       // Read Ref Command
  rc = track ("Read Command",0);       // Read Command
  ds = track ("on of file :",0);       // Enter description.
  mc = track ("Main Command",0);       // Main Command: Time expired.

  call (PutLine,input, Enter);         // Send command and/or filename.

  tmark = timer_start (tol);           // Give me a minute.
 
  while ((stat=trig()) > 0)            // Answer any questions.
  { if (stat==pr)                      // NOT public (if asked),
      call (PutLine,"n", Enter);       // NO notifications.

    else if (stat==b4)                 // He already has that file!
    { flush();
      for (i=strlen(f0)+1; i>0; --i)  
        cputc (8);                     // Send backspace characters 
      flush();                         // to delete filename.
      prints ("");
      addname();                       // Add file to upload log.
      cputs ("^M");                    // No file.
    }

    else if (stat==nt                  // Not enough time for this!
         ||  stat==na                  // Not allowed to upload????
         ||  stat==mc)                 // Main Command?
    { fclose (infile);                 // Terminate reading file.
      fstat = -1;
      if (stat==mc)                    // Error?
      { release();                     // Yes, release tracks.
        return (0);                    // No file sent.
      }
    }
    else if (stat==rn1 || stat==rn2)   // Receive now.
      goto putit;

    else if (stat==dn)                 // Directory name?
      call (PutLine,"Upload",Enter);   // Upload, naturally!

    else if (stat==ds)                 // Description?
    { input = "";
      if (!fstat)
        input = description;
      setchr (input,42,0);             // Cut after 42 characters.
      call (PutLine,input,Enter);      // End with CR.
    }
    else if (stat==rc || stat==rrc)    // Read (Ref) Command?
      call (PutLine,"F",Enter);        // Go back to the file menu!

    else if (stat==fc)                 // File Command?
      break;
  }

  release();                           // Release timer and tracks.
  return (0);                          // No files sent.

putit:
  release();                           // Release tracks and timer.
  terminal();                          // Update screen, start new tracks.

  fc = track ("File Command",0);       // File command
  ds = track ("(Enter=Y):",0);         // Detailed description?
  na = track ("ry number:",0);         // Category number?

  i = call (UpDownF, 1,f1,f0);         // Send file.
  if (i)                               // Error?
  { release();                         // Yes, release tracks.
    return (0);                        // No file sent.
  }

  addname();                           // Add name to upload log.

  tmark = timer_start (tol);           // Give me a minute.
 
  while ((stat=trig()) > 0)            // Answer any questions.
  { if (stat==fc)
      break;                           // End.
    
    else if (stat==na)                 // Category number?
      Call (PutLine,"1",0);            // One - PC.
  
    else if (stat==ds)                 // Detailed description?
    { if (filename())                  // Next is filename
        call (PutLine, "N",Enter);     // or EOF.
      else  
      { call (PutLine,"Y", Enter);     // More description found.
        FSE();                         // Use full-screen editor.
      }
    }
  }
  release();                           // Release timer and tracks.
  return (1);
}

//-----------------------------------------------------------
// RBBS upload.
//-----------------------------------------------------------

rbbsup()
{
int ok, i
   ,rr
   ,error
   ;
  
  ok = 0;
  error = 1;
  if (!infilemenu)                     // NOT in the file menu:
  { call (PutLine,"Q F", Enter);       // Quit, then enter file menu.
    infilemenu = 1;                    // We're in the file menu now.
  }
  input = "U ";
  strcat (input,"U ");
  strcat (input,f0);                   // Send filename.

  rr = track ("Ready to",0);           // Ready to receive.
  call (PutLine, input, Enter);

  tmark = timer_start (tol);           // Give me a minute.
 
  while ((stat=trig()) > 0)            // Answer any questions.
  { if (stat==rr)                      // Ready?
    { waitfor (f0,10);                 // Wait for filename.
      terminal();
      ok = !call (UpDownF, 1,f1,f0);   // Send file.
    }
    break;                             // Other; Break out.
  }
  release();                           // Release timer and tracks.

  if (ok)
    addname();                         // One file sent.

  return (ok);                         // 0 or 1 file sent.
}

//-----------------------------------------------------------
// Full-screen editor input.
// Also works with line-oriented editor.
//-----------------------------------------------------------

FSE()
{
int l, line;

// Check for screen editor.

  line = waitfor ("Enter> key on its own",2);

  do
  { if (mbbs && line)
      waitfor (":",1);                 // Line editor with MBBS: Wait.
    else
      flush();
    setchr (description,72,0);         // Cut at 72 characters.
    for (l=strlen(description)-1; l>0; --l)
    { if (subchr(description,l) > ' ') break;
      setchr(description,l,0);
    }
    if (l<1)
      description = " ";               // Empty line.

    cputs (description);               // Description line.
    if (l != 72) cputs ("^M");         // End the line,
  } while (!filename());               // != 0 when description is done.

  if (line)
    cputs ("^MS^M");                   // End line mode.
  else
    cputs ("^Z");                      // End screen mode.
}

//-----------------------------------------------------------
// Routine to check if the current line contains a filename
//-----------------------------------------------------------

// One line is read from the input file.
// Filename (if found) is in "f0".
// If a filename is not found, the routine checks the input line.
// If it is a description line, it's moved to "description" and
// a zero is returned.
// If it is a conference name it's moved to "NextConf" and
// another line is read.
// If an EOF is read, the return code is negative.

filename()
{
int c, k, maxl;

  fstat = -1;                          // Assume EOF.
  description = "";                    // No description yet.
  do                                   // Continue till D or F line.
  { maxl = fgets (input,80,infile);
    if (maxl < 0) return (fstat);      // EOF!

    maxl = strchr(input,0,':');        // Find colon.
    if (maxl < 1) continue;            // Ignore illegal line.

    for (k=0; k<maxl; ++k)             
    { c = subchr(input,k);             // Find first non-space.
      if (c > ' ') break;
    }

    fstat = 1;
    c = toupper(c); 
    if (c=='D')                        // Description line?
    { setdescr();                      // Set description.   
      if (!fstat) return (fstat);
    }
    else if (c=='P' || c=='N')         // User name?
    { if (mbbs) setUname();            // MBBS only: Set name.
    }
    else if (c=='#' || c=='+' || c=='-') // Set next conference.
    { newconf();
      setconf(c);                      // Join or resign conference.
    }
  } while (c!='F');                    // Loop until filename found.

// Copy filename to "f1":
//-----------------------------------------------------------

  dline = 0;                           // Description starts next line!
  fstat = 0;                           // Filename empty now.
  k = maxl+1;
  maxl = strlen(input);
  for (k; k<maxl; ++k)                 // From next char. to last:
  { c = subchr(input,k);               // Copy filename.  
    if (c <= ' ')  
    { if (fstat==0)
      { prints ("Tý: NO FILENAME FOUND!");
        continue;
      }
      break;                           // <= space and filename read.      
    }
    else  
    { setchr (f1,fstat,toupper(c));
      ++fstat;
    }
  }
  setchr (f1,fstat,0);                 // End string with a zero.
  return(fstat);                       // Good or bad return.
}

//-----------------------------------------------------------
// Routine to copy the current line to a description line. 
//-----------------------------------------------------------

// The routine strips the "D:" from the input line and
// copies the rest of the line into "description".

setdescr()
{
int c, k, maxl, longest;

  fstat = 1;                           // No description yet.
  maxl = strlen(input);                // Length of line.
  k = strchr(input,0,':')+1;           // Find the position of the first
                                       // character after the colon.
  if (pcb)                             // Find max. allowable
    longest = 46;                      // length of description.
  else
  { longest = 42;                      // MBBS allows longer
    if (dline > 0) longest = 72;       // lines later.
  }

  if (maxl < longest) longest = maxl;  // length of conference name.
  maxl = longest-k;

  substr (input,k,maxl,description);   // Copy the remaining text.

  fstat = 0;                           // Description found.
  ++dline;                             // Description line number.
}

//-----------------------------------------------------------
// Routine to extract a user name from the current line.
//-----------------------------------------------------------

// The routine strips the "P:" from the input line and
// copies the rest of the line into "UserName".

setUname()
{
int k;
  k = strchr(input,0,':')+1;           // Find the position of the first
                                       // character after the colon.
  substr (input,k,80,UserName);        // Copy the user name.
}

//-----------------------------------------------------------
// Routine to extract the conference from the current line.
//-----------------------------------------------------------

// The routine strips the "#:" from the input line and
// copies the rest of the line into "NextConf".

newconf()
{
int k, maxl, longest;

  maxl = strlen(input);                // Length of line.
  k = strchr(input,0,':')+1;           // Find the position of the first
                                       // character after the colon.
  for (; k<maxl; ++k)                  // (If no colon, this routine
  { if (subchr(input,k) > ' ') break;  // is not called.)
  }
  longest = 24;                        // Find max. allowable
  if (maxl < longest) longest = maxl;  // length of conference name.
  maxl = longest-k;
  substr (input,k,maxl,NextConf);      // Copy the remaining text.
}

//-----------------------------------------------------------
// The routine joins a conference. If the parameter is
// "+" or "-" the conference is joined or resigned permanently.
//-----------------------------------------------------------  

setconf(int scan)                      // Scan is #, + or -
{
int con, i, k, on, off, timl;
str help  [6];

  switched = call (join,NextConf);     // Join the conf.
  read (conf,PrevConf);                // Get current conference.
             
  if (scan!='+' && scan!='-') return;  // Neither join nor resign?

// This section sets or clears the scan flag for a conference. 

  k = 0;
  if (pcb && BBSver > 144)             // PCBoard newer than 14.4:
  { if (scan=='+')                     // Become a member:
    { call (PutLine,"R SEL", Enter);   // Issue the SELECT command.
      call (PutLine,"R SET", Enter);   // Issue the SET command.
      waitfor ("Read to?",3);          // Wait for question.
      vgetchrs(0,gety(),input,0,80);   // Get line from screen.
                                       // Delete all before "-".
      for (i=0; subchr(input,i) != '-'; ++i)
        setchr (input,i,' ');
      i = -stoi (input)-50;            // Get number, subtract 50.
      itos (i,input);
      call (PutLine,input,Enter);      // Send line.
    }
    else if (scan=='-')                // Quit conference:
      call (PutLine,"R DES", Enter);   // Issue the DESELECT command.
  }  

// This section is used for ProDoor (SCan command).

  else if (pcb)                        // ProDoor:
  { on  = track ("is ON",0);
    off = track ("is OFF",0);
    con = track (command, 0);
  
    call (PutLine,"SCAN", Enter);      // Send SCAN command.
    tmark = timer_start (tol);         // Give me a half minute.
    i = 3;
    while ((stat=trig()) > 0)          // Answer any questions.
    { if (stat==on)
        k = '+';
      else if (stat==off)
        k = '-';
      else if (stat==con)
      { if (k==scan) break;            // If wrong scan flag,
        call (PutLine,"SCAN", Enter);  // send SCAN command again.
      }
      if (!(--i)) break;
    }
    release();                         // Release timer and tracks.
  }

// MBBS has already joined. If RESign is wanted, do it.

  else if (mbbs)
  { write (conflist,"YES");            // Update conference list.
    if (scan =='-')                    // MBBS:
    { t1 = track ("rning from", 0);    // Resigning from....
      i = 0;
      do
      { call (PutLine,"RES Y", Enter); // Resign.
        timl = tol;                    // Save timeout value.
        tol = 20;                 
        tmark = timer_start (tol);     // Give me two seconds.
        while ((stat=trig()) > 0)      // Check returned string.
          if (stat == t1) break;

      } while (stat < 0  && ++i < 3);
      release();                       // Release trigger.
      tol = timl;                      // Restore previous time-out.
    }
  }

// RBBS has already joined. If RESign is wanted, do it.

  else if (rbbs && scan =='-')         // RBBS:
    call (PutLine,"A C", Enter);       // Abandon conference.
}

//-----------------------------------------------------------
// Wait while PCBoard is checking the uploaded file.
//-----------------------------------------------------------

longwait()
{
  t1 = track (command,0);              // Track this 
  track ("...",0);                     // .and  this 
  track ("Okay.",0);                   // ..and this 
  track ("Testing: ",0);               // ..and this 
  track ("Bytes ",0);                  // ..and this.

// (Note: Only track t1 is used).

  tmark = timer_start (tol);           // Gimme another minute.

  while ((stat=trig()) > 0             // Answer any questions.
    && stat!=t1)                       // Command: Exit.
    ;

  release();                           // Release timer and tracks.
}

//-----------------------------------------------------------    
// Add a file name to the upload log file.
//-----------------------------------------------------------    

addname()
{
int i;
   i = subchr (username,0);            // Get user name.
   if (i > ' ')
   { setchr (username,0,0);            // Delete username and
     return;                           // don't update file list. 
   }
   i = fopen (upload_log,"a+");        // Open the file for append
   fputs (f0,i);                       // and write the filename.
   fputs ("^M^J",i);
   fclose (i);
   printsc ("Tý: ");
   printsc (f0);
   printsc (" added to upload log file ");
   prints (upload_log);
}

//-----------------------------------------------------------
// Wrong BBS type.
//-----------------------------------------------------------

wrongBBS(str string)
{
str help[48];
    help = "Illegal BBS type (or not found): ";
    strcat (help,string);
    strcat (help,"!");
    status_wind (help,20);             // Display message for 2 sec.
}

//-----------------------------------------------------------
// Flush incoming text from BBS.
//-----------------------------------------------------------

flush()
{
  do  
  { terminal();                        // Process all echo
    delay(1);                          // from the BBS.
  } while (cinp_cnt() > 0);
}

//-----------------------------------------------------------
// Routine to update colors and status bar.
//-----------------------------------------------------------

entry ()
{
  _back_color = 1;
  _fore_color = 14;
  update_term();
}

//-----------------------------------------------------------
// Free timer and tracks.
//-----------------------------------------------------------

release()
{
  timer_free (tmark);
  track_free(0);
}

//-----------------------------------------------------------
//  Trig loop. Waits here until either one "trig string" is
//  found, or we have a time-out, or carrier is lost.
//-----------------------------------------------------------

trig()
{
int i;
  do
  { terminal();
  }  while (!time_up (tmark)           // Loop until time-out
          && carrier()                 // or carrier lost
          && (i=track_hit(0))==0);     // or we trigged.
  if (i==0) 
    i = -1;                            // Error!
  else
    timer_restart (tmark,tol);         // Restore timer.
  return (i);
}

//-----------------------------------------------------------
// Read a global variable.
//-----------------------------------------------------------

read (str name, str varname)
{
  return (call (global,"R",name,varname));
}

//-----------------------------------------------------------
// Write a global variable.
//-----------------------------------------------------------

write(str name, str varname)
{ 
  return (call (global,"W",name,varname));
}

//-----------------------------------------------------------
// Execute a program.
//-----------------------------------------------------------

exec (str prog,str pram)
{
str line [80];
int i;
  i = run (prog,pram,2);               // Try to run program.
  if (i >= 0) return (i);              // OK.

  line = "Couldn't find or execute '";
  strcat (line,prog);
  strcat (line,".EXE'!");
  tone (80,80);                        // No success:
  status_wind (line,20);
  return (i);
}
