main()
{
int handle=99
   ,save_zmod
   ,c
   ;
  if (handle==99)
    save_zmod = _zmod_auto;

  handle = vsavearea (10,10,62,14);
  _back_color = 4;
  _fore_color = 15;
  c = _back_color*16 + _fore_color;
  if (is_loaded("QDIAL"))
  { box (10,10,62,14,2,0,c);
    pstraxy ("Press 'Y' to abort -- anything else to continue.",12,12,c);
    gotoxy (19,12);
    if ((c=inkeyw())=='Y' || c=='y')
    { call ("GLOBAL","W","LASTK","ESC");
      _zmod_auto = save_zmod;
    }
  }
  else
  { box (10,10,60,14,2,0,c);
    pstraxy ("Press 'Y' to exit -- anything else to continue.",12,12,c);
    gotoxy (19,12);
    if ((c=inkeyw())=='Y' || c=='y')
      exittelix (0,1);                 // Exit.
  }
  vrstrarea (handle);
  handle = 0;
}
