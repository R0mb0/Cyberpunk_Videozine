//          N-1300 SANDVIKA
//          NORWAY
//          tel. (472) 546 396

//-----------------------------------------------------------
// Script starts here.
//-----------------------------------------------------------

main()
{
str sline [5];         // Room for (part of) status line.
int number;            // Line number.

  for (number=0; number<54;++number)   // Find status line.         
  { vgetchrs(50,number,sline,0,5);
    if (subchr(sline,0)==179 && subchr(sline,4)==179)
      break;
    else if (number==0)                // Skip lines 1-23.
      number = 23;
  }
  if (number >= 54) number=0;
  return (number);                     // Return line number.
}
