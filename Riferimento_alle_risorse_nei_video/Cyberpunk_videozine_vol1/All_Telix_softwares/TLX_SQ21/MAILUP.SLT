//-----------------------------------------------------------
// MAILUP.SL? Automatic ASCII upload.
//
// Please look at the comments through the whole file, and modify to
// suit your needs, BEFORE you use it. Then recompile with CS MAILUP.
//-----------------------------------------------------------

// If you have suggestions for improving this script, please suggest
// improvements to me via old-fashioned snail-mail to:

// Author:  Inge Vabekk
//          Hamangskogen 108
//          N-1300 SANDVIKA
//          NORWAY
//          tel. (472) 546 396

int LIMIT = 295;                  // Max. no. of lines for messages.

str bbs_type  [32]                // BBS type.
   ,codename   [8]                // This BBS's codename
   ,maildir   [64] = ""           // Mail directory
   ,input    [144]                // Input line.
   ,input1   [144]                // Help line.
   ,sign      [80]                // Personal signature.
   ,filespec  [64]                // File specification.
   ,shortname [10]                // Shortened name for this BBS.
   ,PrevConf  [20]                // Previous conference.
   ,file      [64]                // Filename for upload.
   ,allfiles [100]                // File *numbers* for upload.
   ,command   [10]="Command:"     // Command prompt.
   ,temp       [4]                // Short temporary string.
                                  // For the Global storage:
   ,global      []="GLOBAL"       // Global script.
   ,join        []="JOINCONF"     // Join Conference script
   ,PutLine     []="PUTLINE"      // Put Line script
   ,conflist    []="CONFLIST"     // Get conference list.
   ,bbstype     []="BTYPE"        // BBS type.
   ,short       []="SHORT"        // Short BBS name.
   ,code        []="CNAME"        // Codename for this BBS.
   ,graph       []="GRAPH"        // Graphics
   ,version     []="BBSVER"       // PCB version number
   ,conf        []="CONF"         // Current conference.
   ,greet       []="GREET"        // Greetings on/off.
   ,prompt      []="PROMPT"       // Current command prompt.
   ,reader      []="READER"       // Name of offline reader.
   ,newmes      []="NEWMES"       // Directory for new messages.
   ;     

int tol = 300                // No activity for 30 sec.
   ,stat, tmark              // makes script time out. 
   ,mbbs, pcb, rbbs, opus, fido, crcs 
   ,BBSver                   // BBS version.
   ,f, first
   ,graphics
   ,XBoard
   ,CR=13                    // Code for CR.
   ;

//-----------------------------------------------------------   
// Script starts here.
//-----------------------------------------------------------   

main()
{
int c, i, j, k, l, m;

  XBoard = 0;
  update_term();                       // Update status bar. 

// Only if online.

  if (!carrier())  
  { failtone();
    status_wind ("Tý: YOU CAN'T SEND MAIL IF YOU'RE OFFLINE!",20);
    return (-1);
  }
  
  read (bbstype,bbs_type);             // Get BBS type. 
  read (short,shortname);              // Shortened BBS name.
  read (conf,PrevConf);                // Previous conference.
  read (prompt,command);               // Command prompt.
  read ("SIGN",sign);                  // Personal signature.

  read (version,temp);                 // Get BBS version no.
  BBSver = subchr (temp,0);
  mbbs = pcb = rbbs = opus = fido = crcs = 0;
  if      (bbs_type == "MBBS") mbbs = 1;
  else if (bbs_type == "PCB" ) pcb  = 1;
  else if (bbs_type == "RBBS") rbbs = 1;
  else if (bbs_type == "OPUS") opus = 1;
  else if (bbs_type == "FIDO") fido = 1;
  else if (bbs_type == "CRCS") crcs = 1;
  else                                          
  { wrongBBS(bbs_type);                // Doesn't match script!
    return (-1);
  }

// Search for the upload specifications.

  if (read (code,codename) <= 0)       // Get BBS ID-code.
    codename = "MAIL";                 // Set default.
  if (read (reader,input) > 0)         // Get offline reader.
  { if (strposi (input,"XBOARD") >= 0) // XBoard?
    { read (newmes, maildir);
      XBoard = 1;
    }
  }
  else
  { maildir = _up_dir;                 // If no XBoard, use MailDir.
    if (codename=="MAIL")
    { strcat (maildir,shortname);      // Use short name.
      strcat (maildir,"\");    
    }
    else
      strcat (maildir,codename);       // Use codename.
  }

  filespec = maildir;                  // Get mail dir.
  strcat (filespec,codename);          // Add codename again.
  l = strlen (filespec);               // Remember length.
  strcat (filespec,".joi");            // Check the "Join" file.
  m = 0;
  for (i=0; i<2; ++i)
  { f=fopen (filespec,"r");            // Open file,
    if ( f > 0)                        // OK?
    { while (fgets (input,144,f) >= 0) // Join conferences.
      { call (Join,input);
        m = 1;
        if (i) call (PutLine,"RES Y",13); // Resign!
      }
      fclose (f);
      fdelete (filespec);              // Delete file.
    }
    setchr (filespec,l,0);             // 2.nd round:
    strcat (filespec,".res");          // Check the "Resign" file.
  }

  if (m) call (conflist);              // Get new conference list.
  setchr (filespec,l,0);               // Proceed with mail.
  strcat (filespec,".m*");             // Add extension.
  setchrs (allfiles,0,' ',100);        // Init. all files to 0.

  while (filefind(filespec,0,file))    // For each file found:
  { filespec = "";               
    k = strposi (file,".M",0)+2;       // Find number.
    setchrs(file,0,' ',k);
    setchr (allfiles,stoi(file),'!');  // Mark this file number.
  }
  
  while ((k=strposi(allfiles,"!",0)) > 0)// For each file found
  { setchr (allfiles,k,' ');           // earlier:
    itos (k,file);
    filespec=codename;                 // Build name.
    strcat(filespec,".M");
    strcat(filespec,file);
    message_up(filespec);              // Send message.
  }
  return(0);
}

//-----------------------------------------------------------
// Upload one message to the BBS.
//-----------------------------------------------------------

message_up (str fname)
{
int i, l, lineno, FSE, again, next
   ,RO, WT  
   ,t1, t2, t3, t4, t5, t6, t7, t8, t9, t11 // Variables for tracking.
   ,empty, hide, number, insert, info, errors
   ;
str fullname [64]           // Full file name.
   ,newname  [12]           // For renaming.
   ,include  [64]           // Include file name.
   ,conf     [20]           // Conference name.
   ,towhom   [24]           // To whom.
   ,reply     [6]           // Reply to which mess.number
   ,subj     [26]           // What subject?
   ,echo      [2]           // Echo to other BBSes?
   ,priv      [2]           // Private?
   ,help      [6]           // Help string
   ,sline    [80]           // Line read back from screen.
   ,quote     [4]           // Previous
   ,nextq     [4]           // and next quote.
   ,ronly []="RONLY"        // To check for read only conference.
   ;

  errors = 0;
  fullname = maildir;                  // Build full filename.
  strcat(fullname,fname);

  read (ronly,newname);                // Check for read-only conference.
  if (strcmpi(newname,"YES")==0)       // Yes.
  { l = strposi (fullname,".M")+1;     // Find position of extension.
    while (filesize (fullname) > 0)    // Rename file.
      setchr (fullname,(i=subchr(fullname,l)+1));
    fullname = maildir;                // Restore original name,
    strcat(fullname,fname);
    newname = fname;
    l = strposi (newname,".M")+1;      // Find position of extension.
    setchr (newname,l,i);              // Use found character.
    frename (fullname,newname);

    tone (100,100);                    // Message.
    printsc
    ("Tý: Read-only conference: Can't send mail. Mail file renamed to ");
    prints (newname);
    return (0);
  }

  f=fopen(fullname,"r");               // Open file,
  if (f < 0) return (0);               // check for error.

// Read these before starting to send mail.

  if (fgets(input,144,f) <0) goto error; // Read conference.
  conf = input;
  if (fgets(input,144,f) <0) goto error; // Read name.
  towhom = input;
  if (fgets(input,144,f) <0) goto error; // Read reference
  reply = input;
  if (fgets(input,144,f) <0) goto error; // Read subject.
  subj = input;
  if (fgets(input,144,f) <0) goto error; // Echo to other systems (Yes/no)
  echo = input;
  if (fgets(input,144,f) <0) goto error; // Read private (Yes/no)
  priv = input;

  setchr (echo,1,0);
  setchr (priv,1,0);
  strupper (priv);
  strupper (echo);
  if (echo != "Y")                     // Answer to echo question
    echo = "N";                        // must be Y or N.

  if (priv == "Y")                     // Private?
    RO = 1;                            // Yes
  else                                 // or
    RO = 0;                            // No.

  info = 0;
  if (mbbs && (strposi(conf,"resum",0) >= 0
    || strposi(conf,"resym",0) >= 0))  // Resume or resyme
      info = 1;
  else if (call (Join,conf) < 0)       // Join conference.
    goto error;                        // Return if error.

  again = 0;

// Send the mail. Maildir contains directory, Filespec contains
// wildcard name of the files to be uploaded.

enter:                                 // Start entering message.
  release();
  vgetchrs(0,gety(),sline,0,80);       // Read screen.
  if (strpos(sline,command,0) < 0)     // No prompt:
    waitfor (command,3);               // Wait for it.
  WT = 1;                              // Wait time initially 1 sec.
  if (!carrier()) goto error;

  if (info)
    input = "Q EDIT";

  else if (reply == "0")  
  { input = "E ";
    if (pcb)                           // PCBoard won't have
    { call (PutLine, input, CR);       // the name on the
      input = "";
      help = ":";
      if (BBSver>144) help="`ALL'?";
      if (!waitfor (help,WT))
        ++WT;                          // same line!
      else if (WT > 2)
        --WT;
    }
    strcat (input,towhom);
  }
  else
  { input = "REPLY ";                  // Answer to previous message.
    strcat (input,reply);
  }

  priv = "";
  t8 = t9 = insert= 0;           // Not used yet.
  if (pcb)                       // PCBoard:
  { FSE = 0;
    LIMIT = 96;
    t1 = track("=abort? ",0);    // Subject : (Blank)=abort?
                                 // or Subject (Enter)=abort?
    t11= track("hange? (",0);    // or Subject (Enter)=no change?

    t2 = track("Security",0);    // Security:? (R)eceiver only, (Enter)=none?
    if (RO) priv = "R";          // If private message.  
    t3 = track("Echo",0);        // Echo to Other Systems:? (Enter)=yes? 
                                 // 'Echo' Message, (Enter)=Y? (y)
    t4 = track(" Editor",0);     // Use Visual Editor: (Enter)=yes?
                                 // Use Full Screen Editor? (n)
    if (BBSver < 145)
      t5 = track("(-------",0);  // Start sending.
    else
      t5 = track("nd mode)",0);  // Start sending.
    t6 = track("(C)ontin",0);    // Unknown name.
    t7 = track("ply to M",0);    // Message unknown.
  }
  else if (mbbs)  
  {
    FSE = 1;
    t1 = track("message:",0);      // Subject of message:
    t2 = track("Private ",0);      // Private message (Enter=N): 
    if (RO) priv = "Y";            // If private message.
    t3 = track("Include ",0);      // Include original message (Enter=N): 
    echo = "N";                    // (This is the answer to that!)
    t4 = track("ter> key",0);      // Not FSE: Enter key twice to end!
    t5 = track("+----7->",0);      // Start sending.
    t6 = track("istered!",0);      // Sorry, that name is not registered!
    t7 = track("or reply",0);      // Message is not available for reply.
    t8 = track("ed (Ente",0);      // Want name & addr. displayed?
    t9 = track("Insert",0);        // Insert mode set.
    t11= track(command,0);         // New command?
  }

  tmark = timer_start (tol);
  lineno = 0;                          // Preset line number.
  call (PutLine, input, CR);           // Send command.

  while ((stat=trig()) > 0)
  { if (stat == t11)                   // Subject (PCBoard 14.5)?
    { if (pcb)
      { t1 = t11;                      // t11 is same as t1, except
        t11 = 0;                       // it's for PCBoard 14.5
        if (BBSver < 145)
          BBSver = 145;                // and later (???)
        setchr (temp,0,BBSver);
        setchr (temp,1,0);
        write (version,temp);          // Save PCB version.
      }
      else if (mbbs)                   // Error, try again!
      { if (++errors < 3) goto enter;
        for (i=strlen(input)+2; i>0; --i) // Failed to send message.
          cputc (8);
        cputc (CR);
        prints ("");
        prints ("");
        prints ("Tý: !!!! ERROR !!!! Couldn't send this message!");
        prints ("");
        prints ("");
        tone (300,10);
        tone (500,10);
        tone (300,10);
        tone (500,10);
        goto error;                    // Return if error.
      }
    }
    if (stat == t1)                    // Subject?
      subject(reply,subj);             // Update subject.

    else if (stat == t2)               // Private?
      call (PutLine, priv, CR);        // YEs or NO.

    else if (stat == t3)               // Echo to other systems:?
      call (PutLine, echo, CR);        // YES or NO.

    else if (stat == t4)               // Use Visual Editor?
    { if (pcb)                         // PCBoard?
      { if (BBSver < 145)
          call (PutLine, "N", CR);     // No.
        else
          call (PutLine, "U", CR);     // No echo for version >= 14.5
      }
      FSE = 0;
    }
    else if (stat == t5)               // Start entering message.
    { if (pcb)                         // PCB: Limited length.
      { i = gety()-1;                  // Read previous line from
        vgetchrs(0,i,sline,0,80);      // screen.
        i = strposi(sline,"/line, ",0);// Get position of number.
        if (i > 40) 
        { substr (sline,i+6,5,help);   // Move the number string.
          LIMIT = stoi (help) - 2;
        }
        if (pcb && echo == "Y")        // PCBoard and echo? Limit the
          if (LIMIT > 96) LIMIT = 96;  // length to 97 lines (starts on 0).
      }
      break;                           // Ready to send!
    }
    else if (stat == t6)
    { input = "";
      if (PCB) 
      { if (BBSver > 144) input = "C";
        call (PutLine, input, CR);     // Insist on that name!
      }
      else if (mbbs)
      { flush();
        vgetchrs(0,gety(),input1,0,80);// Read from screen.
        for (i=-3;i<strlen(towhom);++i)
          cputc (8);                   // Delete name.
        if (strposi (input1,towhom,0) > 0)  // Bad spelling?
        { call (PutLine, towhom, CR);  // Try again!
          continue;
        }
        cputc (CR);                    // Can't send this message!
        flush();
        release();
        failtone();
        input1 = "BBS won't have a message to ";
        strcat (input1,towhom);
        strcat (input1,"!");
        status_wind (input1,30);
        goto error;                    // Return if error.
      }
    }
    else if (stat == t7)               // Not available for reply
    { reply = "0";                     // Wrong conference or 
      if (pcb) flush();                // message deleted. Try again.
      cputc (CR);
      goto enter;
    }
    else if (stat == t8)               // Name & addr. displayed?
      call (PutLine,"N",CR);           // No.

    else if (stat == t9)               // MBBS: Insert mode set.
      insert = 1;
  }
  release();                           // Free all tracks.
  if (!carrier()) goto error;

// Enter lines into either Full Screen Editor, or the line
// oriented editor. Both should work equally well.

  hide = 0;
  setchr (input1,0,0);                 // Line empty now.
  if (info) 
  { flush();
    for (i=1; i<3; ++i)
    { vgetchrs(0,i,input,0,40);        // Read line 2 or 3 from screen.
      setchr (input,40,0);             // Terminate string.
      l = strposi (input,"Message:",0) + 9;
      if (l > 9) break;
    }
    substr (input,l,40-l,input);       // Move the number string.
    i = stoi (input);
    cputc (8);
    cputc (8);
    for (;i>=0;--i) 
    { cputs ("^Y");                    // MBBS info: Clear old message.
      if (i % 10) flush();
    }
    cputc (8);
    cputc (8);
  }
  if (mbbs && FSE)
  { if (insert) cputc (22);            // MBBS: Use Overwrite mode.
    if (BBSver > 98) 
    { cputc (11);
      cputc ('Z');                     // Suppress echo (v.9.9)
    }
  }
  if (info) goto repeat;               // Info: No special processing.

  for (i=strlen(towhom)-1;i>0;--i)     // Cut trailing spaces.
  { if (subchr(towhom,i) > ' ') 
      break;
    setchr (towhom,i,0);
  }
  input = towhom;                      // Get user name.
  for (i=strlen(input)-1;i>=0;--i)     // Cut last word.
  { if (subchr(input,i) <= ' ')
      break;
  }
  setchr (input,i,0);

  read (greet,input1);                 // Greetings on? 
  l = toupper(subchr(input1,0))=='Y';
  next = ftell (f);                    // Get file position.
  fgets (input1,144,f);                // Get first line. 
  if (input1=="!")
    l = !l;                            // Reverse meening of "greet".
  else
    fseek (f,next,0);                  // Reposition file.'
  setchr (input1,0,0);                 // Line empty now.

  if (i>1 && l)                        // Real name? Greetings on?
  { for (;i>=0;--i)
    { l = subchr (input,i);            // Make small characters.
      if (i>0)
        next = subchr(input,i-1);
      else
        next = ' ';

      if (next!=' ' && next!='_' && next!='-')
      { if (l>='A' && l <= 'Z')
          l = l+32;
        else if (l=='’') 
          l = '‘';
        else if (l=='') 
          l = '›';
        else if (l=='') 
          l = '†';
        else if (l=='_' || l=='-') 
          l = ' ';
        setchr (input,i,l);
      }
      else
      { if (l>='a' && l <= 'z')        // First char. is capital.
          l = l-32;
        else if (l=='‘') 
          l = '’';
        else if (l=='›') 
          l = '';
        else if (l=='†') 
          l = '';
        else if (l=='_' || l=='-') 
          l = ' ';
        setchr (input,i,l);
      }
    }
    strcat (input,",^M");
    cputs (input);                      // Write first name.
  }

repeat:
  empty = 0;
  
  while (fgets (input,144,f) >= 0)     // Get next line. 
  { if (again)
    { cputs ("<<<<-------- continued from previous message! --------^M");
      again = 0;
      lineno = 1;
    }

check:
    delay(1);
    terminal();
    if ((l=strchr(input,0,'^Z'))>=0)   // Remove all control-Z
      setchr(input,l,0);               // and all behind.

    while ((l=strchr(input,0,255))>=0) // Find 'FF' in line. 
      setchr(input,l,' ');             // Replace with normal spaces. 

    if (!hide)
    { if (strposi (input,"!END",0) >= 0) // !END signals stop.
        break;
      if ((i=strposi (input,"!TAG",0)) >= 0) // !TAG trigs tagline. 
      { setchr(input,i,0);             // Cut the rest and write first
        write ("TAGX",input);          // part of tagline to "TAGX".   
        call ("Tagline");
        break;
      }
                                       // !INCLUDE includes another file.
      if ((i=strposi(input,"!INCL",0)) >= 0)
      { l = strip (input);
        for (i=i+5; i < l; ++i)
          if (subchr(input,i)==' ') break;
        if (++i < l-2)
        { hide = f;
          substr (input,i,l-i,include);
          f=fopen (include,"r");       // Open include file,
          if (f < 0) 
          { f = hide;                  // Failure.
            hide = 0;
          }
          goto repeat;
        }
      }
      if (strposi (input,"!SPLIT",0) >= 0) // !SPLIT splits message. 
      { cputs (" ------ message split here - continues next message!");
        cputs (" ------>>>>^M");
        again = 1;
        lineno = LIMIT+1;              // Set high line no. 
        goto endmes;       
      }
    }

    l = strip (input);
    if (l>71)
    { l = 72;
      while ( l > 50)
      { if (subchr(input,--l) <= ' ')  // Split the line by space. 
          goto split;
      }
      l = 71;                          // No space found after 50. 
split:
      substr (input,l+1,144,input1);   // Save second half. 
      setchr (input,l,0);              // End input here. 

      l = strip (input1);              // Delete trailing spaces.
      l = strip (input);
    }
    if (mbbs && !FSE)                  // MBBS: Line editor can't take
      waitfor (":",1);                 // full speed.

    if (l > 0)
    { if (pcb && BBSver > 144) prints (input);
      cputs (input);                   // Write current line. 
    }
    else
    { if (pcb && BBSver > 144) prints ("");
      cputs (" ");                     // No line; write space. 
    }
    if (l!=72) cputc (CR);
    if (strlen (sign) > 1)             // Signature defined?
      if (strpos (input,sign,0) == 0)  // This is my signature,
        break;                         // so stop here.

    if (empty)                         // Add empty line?
    { empty = 0;
      if (pcb && BBSver > 144) prints ("");
      cputs (" ^M");                   // Do it.
      ++lineno;
    }

    terminal();                        // Update screen.
    ++lineno;                          // Next line.
    if (strlen(input1))                // Did we split the line? 
    { first = strpos (input,"³ ",0);   // Quote found?
      if (first < 0)
        first = 0;
      else
        ++first;                       // Yes,
      setchr (input,first,0);          // keep it in input line.

      substr (input,0,3,quote);        // Remember quote. 
      l = strip (input);               // Delete trailing spaces.
      if (l)
      { if (subchr(input1,0) != ' ')   // If first char. of "input1"
          strcat (input," ");          // is not space, add one.
      }
      strcat (input,input1);           // Add next line.
      setchr (input1,0,0);             // Line empty now.
      l = subchr (input,strlen(input)-1);// Get last character. 
      if (!isalnum(l)                  // Alphanumeric? 
        && l < '@') goto check;        // "sign"? 

      input1 = "";
      if (fgets (input1,144,f) < 0)    // No, read next line. 
        goto check;                    // Stop when exhausted. 

      l = strip (input1);              // Cut trailing spaces. 
      if (l==0)
      { empty = 1;                     // This line empty?
        goto check;
      }
      else
      if (strposi(input1,quote,0) == 0)// Same quote? 
      { substr (input1,first,l,input1);// Yes, add the line 
        l = strip (input);             // Cut trailing spaces. 
        if (subchr(input1,0) != ' ')   // If first char. of "input1"
          strcat (input," ");          // is not space, add one.
        strcat (input,input1);         // Add next line.
        setchr (input1,0,0);           // Delete the rest. 
        goto check;
      }
    }
  }                                    // Continues till file exhausted. 
  fclose (f);
  if (hide)                            // Included file?
  { f = hide;                          // So return.
    hide = 0;
    goto repeat;
  }
  f = -1;                              // Signal that file is closed.  

endmes:
  if (!FSE)                            // NOT Full Screen Editor:
  { if (mbbs)
      help = "ption:";
    else
      help = "?";
    for (i=0; i<3; ++i)                // Wait for response.
    { cputc (CR);                      // Repeat if there's no response.
      if (waitfor (help,3))
        break;
    }
    cputs ("s");
  }

  t1 = track (command, 0);             // Await next command.
  t2 = track("(Enter", 0);     // Reply to what message number: (Enter)=none?
                               // MBBS: Carbon copies? (Enter=N):
  t3 = track("Mail Co",0);     // Old PCBoard version?

  delay(5);
  if (mbbs && FSE)
    cputs ("^Z");
  else
    cputc (CR);

  tol = 150;
  number = 0;                          // Set message number to 0.
  tmark = timer_start (tol);           // Wait only 15 seconds.

  while ((stat=trig()) > 0)
  { if (stat==t1)  
    { number = readit(info);           // Read message number.
      break;                           // Command makes us exit.
    }
    else if (stat == t2) 
    { number = readit(info);           // Read message number.
      cputc (CR);                      // Enter ENTER.
    }
    else if (stat == t3)               // Old PCB version: QUit.      
      call (PutLine, "QU", CR);
  }
  release();
  tol = 300; 
  if (f > 0) goto enter;               // Had to cut message -
  if (stat < 0) goto error;            // Error!
  
  if (!carrier()) goto error;
  fdelete (fullname);                  // Done - Delete the file.
  if (mbbs && number)
  { itos (number,input1);
    input = "M ";                      // Mark last message.
    strcat (input, input1);
    call (PutLine, input, CR);
    waitfor (command,5);
  }
  if (mbbs && !FSE)
  { _back_color = 4;
    _fore_color = 15;
    update_term();
    tone (660,20);
    tone (440,20);
    prints ("Tý: You should switch to the SCREEN EDITOR for faster upload!");
    prints ("    (Use the U)tility M)ode command).");
    _back_color = 1;
    _fore_color = 14;
    update_term();
  }
  return (0);

error:
  fclose(f);
  printsc ("Tý: Mail file ");
  printsc (fullname);
  prints (" is still available for send!");
  failtone();
  return (0);
}                                      // Continue in next message.

//-----------------------------------------------------------
// This routine updates the subject line when replying to messages.
//-----------------------------------------------------------

subject(str type, str new)
{
int i;
str Sline[80];

  if (type!="0")                       // This is not a reply.
  { flush();
    vgetchrs(0,gety(),Sline,0,80);     // Get last line from screen.
    if (strpos(Sline,new,0) > 0)       // Same subject?
    { cputc (CR);
      return;
    }
                                       // Not PCB, or
    if (BBSver < 145)                  // PCB version prior to 14.5:
    { delay(1);
      terminal();
      for(i=0; i<30; ++i)              // Backspace over text already
        cputc (8);                     // written.
    }
  }
  setchr(new,25,0);                    // No more than 25 characters.
  call (PutLine, new, CR);             // Display new subject.
}

//-----------------------------------------------------------
// Read message number on previous line (MBBS).
//-----------------------------------------------------------

readit(int info)
{
int i, l;
  if (mbbs && !info && BBSver < 99)
  {  for (i = gety()-1; i>=0; --i)
    { vgetchrs(0,i,input,0,32);
      if ((l=strposi (input,"ge number ",0)) > 0)
      { substr (input,l+10,5,input);   // Isolate number.
        return (stoi (input));         // Read, then return number.
      }
    }
  }
  return (0);
}

//-----------------------------------------------------------
// Wrong BBS type.
//-----------------------------------------------------------

wrongBBS(str string)
{
str help[48];
    help = "Illegal BBS type (or not found): ";
    strcat (help,string);
    strcat (help,"!");
    status_wind (help,20);             // Display message for 2 sec.
}

//-----------------------------------------------------------
// Flush incoming text from BBS.
//-----------------------------------------------------------

flush()
{
  do  
  { terminal();
    delay(2);                          // Process all echo
  } while (cinp_cnt() > 0);            // from the BBS.
}

//-----------------------------------------------------------
// Play fail tone.
//-----------------------------------------------------------

failtone()
{
  int n;
  for (n=140; n > 10; n = 100*n/120) 
  { tone(n*10,12);                     // Fail tone!!
    terminal();                        // Process text.
  }
}

//-----------------------------------------------------------
//  Trig loop. Waits here until either one "trig string" is
//  found, or we have a time-out, or carrier is lost.
//-----------------------------------------------------------

trig()
{
int i;
  do
  { terminal();
    i = 0;
    if (!carrier()) break;
  }  while (!time_up (tmark)           // Loop until time-out
          && (i=track_hit(0))==0);     // or we trigged.
  if (i==0) 
    i = -1;                            // Error!
  else
    timer_restart (tmark,tol);         // Restore timer.
  return (i);
}

//-----------------------------------------------------------
// Free timer and tracking functions.
//-----------------------------------------------------------

release()
{
  timer_free (tmark);                  // free timer channel
  track_free (0);                      // and all track channels.
}

//-----------------------------------------------------------
// Strip trailing spaces from string.
//-----------------------------------------------------------

strip (str string)                     // Strip strailing spaces,
{                                      // return length.
int l;
  for (l=strlen(string); l>=0; --l)
  { if (subchr(string,l) > ' ') return (++l);
    setchr(string,l,0);
  }
  return (0);
}

//-----------------------------------------------------------
// Read a global variable.
//-----------------------------------------------------------

read (str name, str varname)
{
  return (call (global,"R",name,varname));
}

//-----------------------------------------------------------
// Write a global variable.
//-----------------------------------------------------------

write(str name, str varname)
{ 
  return (call (global,"W",name,varname));
}
