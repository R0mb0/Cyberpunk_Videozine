//
//Script to log on to Telenet's local access number and load ICEX203
//

str T_ID[] = "D1";
str cr[] = "^M";

main()
{
 alarm(1);
 {
 cputs(cr);
 cputs("D");
 cputs(cr);
 }
   cputs(T_ID);
   cputs("^M");
 if (not waitfor("@", 20))
  {
   prints("Log-on failed!");
   return;
  }
run("icex203","-d",0);
}
