//
//Script to log on to Telenet's local access number and call
//                    Net BBS at 2400BPS
//

str T_ID[] = "D1";
str cr[] = "^M";

main()
{
 alarm(2);
 {
 cputs_tr("@~D~^M~~");

 }
   cputs(T_ID);
   cputs("^M");
 if (not waitfor("@", 20))
  {
   prints("Log-on failed!");
   return;
  }
   cputs("909631");
   cputs("^M");
 if (waitfor("CONNECTED"))
   delay(20);
   cputs("bbs");
   cputs("^M");
}
