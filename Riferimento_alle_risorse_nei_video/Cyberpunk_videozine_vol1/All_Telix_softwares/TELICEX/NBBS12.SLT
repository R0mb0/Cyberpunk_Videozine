//
//Script to log on to Telenet's local access number and
// then onto new BBS at 1200 BPS
//

str T_ID[] = "D1";
str cr[] = "^M";

main()
{
 alarm(1);
 {
 cputs(cr);
 cputs("D");
 cputs(cr);
 }
   cputs(T_ID);
   cputs("^M");
 if (not waitfor("@", 20))
  {
   prints("Log-on failed!");
   return;
  }
   cputs("909631");
   cputs("^M");
 if (waitfor("CONNECTED"))
    delay(20);
    cputs("bbs");
    cputs("^M");
}
