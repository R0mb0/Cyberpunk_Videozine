///////////////////////////////////////////////////////////////////////////////
// This TELIX 3.11 script implements the JMODEM UPLOAD function.
//
// It simply calls JXFER.SLC with the parameter indicating UPLOAD.
//
// The file names to be uploaded are obtained from TELIX.
//
// NOTE:  The file list may contain both wildcards AND multiple filespecs.
//
// Written by: Michael K. Bozovich
// Date: 3-19-89
///////////////////////////////////////////////////////////////////////////////

main()

{

  call("jxfer", "S");

}

