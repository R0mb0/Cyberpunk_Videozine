str code1[] = "C PURSUIT,XXXXXXXX^M"; // Replace the X's with your User ID
str code2[] = "YYYYYYYY^M";           // Replace the Y's with your Password
str cr[] = "^M";

main()
{

int status, t1, t2, t3, t4, t5, t6;
t1 = track("@",1);
t2 = track("PASSWORD = ",1);
t3 = track("CONNECTED",1);
t4 = track("BUSY",1);
t5 = track("UNRECOGNIZED",1);
t6 = track("NOT OPERATING",1);

cputs(cr);

while (1)
  {
   terminal();

   status = track_hit(0);

    if (status == t1)
       cputs(code1);

    if (status == t2)
       cputs(code2);

    if (status == t3)
       break;

    if (status == t4)
       continue;

    if (status == t5)
       {
       clear_scr();
       prints("Error dialing City. Press F9 for the City menu.");
       break;
       }

    if (status == t6)
       {
       clear_scr();
       prints("Error dialing City. It is not operating. Press F9");
       break;
       }

  }
track_free(t1);
track_free(t2);
track_free(t3);
track_free(t4);
track_free(t5);
}
