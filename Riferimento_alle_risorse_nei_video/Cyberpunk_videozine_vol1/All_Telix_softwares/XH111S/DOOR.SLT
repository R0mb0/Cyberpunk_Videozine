// Door.Slt
// Converter to DOOR.SYS, DORINFO1.DEF, PCBOARD.SYS.

Str current_caller  [26],         // Storage of current caller's name
    real_name       [26],         // Caller's real name
    password        [13],         // Caller's password
    city            [25],         // City
    country         [31],         // Country
    bitmaps         [10],         // Record of conf to scan & registration
    expiry_date     [8],          // easy...
    reads[80],
    doorprog[45],
    doorprm[45],
    comment         [30];         // comment on this user

int rec_no,                        // User's Record Number
    acode,
    phone,                         // Phone number
    bytes,                         // Allowed bytes for today
    bdwnld,                         // bytes downloaded
    bupld,                         // bytes uploaded
    fdwnld,                         // to implement
    fupld,                         // idem
    proto,                         // Default protocol
    last_log,                      // Last time/date of log
    ttime,
    control,
    time_left,
    status,                        // see below
    access_level,                  // Access level of current caller
    flags,                         // see below
    total_calls,
    longptr,                       // Pointer into Last_Read file for extended
    read;                          // Last msg read by user (current conf)

int REC_LEN = 320;                 // record length in user file

str name[64], sysop[26], confnum[3];
int baudrate, dbits, call_stat, logt, timer_begin;
str host_dir[64], dir[64], list1[320];

main( int baud, int rec, int stats, int logon_t, str host_dr,
      int timer_b, str confn, int num, str bbs_name, str sysop_name)
{
_scr_chk_key = 0;
name = bbs_name;
sysop = sysop_name;
confnum = confn;
timer_begin = timer_b;
logt = logon_t;
call_stat = stats;
baudrate = baud;
dbits = get_datab();
rec_no = rec;
host_dir = host_dr;
newdir(_telix_dir);
load_user( );

if (!getdoor(num))
    return;

fnstrip(doorprog, 12, dir);
if (dir)
    newdir(dir);
if (control&4)
    door_sys();
if (control&8)
    dorinfo_def();
if (control&16)
    pcboard_sys();

if (control&32)
    calld("CVT-1");
if (control&64)
    calld("CVT-2");
if (control&128)
    calld("CVT-3");

if (control&1)
    calld(doorprog, doorprm);
else
    run(doorprog, doorprm, 0);

if (control&4)
    fdelete("Door.Sys");
if (control&8)
    fdelete("DORINFO1.DEF");
if (control&16)
    fdelete("PCBOARD.SYS");

}
///////////////////////////////////////////////////////////////////////////////
door_sys()

// DOOR.SYS:

// COM1:             <-- Comm Pnrt - COM0: = LOCAL MODE
// 2400              <-- Baud Rate - 300 to 38400
// 8                 <-- Parity - 7 or 8
// 1                 <-- Node Number - 1 to 99                    (Default to 1)
// 19200             <-- DTE Rate. Actual BPS rate to use.
// Y                 <-- Screen Display - Y=On  N=Off             (Default to Y)
// Y                 <-- Printer Toggle - Y=On  N=Off             (Default tn Y)
// Y                 <-- Page Bell      - Y=On  N=Off             (Default to Y)
// Y                 <-- Caller Alarm   - Y=On  N=Off             (Default tn Y)
// Rick Greer        <-- User Full Name
// Lewisville, Tx.   <-- Calling From
// 214 221-7814      <-- Hnme Phone
// 214 221-7814      <-- Work/Data Phone
{
int f, x;
str out[80], tmp[5];

f = fopen("DOOR.SYS", "w");

out = "COMx:";

if (ttime > time_left)
   ttime = time_left;

if (!(call_stat&1))
    setchr(out, 3, get_port()+48);
else
    setchr(out, 3, 48);     // 0 for local mode
fputs(out, f);
fputs("^M^J", f);
itos(baudrate, out);
fputs(out, f);
fputs("^M^J", f);
itos(dbits, out);
fputs(out, f);
fputs("^M^J", f);
fputs("1^M^J", f);
itos(get_baud(), out);
fputs(out, f);
fputs("^M^JY^M^JN^M^J", f);
if (call_stat&256)
   fputs("Y^M^JY^M^J", f);
else
   fputs("N^M^JN^M^J", f);

fputs(current_caller, f);
fputs("^M^J", f);
fputs(city, f);
fputs("^M^J", f);
itos(acode, out);
fputs(out, f);
itos(phone, out);
inschrs("-", out, 3, 1);
fputs(" ", f);
fputs(out, f);
fputs("^M^J", f);
itos(acode, out);
fputs(out, f);
itos(phone, out);
inschrs("-", out, 3, 1);
fputs(" ", f);
fputs(out, f);
fputs("^M^J", f);

fputs(password, f);
fputs("^M^J", f);
itos(access_level, out);
fputs(out, f);
fputs("^M^J", f);

itos(total_calls, out);
fputs(out, f);
fputs("^M^J", f);

date(last_log, out);
fputs(out, f);
fputs("^M^J", f);

itos(ttime*60, out);
fputs(out, f);
fputs("^M^J", f);

itos(ttime, out);
fputs(out, f);
fputs("^M^J", f);
if (status&16)
   fputs("GR", f);
else
  fputs("NG", f);
fputs("^M^J23^M^J", f);
if (status&8)
   fputs("Y", f);
else
  fputs("N", f);
fputs("^M^J", f);
// PASSWORD          <-- Password
// 110               <-- Security Level
// 1456              <-- Total Times On
// 03/14/88          <-- Last Date Called
// 7560              <-- Seconds Remaining THIS call (for those that particular)
// 126               <-- Minutes Remaining THIS call
// GR                <-- Graphics Mode - GR=Graph, NG=Non-Graph, 7E=7,E Caller
// 23                <-- Page Length
// Y                 <-- User Mode - Y = Expert, N = Novice

out = "";
for (x = 1; x <= 40; ++x)
    {
    if (bitcheck(x, 1))
       {
        itos(x, tmp);
        if (out)
            inschrs(",", out, strlen(out), 1);
        inschrs(tmp, out, strlen(out), strlen(tmp));
        }
    }

fputs(out, f);
fputs("^M^J", f);

fputs("1", f);
fputs("^M^J", f);

fputs(expiry_date, f);
fputs("^M^J", f);

itos(rec_no, out);
fputs(out, f);
fputs("^M^J", f);

fputc(proto, f);
fputs("^M^J", f);

itos(fupld, out);
fputs(out, f);
fputs("^M^J", f);

itos(fdwnld, out);
fputs(out, f);
fputs("^M^J", f);

fputs("0^M^J", f);

itos(bytes, out);
fputs(out, f);
fputs("^M^J", f);

// 1,2,3,4,5,6,7     <-- Conferences/Forums Registered In  (ABCDEFG)
// 7                 <-- Conference Exited To DOOR From    (G)
// 01/01/99          <-- User Expiration Date
// 1                 <-- User File's Record Number
// Y                 <-- Default Protncol - X, C, Y, G, I, N, Etc.
// 0                 <-- Total Uploads
// 0                 <-- Total Dlwnloads
// 0                 <-- Daily Dnwnload "K" Total
// 999999            <-- Daily Dnwnload Max. "K" Limit
fclose(f);
}
///////////////////////////////////////////////////////////////////////////////
load_user( )
{
 int file;
 if (filefind("USERS.DAT", 0))
    {
      if ((file = fopen("USERS.DAT", "r")) <= 0)
         {
         fclose(file);
         return 0;
         }

      if (ferror(file) || feof(file))
         {
         fclose(file);
         return 0;
         }
     }
 else
     return 0;

fseek(file, (rec_no-1)*rec_len ,0);
fread(list1, 320, file);    // get all from disk

status = subchr(list1, 0);
subchrs(list1, 1, 26, current_caller);
subchrs(list1, 27, 13, password);
access_level = subchr(list1, 40);
flags = subchr(list1, 41);
subchrs(list1, 42, 26, real_name);
acode = get_int(list1, 68, 2);
phone = get_int(list1, 70, 4);
subchrs(list1, 74, 25, city);
subchrs(list1, 99, 31, country);
proto = subchr(list1, 133);
bytes = get_int(list1, 134, 4);
bupld = get_int(list1, 138, 4);
bdwnld = get_int(list1, 142, 4);
fupld = get_int(list1, 146, 2);
fdwnld = get_int(list1, 148, 2);
subchrs(list1, 150, 8, expiry_date);
last_log = get_int(list1, 158, 4);
time_left = get_int(list1, 162, 2);
total_calls = get_int(list1, 164, 2);
subchrs(list1, 166, 30, comment);
subchrs(list1, 196, 10, bitmaps);
longptr = get_int(list1, 206, 4);
subchrs(list1, 210, 80, reads);
fclose(file);
newdir(host_dir);
}
///////////////////////////////////////////////////////////////////////////////
bitcheck( int confn, int map )
{
int checker = 1, x;
for (x = 1; x <= (confn-1)%8; ++x)
    checker = checker*2;

if ((subchr(bitmaps, map*5 + (confn-1)/8)&checker) != checker)
    return 0;
return 1;
}

dorinfo_def()
{
int f, x;
str out[80],tmp[5];
f = fopen("DORINFO1.DEF", "w");

// THE WARP ZONE           ; BBS name

fputs(name, f);
fputs("^M^J", f);

// DATA                    ; SysOp name 1
out = sysop;
x = strchr(out, 0, 32);
setchr(out, x, 0);
fputs(out, f);
fputs("^M^J", f);

// MASTER                  ;       name 2
delchrs(out, 0, x+1);
fputs(out, f);
fputs("^M^J", f);

// COM0                    ; Com Port  (0 = local)
out = "COMx";
if (!(call_stat&1))
    setchr(out, 3, get_port()+48);
else
    setchr(out, 3, 48);     // 0 for local mode
fputs(out, f);
fputs("^M^J", f);
// 0 BAUD,N,8,1            ; Baud rate (0 = local), Parity, DataBits, Stop Bits
if (call_stat&1)
    out = "0";
else
    itos(get_baud(), out);

strcat(out, " BAUD,N,8,1^M^J1^M^J");
fputs(out, f);
// 1                       ; Network type

// DATA                    ; User name 1
out = current_caller;
x = strchr(out, 0, 32);
setchr(out, x, 0);
fputs(out, f);
fputs("^M^J", f);

// MASTER                  ;       name 2
delchrs(out, 0, x+1);
fputs(out, f);
fputs("^M^J", f);

// CITY, PROVINCE          ; City, Province
fputs(city, f);
fputs("^M^J", f);
// 1                       ; ANSI 1=Yes, 0=No
if (status&16)
 out = "1";
else out = "0";
fputs(out, f);
fputs("^M^J", f);
// 30000                   ; Level
itos(access_level, out);

fputs(out, f);
fputs("^M^J", f);
// 580
if (ttime > time_left)
   ttime = time_left;
itos(ttime, out);
fputs(out, f);
fputs("^M^J", f);
fclose(f);
}

pcboard_sys()
{
int f, x;
str out[80],tmp[5];
f = fopen("PCBOARD.SYS", "w");

//   Offset   Type   Length  Description
//   ------  ------  ------  -----------
//      0    str        2    Display On/Off ("-1" = On, " 0" = Off)
fputs("-1", f);

//      2    str        2    Printer On/Off ("-1" = On, " 0" = Off)
fputs(" 0", f);

//      4    str        2    Page Bell On/Off ("-1" = On, " 0" = Off)
fputs("-1", f);

//      6    str        2    Caller Alarm On/Off ("-1" = On, " 0" = Off)
fputs(" 0", f);

//      8    char       1    Sysop Flag (" ", "N"=sysop next, "X"=exit dos)
fputs(" ", f);

//      9    str        2    Error Corrected ("-1" = On, " 0" = Off)
fputs(" 0", f);
//     11    char       1    Graphics Mode ('Y'=yes, 'N'=no, '7'=7E1)

if (status&16)
   fputc('Y', f);
else
   fputc('N', f);

//     12    char       1    Node Chat Status ('A'=available, 'U'=unavailable)
fputc('N', f);

//     13    str        5    DTE Port Speed (PC to Modem speed)
itos(get_baud(), out);
format(out, 5);
fwrite(out, 5, f);

//     18    str        5    Connect Speed shown to caller or "Local"
itos(baudrate, out);
format(out, 5);
fputs(out, f);

//     23    int        2    User's Record Number in the USERS file
itos(rec_no, out);
fputs(out, f);
fputs("^M^J", f);

//     25    str       15    User's First Name (padded to 15 characters)
substr(current_caller, 0, strchr(current_caller, 0, 32), out);
if (!out || strlen(out) > 15)
    out = "";
fwrite(out, 15, f);

//     40    str       12    User's Password (padded to 12 characters)
fwrite(password, 12, f);

//     52    int        2    Time User Logged On (in minutes since midnight)
itoc(thour(logt)*60 + tmin(logt), 2, f);

//     54    int        2    Time used so far today (negative number of minutes)
itoc((curtime()-logt)/600, 2, f);   // figure this out

//     56    str        5    Time User Logged On (in "HH:MM" format)
itos(thour(logt), out);
inschrs("0", out, 0, 2-strlen(out));
fwrite(out, 2, f);
fputc(':', f);
itos(tmin(logt), out);
inschrs("0", out, 0, 2-strlen(out));
fwrite(out, 2, f);
//     61    int        2    Time Allowed On (from PWRD file) (see note 1 below)
itoc(timer_begin/600, 2, f);
//     63    int        2    Allowed K-Bytes for Download (see note 2 below)
itoc(bytes/1024, 2, f);
//     65    char       1    Conference Area user was in (if <= 255)
fputc(stoi(confnum), f);
//     66    bitmap     5    Conference Areas the user has joined this session
//     71    bitmap     5    Conference Areas the user has scanned this session
out = "";
fwrite(out, 10, f);
//     76    int        2    Conference Add Time in minutes
itoc(0, 2, f);
//     78    int        2    Upload/Sysop CHAT Credit Minutes (see note 3 below)
itoc(0, 2, f);
//     80    str        4    Language Extension (see note 4 below)
fwrite("    ", 4, f);
//     84    str       25    User's Full Name (padded to 25 characters)
fwrite(current_caller, 25, f);
//    109    int        2    Calculated Minutes Remaining (see note 5 below)
itoc(time_left, 2, f);
//    111    char       1    Node Number (or ' ' if no network)
fputc(' ', f);
//    112    str        5    Scheduled Event Time (in "HH:MM" format)
fwrite("00:00", 5, f);
//    117    str        2    Is Event Active ("-1" = On, " 0" = Off)
fwrite(" 0", 2, f);
//    119    str        2    Slide Event ("-1" = On, " 0" = Off)
fwrite(" 0", 2, f);
//    121    bsreal     4    Memorized Message Number
itoc(0, 4, f);
//    125    char       1    Comm Port Number (0=none, 1-8)
if (!(call_stat&1))
    fputc(get_port(), f);
else
    fputc(0, f);     // 0 for local mode
//    126    char       1    Reserved for PCBoard
//    127    char       1    Reserved for PCBoard
itoc(0, 2, f);
//    128    char       1    Use ANSI (1 = Yes, 0 = No)
fputc((status&16)/16, f);
//    129    char       8    Last Event Date (in "MM-DD-YY" format)
fputs("01-01-92", f);
//    137    int        2    Last Event Minute (in minutes since midnight)
itoc(0, 2, f);
//    139    char       1    Caller Exited to DOS (1 = Yes, 0 = No)
fputc(0, f);
//    140    char       1    Event Up Coming (1 = Yes, 0 = No)
fputc(0, f);
//    141    char       1    Stop Uploads (1 = Yes, 0 = No)
fputc(0, f);
//    142    int        2    Conference Area user was in (up to 65535)
itoc(stoi(confnum), 2, f);
//    144    bitmap  varies  High Conference Areas the user has joined (note 6)
//   varies  bitmap  varies  High Conference Areas the user has scanned (note 6)
fclose(f);
}

ctoi( int num, int fcb )
{
  int i = 0, x, z;
  z = 1;

  for (x = 1; x <= num; ++x)
  {
   i = fgetc(fcb)*z+i;
   if (i == -1)
       break;
   z = z*256;
  }
 return i;
}
///////////////////////////////////////////////////////////////////////////////
// Code to transform an int (src) to a savable form. num is the bytes
// used on disk, 2 or 4. (2 for less than 32767, 4 for bigger)

itoc( int src, int num, int file )
{
 str digits[4];
 int i, ma, mz, my;

if (num == 4)
  mz = 16777216;
else
  mz = 256;

 my = src;

 for (ma = 1; ma <= num; ++ma)
   {
    i = my/mz;
    setchr(digits, num-ma, i);
    my = my%mz;
    mz = mz/256;
    }
 fwrite(digits, num, file);
 return;
}
///////////////////////////////////////////////////////////////////////////////
format( Str string, int length )
{
 if (length == 0)
  {
  while (subchr(string, strlen(string)-1) == 32)
     delchrs(string, strlen(string)-1, 1);
   }
 else
   setchrs(string, strlen(string), 32, length-strlen(string));
  return;
}
///////////////////////////////////////////////////////////////////////////////
// f //

GetDoor( int Num )
{
 int objf;
 str obj_fname[64];
 str param[10];

 param = ".DOR";

 prep(stoi(confnum), param, obj_fname);
 inschrs(host_dir, obj_fname, 0, strlen(host_dir));
 param = "";

 objf = fopen(obj_fname, "r");

 if (objf <= 0)
    {
     fclose(objf);
     return 0;
     }

 fseek(objf, 349 + 131 * (num-1), 0);

 if (fread(doorprog, 45, objf) < 45)
    {
     fclose(objf);
     return 0;
     }
 format(doorprog, 0);
 fseek(objf, 3, 1);         // skip enbyte & CR LF

 fread(doorprm, 45, objf);
 format(doorprm, 0);

 ttime = ctoi(2, objf);
 control = fgetc(objf);
 fclose(objf);
}
///////////////////////////////////////////////////////////////////////////////
Prep( int num, str ext, str buf )
{
itos(num, buf);
inschrs("000", buf, 0, 3-strlen(buf));
inschrs(ext, buf, strlen(buf), strlen(ext));
}
///////////////////////////////////////////////////////////////////////////////
get_int( str src, int pos, int num )
{
int i, x, mult = 1;
for (x = 0; x < num; ++x)
  {
   i = subchr(src, pos + x) * mult + i;
   mult = mult * 256;
  }
return i;
}
