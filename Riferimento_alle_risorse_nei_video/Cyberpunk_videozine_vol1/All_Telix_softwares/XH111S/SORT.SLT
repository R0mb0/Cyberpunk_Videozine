str host_dir[80];
str confpath[45];
main( )
{
str ffound[12];
int done, file, i;
str ffblk2[12] = "*.DIR";

str dirrec[80];
            // xdir must be current one
 get_dir(); // load current dir
 if (!filefind("CONFS.DAT", 0))
    {
    prints("Can't find CONFS.DAT!^M^JThe current directory must be the XHost data directory.");
    return;
    }
 prints("Sorting file lists:");
 i = 1;
 while (get_conf(i))
       {
       // chdir, prep fname, open
       newdir(confpath);
       itos(i, ffound);
       inschrs("00", ffound, 0, 3-strlen(ffound));
       inschrs(".DIR", ffound, strlen(ffound), 4);
       file = fopen(ffound, "r");
       dirrec = "";
       fread(dirrec, 19, file);
       if (strcmpi(dirrec, "* xHost Data File *") == 0)
          {
          setchr(ffound, 3, 0);
          printsc("Conference ");
          prints(ffound);
          fseek(file, 317, 0);

         while(fread(dirrec, 80, file) == 80)
              {
               delchrs(dirrec, 0, 32);
               if (newdir(dirrec))
                  {
                  if (filefind("FILES.LST", 0))
                     {
                      setchr(dirrec, 45, 0);
                      printsc("  ");
                      prints(dirrec);
                      dos("sort <files.lst>xh$$$.tmp", 0);
                      fdelete("FILES.LST");
                      dos("rename xh$$$.tmp files.lst", 0);
                      }
                  }
               }
	     }
      fclose(file);
      ++i;
    }
 newdir(host_dir);
 prints("Done!");
}

Get_Conf( int dir_num )
{
int c;
str list1[80], confn[20];

if (dir_num < 1 || dir_num > 40)
    return 0;

newdir(host_dir);
c = fopen("CONFS.DAT", "r");

if (c <= 0)
   {
    fclose(c);
    return 0;
    }

fseek(c, 80*(dir_num-1), 0);

if (fread(list1, 80, c) < 80)
    {
     fclose(c);
     return 0;
     }
fclose(c);
subchrs(list1, 3, 20, confn);
subchrs(list1, 23, 45, confpath);
if (!confpath)
    confpath = host_dir;
return (Strlen(confn) > 0);
}
///////////////////////////////////////////////////////////////////////////////
get_dir()
{
dos ("cd>xh$$$.tmp", 0);
int f;
f = fopen("XH$$$.TMP", "r");
fgets(host_dir, 80, f);
fclose(f);
fdelete("XH$$$.TMP");
}
