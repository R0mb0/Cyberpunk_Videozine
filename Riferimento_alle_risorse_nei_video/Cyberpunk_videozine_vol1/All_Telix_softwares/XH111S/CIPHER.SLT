str info[] =  "Andras1Pattantyus1He",
    key[20] = "-òÉ“ößž€ª‰ÐÆåÙÅðý";
main()
{
str dmp[20];
int ix, x;
ix = curtime();
encode();
dmp = info;
for (x = 0; X <= 100; ++x)
    {
    info = dmp;
    decode(strlen(info));
    }
printn(curtime()-ix);
prints(info);
}
encode(str info)
{
int length, count, loop, j;

length = strlen(info);
count = strlen(key);
 j = 0;
for (loop = 0; loop < length; ++loop)
     {
      setchr(info, loop, (subchr(info, loop) + subchr(info, loop+1) * 256)^(subchr(key, j) + subchr(key, j+1)*256));
      ++j;
      if (j >= count)
         j = 0;
     }
}
decode(str info, int len)
{
int length, kpos, loop;
length = len;
if (length%strlen(key) == 0)
    kpos = len - 1;
else
    kpos = length%strlen(key) - 1;

for (loop = len-1; loop >= 0; --loop)
    {
    if (loop == len - 1)
        setchr(info, loop, (subchr(info, loop))^(subchr(key, kpos)));
    else
        setchr(info, loop, (subchr(info, loop) + subchr(info, loop+1) * 256)^(subchr(key, kpos) + subchr(key, kpos+1)*256));
    --kpos;
    if (kpos < 0)
        kpos = strlen(key) - 1;
    }
}
