///////////////////////////////////////////////////////////////////////////////
vars( )
{
str time_[8];
_sound_on = (thour(curtime()) >= chaton && thour(curtime()) < chatoff && chaton <= chatoff)
 || (chaton > chatoff && !(thour(curtime()) <= chaton && thour(curtime()) > chatoff));
if (sysbyte&64)      // if forced ON
    _sound_on = 1;
if (sysbyte&128)     //  if OFF
    _sound_on = 0;

if (!(call_stat&128))
    last_end = curtime();

if (calls)
    time(last_end-last_start, time_);
else
    time_ = "Zilch";
pstraxy(time_, 17, 11, 7);

gotoxy(14, 13);
onoff(_sound_on);
if (sysbyte&64 || sysbyte&128)
    pstra(" (Locked)", 7);
else
    pstra("         ", 7);
gotoxy(16, 14);
onoff(sysbyte&16);
gotoxy(23, 15);
onoff(sysbyte&2);
gotoxy(20, 16);
onoff(sysbyte&1);
}
