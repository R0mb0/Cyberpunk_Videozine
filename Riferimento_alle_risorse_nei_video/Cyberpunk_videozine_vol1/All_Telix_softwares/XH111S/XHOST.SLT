{
str s[13];
setchrs(s, 0, 32, 12-strlen(id));
inschrs(":", s, 0, 1);
print("^M^J");
puts(id, "0");
print(s);
puts(inf, "0;1");
}
///////////////////////////////////////////////////////////////////////////////
kick_out( )
{
 if (!(call_stat&8))
     puts("^M^JGoodbye!^M^J", "0;32");
 if (call_stat&2 && carrier())
    {
     hangup();
     delay(10);
     if (carrier())
       {
        delay(10);
        if (carrier())
            init_mdm(_mdm_hang_str, 0);
        }
     }
 call_stat = call_stat | 8;
 }
///////////////////////////////////////////////////////////////////////////////
defmenu( )
{
 int x;
 menu_keys = "GUDFTYCR?";
 commands = "^002^255^044^255^045^255^046^255^011^255^003^255^004^255^046^255^001^255";
 area = "The Main Menu";
 for (x = 1; x <= strlen(commands); x = x + 2)
     setchr(commands, x, 0);
}
///////////////////////////////////////////////////////////////////////////////
load_menudef( int mnu )
{
int mfile, pos, x;
str name[12];
newdir(host_dir);
// 5 bytes per command, 50 keys in all, + 30 for name, = 280 bytes
menu_keys = "";
if ((mfile = openf("MENU.DEF", "r", 1)) != -1)
    {
    commands = "";
    fread(list1, 100, mfile);
    x = 0;
    while (x <= 95 && subchr(list1, x+2) > 0)
       {
        if (subchr(list1, x) <= access_level && (subchr(list1, x+1)&flags) ==
            subchr(list1, x+1))
            {
            setchr(menu_keys, pos, subchr(list1, x+2));
            setchr(commands, pos*2, subchr(list1, x+3));
            setchr(commands, pos*2 + 1, subchr(list1, x+4));
            ++pos;
           }
         x = x + 5;
        }
    fseek(mfile, mnu*255, 1);
    if (fread(area, 25, mfile) == 25)
        {
        if (strlen(area) > 0)
            {
            fread(list1, 230, mfile);
            x = 0;
            while (x <= 225 && subchr(list1, x+2) > 0)
               {
                if (subchr(list1, x) <= access_level && (subchr(list1, x+1)&flags) ==
                    subchr(list1, x+1))
                    {
                    setchr(menu_keys, pos, subchr(list1, x+2));
                    setchr(commands, pos*2, subchr(list1, x+3));
                    setchr(commands, pos*2 + 1, subchr(list1, x+4));
                    ++pos;
                   }
                 x = x + 5;
                }
            menu = mnu;
            }
       }
    else menu_keys = "";
    fclose(mfile);
    }
return strlen(menu_keys);
}
///////////////////////////////////////////////////////////////////////////////
make_nice( str ss )
{
 int c;
 strlower(ss);
 setchr(ss, 0, toupper(subchr(ss, 0)));

 for (c = 1; c <= strlen(ss)-1; ++c)  // this makes the name look nicer
     {
     if (!isalnum(subchr(ss, c-1))) // if preceding char is space or whatever
         setchr(ss, c, toupper(subchr(ss, c)));
     }
}
