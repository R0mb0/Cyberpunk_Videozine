///////////////////////////////////////////////////////////////////////////////
//  X H o s t  -  by Andras Pattantyus                              //
///////////////////////////////////////////////////////////////////////////////
//  For Telix 3.15.                                                          //
///////////////////////////////////////////////////////////////////////////////

///////////////////////////////////////////////////////////////////////////////
// The System Variables... These are updated by SETUP.

Str host_dir   [64] = "D:\COMMS\SCRIPT\",   // xHost's directory. 15
    system_name[20] = "The Cavern", // System's name 82
    system_pass[12] = "BBS",        // System Password  105
    sysop_name [25] = "ACE APE",    // System Operator's name 120
    temp_dir   [64] = "D:\TEMP\";   // Temp dir 148

int raw_level = 20,                   //               Raw Dir access 214
    path_level = 255,                                              //219
    high_conf = 1,                       //       Highest Conference 224
    chaton = 14,                          // Chat start time         229
    chatoff = 20,                         //      end time           234
    sysbyte = 4368,                                         //       239
    minbaud = 1200,                                      //          244
    startup_time,                // int for time/date of startup.    249
    last_start,                  // Time of start of last call       254
    last_end,                    // Time of end of last call         259
    calls,                       // Number of calls                  264
    callsi;                      // Number of calls since startup    269

// sysbyte: DSSE DnCdL
//          0000 00000

// Display, New Users OFF, Capture, direct_connect, Locked rate.

// Sound force off, force on, Exit Telix on EOC
//          128         64          32
// 256: Real names 512: don't use file lists  1024: don't test uploads
//
// 2048: no user records    4096: use file_id.diz

// Protocol List (with control byte)

str protkeys  [18] = "XYZ1EGMTKS",
    protdata  [18] = "^A^C^C^A^C^A^C^C^A^C",
    busystr   [10] = "ATS0=0^M";
///////////////////////////////////////////////////////////////////////////////
// Variables that are read from xxx.DAT or Object File

int conf_lvl,                    // Conference Access Level
    conf_flag,                   // Conference Access Flags
    high_dir,                    // Number of Last Dir
    high_txt,                    //                Text file
    high_door,                   //                door
    conf_stat,                   // Conference Status Flag
    menu,                        // number of current menu
    obj_lvl,                     // Level for Object retrieved by GetObj
    obj_flag;                    // Flags for Object retrieved by GetObj

Str obj_name    [30],            // Name of Object retrieved by GetObj
    obj_path    [45],            // Path of Object retrieved by GetObj

    confname    [20],            // name of current conference
    confpath    [45],
    confnum     [3],             // number of current conference

    area        [30],            // Defines the current area (File, msg, etc.)
    arg_list    [80],            // Argument list on command line

    descr       [46],            // File description
    menu_keys   [66],
    commands    [132],
    list0       [1200],          // File list!
    list1       [2000],          // List for files and other things

    stuff       [100],           // Stuff (used for anything)
    temp        [80],            // Temp string
    listline    [512],
    things      [128];           // catch-all string
    
///////////////////////////////////////////////////////////////////////////////
// The user variables... All of them are read off the USERS.DAT file.

Str current_caller  [26],         // Storage of current caller's name
    real_name       [26],         // Caller's real name
    password        [13],         // Caller's password
    city            [25],         // City
    country         [31],         // Country
    bitmaps         [10],         // Record of conf to scan & registration
    reads           [80],         // all the LAST_READs for conferences 1-40
    comment         [30];         // comment on this user

int rec_no,                        // User's Record Number
    acode,
    phone,                         // Phone number
    bytes,                         // Allowed bytes for today
    bdwnld,                        // bytes downloaded
    bupld,                         // bytes uploaded
    fupld,                         //
    fdwnld,                        //
    proto,                         // Default protocol
    last_log,                      // Last time/date of log
    time_left,
    page_length = 24,
    status,                        // see below

//  Status byte:
//   xCxAXSBD (xxxxxxx, Capture, xxxxx, ANSI, Xpert, Scan, Blacklist, Deleted)
//   00011000

    access_level,                  // Access level of current caller
    flags,                         // see below

//  Flag byte:
//       ??????SC   (6 definable, Co-SysOp, SysOp)
//       00000000

    total_calls,
    read;                          // Last msg read by user (current conf)


int REC_LEN = 320,                 // record length in user file
    MSG_LEN = 128;
///////////////////////////////////////////////////////////////////////////////
// Control and Other variables

//   Call_Stat Flags:

//   1 local_mode,                   TRUE if I/O is local only
//   2 check_carrier,                TRUE if we need to check carrier
//   4 already_connected,            TRUE when carrier is present on startup
//   8 finished_caller,              TRUE on end of call
//  16 exit_requested,               TRUE when SysOp wants to terminate
//  32 exit_tlx,                     TRUE when we should exit Telix
//  64 pause,                        TRUE when pauses must be made
// 128 waiting,                      TRUE while inside of initial loop

int call_stat,
    baud,
    conn_baud,                   // Baud rate of connection (as opposed to DTE)
    pointy,                      // number of lines sent
    help_line,                   // Row of Status Line (-1 == none)
    file,                        // Some file handles
    file2,                       // idem
    ratio,                       // byte ratio of user's level

    pos,                         // general int

    ttime,                       // Transfer time setting
    totalbytes,                  // byte total for transfer

    timer_begin,                 // Where initial timer value is stored
    tmark;                       // Timer for time left this call

str DefExt        [4]  = ".ZIP", // Default archive extension
    USERF         []   = "USERS.DAT",
    FLIST         []   = "FILES.LST",
    EXFILE        []   = "EXTRACT",
    SHELL         []   = "SHELL.BAT",
    TMPFILE       []   = "XH$$$.TMP",
    DONE          []   = "Done...",
    ERROR         []   = "An error occured.",
    CLOSE         []   = "*CLOSE*",
    NEW_VAL       []   = "^M^JNew value (Enter=no change)? ",
    VERSION[] = "XHost 1.11",
    stat_line     [80],
    HELP          [80];
int stat_color;
///////////////////////////////////////////////////////////////////////////////
// Start of main procedure
// This displays information on xHost status and awaits a call or action
// by the sysop.

Main( )
{
  Str old_down_dir    [64], old_up[64];

  // should also save: capture and usage log filename

  Int old_scr_chk_key,            // Saving default values for restoring
      old_cisb_auto,
      old_time,
      old_zmod_auto,
      old_sound, 
      old_alarm,
      old_b,                       // Old back color
      old_date,
      old_f,                       // Old fore color
      qwik,
      c;
  old_up = _up_dir;
  old_scr_chk_key = _scr_chk_key;
  old_cisb_auto = _cisb_auto;
  old_zmod_auto = _zmod_auto;
  old_sound = _sound_on;
  old_alarm = _alarm_on;
  old_date = _date_format;
  old_time = _time_format;
  old_b = _back_color;
  old_f = _fore_color;
  old_down_dir = _down_dir;

  _down_dir = temp_dir;
  _scr_chk_key = 0;
  _time_format = 1;
  _date_format = 0;
  _cisb_auto = 0;
  _alarm_on = 1;
  _zmod_auto = 0;
  _fore_color = 7;
  _back_color = 0;

 // Here we start off by doing some checking...

  set_terminal("ANSI-BBS");

  if (!host_dir)
     {
      calld("SETUP.SLC");
      prints("Please restart XHost to load new configuration.");
      return;
      }

  if (!_telix_dir)
      _telix_dir = host_dir;

  startup_time = curtime();

  set_defprot(90);                // Default protocol for estimates set to Z

  clear_scr();
  gethelpline();
  gotoxy(0, 0);
  getarc(1, "", ""); // load default archive extension

  if (!temp_dir) 
     {
      if (subchr(host_dir, 1) == 58)  // if we have a colon in hostdir,
         {
          setchr(temp_dir, 0, subchr(host_dir, 0));     // then set temp_dir
          setchr(temp_dir, 1, 58);                // to same drive with colon
         }

        inschrs("\XH_TEMP", temp_dir, strlen(temp_dir), 8);

        if (!filefind(temp_dir, 16))        // if doesn't already exist
        {
          prints("^L^JCreating Temporary Directory.");
          stuff = temp_dir;
          inschrs("md ", stuff, 0, 3);
		  dos(stuff, 0);
          }
       inschrs("\", temp_dir, strlen(temp_dir), 1);
     }
  
  // Here we save some system variables that we change,
  // for restoring at the end.
    
   cleardir();
   baud = get_baud();
   if (carrier() && !(sysbyte&2))         // if not direct and carrier found
       call_stat = call_stat | 4;         // then already connected

   if (!(sysbyte&2) && !(call_stat&4))    // if not direct or already connected
      {
       if (init_mdm(_auto_ans_str, 1) == -1)   // initialize modem
           return -1;
       }
   if (usage_stat())
       usagelog(CLOSE);
   if (capture_stat())
       capture(CLOSE);
   newdir(host_dir);
   usagelog("XHOST.LOG");                       // start usage log
   if (sysbyte&4)
       capture("XHOST.CAP");

   access_level = 255;
   flags = 255;
   confnum = "1";
   high_dir = 2;

   if (getobj(1, 2))
       _up_dir = obj_path;

   update_term();
   if (help_line != -1)
       {
       vgetchrs(0, help_line, stat_line, 0, 80);
       gotoxy(0, help_line);
       stat_color = vgetchr()/256;
       gotoxy(0, 0);
       }

   if (!sysop_name)
       sysop_name = "SYSOP";

   status_line(1);
   while (!(call_stat&16))     // while exit not requested
      {
       confpath = host_dir;
       pos = 0;
       call_stat = call_stat&253;              // set check_carrier flag off
       call_stat = call_stat | ((!(sysbyte&2))*2); // then set using
                                                    // direct_connect flag
       call_stat = call_stat | 128;

       if (!(call_stat&4))  // if not already connected, show screen
           {
            screen();
            pos = -1;
           }
       else
            pos = 0; // skip next part, go directly to do_caller

       // pos set to 0 for call, 1 for exit.

       while (pos == -1)                 // internal loop (waiting for action)
        {
         while (!(c = toupper(inkey())) && !carrier()) // inner loop (display time)
               {
                disptime();
                if (tsec(curtime()) == 9)
                    {
                    vars();
                    date(curtime(), stuff);
                    date(last_start, things);
                    }
                }

         if (carrier() && !(sysbyte&2))          // ! direct_connect
            {
             if (determine_baud())
                 {
                  pos = 0;
                  call_stat = call_stat&254; // local_mode = 0
                  }
             }
          else if (c)
             {
              cursor_onoff(1);
              if (check_action(c))
                 pos = 1;
              else if (c == 'Q' && sysbyte&16)
                 {
                 gotoxy(0, 22);
                 tmark = timer_start(300);
                 call_stat = 1;
                 if (ask_for_pass(system_pass, 1) == 1)    // as local mode
                    {
                    ustamp("Quick Logon", 1, 1);
                    if (!(sysbyte&2))
                       init_mdm(busystr, 0);    // reset modem
                    qwik = 1;
                    pos = 0;
                    }
                 else
                     pos = 1;
                  timer_free(tmark);
                 }
              else if (c == 'L' && sysbyte&16)            // (L)ocal test mode
                 {
                  if (!(sysbyte&2))            // if not direct_connect
                      {
                        ustamp("Local mode started", 1, 1);
                        call_stat = 1;  // set local flag on
                        gotoxy(0, 22);
                        init_mdm(busystr, 0);    // reset modem
                       }
                   else
                       {
                        ustamp("Direct Connect mode started", 1, 1);
                        call_stat = 0;    // everything off
                        }
                    pos = 0;
                  }
              cursor_onoff(0);
             }
       }
    call_stat = call_stat & 127;

    cursor_onoff(1);

    if (!pos && !(call_stat&16)) // process call here
          {
           if (!qwik)
              alarm(1);
           rec_no = 0;
           status_line(2);
           pos = do_caller(qwik);
           status_line(1);
           if (status&64 && !(sysbyte&4))
               capture(CLOSE);

           if (pos == 1)
              {
               if (rec_no)
                   update_user(current_caller);
               ustamp("Total time on system: ", 1, 0);
               time(curtime()-last_start, stuff);
               ustamp(stuff, 0, 1);
               ustamp("^M^J^I^IEnd of call by ");
               ustamp(current_caller, 0, 1);
               ustamp("", 0, 1);
               confnum = "1";
               if (getobj(1, 2))
                   {
                   newdir(obj_path);
                   stuff = exfile;
                   extend(stuff);
                   fdelete(stuff);
                   }
               if (filefind("End.Slc", 0, stuff))
                  runscr(stuff);
              }
           status_line(-1);
           timer_free(tmark);
           cleardir();
           rec_no = 0;
           printsc_trm("^[[0m");
           last_end = curtime();
         }
       qwik = 0;

       if (call_stat&16 || call_stat&32 || sysbyte&32) // if exit telix
          {
           gotoxy(0, 23);
           if (!carrier() && !(sysbyte&2))
               init_mdm(_mdm_init_str, 1);
           status_line(0);
           _cisb_auto = old_cisb_auto;
           _zmod_auto = old_zmod_auto;
           _down_dir = old_down_dir;
           _sound_on = old_sound;
           _alarm_on = old_alarm;
           _back_color = old_b;
           _fore_color = old_f;
           _date_format = old_date;
           _time_format = old_time;
           _up_dir = old_up;
           things = "XHost script finished.";
           prints(things);
           newdir(_telix_dir);
           ustamp(things, 1, 1);
           if (sysbyte&4)
              capture(CLOSE);
           usagelog(CLOSE);
           if (call_stat&32 || sysbyte&32) // if exit telix
              exittelix();
           update_term();
          }
     else
          call_stat = 0;
     _fore_color = 7;
     _back_color = 0;
     qwik = 0;
   if (!(sysbyte&2))    // if not Direct
      {
       if (init_mdm(_auto_ans_str, 1) == -1)   // initialize modem
           continue;           // do something here
       }
    }
  _scr_chk_key = old_scr_chk_key;

}
///////////////////////////////////////////////////////////////////////////////
// f //

// Description: Actually, the main part of the program.
//              Processes one caller after CD high or local mode ON.

// Parameters: - quick: Quick logon or not

Do_Caller( int quick )
{

str FName[64],
    arcpath[64];            // contains name+path of current archive

int action, option, stat, quit, k, i, c;

   ++calls;
   ++callsi;

   access_level = 1;
   current_caller = "Unknown";
   last_log = 0;
   if (!conn_baud)
       conn_baud = get_baud();
   date(curtime(), stuff);
   time(curtime(), things);
   last_start = curtime();
// quick ---- skip
   if (!quick)
      {
       print("^L");
       print(version);
       print("^M^JSystem: ");
       print(system_name);
       print("^M^JLogin: ");
       print(things);
       print(", ");
       print(stuff);
       print(" @ ");
       itos(conn_baud, things);
       print(things);
       print(" Baud.^M^JDo you want ANSI colors");

       timer_begin = 9000;
       tmark = timer_start(timer_begin);  // allow a 15 minute logon...
       status = 0;
       status = yn('Y', "")*16;  // Set ANSI

       pointy = 0;

       call_stat = call_stat | 64;
       type_file("FIRST", status&16, 1, 1);

       if (call_stat&8)
          return 0;

       while ((option = load_caller()) == 0)
             ;

       if (option == -1 || access_level <= 0)     // if access isn't given
           {
            ustamp("Failed logon by ", 1, 0);  //record attempt
            if (!current_caller)
                current_caller = "unknown user";
            ustamp(current_caller, 0, 1);
            kick_out();
            }

       if (call_stat&8)
           return 0;

       ustamp("^M^J^I^ILogon by ");
       ustamp(current_caller, 0, 1);
       ustamp("", 0, 1);

      things = current_caller; // prepare our greetings

      timer_begin = get_lvl(access_level);

      if (timer_begin == -1) // if problems
         {
          ustamp("Undefined access level: ", 1, 0);
          itos(access_level, things);
          ustamp(things);
          ustamp(". Using level 1.", 0, 1);
          if ((timer_begin = get_lvl(1)) == -1) // if still problems
              timer_begin = 90000;              // allow 30 minutes
          }
     } // end !quick
  else
     {
      status = 24;
      if (sysbyte&2048 || !load_user(sysop_name, 1))
         {
          // then invent profile, leave rec_no at 0
          setchrs(bitmaps, 0, 10, 255);
          reads = "";
          bytes = 99999999;
          ratio = 0;
          proto = 'Z';
          status = 24;
          access_level = 255;
          flags = 255;
         }
       current_caller = sysop_name;
       tmark = timer_start(180000);
       timer_begin = 180000;
       time_left = 300;
      }

  if (status&64 && !capture_stat())   // if capture
      {
       stuff = current_caller;
       setchr(stuff, 8, 0);         // trim to 8 characters.
       while ((pos = strchr(current_caller, 0, 32)) <= 7)
              setchr(current_caller, pos, '_');
       inschrs(host_dir, stuff, 0, strlen(host_dir));
       inschrs(".CAP", stuff, strlen(stuff), 4);
       capture(stuff);
       }

  puts("^JUser: ", "0;32");
  puts(current_caller, "0");
  if (!(sysbyte&2048))
     {
      puts("^M^JLast logon: ", "0;32");
      date(last_log, fname);
      time(last_log, stuff);

  if (last_log)
     {
      puts(fname, "0");
      print(", ");
      print(stuff);
     }
  else
     puts("Never", "0");
     }
  puts("^M^JTime left: ", "0;32");
                            // compare dates
  date(curtime(), stuff);
  if (strcmpi(stuff, fname) == 0 && time_left*600 <= timer_begin
      && !(sysbyte&2048))
     timer_begin = time_left*600;
                                              // substract time already used up
  timer_begin = timer_begin - timer_total(tmark);
  timer_restart(tmark, timer_begin);
  itos(timer_begin/600, stuff);

  puts(stuff, "0");
  if (proto > 0)                // Set protocol to his default
      set_defprot(proto);
  else
      set_defprot(90);  // or else set it to Zmodem (internal)
   
   confnum = "0";     // Set message base filename to 0, for no update on
                      // read counters by switch_conf()

   if (switch_conf(1, !quick) == -1)    // Go to MAIN, don't log/NEWS if quick
       ustamp("Unable to load Conference 1", 1, 1);

   print("^M^J^J");
   delay(10);
   pointy = 0;

   if (!confname)       // Load main conference, or else name one
      {
       confname  = "Main";
       confnum   = "0";
       conf_stat = 1;
       high_dir  = 0;
       high_txt  = 0;
       high_door = 0;
       high_conf = 1;
       conf_lvl  = 1;
       conf_flag = 0;
       confpath = host_dir;
      }

    check_timer();

    if (call_stat&8)
        return 1;

    if (status&4 && !quick)
        {
        scan_msg(1);
        print("^J");
        }
    if (!load_menudef(!quick))
         defmenu();

    arcpath = "";
    while (!(call_stat&8))
          {                              //start the main loop
          if (check_timer())   // check_timer checks time left and access level
              continue;

          print("^M");

          if (!arg_list)       // if no more stacked commands
             {
              if (action)
                  print("^M^J");
              if (!(status&8))               // if not expert mode, show menu
                 {
                  pointy = 0;
                  prep(menu, "", stuff);
                  inschrs("MENU", stuff, 0, 4);
                  call_stat = call_stat | 64;
                  type_file(stuff, status&16, 1, 1);
                  }
              if (arcpath)
                 {
                  fnstrip(arcpath, 3, area);
                  inschrs("Viewing ", area, 0, 8);
                  }
              prompt(area);
              }

         stat = get_command("", stuff, 78, 2);
         if (isdigit(subchr(stuff, 0)))
            stat = '#';

         if ((pos = strchr(menu_keys, 0, stat)) == -1)
            {
             if (!arg_list)
                 puts("That is not a valid command.", "0;32");
             action = 1;
             }
         else
            {
             action = subchr(commands, pos*2);
             option = subchr(commands, pos*2 + 1);
             print("^M^J");

        if (action == 1)        // show menu
            {
             pointy = 0;
             prep(menu, "", stuff);
             inschrs("MENU", stuff, 0, 4);
             call_stat = call_stat | 64;
             type_file(stuff, status&16, 1, 1);
             load_menudef(menu);    // reload in case of level change.
            }
        else if (action == 2)                // Goodbye (Hang-up)
              {
               pointy = 0;
               call_stat = call_stat | 64;
               type_file("LAST", status&16, 1, 1);
               ustamp("User logs off", 1, 1);
               delay(20);
               kick_out();
               }
        else if (action == 3)   // yell (chat)
              {
               input_strn("For what reason dare you disturb the SysOp? ", stuff, 30, 0, 1);
               if (stuff)
                  {
                   check_timer(); // just in case we needed to switch chat on/off
                   title("Paging SysOp");
                   things = "Paging because: ";
                   temp = "Press Space to chat, or any other key to cancel.";
                   strcat(things, stuff);
                   if (!(sysbyte&16))   // if display is off
                      {
                       pstraxy(things, 10, 20, 7);
                       pstraxy(temp, 10, 21, 7);
                       }
                   else
                      {
                       prints(things);
                       prints(temp);
                       }

                   option = 0;

                   i = 1;

                   do
                      {
                       alarm(1);
                       file = !(call_stat&1);      // use any int to save local_mode
                       call_stat = call_stat | 1;    // force to ON
                       for (pos = 1; pos <= 30 && (option = input(1)) == 0; ++pos)
                             delay(1);
                       call_stat = call_stat^file;  // restore local_mode
                       ++i;
                       }
                    while (i <= 3 && !option && !(call_stat&8));

                    if (!(sysbyte&16))
                        box(10, 20, 79, 21, 0, 0, 7);   // clear text
                    if (call_stat&8)
                        continue;
                    if (option == 32)
                        chat();
                    else
                        {
                        puts("^M^JSorry, the SysOp is unavailable! Try leaving a comment.", "0;1");
                        ustamp("Paged for: ", 1, 0);
                        ustamp(stuff, 0, 1);
                        }
                   }
               pause();
              }
        else if (action == 4)    // comment to SysOp
             {
               title("Message to SysOp");
               puts("^J^IYou decide to leave a message to ", "0;35");
               print(sysop_name);
               print(".^M^J");
               fname = confnum;
               confnum = "1";
               write_msg(sysop_name, "", 1, 0);
               confnum = fname;
               pause();
               }
        else if (action == 7)       // goto menu
                {
                arcpath = "";
                i = menu;
                k = 1;
                if (option == 0)
                    {
                     if (ask_for_pass(system_pass, 1) == 1)
                        k = load_menudef(0);
                     else
                        ustamp("*Tries to access menu 0*", 1, 1);
                     }
                 else
                     k = load_menudef(option);

                 if (k == 0)
                    load_menudef(i);
                 else
                    {
                     ustamp("Goes to Menu ", 1, 0);
                     itos(option, stuff);
                     ustamp(stuff, 0, 1);
                     }
                }
        else if (action == 9)
              {
                cursor_onoff(1);
                prep(option, ".SLC", things);
                inschrs("SCR", things, 0, 3);
                ustamp("Running ", 1, 0);
                ustamp(things, 0, 1);
                c = runscr(things);
                // maybe pass some parameters here? it will always be in
                // conf.dir... so pass host_dir?
                // 1 : End of Call
                // 2 : Exit to Terminal
                // 3 : Exit to DOS
                if (c == 3)
                    call_stat = call_stat | 32;
                if (c >= 2)
                    call_stat = call_stat | 16;
                if (c >= 1)
                    call_stat = call_stat | 8;
                }
        else if (action == 10)
             {
              title("Shutting down XHost");
              if (yn('N', "^M^JAre you sure"))
                {
                 call_stat = call_stat|(yn('N', "Exit Telix also")*32);
                 kick_out();
                 ustamp("Shuts down XHost", 1, 1);
                 call_stat = call_stat | 16;
                 }
              }
        else if (action == 11)
              {                                // Text files
              quit = 0;
              if (!load_opt(option) && stat == '#')
                  pusharg(stuff);

              while (!quit && !(call_stat&8))
                   {
                   if (!arg_list)
                       prompt("The Text Files");
                   else
                       print("^M^J");

                   option = get_command("", stuff, 78, 2);

                   if (!option || option == 'Q' || (call_stat&8))
                      {
                       quit = 1;
                       option = 1;
                       }
                   else if (option == '?')
                       {
                         pointy = 7;
                         call_stat = call_stat | 64;
                         list_obj(2, high_txt);
                         print("^M^J^J");
                       }
                   else
                      {
                        k = stoi(stuff);

                        list0 = "";

                        if (k > 0 && k <= high_txt)
                            Getobj(2, k);
                        else if (check_for_file(stuff, -1, 1, 0))
                            {
                             if (strchr(obj_path, 0, 46) == -1)
                                inschrs(".", obj_path, strlen(obj_path), 1);
                             fnstrip(obj_path, 3, obj_name);
                             obj_lvl = access_level;
                             }
                        else
                            {
                             emsg(6);
                             if (subchr(arg_list, 1) == 32 && !isdigit(subchr(arg_list, 0)))
                                 delchrs(arg_list, 0, 2);
                             obj_path = "";
                             delay(5);
                             }

                        if (obj_path)
                           {
                            ustamp("Reads text file: ", 1, 0);
                            ustamp(obj_name, 0, 1);
                            puts("^M^JReading ", "0;32");
                            print(obj_name);
                            print("^M^J");
                            pointy = 2;
                            call_stat = call_stat | 64;
                            type_file(obj_path, 0, 1, 0);
                            }
                     }
                 }
           }
        else if (action == 12)    // Run DOORS.
            {
              quit = 0;
              if (!load_opt(option) && stat == '#')
                  pusharg(stuff);

              while (!quit && !(call_stat&8))
                   {
                   if (!arg_list)
                       prompt("The Doors");
                   else
                       print("^M^J");

                   option = get_command("", stuff, 78, 2);

                   if (!option || option == 'Q' || call_stat&8)
                      {
                       quit = 1;
                       option = 1;
                       }
                   else if (option == '?')
                       {
                         pointy = 5;
                         call_stat = call_stat | 64;
                         print("^M^J");
                         list_obj(3, high_door);
                         if (high_door == 0)
                             puts("^M^J^INo doors yet.", "0;32");
                         print("^M^J^J");
                       }
                 else
                     {
                      k = stoi(stuff);

                     if (k > 0 && k <= high_door)
                        {
                         Getobj(3, k);

                         if (obj_path)
                            {
                             if (pos&2 && !(status&16))
                                 puts("^JANSI mode must be set for this door.", "0;32");
                             else
                                 {
                                 ustamp("Runs door: ", 1, 0);
                                 ustamp(obj_name, 0, 1);
                                 puts("^LLoading ", "0;32");
                                 print(obj_name);
                                 print("...^M^J");
                                 input(1);
                                 if (call_stat&8)
                                     continue;
                                 if (_sound_on)
                                     call_stat = call_stat | 256; //set CHAT bit
                                 c = timer_total(tmark);
                                 if (rec_no)
                                    update_user(current_caller);

                                 cursor_onoff(1);
                                 status_line(0);
                                 calld("DOOR", conn_baud, rec_no,
                                       call_stat, last_start, confpath,
                                       timer_begin, confnum, k,
                                       system_name, sysop_name);
                                 _scr_chk_key = 0;
                                 if (!(sysbyte&16))
                                      screen();
                                 call_stat = call_stat&255; //force 9th bit off
                                 if (rec_no)
                                    load_user(current_caller, 0);
                                 timer_begin = time_left*600 - (timer_total(tmark) - c);
                                 timer_restart(tmark, timer_begin);
                                 status_line(-1);
                                 }
                             }
                          }
                       }
                   }
            }

        else if (action == 14)
             {
              title("Usage Log");
              newdir(_telix_dir);
              pointy = 0;
              call_stat = call_stat | 64;
              if (type_file("XHOST.LOG", 0, 1, 1) != -1)
                   ustamp("Views Log", 1, 1);
              }
        else if (action == 15)           //DOS command/shell
              {
               title("DOS Command");
               input_strn("^M^JType Command, (Q)uit or (Enter=Shell): ", stuff, 80, 0, 1);
               pos = 0;
               if (!stuff)
                   {
                    pos = 1;
                    title("DOS Shell");
                    puts("^M^JEnter EXIT to return to XHost.^M^J", "0;32");
                    if (conn_baud == 300)
                        delay(10);
                    if (call_stat&1)
                        stuff = "";
                    else if (!filefind(SHELL, 0))
                     {
                     if (get_port() >= 1 && get_port() <= 4)
                        {
                         file = openf(SHELL, "w", 1);
                         if (file > 0)
                            {
                             things = "COM ";
                             setchr(things, 3, get_port() + '0'); // get right name to redirect

                             fputs("CTTY ", file);           // write to batch file
                             fputs(things, file);
                             fputs("^M^J%COMSPEC%^M^JCTTY CON^M^JEXIT^M^J", file);
                             fclose(file);                   // close the file
                             stuff = SHELL;
                             }
                         else
                            {
                            puts("^M^JError writing to batch file!", "31;1");
                            pos = 0;
                            }
                        }
                     else
                        {
                         puts("^M^JShell to DOS not possible.", "31;1");
                         pos = 0;
                         }
                     }
                    else
                        stuff = SHELL;
                   }
                else
                    {
                     if (toupper(subchr(stuff, 0)) != 'Q')
                         pos = 1;
                     }

                if (pos)
                   {
                    ustamp("DOS Command: ", 1, 0);
                    if (call_stat&1 && !stuff)
                        ustamp(SHELL, 0, 1);
                    else
                        ustamp(stuff, 0, 1);
                    delay(6);
                    dos(stuff, 0);
                    fdelete(SHELL);
                    status_line(-1);
                    }
                pause();
                }
        else if (action == 16)                 //Read messages
               {
                ustamp("Reads messages", 1, 1);
                read_msg(0);
                }
        else if (action == 17 && conf_stat&1)   // Write message
                {
                 write_msg("", "", 2, 0);
                 pause();
                 }
        else if (action == 21)          // list conferences
               {
                title("Conferences");
                pointy = 4;
                call_stat = call_stat | 64;
                list_conf(1);
                get_conf(stoi(confnum), 0);
                nl();
                pause();
               }
        else if (action == 22)     // Scan conferences
               {
               ustamp("Scans conferences", 1, 1);
               if (stat == '#')
                   pusharg(stuff);
               input_strn("Start Scan at which Conference? ", things, 3, 0, 1);
               scan_msg(stoi(things));
               }
        else if (action == 23)      // Join conference.
               {
               if (!load_opt(option) && stat == '#')
                   pusharg(stuff);
               input_strn("Join which conference? ", things, 3, 0, 1);
               if (things)
                   switch_conf(stoi(things), 1);
               }
        else if (action == 31)
               {
                input_strn("Which archive do you wish to look at? ", fname, 64, 0, 1);

                if (fname)
                   {
                    extend(fname);
                    list0 = "";
                    if (check_for_file(fname, -1, 1, 0))
                       {
                        ustamp("Selects Archive: ", 1, 0);
                        ustamp(obj_path, 0, 1);
                        arcpath = obj_path;
                        }
                    else
                        emsg(6);
                    }
                 pause();
                 }
        else if (action == 32)   // Delete from extract archive
               {
                if (flags&2)
                   {
                   input_strn("Delete from which archive (Enter=EXTRACT, !=Selected)? ", stuff, 64, 0, 1);

                   if (stuff)
                      {
                       if (strcmpi(stuff, "!") == 0)
                           stuff = arcpath;
                       else
                          {
                           extend(stuff);
                           if (!check_for_file(stuff, -1, 1, 0))
                               continue;
                           else
                               stuff = obj_path; // recover path
                           }
                       }
                   }

                if (!stuff)
                    {
                    newdir(_up_dir);
                    stuff = EXFILE;
                    extend(stuff);
                    }

                if (filefind(stuff, 0) || (strcmpi(stuff, arcpath) && (flags&2)))
                   {
                    input_strn("Delete which file? ", fname, 12 , 0, 1);

                    if (fname)
                       {
                       if (yn('N', "^JAre you sure"))
                         {
                          if (getarc(5, stuff, fname) == 1)
                              puts(DONE, "0;32");
                          else
                              puts(ERROR, "0;32");
                          }
                        }
                    }
                 else
                   {
                    puts(stuff, "31;1");
                    print(" was not found.");
                    }
                 pause();
                }
        else if (action == 33 && arcpath)      // List files in archive
               {
                temp = TMPFILE;
                inschrs(">", temp, 0, 1);
                newdir(temp_dir);
                if (getarc(2, arcpath, temp) == 1)
                    {
                    pointy = 0;
                    call_stat = call_stat | 64;
                    type_file(TMPFILE, 0, 1, 0);
                    ustamp("Lists Archive", 1, 1);
                    fdelete(TMPFILE);
                    }
                 pause();
                }
        else if (action == 34)   // Nuke EXTRACT.ext
               {
                newdir(_up_dir);
                stuff = EXFILE;

                extend(stuff);

                if (filefind(stuff, 0))
                    {
                    puts("Delete ", "35;1");
                    puts(stuff, "0");

                    if (yn('N', ": Are you sure"))
                        {
                        if (fdelete(stuff) == 0)
                           {
                            ustamp("Deletes ", 1, 0);
                            ustamp(stuff, 0, 1);
                            puts(DONE, "0;32");
                            }
                        else
                            puts(ERROR, "0;32");
                        }
                     }
                   pause();
                  }
        else if (action == 35 && arcpath)    // Extract file routine
                 {
                 input_strn("What do you want to extract? ", fname, 12, 0, 1);
                 if (fname)
                    {
                     if (flags&2)
                         input_strn("Extract to which directory (Enter=into EXTRACT)? ", stuff, 64, 0, 1);
                     else
                         stuff = "";

                     if (!stuff && _up_dir == "")
                         continue;

                     if (stuff)
                        newdir(stuff);
                     else
                        newdir(temp_dir);

                     if (getarc(3, arcpath, fname) == 1)
                        {
                         ustamp("Extracts ", 1, 0);
                         ustamp(fname, 0, 0);

                         if (!stuff)
                             {
                              stuff = EXFILE;
                              extend(stuff);
                              inschrs(_up_dir, stuff, 0, strlen(_up_dir));
                              ustamp(", added to EXTRACT", 0, 1);
                              if (getarc(4, stuff, fname) == 1)   // (add)
                                   puts(DONE, "0;32");
                              else
                                  puts(ERROR, "0;32");
                              }
                          else
                             {
                              ustamp(" into ", 0, 0);
                              ustamp(stuff, 0, 1);
                              puts(DONE, "0;32");
                              }
                          cleardir();
                          }
                      else
                          puts(ERROR, "0;32");
                    }
                 pause();
                 }

        else if (action == 36)    // Add file routine
                 {
                 input_strn("Which file do you want to add? ", fname, 64, 0, 1);
                 // No checking is performed here, meaning command should have
                 // limited access...
                 if (fname)
                    {
                     stuff = EXFILE;
                     extend(stuff);
                     inschrs(_up_dir, stuff, 0, strlen(_up_dir));
                     ustamp("Adds to EXTRACT: ", 1, 0);
                     ustamp(fname, 0, 1);
                     if (getarc(4, stuff, fname) == 1)
                         puts(DONE, "0;32");
                     else
                         puts(ERROR, "0;32");
                     pause();
                     }
                 }

        else if (action == 37 && arcpath)     // type file inside archive
               {
               input_strn("Which text file do you wish to view? ", fname, 12, 0, 1);
               if (fname)
                  {
                   newdir(temp_dir);
                   if (getarc(3, arcpath, fname) == 1)
                      {
                       pointy = 0;
                       fname = "*.*";
                       while (filefind(fname, 0, things))
                            {
                            ustamp("Views file: ", 1, 0);
                            ustamp(things, 0, 1);
                            puts("^M^JReading ", "0;32");
                            print(things);
                            print("^M^J");
                            pointy = 2;
                            call_stat = call_stat | 64;
                            type_file(things, 0, 1, 0);
                            fdelete(things);
                            fname = "";
                            }
                       }
                   }
                 pause();
               }
        else if (action == 38)    // Contents of EXTRACT
             {
              stuff = EXFILE;
              extend(stuff);
              inschrs(_up_dir, stuff, 0, strlen(_up_dir));
              if (filefind(stuff))
                 {
                  newdir(temp_dir);
                  temp = TMPFILE;
                  inschrs(">", temp, 0, 1);
                  if (getarc(2, stuff, temp) == 1)
                      {
                      pointy = 0;
                      call_stat = call_stat | 64;
                      type_file(TMPFILE, 0, 1, 0);
                      ustamp("Lists contents of EXTRACT", 1, 1);
                      fdelete(TMPFILE);
                      }
                  }
               pause();
             }
        else if (action == 41)    // Files List
             {
              pointy = 0;
              if (!load_opt(option) && stat == '#')
                  pusharg(stuff);
              while (get_a_dir())    // Always returns the name in the string obj_path
                    {
                     newdir(obj_path);

                     if (filefind(FLIST, 0))
                        {
                         ustamp("Lists the files in ", 1, 0);
                         ustamp(obj_path, 0, 1);
                         list_LST(1, "");                // list normal
                        }
                     else
                         puts("^M^JNo files yet.", "0;32");
                    }
             }
        else if (action == 42 || action == 43)              // Search for New files
              {
               if (action == 43)
                  {
                   input_strn("What do you want to look for? ", stuff, 30, 0, 2);

                   if (stuff)
                       {
                       strupper(stuff);
                       puts("^M^JSearching for ", "0");
                       puts(stuff, "0;32");
                       puts(".^M^J", "0");
                       ustamp("Searches files for ", 1, 0);
                       ustamp(stuff, 0, 1);
                       pos = 3;
                       }
                   else
                       continue;
                  }
               else
                   {
                   title("New Files");
                   ustamp("Searches for new files", 1, 1);
                   pos = 2;
                   }
			   pointy = 4;
			   call_stat = call_stat | 64;
               k = 1;
               do
                 {
                  if (getobj(1, k))
                     {
                      itos(k, things);
                      if (nl() == 0)
                          break;
                      puts("Dir ", "0;32");
                      print(things);
                      print(": ");
                      print(obj_name);
                      if (nl() == 0)
                          break;
                      newdir(obj_path);
                      if (!list_LST(pos, stuff))
                         k = high_dir;
                      }
                  ++k;
                  }
               while (k <= high_dir && !(call_stat&8));
			   pause();
               }

        else if (action == 44)          // upload file
            {
                if (getobj(1, 1) <= 0)
                   {
                    puts("^M^J^GYou cannot upload files in this conference.", "31;1");
                    continue;
                    }

				k = toupper(subchr(arg_list, 0));

				if (toupper(proto) == 'N')
				   {
                    if (isalnum(k) && subchr(arg_list, 1) == 32 && strchr(protkeys, 0, k) >= 0)
					   {
						i = k;
						delchrs(arg_list, 0, 2);
						}
					else i = 0;
					}
				else
					i = proto;

				option = get_prot(i);  //make him choose. i = protocol,
                                       //             option = control bitmap.

                if (i <= 0 || i == 'N')
					continue;

                if (option&2)
                    pos = 25;
				else
					pos = 1;
                newdir(temp_dir);

                file2 = openf("FILES.TMP", "w", 1);   // will write all descr to temp file

                if (file2 <= 0)
                   {
                    emsg(1);
                    continue;
                    }

                stuff = "";
                extend(stuff);

                puts("^M^JYou must specify the exact name of each file", "0;32");

                if (!(sysbyte&512))
                    print(", and give a one line description.^M^J");
                else
                    print(". ");
                print("The default filename extension is ");
                print(stuff);
                print(".^M^J^JType '?' for available commands.^M^J");

                if (pos > 1)
                     print("^M^JMultiple files are allowed.");

                list0 = "";

                k = 0;
                c = -1;       // exit on c = 0 (quit), c = 1 (start) c = 2 (g)

                while (c == -1)
                      {
                while (pos-k > 0 && !(call_stat&8))  //start zee loop
                       {
                       stuff = "^M^JFile ";
                       itos(k+1, things);
                       inschrs(things, stuff, strlen(stuff), strlen(things));
                       inschrs(": ", stuff, strlen(stuff), 2);
                       get_command(stuff, fname, 12, 1);

                       if (fname)
                          {
                           strupper(fname);

                           if (strlen(fname) == 1)
                              {
                               k = k + transfunks(subchr(fname, 0), 1);
                               continue;
                               }

                           extend(fname);

                           if (check_for_file(fname, 1, 0, 0))
                               emsg(5);
                           else
                              {
                               descr = "";
                               if (!(sysbyte&512))
                                 {
                                   stat = 1;
                                   do
                                       {
                                        print("^M^J");
                                        puts("Please describe ", "0");
                                        puts(fname, "0;1");
                                        input_strn("^M^J> ", descr, 45, 0, 0);
                                        format(descr, 0);

                                        if (strlen(descr) < 10 && stat <= 2 && !(call_stat&8))
                                            emsg(10);
                                        ++stat;
                                        }
                                   while (stat <= 3 && strlen(descr) < 10 && !(call_stat&8));

                                   if (strlen(descr) < 10)
                                      {
                                       print("^M^J");
                                       puts(fname,"0;32");
                                       puts(" rejected!","32;1");
                                       continue;
                                       }
                                   }
                               inschrs(" ", fname, strlen(fname), 1);
                               inschrs(fname, list0, strlen(list0), strlen(fname));
                               fputs(fname, file2);
                               fputs(descr, file2);
                               fputs("^M^J", file2);
                               ++k;
                               }
                          }
                      else
                         {
                          stat = pos;
                          pos = 0;
                          }
                     }

                if (call_stat&8)
                   c = 0;
                else if (k >= 1 && list0)
                     {
                     if ((c = trans_msg(i)) == -1)
                        pos = stat;
                        }
                else
                    c = 0;
                }
                fclose(file2);

                if (k >= 1 && list0 && c > 0)
                   {
                   k = timer_total(tmark);
                   newdir(_telix_dir);
                   status_line(0);
                   stat = receive(i, list0);
                   timer_begin = timer_begin - k;
                   timer_restart(tmark, timer_begin);

				   if (c == 2)
					  {
					   ustamp("Logs off after transfer", 1, 1);
					   kick_out();
					   }

				   if (stat == -2)						  // Carrier lost
					  {
					   call_stat = call_stat | 8;
                       emsg(9);
					   }
                   else if (stat == -1)     // transfer aborted
					   emsg(7);
                   handle_transfer(option, 1, stat);
				  }
              pause();
			  }

        else if (action == 45) // User chooses download
            {
             if (bupld > 0 || ratio == 0)
				{
				 k = toupper(subchr(arg_list, 0));

				 if (toupper(proto) == 'N')
					{
                     if (isalnum(k) && subchr(arg_list, 1) == 32 && strchr(protkeys, 0, k) >= 0)
						{
						 i = k;
						 delchrs(arg_list, 0, 2);
						}
					 else
						 i = 0;
					}
				else
					i = proto;

				option = get_prot(i);  //make him choose. i = protocol,
                                       // option = control
				if (i <= 0 || i == 'N')
                    continue;

                if (option&2)
                   {
                   if (option&4)
                       pos = 25;
                   else
                       {
                        pos = 5;
                        temp = _up_dir;
                        _up_dir = "";
                        print("^M^JInternal protocol selected.^M^J");
                        print("All files entered MUST reside in the same directory.");
                        }
                    }
                else
					pos = 1;

                if (option&8)
                    {
                    type_file("BIMOD", status&16, 1, 1);
                    pause();
                    }
                totalbytes = 0;

                puts("^M^JWildcards are accepted, and the default extension is ", "0;32");
                stuff = "";
                extend(stuff);
                print(stuff);

                print(".^M^J^JType '?' for available commands.");
                if (option&2)
                   {
                   things = "^M^JUp to  files may be transferred.";
                   itos(pos, stuff);
                   inschrs(stuff, things, 8, strlen(stuff));
                   print(things);
                   }

                list0 = "";

                k = 0;
                c = -1;
                while (c == -1)
                     {
                while (pos-k > 0 && !(call_stat&8))    //start zee loop
                      {
                       stuff = "^M^JFile ";
                       itos(k+1, things);
                       inschrs(things, stuff, strlen(stuff), strlen(things));
                       inschrs(": ", stuff, strlen(stuff), 2);
                       get_command(stuff, fname, 64, 1);

                       if (fname)
                          {
                           strupper(fname);

                           if (strlen(fname) == 1)
                                {
                                k = k + transfunks(subchr(fname, 0), 0);
                                if (k == 0 && option&2 && !(option&4))
                                    _up_dir = "";
                                continue;
                                }

                           extend(fname);

                           if ((c = check_for_file(fname, 0, pos-k, option)) == 0)
                               emsg(6);
                           else
                                k = k + c;
                           }
                       else
                          {
                           stat = pos;
                           pos = 0;
                           }
                       }

                   if (call_stat&8)
                      c = 0;
                   else if (k >= 1 && list0)
                       {
                        if ((c = trans_msg(i)) == -1)
                            pos = stat;
                        }
                   else
                       c = 0;
                   }

               if (k >=1 && c > 0)
                  {
                   newdir(_telix_dir);

                   if (option&4 && option&2)    // if external and batch
                      {
                       newdir(_down_dir);
                       stuff = FLIST;
                       if ((file2 = openf(stuff, "w", 1)) > 0)
                          {
                           pos = 0;
                           while (pos < strlen(list0)-1)
                                {
                                 if (strchr(list0, pos, 32) != -1)
                                    {
                                     substr(list0, pos, strchr(list0, pos, 32)-pos, things);
                                     fwrite(things, strlen(things), file2);
                                     fwrite("^M^J", 2, file2);
                                     pos = strchr(list0, pos, 32) + 1;
                                     }
                                 }
                           fclose(file2);
                           }
                         inschrs(_down_dir, stuff, 0, strlen(_down_dir));
                         status_line(0);
                         if (option&8)
                            {
                             genpathfile();
                             newdir(_telix_dir);
                             stuff = "/T";
                             itos((timer_begin-timer_total(tmark))/600, things);
                             strcat(stuff, things);
                             inschrs(" /S", stuff, strlen(stuff), 3);
                             itos(bytes, things);
                             strcat(stuff, things);
                             things = "HBIMOD.BAT  ";
                             itos(get_port(), fname);
                             inschrs(fname, things, 11, 1);
                             itos(conn_baud, fname);
                             inschrs(fname, things, strlen(things)-1, strlen(fname));
                             inschrs(things, stuff, 0, strlen(things));
                             stat = dos(stuff, 0);
                             }
                         else
                             stat = send(i, stuff);

                         newdir(_down_dir);
                         fdelete(stuff);
                         fdelete("PATHS.LST");
                       }
                   else
                       stat = send(i, list0);

                   _up_dir = temp;
                   status_line(-1);
                   if (stat == -2)                        // Carrier lost
                     {
                      call_stat = call_stat | 8;
                      emsg(9);
                      }
                   else if (stat == -1)
                        emsg(7);

                   handle_transfer(option, 0, stat);

                   if (c == 2)
                      {
                       ustamp("Logs off after transfer", 1, 1);
                       kick_out();
                       }
                    }
               ttime = 0;
               totalbytes = 0;
               }
           else
               puts("You need to upload something first.^M^J", "0;32");
           }
      else if (action == 46)     // Raw (DOS) directory
			{
             if (!load_opt(option) && stat == '#')
                 pusharg(stuff);
             title("Raw File List");
             while (get_a_dir())    // Always returns the name in the string obj_path
                   {
                    newdir(obj_path);

                    if (subchr(obj_path, strlen(obj_path)-1) != '\')
                       inschrs("\", obj_path, strlen(obj_path), 1);

                    ustamp("Looks at raw dir in ", 1, 0);
                    ustamp(obj_path, 0, 1);
                    inschrs("*.*", obj_path, strlen(obj_path), 3);
                    puts("", "0");
                    show_directory(obj_path, !(call_stat&1), call_stat&2);
                    print("^M^J");
                   }
            }

        else if (action == 47) // Add (upload) files to list
            {
             if (sysbyte&512)
                {
                puts("^M^JFile lists have been disabled.", "0;32");
                continue;
                }
             if (get_a_dir())
                 {
                 newdir(obj_path);

                 if (call_stat&1)
                     runscr("add");
                 else
                    {
                     input_strn("Filespec (Enter=*.*): ", fname, 12, 0, 1);
                     if (!fname)
                         fname = "*.*";
                     list1 = "";
                     puts("^M^JWorking...", "0;32");
                     while (filefind(fname, 0, stuff))  // read in all files in dir
                           {
                            inschrs(stuff, list1, strlen(list1), strlen(stuff));
                            inschrs(" ", list1, strlen(list1), 1);
                            fname = "";
                            }
                     puts("^M^J", 0);

                     stat = strposi(list1, FLIST, 0);

                     if (stat >= 0)
                         delchrs(list1, stat, 10);

                     if (filefind(FLIST, 0))
                        {
                         file = openf(FLIST, "r", 1);  // Open FILES list to check files
                         while (fgets(listline, 512, file) > 0)
                               {
                                setchr(listline, strchr(listline, 0, 32), 0);
                                stat = strposi(list1, listline, 0); // search our list for match
                                if (stat >= 0 && subchr(list1, stat+strlen(listline)) == 32) // take off files in FILES.LST
                                    delchrs(list1, stat, strlen(listline)+1);
                              }
                         fclose(file);
                         }

                  format(list1, 0);
                  inschrs(" ", list1, strlen(list1), 1);

                  pos = 0;
                  while (((c = strchr(list1, pos+1, 32)) > 0) && !(call_stat&8))
                       {
                        input(1);    // allow sysop quit

                        fname = "";
                        substr(list1, pos + 1, c - pos - 1, fname);
                        if (fname)
                           {
                            print("^M^J");
                            puts(fname, "36;1");
                            if (yn('Y', ": Add file"))
                                {
                                 descr = "";
                                 get_descr(fname, 0);
                                }
                            }
                         pos = c;
                       }
                 list1 = "";
                 }
               }
           }
    else if (action == 48)    // Move file
            {
            k = 0;
            if (get_a_dir())
                {
                stuff = obj_path;
                do
                  {
                  newdir(stuff);

                  input_strn("^M^JFile to move: ", fname, 12, 0, 1);
                  pos = 0;

                  if (fname && filefind(fname, 0))
                     {
                     if ((file = openf(FLIST, "r", 1)) > 0 &&
                        !(sysbyte&512))
                         {
                          while (fgets(listline, 512, file) > 0)
                               {
                                setchr(listline, strchr(listline, 0, 32), 0);
                                if (strcmpi(fname, listline) == 0)
                                    {
                                    setchr(listline, strlen(listline), 32);
                                    pos = 1;
                                    break;
                                    }
                                }
                          }
                      fclose(file);

                      puts("^M^JEnter destination directory: ", "35;1");
                      if (get_a_dir())
                         {
                          if (move(fname, obj_path) != 0)
                             {
                              newdir(obj_path);
                              if ((file = openf(FLIST, "a", 1)) > 0 && pos)
                                  {
                                  fwrite(listline, strlen(listline), file);
                                  fputs("^M^J", file);
                                  fclose(file);
                                  }
                              puts(DONE, "0;32");
                              k = 1;
                             }
                         }
                     }
                  }while (fname);
                if (k)
                   {
                   newdir(_telix_dir);
                   inschrs("/f ", stuff, 0, 3);
                   run("PACK", stuff, 0);
                   }
                }
            }
      else if (action == 55)
           {
            input_strn("^JWhat will your new password be? ", stuff, 12, 1, 0);
            if (stuff)
               {
               input_strn("^JType it in again: ", things, 12, 1, 0);
               if (things && strcmpi(stuff, things) == 0)
                  {
                   strupper(things);
                   password = things;
                   puts("^JYour password has been changed.^J", "0;32");
                   ustamp("Changes password", 1, 1);
                   }
                else
                    puts("^JYour password has not been changed.^J", "31;1");
                }
            }
      else if (action == 56)          // Default Protocol
          {
           option = 0;
           get_prot(option);
           if (option > 0)
               proto = option;
           }
      else if (action == 57)
           {
           Status = status^4;
           puts("The system will ", "0;32");
           if (!(status&4))
                print("not ");
           print("scan for new messages.^J");
           }
      else if (action == 58)
            {
             set_scans();
             get_conf(stoi(confnum), 0);
             }
     else if (action == 59)          // ANSI On/Off
            {
            if (status&16)
                puts("You switch into B&W mode.^J", "0");
            else
                puts("You are now in ANSI color mode.^J");
            status = status^16;
            pause();
            }
     else if (action == 60)         // Xpert mode on/off
            {
            status = status^8;
            puts("Expert mode is now ", "0;32");
            if (status&8)
                print("On.");
            else
                print("Off.");
            pause();
            }
     else if (action == 61)
            {
              get_lvl(access_level);
              info("User", current_caller);
              itos(access_level, things);
              inschrs(" ()", obj_name, strlen(obj_name), 3);
              inschrs(things, obj_name, strlen(obj_name)-1, strlen(things));
              info("Level", obj_name);
              if (sysbyte&256)
                  info("Real Name", real_name);
              info("City", city);
              info("Country", country);
              itos(phone, stuff);
              info("Phone #", stuff);
              stuff = "";
              itos(page_length, obj_name);
              info("Page Length", obj_name);
              setchr(stuff, 0, 48+((status&16) == 16));
              info("Color", stuff);
              stuff = "";
              setchr(stuff, 0, 48+((status&8) == 8));
              info("Expert", stuff);
              setchr(stuff, 0, proto);
              info("Protocol", stuff);
              itos(total_calls, stuff);
              info("Total Calls", stuff);
              date(last_log, stuff);
              info("Last Call", stuff);
              itos(bytes, stuff);
              info("Bytes/day", stuff);
              itos(bupld, stuff);
              info("Bytes sent", stuff);
              itos(fupld, stuff);
              info("Files sent", stuff);
              itos(bdwnld, stuff);
              info("Bytes taken", stuff);
              itos(fdwnld, stuff);
              info("Files taken", stuff);
              pause();
              ustamp("Displays User Info", 1, 1);
             }
     else if (action == 62)             // set page length
           {
           puts("Page length is ", "0;32");
           itos(page_length, stuff);
           print(stuff);
           print(".");
           if (input_strn(NEW_VAL, stuff, 3, 0, 1))
               if (stoi(stuff) >= 0)
                  {
                   page_length = stoi(stuff);
                   puts("^M^JPage length is now ", "0;32");
                   itos(page_length, stuff);
                   print(stuff);
                   print(".");
                   }
           }
         }
       }
  return 1;  
}

///////////////////////////////////////////////////////////////////////////////
//                       Beginning of functions                              //
///////////////////////////////////////////////////////////////////////////////

// *************************************************************************
// ***************************** I/O Functions *****************************
// *************************************************************************
// .iof.

///////////////////////////////////////////////////////////////////////////////
Check_Action( int chr )
{
 int x, char;
 Str tmp1[18] = "­Wait!";

 if (chr <= 255)
    return 0;
 if (call_stat&8 || call_stat&16)
     return 0;

 if (!(call_stat&128))
     if (check_timer())
        return 1;

if (chr == 11264 && Help_line != -1)      // *Alt-Z* Toggle through helps
    {
     if (call_stat&128 && !help)
        status_line(1);
     else if (subchr(HELP, 26) == 'u')   //In help, goto First Info
        status_line(3);
     else if (subchr(HELP, 26) == 'L')
        status_line(4);
     else if (!help && !(call_stat&128))
        status_line(2);
     else
        status_line(0);     // basic (Telix) status line
    return 0;
    }
 else if (chr == 8448)     // *Alt-F* Dos Functions
     {
      if (!(call_stat&128))
         {
          char = timer_total(tmark);  // Aren't we $%@!* generous to save his time
          puts(tmp1, "31;1");
          }
      dosfunction();
      newdir(confpath);
      if (!(call_stat&128))
         {
          era(strlen(tmp1), 1);
          timer_begin = timer_begin - char;
          timer_restart(tmark, timer_begin);
          }
      return 0;
     }              
  else if (chr == 18688 && !(call_stat&128))     // *PgUp* Add 5 minutes to time
     {
      timer_begin = timer_begin - timer_total(tmark) + 3000;
      timer_restart(tmark, timer_begin);
      return 0;
     }
  else if (chr == 20736 && !(call_stat&128))     // *PgDn* -5 minutes
      {
      timer_begin = timer_begin - timer_total(tmark) - 3000;
      timer_restart(tmark, timer_begin);
      return 0;
      }
   else if (chr == 20011 && !(call_stat&128))     // *+* Put up one level
      {
      if (access_level < 255)
          ++access_level;
      return 0;
      }
   else if (chr == 18989 && !(call_stat&128))      // *-* down one levele
       {
        --access_level;
        if (access_level == 0)
           {
            emsg(4);
            kick_out();
            ustamp("*Locking Out*", 1, 1);
            return 1;
            }
         return 0;
       }
    else if (chr == 5376 && !(call_stat&128))
       {                                 // *Alt-Y* force chat
        chat();
        return 1;
        }
    else if (chr == 7680)   // *Alt-A* User Editor
        {
         if (!(call_stat&128))
            {
             char = timer_total(tmark);  // another special priviledge to user
             puts(tmp1, "31;1");
             if (rec_no)
                update_user(current_caller);
             }
         runscr("edit");
         if (!(call_stat&128))
             era(strlen(tmp1), 1);
         newdir(confpath);
         if (rec_no && !(Call_stat&128))
            {
             if (load_user(current_caller, 0) != 1)
                {
                 kick_out();
                 return 1;
                 }
             timer_begin = time_left*600;
             timer_restart(tmark, timer_begin);
             }
         else if (!(call_stat&128))
           {
            timer_begin = timer_begin - char;
            timer_restart(tmark, timer_begin);
           }
      return 0;
     }
else if (chr == 11520)
    {                      // *Alt-X* sysop wants to exit
     if (!(call_stat&128))
         kick_out();
     call_stat = call_stat | 16;    // Set Exit
     status_wind("Exiting XHost", 20);
     ustamp("Keyboard Exit", 1, 1);
     return 1;
   }
 else if (chr == 4608  &&  ( Sysbyte&2 || Call_Stat&2 ) && !(call_stat&128))
                      // *Alt-E* toggle user's display
   {                  // Only available with direct connections (Sysbyte&8)
                      // or when online (Call_Stat&2 -> Check_Carrier)
                      // (This would have nasty results in Local mode)
    call_stat = call_stat^1;       // XOR local mode (toggle)
    if (help_line != -1)
        {
        if (!help)
            {
            vgetchrsa(0, help_line, HELP, 0, 28);
            x = 1;
            }
        vputchrs(0, help_line, " User's display is now ", 0, 23, 112);
        if (call_stat&1)
            vputchrs(23, help_line, "Off! ", 0, 5, 112);
        else
            vputchrs(23, help_line, "On!  ", 0, 5, 112);
        delay(12);
        if (x == 1)
            {
            vputchrsa(0, help_line, HELP, 0, 28);
            HELP = "";
            }
         status_line(-1);
        }
    return 0;
    }
 else if (chr == 8960 && !(call_stat&128))  // *Alt-H* Terminate Loser
     {
      tmp1 = "Caller terminated!";
      if (sysbyte&16)
          prints(tmp1);
      else
          pstraxy(tmp1, 10, 20, 7);
      ustamp(tmp1, 1, 1);
      kick_out();
      delay(8);
      if (!(sysbyte&16))
          box(10, 20, 40, 20, 0, 0, 7);
      return 1;
     }
 else if (chr == 8192)                // Alt-D display on/off
      {
      sysbyte = sysbyte^16;
      if (!(call_stat&128))
         {
          if (!(sysbyte&16))
             {
              screen();
              disptime();
              }
          else
             {
              cursor_onoff(1);
              clear_scr();
              if (Call_stat&1)        // redisplay last prompt in local mode
                 return 1;
              }
           }
      if (!(sysbyte&16) || call_stat&128)
          vars();
      return 0;
      }
 else if (chr == 7936)                //Alt-Sound on/off
      {
       if (sysbyte&64)      // if forced ON
          {
           sysbyte = sysbyte^64;
           sysbyte = sysbyte | 128; // then force OFF
           }
       else if (sysbyte&128)        // if OFF, then no locks
           sysbyte = sysbyte^128;
       else
           sysbyte = sysbyte | 64;  // lock ON
       if (!(sysbyte&16) || call_stat&128)
           vars();
       return 0;
       }
 else if (chr == 9728)  // *Alt-L* Toggle Capture
     {
      capture("");
      }
 else if (chr == 6144 && call_stat&128)
     {
      runscr("Setup");
      return 1;
      }
 else return 0;
}
///////////////////////////////////////////////////////////////////////////////
check_timer( )
{
 if (call_stat&8)       // if finished_caller
     return 1;

 if (access_level <= 0)
    {
     emsg(4);
     kick_out();
     ustamp("*Locking Out*", 1, 1);
     return 1;
    }
 if (time_up (tmark))
     {
      emsg(8);
      kick_out();
      return 1;
     }

 if (!(sysbyte&16))     // update screen
    {
     disptime();
     vars();
     }

 _sound_on = (thour(curtime()) >= chaton && thour(curtime()) < chatoff && chaton <= chatoff)
             || (chaton > chatoff && !(thour(curtime()) <= chaton && thour(curtime()) > chatoff));
 if (sysbyte&64)      // if forced ON
     _sound_on = 1;
 if (sysbyte&128)     // if OFF
     _sound_on = 0;
 return 0;   
}

///////////////////////////////////////////////////////////////////////////////
format( Str string, int length )
{
 if (length == 0)
  {
  while (subchr(string, strlen(string)-1) == 32)
     delchrs(string, strlen(string)-1, 1);
   }
 else
   setchrs(string, strlen(string), 32, length-strlen(string));
  return;
}
///////////////////////////////////////////////////////////////////////////////
// f //

// Get_Command

// Description: Function to input a string which contains a command and
//              possibly additional arguments.

// Parameters: buf: string to use for storing input
//             len: maximum length of input string
//             use: see Input_Strn

// Return value: If end of call or no input: 0
//               Else: uppercase value of the first letter of the string

get_command( Str Prompt, Str buf, int len, int use )
{
 int opt, p1;

input_strn(prompt, buf, len, 0, use);

if (call_stat&8)   // if caller hung up or was nuked, get out.
   return 0;

format(buf, 0);   // format trims spaces off the end

if (!buf)
   return 0;

inschrs(" ", buf, strlen(buf), 1);      // this is necessary for some checking (not just here)

opt = toupper(subchr(buf, 0));  // option is first letter

p1 = strchr(buf, 0, 32);

if (strlen(buf) - p1 - 1 >= 1)  // if we have stacked commands
  {
    arg_list = "";
    substr(buf, p1+1, strlen(buf) - p1 - 1, arg_list); // get everything after
    delchrs(buf, p1, strlen(buf)-p1);                 // second space

    while (subchr(arg_list, 0) == 32)       // get rid of all spaces
         delchrs(arg_list, 0, 1);
    }
else
   {
    arg_list = "";
    delchrs(buf, strlen(buf)-1, 1);     // get rid of ending space
    }
return opt;
}
///////////////////////////////////////////////////////////////////////////////
// f //

// Input

// Gets a key from user on terminal or caller...

// Parameters:
// Type: only used value is 1, which means that after checking once for
// incoming chars, input() either returns a found char or returns 0.
// (Used by type_file(), among others).

// To exit the loop, we either set finished_caller or stat to 1.
// (When a good char has come in, Stat is set to 1)

// This function does not return non ASCII keys (which should be handled by
// Check_Action() )

input( int type )
{
 int c, stat, tm;

 tm = timer_total(tmark);

 stat = type;

 do
   {
    if ((call_stat&2 && !carrier()) || timer_total(tmark)-tm >= 3000 || time_up(tmark))
        stat = -1;

    if ((c = inkey()) > 0)
       {
        if (c > 255)
           {
            if (stat = check_action(c))
                c = -1;
            }
        else if (sysbyte&16)
            stat = 1;
       }
    else if (cinp_cnt() && !(call_stat&1))  // if any chars in buffer
        {
         c = cgetc();     // get first
         stat = 1;
         }
    }
  while (!stat);

 if (stat > 0)
    return c;

 if (timer_total(tmark)-tm >= 3000)
     {
      puts("^L^GYou must have fallen asleep!", "31;1");
      ustamp("*Inactive for 5 minutes, terminated*", 1, 1);
      }
 else if (time_up(tmark))
      emsg(8);
 else if (call_stat&2 && !carrier())
      {
       if (sysbyte&16)
           prints("^M^JCarrier lost, call terminated.^M^J");
       ustamp("Carrier lost", 1, 1);
       }
 kick_out();
 return -1;
}
///////////////////////////////////////////////////////////////////////////////
// f //

// Input_Strn

// buf: Destination string.
// maximum: Maximum length of input
// echo_dots: for use with PW input, TRUE means echo a .(^046) instead of char

// usage == 0 means get string from user
//       == 1 means stick next arg on arg_list into buf (if possible)
//       == 2 means stick all of arg_list into buf      ("     "    )

input_strn( Str prompt, str buf, int maximum, int echo_dots, int usage )
 {
  int i = 0, key, finish = 0;

  if (arg_list)
     {
     if (usage == 1)
        {
         if (get_next_arg(buf))
             finish = 1;
         }
     else if (usage == 2)
         {
         buf = arg_list;
         while (subchr(buf, strlen(buf)-1) == 32)
                delchrs(buf, strlen(buf)-1, 1);
         if (buf)
            finish = 1;
         arg_list = "";   // get rid of arg_list
         }
      }

  if (finish)
     {
      input(1);
      if (call_stat&8)
          return;
      i = strlen(buf);
      }
   else
     {
     puts(prompt, "35;1");
     puts("", "36;1");
     }

  while (!finish && !(call_stat&8))
     {
       key = input(0);

       if (key >= 33 && key <= 255)
          {
           if (i < maximum)
               {
                setchr(buf, i, key);
                if (echo_dots)
                   key = 46;   // echo dot
                puts_c(key);   // or echo char.
                ++i;
                }
           }
       else if (key == 32)    // if space
          {
           if (i > 0 && i < maximum && !echo_dots)
              {
                setchr(buf, i, key);
                puts_c(key);   // or echo char.
                ++i;
               }
           }
       else if (key == 127 || key == 8)
           {
            if (i)
              {
               --i;
               puts_c(key);
               }
            }

       else if (key == '^M')
          {
           puts("^M^J", "0");
           finish = 1;
           }

       else if (key == 27)
           {
            era(i, 0);
            i = 0;
            buf = "";
            }
       else if (key == -1)
          {                           // timeout or user disconnect
           setchr(buf, 0, 0);         // set string to empty to
           finish = 1;                // indicate end of call
          }
   }

   if (status&16)
      print("^[[0m");
   
   setchr(buf, i, 0);

   if (subchr(buf, 0))
       return 1;
   return 0;
}
///////////////////////////////////////////////////////////////////////////////
Openf( str fname, str oper, int log )
{
int f;

if (!(f = fopen(fname, oper)) || ferror(f))
     {
      if (log)
         {
           ustamp("Error opening ", 1, 0);
           ustamp(fname);
           ustamp(" for ^"");
           ustamp(oper);
           ustamp("^"", 0, 1);
           }
       fclose(f);
       return -1;
       }
 return f;
}
///////////////////////////////////////////////////////////////////////////////
// Pause the display until keypress / char in.
pause( )
{
 print("^M^J");
 if (status&8)
    delay(9);
 else
    {
     puts("[Pause]", "0");
     input(0);
     era(7, 0);
     }
}
///////////////////////////////////////////////////////////////////////////////
// The bare-bones output function. If activity is to be displayed,
// then string is printed to terminal. If local mode is off, then it is also
// sent to the COM port.

print( str buf )
{
int c = -1;
if (sysbyte&16)
   printsc_trm(buf);
if (!(call_stat&1))
   cputs(buf);
}
//////////////////////////////////////////////////////////////////////////////
// Prints info on user to screen, puts time left and asks for input.
prompt( str area )
{
 str tts[8];

 itos((timer_begin - timer_total(tmark))/600, tts);
 puts("[", "0");
 puts(tts, "0;1");
 puts(" min] ", "0");
 print(confname);
 print(" (");
 print(confnum);
 print(")^M^J-> ");
 puts(area, "0;1");
 puts(" ¨Your command? ", "0");
 }
///////////////////////////////////////////////////////////////////////////////
// f //
// Puts

// Description: sends string 'outstr' to COM port and/or console.
//              ANSI color can be indicated with string 'color'

// Parameters: - OutStr: String to send
//             - Color: part of ANSI sequence between ESC[ and m .
//                      ex: for ESC[0;1m: puts("text", "0;1");

puts( str outstr, str color )
{ 
 str s[8];
 
 if (status&16)
    {
     s = "^[[";
     inschrs(color, s, strlen(s), strlen(color));
     inschrs("m", s, strlen(s), 1);
     print(s);
    }
  print(outstr);
}
///////////////////////////////////////////////////////////////////////////////
// f //
// Puts_C

// Description: sends character to COM port and/or console

// Parameters: - Chr: Character to send

puts_c( int chr )
{
 if (sysbyte&16)
    printc(chr);
 if (!(call_stat&1))
    cputc(chr);
}
///////////////////////////////////////////////////////////////////////////////
// f //
// Type_File

// Description: Types the file 'fname'.

// Parameters: - Fname: name of file to type out
//             - Type: type of file (0 = ASCII, 1 = ANSI)

type_file( str fname, int typ, int log, int dir )
 {
   int f, c, quit = 0, type;

   type = typ;
   list1 = fname;

   if (dir == 1)
       newdir(host_dir);
   else if (dir == 2)
       newdir(confpath);

   if (strchr(list1, 0, 46) == -1)
      {
       if ((status&16) == 16)
           {
            inschrs(".ANS", list1, strlen(list1), 4);
            if (!filefind(list1, 0))
               {
                delchrs(list1, strlen(list1)-3, 3);
                inschrs("ASC", list1, strlen(list1), 3);
                type = 0;
                }
            else
               type = 1;
            }
       else
           inschrs(".ASC", list1, strlen(list1), 4);
       }

   if ((f = openf(list1, "r", log)) == -1)
      {
       if (log)
          {
           print("^M^J");
           puts(list1, "0");
           print(" is missing!^M^J^J");
           }
       return -1;
       }

   puts("", "0");                // reset color

   while (!quit)
      {
       if (type)
           {
           if ((c = fread(list1, 255, f)) > 0)
              setchr(list1, c, 0);
           }
       else
          {
           c = fgets(list1, 82, f);
           if (nl() == 0)
              c = 0;
           }

       if (c <= 0)
          {
           nl();
           quit = 1;
           }
       else
          {
           print(list1);

           if (c = input(1))
               {
                if (c == -1 || c == 32)
                   {
                    print("^M^J");
                    quit = 1;
                    }
                else if (toupper(c) == 'P')
                   {
                    print(" [Pause]");
                    input(0);                    //wait for key
                    era(8, 0);
                    }
                }
            }
     }

  fclose(f);
  puts("", "0;0");
  return 1;
}
///////////////////////////////////////////////////////////////////////////////
yn( int def, str prompt )
{
int c = 1;
str buf[1];
if (!getarg1(buf, "YN"))
    {
     puts(prompt, "35;1");
     puts(" (Enter=", "0");
     puts_c(def);
     print(")? ");
     while (strchr("YN^M", 0, c) == -1 && !(call_stat&8) && c != 0)
            c = toupper(input(0));
     }
else
    c = subchr(buf, 0);
    
if (c <= 0)
   return 0;
   
if (call_stat&8)
   return 0;

if (c == 13)
    c = def;
if (c == 'Y')
  {
  puts("Yes^M^J", "32;1");
  return 1;
  }
else if (c == 'N')
   {
   puts("No^M^J", "31;1");
   return 0;
   }
}    
///////////////////////////////////////////////////////////////////////////////

// *************************************************************************
// ************************* File Transfer Functions ***********************
// *************************************************************************
// .ftf.

///////////////////////////////////////////////////////////////////////////////
// f //

// Check_for_file

//    Looks in all the defined directories for the file.
//    Puts the whole filename into OBJ_PATH.
//    Checks wildcards, and FILES.LST (if necessary).

// Parameters:
//           - str filename: name of file to find
//           - int upload: 1 = upload, 0 = download, -1 = get match
//           - int how_many: max number of files to find

// POS is set to 1 in the first loop once a match is found.
// Then reset to 0 for second loop, set to 1 when a file is added to LIST0.

Check_for_file( str filename, int upload, int how_many, int option)
{
 int k, pos, objf, multiple, lpos, flen;
 str files[64], files1[64], ss[12], stuff[12];
 ss = EXFILE;
 extend(ss);

 if (strchr(filename, 0, 42) >= 0 || strchr(filename, 0, 63) >= 0)
    {
     if (upload == 1)
        {
         puts("^M^JWhat? Please be more specific.", "0;32");
         return 0;
         }
     else
         multiple = 1;
     }

 strupper(filename);
 files = filename;
 things = "";
 fnstrip(files, 12, things);

 list1 = "";
 if (access_level < path_level || upload == 1 || !things)
    {
     fnstrip(files, 3, files);      // clear junk
     newdir(confpath);
     prep(stoi(confnum), ".DIR", stuff);
     objf = openf(stuff, "r", 1);

     if (objf == -1)
        return 0;

     fseek(objf, 317, 0);

     k = 1;

     do
        {
         ++k;
         input(1);
         if (fread(things, 80, objf) == 80)
            {
             obj_lvl = subchr(things, 0);
             obj_flag = subchr(things, 1);
             subchrs(things, 32, 45, obj_path);
             format(obj_path, 0);

             if (obj_path && access_level >= obj_lvl && (obj_flag&flags) == obj_flag)
                {
                 things = obj_path;
                 inschrs(files, things, strlen(things), strlen(files));

                 pos = 0;

                 // shove all valid files into LIST1.
                 // list1 format: filename[]space[1] ...
                 // this loop will end once all files are found, or one is found on an upload

                 while (filefind(things, 0, files1) > 0 && !(call_stat&8) && (!pos
                        || multiple) )
                      {
                      inschrs(obj_path, list1, strlen(list1), strlen(obj_path));
                      inschrs(files1, list1, strlen(list1), strlen(files1));
                      inschrs(" ", list1, strlen(list1), 1);
                      pos = 1;
                      things = "";
                      }
                  validat(upload, obj_path, option);
                }
              }
            }
       while (k <= high_dir && (!pos || multiple) && !feof(objf) && !(call_stat&8));
       fclose(objf);
   }
else if (access_level >= path_level)   // if (filename+path), download only
  {
  // things contains PATH segment of filename

   while (filefind(files, 0, files1) > 0)
          {
          inschrs(things, list1, strlen(list1), strlen(things));
          inschrs(files1, list1, strlen(list1), strlen(files1));
          inschrs(" ", list1, strlen(list1), 1);
          files = "";
          }

   validat(upload, things, option);
   }

 if (upload == 1)
    return pos;

 if ((pos = strposi(list1, ss, 0)) > 0)     // fix for EXTRACT
     {
      if (subchr(list1, pos+strlen(ss)) == 32)
          setchr(list1, pos+strlen(ss, 1));
      }

 pos = 0;

 while (how_many-pos > 0 && ((lpos = strchr(list1, 0, 1)) > 0) && !(call_stat&8))
      {
       input(1);    // allow sysop quit

       flen = strchr(list1, 0, 32);  //look for 1st space

       if (lpos < flen || flen == -1)
          {
           substr(list1, 0, lpos, files);  // get everything before the ^A
           delchrs(list1, 0, lpos+1);
           files1 = "";
           fnstrip(files, 3, files1);

           if (upload == 0)
               {
               if (show_info(files1, files) != -1)
                  {
                   if (option&2 && !(option&4)) // batch internal
                      {
                       fnstrip(files, 12, files1);
                       if (_up_dir)
                          {
                           if (strcmpi(files1, _up_dir) != 0)
                                     // if paths don't match
                               {
print("^M^JFiles transferred with this protocol cannot be in different directories.");
                               continue;
                               }
                           }
                        else
                           _up_dir = files1;  //else set new _up_dir;
                        fnstrip(files, 3, files); // then remove path
                       }
                   inschrs(files, list0, strlen(list0), strlen(files));
                   inschrs(" ", list0, strlen(list0), 1);
                   ++pos;
                   }
                }
            else
               {
                inschrs(files, list0, strlen(list0), strlen(files));
                inschrs(" ", list0, strlen(list0), 1);
                ++pos;
                }
           }
       else
            delchrs(list1, 0, flen+1);        // remove file from list
       }
 list1 = "";

 if (pos && upload == -1)
    {
     obj_path = "";
     substr(list0, 0, strchr(list0, 0, 32), obj_path);
     }
 return pos;
}
///////////////////////////////////////////////////////////////////////////////
validat( int upload, str obj_path, int option)
{
 int lpos, flen;

 if (access_level < raw_level && upload != 1 && !(sysbyte&512) && list1)
     {
      pos = 0;
      things = obj_path;
      inschrs(FLIST, things, strlen(things), strlen(FLIST));
      file = openf(things, "r", 1);

      while (fgets(listline, 512, file) > 0 && strchr(list1, 0, 32) > 0)
            {
             setchr(listline, strchr(listline, 0, 32), 0);
             flen = strlen(listline);
             lpos = strposi(list1, listline, 0);
             if (lpos >= 0 && subchr(list1, lpos+flen) == 32 &&
                 subchr(list1, lpos-1) == '\')
                 {
                  setchr(list1, lpos+flen, 1);
                  pos = 1;
                  }
             }
       fclose(file);
       }
  else if (list1 && upload != 1)
          {
          lpos = 0;
          while ((lpos = strchr(list1, lpos, 32)) >= 0)
                setchr(list1, lpos, 1);
          }
}
///////////////////////////////////////////////////////////////////////////////
// Returns a directory number for a raw dir, files list, etc.
get_a_dir( )
{
 int c, i = 0;

 str s[64], ask[64];

 if (arg_list)
    {
      get_next_arg(s);
      if (access_level >= path_level && filefind(s, 16) && s != "?")
         i = -2;
      else if (s == "?")
         inschrs("? ", arg_list, 0, 2);
      else if ((i = stoi(s)) < 0)
         i = 0;
     }

while (i == 0)
      {
      if (access_level >= path_level)
          c = 64;
      else
          c = 3;

      get_command("^M^JWhich File Directory? ", ask, c, 2);

      if (!ask)
         i = -1;
      else if (subchr(ask, 0) == '?')
           {
           pointy = 4;
           nl();
           call_stat = call_stat | 64;
           list_obj(1, high_dir);
           i = 0;
          }
      else if (stoi(ask) > 0)
          {
          i = stoi(ask);
          if (i == 0)
             i = -1;
          }
      else if (c == 64 && filefind(ask, 16))
          i = -2;
      else
          i = -1;
      }

  if (call_stat&8 || i == -1)
      return 0;

  if (i > 0)
     {
      getobj(1, i);
      if (!obj_path)         // either a directory reference
          return 0;
      else
         return i;
      }
  else if (access_level < path_level)
      return 0;

  if (!filefind(ask, 16))       // if not a valid dir
     return 0;
 else                           // or else make sure format is correct
    {
     if (subchr(ask, strlen(ask)-1) != '\')
        inschrs("\", ask, strlen(ask), 1);
     obj_path = ask;
     }
 return 1;
}
///////////////////////////////////////////////////////////////////////////////
// Get_descr... Function to get a file's description, and to write it to
// FILES.LST.  Also tests archive integrity.

get_descr( str upname, int test )
{
  str fsize[10], fdate[10], fname[15];
  int ret;

  newdir(obj_path);

  if (test && !(sysbyte&1024))
    {
     puts("^M^JTesting ", "0;32");
     print(upname);
     ret = getarc(6, upname, "");
     temp = obj_path;

     if (ret == 0)
       {
        puts(": error found!", "31;1");
        print("^M^JDeleting...");
        ustamp("Deleting archive: ", 1, 0);
        ustamp(upname, 0, 1);
        fdelete(upname);
        return 0;
       }
     else if (ret == -1)
        {
        ustamp("Could not test: ", 1, 0);
        ustamp(upname, 0, 1);
        }
     }
   if (!(sysbyte&512))
      {
        listline = "";
        if (sysbyte&4096)
           {
           if (import_diz())
                descr = " ";
           }
        ret = 0;
        if (!(call_stat&8) && !descr)
           {
        do
             {
              puts("^M^JPlease describe ", "0");
              puts(upname, "0;1");
              input_strn("^M^J> ", descr, 45, 0, 0);
              format(descr, 0);

              if (strlen(descr) < 10)
                 emsg(10);
              ++ret;
              }
       while (strlen(descr) < 10 && !(call_stat&8) && ret < 3);
            }

       if (strlen(descr) < 10)
           descr = "No description left.";

       if (!listline)
           listline = descr;

       itos(filesize(upname), fsize);
       date(filetime(upname), fdate);

       fname = upname;
       if ((file = openf(FLIST, "a", 1)) == -1)
           return -1;

      format(fname, 14);
      fwrite(fname, 14, file);

      format(fdate, 9);
      fwrite(fdate, 9, file);

      inschrs("      ", fsize, 0, 8-strlen(fsize));
      format(fsize, 10);
      fwrite(fsize, 10, file);

      fwrite(listline, strlen(listline), file);
      fwrite("^M^J", 2, file);
      fclose(file);
      }
  return 1;
}     
///////////////////////////////////////////////////////////////////////////////
// f //
// Get_Prot

// Description:  Get_Prot is used to make the user choose a protocol
//               before a file transfer.  If parameter Chr is a valid
//               protocol, it will be returned.  Or else PROTO.DAT will
//               be displayed to the user, and he/she will be asked
//               for a choice, with a default protocol furnished.

//               Get_Prot is only called before a download/upload if the user's
//               default protocol is set to 'N'one.

// Parameters:  - Chr: integer which should hold a valid character
//                     for a protocol.

// Return:    Whether Batch is On or Off for the chosen Protocol
//            -1 if 'Quit' or Bad protocol.

get_prot( int chr )
{
str prot[1];
int pop;

  chr = toupper(chr);

  if (strchr(protkeys, 0, chr) == -1 || !chr)
     {
      pointy = 0;
      call_stat = call_stat | 64;
      type_file("PROTO", status&16, 1, 1);
      puts("^M^J^IWhich Protocol (Enter=", "35;1");
      if (!proto)
          print("None");
      else
          puts_c(proto);

      input_strn(")? ", prot, 1, 0, 0);

      if (!prot)
         chr = toupper(proto);  // set default
      else
         chr = toupper(subchr(prot, 0));
      }
  if (chr == 'Q')
      chr = -1;

  if ((pop = strchr(protkeys, 0, chr)) == -1)     // if illegal protocol
      chr = 'N';
  else if (!(subchr(protdata, pop)&1))
      chr = -1;

  if (pop == -1)
     return -1;

  return (subchr(protdata, pop));
} 
///////////////////////////////////////////////////////////////////////////////
handle_file( str filen)
{
 str comline[12], fname[12];
 int file, fsize;

 fnstrip(filen, 3, fname);

 if (check_for_file(fname, 1, 0, 0))
    {
     print("^M^J");
     puts(fname, "0;32");
     puts(": file already on board!", "31;1");
     ustamp("Uploads file already on board: ", 1, 0);
     ustamp(fname, 0, 1);
     fdelete(fname);
     return;
    }

 newdir(_down_dir);
 if (!(sysbyte&512))
     {
     file = openf("FILES.TMP", "r", 0);

     while (fgets(things, 80, file) > 0 )  //insert files that were supposed to be uploaded
          {
           if ((pos = strchr(things, 0, 32)) > 0)
               {
                substr(things, 0, pos, comline);
                if (strcmpi(comline, fname) == 0)
                    substr(things, pos+1, strlen(things) - pos - 1, descr);
                }
           }
     fclose(file);
     }
 else
     descr = "";

 fsize = filesize(fname);
 if (move(fname, temp) == 0)
     puts(ERROR, "31;1");
 fnstrip(fname, 3, fname);
 obj_path = temp;

 if (get_descr(fname, 1) == 1)
     {
      ++fupld;
      totalbytes = totalbytes + fsize;
      ustamp("++ Uploads: ", 1, 0);
      ustamp(fname, 0, 1);
      print("^M^J");
      puts(fname, "0;1");
      puts(": Received, Okay.^M^J", "0");
      }
  newdir(_down_dir);
}
///////////////////////////////////////////////////////////////////////////////
//
handle_transfer( int option, int upload, int trans_stat )
{
int logf, stat, fsize;
str line[140], fname[80], filen[12];

newdir(_down_dir);
getenv("DSZLOG", line);
if (getobj(1, 1) <= 0)
    obj_path = _down_dir;

temp = obj_path;

if (upload)
    totalbytes = 0;

puts("^M^JProcessing your transfer...^M^J", "0;32");

 if (option&8)
    {
    if ((logf = openf("BIMOD.LOG", "r", 1)) > 0)
        {
        totalbytes = 0;
        while( fread(list1, 256, logf) == 256)
              {
              fsize = subchr(list1, 8); // actually direction
              substr(list1, 9, 79, fname);
              stat = subchr(list1, 88);

              if (stat == 32)       // if success
                 {
                  if (fsize == 'R')
                     {
                      substr(list1, 89, 45, descr);
                      format(descr, 0);
                      handle_file(fname);
                      }
                  else
                     {
                      fsize = get_int(list1, 245, 4);
                      stamp_dl(fname, fsize);
                      }
                  }
              }
           fclose(logf);
           cleardir();
           bupld = bupld + totalbytes;
           return;
        }
    }
 else if ((option&4) && line)       // if external, log available
   {
     if (logf = openf(line, "r", 1))
        {
         totalbytes = 0;
         while (fgets(line, 140, logf) > 0)
              {
               stat = subchr(line, 0);
               substr(line, 2, 6, fname);
               while (subchr(fname, 0) == 32)
                     delchrs(fname, 0, 1);
               fsize = stoi(fname);
               fname = "";
               if (strchr(line, 50, 32) > 51)
                   substr(line, 50, strchr(line, 50, 32) - 50, fname);
               else
                   substr(line, 50, strlen(line)-51, fname);

               if (toupper(stat) == 'E' || toupper(stat) == 'L')
                  {                         // delete bad uploads
                  if (filefind(fname, 0))   // & do nothing for bad downloads
                       fdelete(fname);
                  }
               else if (islower(stat))
                   stamp_dl(fname, fsize);
              else if (isupper(stat))
                   {
                   handle_file(fname);
                   newdir(_down_dir);
                   }
              }
         fclose(logf);
         cleardir();
         bupld = bupld + totalbytes;
         return;
        }
     }

if (upload)
   {
    totalbytes = 0;
    fname = "*.*";

    while (filefind(fname, 0, filen))  // find all files
          {
           if (strcmpi(filen, "FILES.TMP") != 0)
              {
               handle_file(filen);
               fname = "*.*";
               }
           else
              fname = "";
           }
    // theoretically all files will have been deleted now.
    cleardir();
    bupld = bupld + totalbytes;
   }
else if (trans_stat > -1)
        {
         bdwnld = bdwnld + totalbytes;
         bytes = bytes - totalbytes;
         ustamp("++ Downloads: " , 1, 0);
         ustamp(list0, 0, 1);
         puts("^M^JDownload Successful.", "32;1");
         }
}
///////////////////////////////////////////////////////////////////////////////
stamp_dl( str dls, int fsize)
{
  ustamp("++ Downloads: " , 1, 0);
  ustamp(dls, 0, 1);
  print("^M^J");
  fnstrip(dls, 3, dls);
  puts(dls, "0;1");
  puts(": Sent, Okay.^M^J", "0");
  ++fdwnld;
  bdwnld = bdwnld + fsize;
  bytes = bytes - fsize;
}
///////////////////////////////////////////////////////////////////////////////
// f //

// List_LST

// Description: Reads FILES.LST and does what is indicated by Com (List,
//              NewFile or Search)

// Parameters: - com: The command: com = 1 : normal file list
//                                       2 : newfile search
//                                       3 : string scan
//             - scan_str: String to scan for if (com == 3)

// In all: Info, CR/LF
//                                   36 + <= 45 -> 81
// 35 + 8*45 + 7 * (4 tabs + ^M^J)   = 36 + 360 + 42 = 438 (?) max
// file[12] spc[2] date[8] spc[1] size[8] spc[2] descr[<=45] CR/LF[2]
// 12345678.ZIP  12-12-93 12345678  123456789012345678901234567890123456789012345
// file        12  date  12  size 12 descr
//    spaces--^^^--------^^-------^^^

// possibly change file format for (filename) (descr)
// and read date+size off disk... like:
// fread(name), send name
// itos(filesize(name), size), send size
// date(filetime(name), fdate), send fdate
// fread(descr), send descr

// but this would slow things down... //

list_LST( int com, str scan_str )
{
 int abrt = 1, c, there, pos, i;
 str filen[12], line[80];
 str head[] = "^M^JFile           Date      Size      Description^M^J";

 if (!filefind(FLIST, 0))
     return 1;

 file = openf(FLIST, "r", 1);

 call_stat = call_stat | 64;       // set pause to on.

 pointy = pointy + 2;

 if (com == 1)
    puts(head, "33;1");

 while (fgets(listline, 512, file) > 0 && abrt == 1)
    {
     c = input(1);

     if (c == -1) // if space or user disconnect
        {
         abrt = 0;
         continue;
        }
     if (com > 1)
        {
         if (com == 2)
           {
            substr(listline, 0, 12, filen);
            if (filetime(filen) < last_log)
                continue;
            }
         else if (com == 3)
           if (strposi(listline, scan_str, 0) == -1)   // If we're scanning, and
               continue;                             // no match
         }
     pos = 0;
     i = 1;

     do
       {
        pos = strchr(listline, 0, 16);
        if (i > 1)
           print("^I^I^I^I ");
        if (pos >=0)
           {
           substr(listline, 0, pos, line);
           delchrs(listline, 0, pos+1);
           }
        else
           {
           line = listline;
           listline = "";
           }
        puts(line, "0");
        abrt = nl();
        ++i;
        }
     while (strlen(listline) > 0 && abrt == 1);

     if (toupper(c) == 'P' && !(call_stat&64))
         {
         pause();
         pointy = 0;
         }
     }
 fclose(file);
 return abrt;
}
///////////////////////////////////////////////////////////////////////////////
// f //
// Show_Info

show_info( str name, str namepath )
{
  int size, cps, pos;
  str dump[80];
  size = filesize(namepath);          // get file's size

  if (!name || !namepath)
      return -1;

  print("^M^J");
  strupper(name);
  format(name, 14);
  puts(name, "36;1");
  format(name, 0);
  itos(size, dump);
  inschrs(" bytes", dump, strlen(dump), 6);
  format(dump, 14);

  cps = size/(9 * conn_baud/100);

  puts(dump, "0");

  itos(cps/6, dump);
  inschrs(".", dump, strlen(dump)-1, 1);
  inschrs(" minutes", dump, strlen(dump), 11);
  format(dump, 17);
  print(dump);          //send it all

  if (bupld > 0)
    {
     if ((bdwnld+totalbytes+size)/bupld > ratio && ratio > 0)
        {
         puts("This would exceed your ratio!", "31;1");
         return -1;
       }
     }
  if (bytes-totalbytes-size < 0)
     {
       puts("You don't have enough bytes!", "31;1");
       return -1;
      }
  if (timer_begin - timer_total(tmark) - ttime - (cps * 10)<= 300)
    {
     puts("You're short of time.", "31;1");
     return -1;
     }
  pos = strposi(list0, namepath, 0);
  if (pos >= 0 && subchr(list0, pos+strlen(namepath)) == 32)
    {
     puts("This file is already on your list.", "31;1");
     return -1;
     }
 ttime = ttime + cps * 10;
 totalbytes = totalbytes + size;
 puts("Okay.", "0;1");
 return 1;
}
///////////////////////////////////////////////////////////////////////////////
// load this if strlen fname = 1
transfunks( int char, int upload )
{
 int pos, pos2;

 if (char == '?')
    {
     puts("^M^J^IThe following commands can be used: ", "1;36");
     print("^M^J^J^I^I(L)ist all files to be transferred,");
     print("^M^J^I^I(D)elete a file from the list");
     if (!upload)
         print(",^M^J^I^Icheck transfer (S)tats.");
     else
         print(".");
     print("^M^J^J^IPress Enter at the prompt to end the list.^M^J");
     }
 else if (char == 'L')
    {
     puts("^M^JThe following files will be transferred:^M^J^J", "0;1");
     pointy = 2;
     puts("", "0");
     while ((pos2 = strchr(list0, pos, 32)) > 0)
            {
             substr(list0, pos, pos2-pos, stuff);
             fnstrip(stuff, 3, stuff);
             print(stuff);
             if (nl() == 0)
                 pos = strlen(list0)-1;
             else
                 pos = pos2+1;
             }
     }
  else if (char == 'D')
       {
        input_strn("^M^JDelete which file from the list? ", stuff, 64, 0, 1);
        format(stuff, 0);

        if (stuff)
           {
            pos = strposi(list0, stuff, 0);
            pos2 = strlen(stuff);

            if (pos >= 0 && subchr(list0, pos+pos2) == 32 &&
                 subchr(list0, pos-1) == '\')
                 {
                  pos2 = pos;
                  while (subchr(list0, pos-1) != 32 && pos > 0)
                        --pos;
                  substr(list0, pos, pos2 - pos + strlen(stuff), things);
                  delchrs(list0, pos, pos2-pos + strlen(stuff) + 1);
                  if (!upload)
                     {
                      pos2 = filesize(things);
                      pos = pos2/(9 * conn_baud/100);
                      totalbytes = totalbytes - pos2;
                      ttime = ttime - pos * 10;
                      }
                  puts("^M^JOkay...^M^J", "0;32");
                  return -1;
                  }
             }

        }
 else if (char == 'S' && upload == 0)
      {
       itos(totalbytes, stuff);
       itos(ttime/60, things);
       inschrs(".", things, strlen(things)-1, 1);
       puts("^M^JTotal Size: ", "0;32");
       puts(stuff, "0");
       puts(" bytes, ", "0;32");
       itos(bytes-totalbytes, stuff);
       puts(stuff, "0");
       puts(" left.", "0;32");
       puts("^M^JTotal Time: ", "0;32");
       puts(things, "0");
       puts(" minutes, ", "0;32");
       itos((timer_begin - timer_total(tmark)-ttime)/60,
             stuff);
       inschrs(".", stuff, strlen(stuff)-1, 1);
       puts(stuff, "0");
       puts(" left.^M^J", "0;32");
       }
 return 0;
}
///////////////////////////////////////////////////////////////////////////////
// f //
// Trans_Msg

// Description: Sends the 'get ready to start' message, with several options,
//              including 'Goodbye after', 'Cancel' the transfer, 'List' or
//              Edit the file transfer list.

trans_msg( int proto )
{

 int char, quit = 10;
 str ask[1];

 puts("^M^J^JReady to start transfer.^J", "0");

 if (!getarg1(ask, "CSHQ"))
    {
     puts("^M^J(Q)uit, (H)angup after transfer, (C)ontinue list, or (Enter=Start)? ", "35;1");
     while (strchr("CSHQ^M", 0, char = toupper(input(0))) == -1 && !(call_stat&8) )
            ;                    // wait for key
     }
 else
     char = subchr(ask, 0);
 if (!char)
    char = 'S';

 if (call_stat&8)
     quit = 0;

 puts_c(char);

 if (char == 'S')
     quit = 1;
 else if (char == 'H')
     quit = 2;
 else if (char == 'Q')
     quit = 0;
 else if (char == 'C')
     quit = -1;
 if (quit > 0)
    {
     things = "";
     getenv("DSZLOG", things);
     if (things)
        fdelete(things);

     puts("^M^J^JStarting transfer...^M^JProtocol: ","0;32");
     puts_c(proto);
     if (totalbytes > 0 && ttime > 0)
        {
         itos(totalbytes, stuff);
         itos(ttime/60, things);
         inschrs(".", things, strlen(things)-1, 1);
         puts("^M^JTotal Size: ", "0;32");
         puts(stuff, "0");
         puts(" bytes.", "0;32");
         puts("^M^JTotal Time: ", "0;32");
         puts(things, "0");
         puts(" minutes.", "0;32");
        }
     print("^M^J^JSend Ctrl-X at least twice to halt transfer.");
     delay(15);
     }
 return quit;
}
///////////////////////////////////////////////////////////////////////////////

///////////////////////////////////////////////////////////////////////////////
// *************************************************************************
// ************************** User File Functions **************************
// *************************************************************************
// .uff.

///////////////////////////////////////////////////////////////////////////////
Ask_for_pass( str pw, int maxtries )
{
 int count = 1;
 str log[] = "System Password failure";

 do
   {
   input_strn("^M^JWhat is your password? ", things, 12, 1, 0);

   if (strcmpi(things, pw) == 0)
       count = maxtries+2;
   else
     {
      puts("^M^JWrong password.", "31;1");
      if (count <= maxtries-1)
          print(" Please try again.^M^J");
      else
          print("^M^J");
      ++count;
      }
   }
 while (count <= maxtries && !(call_stat&8));

if (count == maxtries+2)
    return 1;
else
    {
    if (maxtries == 1)  // since we know maxtries for syspass is 1
        ustamp(log, 1, 1);
    else
        {
        delchrs(log, 0, 7);
        ustamp(log, 1, 1);
        }
    return -1;
    }
}
///////////////////////////////////////////////////////////////////////////////
// Asks/Verifies the user's password, registers new users.

load_caller( )
{
   str trystr[] = "Try again...";
   int found_password = 0, counter = 0;

   counter = 1;

     do
       {
        ++counter;
        input_strn("^M^J^JWhat is your name? ", current_caller, 25, 0, 0);

        if (current_caller && strposi(current_caller, "sysop", 0) == -1 && strcmpi(current_caller, "all") != 0)
            format(current_caller, 0);  // trim spaces off end
        else
            current_caller = "";

       } while (counter <= 3 && !(call_stat&8) && StrLen(Current_Caller) < 3);

   if (strlen(current_caller) < 3)
      return -1;

   make_nice(current_caller);
   stuff = current_caller;

   if (sysbyte&2048)   // if no user records, ask for pass then look for it
      {
       input_strn("^M^JWhat is your password? ", things, 12, 1, 0);
       rec_no = 0;
       do
           {
           ++rec_no;
           load_user(current_caller, 0);
           if (strcmpi(things, password) == 0)
              {
              current_caller = stuff;
              found_password = 1;
              if (status&2)
                 found_password = -1;
              }
           }
       while (rec_no <= 10 && found_password == 0);

       if (found_password == 0)
          {
           type_file("PRIVATE", 0, 0, 1);
           kick_out();
           return -1;
           }
       }
   else
      {
       puts("^M^JLooking for your record...", "0;32");
       rec_no = 0;
       found_password = load_user(current_caller, 0);
       }
   ++total_calls;
   print("^M^J");
  
   if (found_password == -1)
       {
       things = "Blacklisted user!";
       puts("^M^J^G", "31;1");
       print(things);
       print("^M^JYou've been banned for eternity from this system.");
       ustamp(things, 1, 1);
       return -1;
       }

   if (sysbyte&2048)
      return found_password;

   if (found_password > 0)  //found password, so ask for it
       return ask_for_pass(password, 3);

   else if (found_password == 0)
     {                                // Offer chance to register
       puts("^M^JThat name doesn't evoke any memories...", "0;32");
       if (!yn('N', "^M^J^JAre you a new caller"))
           return 0;
       if (sysbyte&8)
           {
            call_stat = call_stat | 64;
            type_file("PRIVATE", status&16, 1, 1);
            kick_out();
            ustamp("New User! Hanging up.", 1, 1);
            return -1;
           }
       delay(10);
       puts("^L^J So, ", "0");
       puts(current_caller, "0;1");
       puts(", you're not on the User List.^M^J^J", "0");
       if (yn('Y', "Would you like to join this System") == 0 || (call_stat&8))
           return -1;
       pointy = 0;
       call_stat = call_stat | 64;
       type_file("POLICY", 0, 0, 1);    // show board policy

                 // If user wants to register, then:
                 // XHost Registration Questionaire
       pause();
       ustamp("New user, starting registration", 1, 1);
       title("Registration Questionaire");
       puts("^M^J^JFirst, you must choose your password. It has to be longer", "0;32");
       print("^M^Jthan 4 characters, with a maximum of 12.");
       password = "";
       things = "a";

      while (strcmpi(things, password) != 0 && !(call_stat&8))
            {
            password = "";
            while (strlen(password) < 5 && !(call_stat&8))
                  input_strn("^M^JYour password...^M^J> ", password, 12, 1, 0);
            puts("^M^JPlease type in your password again.", "0;32");
            input_strn("^M^J> ", things, 12, 1, 0);
           }

     if (sysbyte&256)
        {
         puts("^M^J^JNow I need your real name.", "0;32");

         real_name = "";
         while (strlen(real_name) < 5 && !(call_stat&8))
             {
             input_strn("^M^J> ", real_name, 25, 0, 0);
             if (strlen(real_name) < 5)
                 puts(trystr, "0;32");
              }
         make_nice(real_name);
         }

     stuff = "";
     puts("^M^JWhat is your voice phone number?", "0;32");
     while (strlen(stuff) < 3 && !(call_stat&8))
          {
          input_strn("^M^JArea code: ", stuff, 3, 0, 0);
          if (strlen(stuff) < 3)
              puts(trystr, "0;32");
          }
     acode = stoi(stuff);

     while (strlen(stuff) < 7 && !(call_stat&8))
          {
          input_strn("^M^JPhone Number (no punctuation): ", stuff, 7, 0, 0);
          if (strlen(stuff) < 7)
              puts(trystr, "0;32");
          }

     phone = stoi(stuff);

     puts("^M^JPlease type in your city and state.", "0;32");
     city = "";
     while (strlen(city) < 6 && !(call_stat&8))
          {
          input_strn("^M^J> ", city, 24, 0, 0);
          if (strlen(city) < 6)
              puts(trystr, "0;32");
          }
     make_nice(city);

     puts("^M^JWhich country are you calling from?", "0;32");
     country = "";
     while (strlen(country) < 6 && !(call_stat&8))
          {
          input_strn("^M^J> ", country, 30, 0, 0);
          if (strlen(country) < 6)
              puts(trystr, "0;32");
          }
     make_nice(country);

     if (call_stat&8)           // get rid of finished caller
        return -1;
     proto = 90;        // set to Zedmodem
     puts("^M^J^JYou must now beg the SysOp for access!^M^J", "0;32");
     delay(15);
     confnum = "1";
     if (write_msg(sysop_name, "As a new user, ...", 1, 0) > 0)
          puts("^M^JGood... The SysOp should get to your request within a few days.", "0;32");
  else
     {
      puts("^M^JDon't forget to call back when you have more patience!", "31;1");
      ustamp("No comment left - New user kicked out", 1, 1);
      return -1;
     }

    if (call_stat&8)
        return -1;
    delay(10);

    puts("^M^J^JThank you for answering these questions, and if everything is correct, ", "0;32");
    print("^M^Jyou will be validated soon.^M^J");
    get_lvl(1);

    make_nice(current_caller);

    access_level = 1;
    bytes = 0;
    flags = 0;
    bupld = 0;
    bdwnld = 0;
    last_log = 0;
    page_length = 24;
    comment = "Login on ";              // 239 bytes now
    date(curtime(), stuff);           // stick logon date into comment
    inschrs(stuff, comment, strlen(comment), strlen(stuff));
    bitmaps = "";
    setchr(bitmaps, 0, 1);      // scan conference 1
    rec_no = 0;
    update_user(current_caller);
    load_user(current_caller, 0);            // reload all info into memory
    return 1;
    }
   return -1;
 }
///////////////////////////////////////////////////////////////////////////////
ctoi( int num, int fcb )
{
  str tmp[4];
  fread(tmp, num, fcb);
  return get_int(tmp, 0, num);
}
///////////////////////////////////////////////////////////////////////////////
// kludge is to be able to get the sysop's default color on/off bit
// for quick logons

load_user( str user_name, int kludge )
{

 str name[25];
 int sbyte, rec, found = 0;

 if (rec_no)
    found = 1;

 rec = rec_no;

 newdir(_telix_dir);

 if (filefind(USERF, 0) && filesize(USERF) >= REC_LEN)
    {
      if ((file = openf(USERF, "r", 1)) == -1)
         return 0;
     }
 else
     return 0;

 if (!found)
    {
     while (fread(things, 26, file) > 0 && !found)
          {
           ++rec;
           subchrs(things, 1, 25, name);

           sbyte = subchr(things, 0);
           if (sbyte&2 && strcmpi(name, user_name) == 0)       // locked out user
               found = -1;
          else if (strcmpi(name, user_name) == 0 && (sbyte&1) == 0)
               found = 1;
          else
              fseek(file, REC_LEN-26, 1);
         }
      }

if (found == 1)
   {
    fseek(file, (rec-1)*rec_len ,0);
    fread(list1, 320, file);    // get all from disk
    status = status&16; // keep old color

    status = status | (subchr(list1, 0)&(255-16*(!kludge)) );

    if (status&2)       // locked out user
       {
        fclose(file);
        return -1;
        }
    subchrs(list1, 1, 26, user_name);
    subchrs(list1, 27, 13, password);
    access_level = subchr(list1, 40);
    flags = subchr(list1, 41);
    subchrs(list1, 42, 26, real_name);
    acode = get_int(list1, 68, 2);
    phone = get_int(list1, 70, 4);
    subchrs(list1, 74, 25, city);
    subchrs(list1, 99, 31, country);
    page_length = subchr(list1, 130);
    proto = subchr(list1, 133);
    bytes = get_int(list1, 134, 4);
    bupld = get_int(list1, 138, 4);
    bdwnld = get_int(list1, 142, 4);
    fupld = get_int(list1, 146, 2);
    fdwnld = get_int(list1, 148, 2);
    last_log = get_int(list1, 158, 4);
    time_left = get_int(list1, 162, 2);
    total_calls = get_int(list1, 164, 2);
    subchrs(list1, 166, 30, comment);
    subchrs(list1, 196, 10, bitmaps);
    subchrs(list1, 210, 80, reads);
    rec_no = rec;
    }
fclose(file);
return found;
}
///////////////////////////////////////////////////////////////////////////////
get_last_read( int confn )
{
if (confn && confn <= 40)        // this is easy
    read = get_int(reads, (confn-1)*2, 2);
else
    read = 0;
}
///////////////////////////////////////////////////////////////////////////////
// conference = stoi(confnum)
save_last_read( int confn )
{
if (confn && confn <= 40)        // this is easy
    {
    setchr(reads, (confn-1)*2, read%256);
    setchr(reads, (confn-1)*2 + 1, read/256);
    }
}
///////////////////////////////////////////////////////////////////////////////
set_scans( )
{
int choice, quit, bitpos, x;
str buf[255], com[4];

arg_list = "";
print("^L");
list_conf(0);
print("^M^J");
while (quit == 0)
    {
     if (!arg_list)
        {
         input_strn("^M^JEnter conference # to change (Enter=Quit): ", buf, 128, 0, 2);
         arg_list = buf;
         }

     get_next_arg(com);
     choice = stoi(com);

    if (subchr(com, 0) == '?')
       {
        pointy = 0;
        list_conf(0);
        puts("^M^JYou can also (S)elect or (D)eselect all conferences.^M^J", "0;36");
        }
     else if (toupper(subchr(com, 0)) == 'D')
          setchrs(bitmaps, 0, 0, 5);
     else if (toupper(subchr(com, 0)) == 'A')
          setchrs(bitmaps, 0, 255, 5);
     else if (choice >= 1 && choice <= high_conf)
         {
         conf_stat = 0;
         if (get_conf(choice, 0) > 0 && conf_stat&1)
            {
            bitpos = 1;
            for (x = 1; x <= (choice-1)%8; ++x)
                bitpos = bitpos*2;
            setchr(bitmaps, (choice-1)/8, subchr(bitmaps, (choice-1)/8)^bitpos);
            if (bitcheck(choice, 0))
                print("Conference is now included in Scans.");
            else
                print("Conference is now excluded.");
            }
          else
              print("You cannot access that conference.");
         }
      else
        quit = 1;
   }
}
///////////////////////////////////////////////////////////////////////////////
// f //
// Update_User

update_user( str user_name )
{
 str name[25];
 int found_spot = -1, sbyte;

 if (sysbyte&2048)
     return 1;

newdir(_telix_dir);

if (filefind(USERF, 0))
  {
   file = openf(USERF, "r+", 1);
   if (rec_no == 0)
      {
       while (fread(things, 26, file) > 0 && found_spot == -1)
          {
           subchrs(things, 1, 25, name);
           if (subchr(things, 0)&1)         // if deleted user
               found_spot = ftell(file)-26;
           else
               fseek(file, REC_LEN - 26, 1);
          }
        }
   else
       found_spot = (rec_no-1) * rec_len;

   if (found_spot >= 0)
       fseek(file, found_spot, 0);
   else
      {
       fclose(file);
       file = openf(USERF, "a", 1);
       fseek(file, 0, 2);
       }
   }
else
    file = openf(USERF, "w", 1);

setchr(list1, 0, status);
copychrs(user_name, list1, 1, 26);
copychrs(password, list1, 27, 13);
setchr(list1, 40, access_level);
setchr(list1, 41, flags);
copychrs(real_name, list1, 42, 26);
put_int(acode, list1, 68, 2);
put_int(phone, list1, 70, 4);
copychrs(city, list1, 74, 25);
copychrs(country, list1, 99, 31);
setchr(list1, 130, page_length);
setchr(list1, 133, proto);
put_int(bytes, list1, 134, 4);
put_int(bupld, list1, 138, 4);
put_int(bdwnld, list1, 142, 4);
put_int(fupld, list1, 146, 2);
put_int(fdwnld, list1, 148, 2);
put_int(curtime(), list1, 158, 4);
time_left = (timer_begin - timer_total(tmark))/600;
if (time_left < 0)
    time_left = 0;
put_int(time_left, list1, 162, 2);
put_int(total_calls, list1, 164, 2);
copychrs(comment, list1, 166, 30);
copychrs(bitmaps, list1, 196, 10);

if (rec_no == 0)
    setchrs(reads, 0, 0, 80); // then blank out last_reads

copychrs(reads, list1, 210, 80);
setchrs(reads, 0, 0, 30); // then blank out reserved bytes
fwrite(list1, 320, file);
fclose(file);
return 1;
}
///////////////////////////////////////////////////////////////////////////////

// *************************************************************************
// ************************* Message Base Functions*************************
// *************************************************************************
// .mbf.

///////////////////////////////////////////////////////////////////////////////
// f //
// Extract
// extracts message from .MSG into TMPFILE

// f //
// Fl

// Descr: Finds the last message in a messagebase
// Params: - msg_index: string with the number of the msg base
//         - scan_through: to get all VALID new messages
//         - last_read: only needed when scan_through is TRUE

findlast( str conf, int scan_through)
{
// - Header:
// Nothing[128]
// - Each message:      0 12 3456 7890 1234 56
// Status[1] Number_Chars[2] Date_Chars[4] Start_Chars[4] End_Chars[4]
// RefChars[2] To[25] From[25] Subject[25] Res[36]
//
//                status byte    UERHDP  Echo, Replies, Has read, Deleted, Pvt
//                             00000000  NOP
//

 int last, idxfile, state, msg_num, msg_to;

 str tmp[13], tmp1[25], last_name[25], reader[25];

 reader = current_caller;
 format(reader, 25);

 prep(stoi(conf), ".IDX", tmp );

 if (filefind(tmp, 0))
     idxfile = openf(tmp, "r", 1);
 else idxfile = 0;

 tmp = "";
 if (scan_through)
    {
     nl();
     puts("Scanning ", "0");
     puts(confname, "0;1");
     puts("...", "0");
     }

 if (idxfile > 0)  // if file doesn't exist, return no new msgs
    {
     fseek(idxfile, 1-MSG_LEN, 2); // goto last record of file
     if (ftell(idxfile) > 127)
         last = ctoi(2, idxfile);
     else // no messages
         last = 0;

     if (scan_through)
        {
         if (read < last)
            {
            fseek(idxfile, 129, 0);      // skip header
            fseek(idxfile, (read - ctoi(2, idxfile) + 2) * 128, 0);
            if (ftell(idxfile) < 128)
                fseek(idxfile, 128, 0);

            while (fread(things, 128, idxfile) == 128)
                  {
                  state = subchr(things, 0);
                  if ((flags&2) || !(state&2))
                     {
                      subchrs(things, 17, 25, tmp1);       // Extract To
                      subchrs(things, 42, 25, last_name);  // Extract From

                     if (strcmpi(tmp1, reader) == 0)
                         ++msg_to;

                     if (state&1)     // private message
                         {
                       // if reader is sender/receiver or sysop
                          if (strcmpi(tmp1, reader) == 0 ||
                             strcmpi(last_name, reader) == 0 || flags&2)
                             ++msg_num;
                           }
                        else
                           ++msg_num;
                        }
                   }
            }
       }
  }
 fclose(idxfile);

 if (scan_through)
    {
     if (nl() == 0)
        return last;
     itos(read, tmp1);
     puts("The last message you read: ", "0;32");
     puts(tmp1, "32;1");
     itos(last, tmp1);
     puts("^M^JThe highest message found: ", "0;32");
     puts(tmp1, "32;1");
     ++pointy;
     if (read < last)
        {
         if (nl() == 0)
            return last;
         puts("  New messages: ", "0");
         itos(msg_num, tmp);
         puts(tmp, "0;1");

         puts("^M^J^ITo you: ", "0");
         itos(msg_to, tmp);
         puts(tmp, "0;1");
         ++pointy;
         }
      else
        {
         puts("^M^JNo new messages.", "0;32");
         ++pointy;
         }
      delay(5);
     }
 return last;
}
///////////////////////////////////////////////////////////////////////////////
// f //

get_int( str src, int pos, int num )
{
int i, x, mult = 1;
for (x = 0; x < num; ++x)
  {
   i = subchr(src, pos + x) * mult + i;
   mult = mult * 256;
  }
return i;
}
///////////////////////////////////////////////////////////////////////////////
put_int( int src, str target, int pos, int num)
{
 int x, div, source;

if (num == 4)
    div = 16777216;
else
    div = 256;

 source = src;

 for (x = num - 1; x >= 0; --x)
    {
     setchr(target, pos + x, source/div);
     source = source%div;
     div = div/256;
     }
}
///////////////////////////////////////////////////////////////////////////////
// Read the messages

read_msg( int scan )
{
 str last_subject[26],        // subject of current message
     last_name[26],           // author of current message
     mdate[8],               // date of message creation
     temp2[25],               // Multiple uses
     mtime[8],               // Time of message creation
     last_msg[5],             // Last message read by user

// note that THINGS is also used in part of the message header

     temp1[25],
     ref[5],
     mname[10],
     reader[26],    // this will contain Current_Caller padded to length 25.
     ask[2];

 int msgfile,
     idxfile;

 int prompt = 1,
     c,
     priv, 
     quit = 0, 
     has_read = 0,            // if user has read any messages at all
     last_num,                // last GOOD message user has read
     new_num,                 // # of msg we're looking for
     high_num, 
     read_next = 1,           // TRUE when we want to read in next message
     z,
     num_at_offset = 0,       // number of that message
     direction = 1,           // going north or south...
     start,
     end,
     next_num;

 reader = current_caller;
 format(reader, 25);
 pointy = 0;

 if (scan)
    has_read = 1;
 while (quit == 0)
    {
     newdir(confpath);
     quit = check_timer();

     if (call_stat&8 || quit)
       {
        read = high_num;
        quit = 1;
        continue;
       }

// Message Index File format: (spaces only for clarity)

// - Header:
// Head[128]

// - Each message:
// Status[1] Number_Chars[2] Date_Chars[4] Start_Chars[4] End_Chars[4]
// Ref_Num[2] To[26] From[26] Subject[26] Reserved[33]

// Overall length:  128 bytes/message

// So we initially get 3 chars to figure out number
 if (read_next == 1)         // if we should get next message
    {
    if (num_at_offset)  // we check num_at... which should be >= 1.
       {
        new_num = new_num+direction;     // make it look for next message

        if (new_num < num_at_offset)     // in case we go off the edge...
           {
            if (direction == -1)  // if going in reverse
              {
               quit = 1;          // (num_at_offset always is the first message)
               continue;
              }
           else                   // or else jump to first message
               new_num = num_at_offset;
            }

     next_num = (new_num - num_at_offset)*MSG_LEN;
     fseek(idxfile, next_num + 128, 0);

     if (fread(things, 128, idxfile) == 128)
          // if read is succesful, then extract rest of message header
         {
          priv = subchr(things, 0);
          next_num = get_int(things, 1, 2);
                        // shit! this line should never be processed.
                        // but if Next_Num IS less than New_Num, then look for next msg
          if (next_num < new_num)
             {
              ustamp("Message base sequence error!", 1, 1);  // notify sysop
              new_num = new_num+direction;
              continue;
              }
          else
              last_num = next_num;

          if (priv&2 && !(flags&2))  // If deleted message, and not CoSysOp
                 continue;    // go to next message

          substr(things, 17, 25, temp2);       // Extract To
          substr(things, 43, 25, last_name);   //         From

          if (priv&1) // status of message. If private...
               {
      if (strcmpi(temp2, reader) != 0 && strcmpi(last_name, reader) != 0 &&
         !(flags&2 && (strcmpi(temp2, "sysop") != 0 || strcmpi(temp2,
         sysop_name) != 0)) && !(Flags&1))
                  continue;
               }

          subchrs(things, 69, 25, last_subject); // Extract Subject
          itos(get_int(things, 15, 2), ref);

          if (last_num > high_num)  // Update our read pointers
              high_num = last_num;

          if ((strcmpi(temp2, reader) == 0 && !(priv&4)) || (strposi(temp2, "sysop", 0) == 0 && flags&1))
             {
              fseek(idxfile, -MSG_LEN, 1);
              fputc(priv|4, idxfile);    // set has-read-message ON
              fseek(idxfile, MSG_LEN-1, 1);
              puts_c(7);            // Beep for message to current_caller
             }

          next_num = get_int(things, 3, 4); // this is curtime() at message write time
          date(next_num, mdate);        // convert to strings
          time(next_num, mtime);

          start = get_int(things, 7, 4);
          end   = get_int(things, 11, 4);
          itos(last_num, things);
          format(ref, 5);
         }
      else // if no more messages / possibly error
          {
           priv = -1;
           if (!has_read)
               has_read = 1;
           else
              {
               quit = 1;
               continue;
               }
           }
     }
  else                        // if we don't have an offset, get one.
     {
      if ((z = findlast(confnum, 1)) <= 0)
         {
          quit = 1;
          continue;
          }
      nl();
      high_num = read;        // do various preparations
      new_num = read;
      last_num = 0;

      prep(stoi(confnum), ".MSG", mname);

      msgfile = openf(mname, "r", 1);

      if (msgfile <= 0)
         {
          quit = 1;
          continue;
          }

      prep(stoi(confnum), ".IDX", things);

      idxfile = openf(things, "r+", 1);

      if (idxfile <= 0)
         {
          quit = 1;
          continue;
          }

      itos(z, last_msg);  // get last number again.

      fseek(idxfile, 129, 0);       // skip header of IDX file

      if ((num_at_offset = ctoi(2, idxfile)) <= 0)
         {
          quit = 1;     
          continue;
         }

       fseek(idxfile, 128, 0);    // offset is always a REAL position
       continue;                     // as oposed to RELATIVE (so seek from 0)
      }
    }

// Here we send the header and then type the file containing the message

  if (priv != -1 && read_next >= 1)
     {
     puts("^M^JMessage in ", "0");          // line = 1
     puts(confname, "0;1");
     puts(" (", "0");
     print(confnum);
     print(")^M^J");                         // 2
     puts("   To: ", "35;1");
     puts(temp2, "32;1");
     puts(" Date: ", "35;1");
     puts(mdate, "0");
     print(" ");
     print(mtime);
     puts("^M^J From: ", "35;1");            // 3
     puts(last_name, "36;1");
     puts(" Number: ", "35;1");
     puts(things, "36;1");
     puts(" of ", "35;1");
     puts(last_msg, "36;1");
     puts("^M^JAbout: ", "35;1");            // 4
     puts(last_subject, "33;1");
     if (!(priv&32))
       {
        puts(" Received: ", "35;1");
        puts("", "0");
        if (priv&4)
             print("Yes");
        else print("No");
        }
     print("^M^J");
     if (stoi(ref) > 0)
        {
         puts("Reply to # ", "35;1");
         puts(ref, "0");
         print("^I^I ");
         }
     puts("Status: ", "35;1");
     puts("" , "0");
     if (priv&2)
         print("Deleted");
     else
         print("Active");

     if (priv&1)
         print(", Private");

     if (priv&8)
         print(", Has a Reply");
     print("^M^J");                          // 6
     pointy = 6;
     if (prompt&1)
         call_stat = call_stat | 64;
     else
         call_stat = call_stat&191;

     if (end - start > 0)
        {
         puts("", "0");                // reset color
         fseek(msgfile, start, 0);
         z = 0;

         while (!z && ftell(msgfile) < end)
               {
                c = fgets(list1, 82, msgfile);
                if (nl() == 0)
                    c = 0;

                if (c <= 0)
                   {
                    nl();
                    z = 1;
                   }
                else
                   {
                    print(list1);

                    if (c = input(1))
                       {
                        if (c == -1 || c == 32)
                           {
                            print("^M^J");
                            z = 1;
                            }
                        else if (toupper(c) == 'P')
                           {
                            print(" [Pause]");
                            input(0);                    //wait for key
                            era(8, 0);
                            }
                        else if (c == '^K')
                            {
                            pointy = page_length-1;
                            call_stat = call_stat&191;
                            prompt = prompt | 1;
                            }
                        }
                    }
             }
          nl();
        }
     has_read = 1;
     read_next = 1;
     }
     
  if (prompt&1 || strlen(arg_list))  // check bit 1
      {
       if (!arg_list)
          {
           nl();
           if (priv >= 0)
               puts("You're reading messages.", "0;35");
           else          // priv == -1 indicates end of messages
              {
               puts("End of messages.", "0;35");
               read_next = 0;
               }

           puts(" What now? ", "35;1");
           z = get_command("", stuff, 20, 0);
           ++pointy;
           }
       else
          {
           get_next_arg(stuff);
           z = toupper(subchr(stuff, 0));
           }
        if (call_stat&8)
           {
            quit = 1;
            continue;
            }

          if (z == 0)    // Next message
             {
              if (priv == -1)   // on end of messages, quit.
                  quit = 1;
              read_next = 1;
              }
          else if (z == 'Q')
                quit = -1;
          else if (z == '+' && priv != -1)
               {
                direction = 1;    // forward
                read_next = 1;
                }
          else if (z == '-' && priv != -1)
               {
                direction = -1;   // reverse direction
                read_next = 1;
                }
          else if (z == 'A' && priv != -1)
                read_next = 2;   // show current message again
          else if (z == 'J')
               {
                input_strn("^M^JSwitch to which conference? ", stuff, 3, 0, 1);
    
                if (stoi(stuff))
                   {
                    if (get_conf(stoi(stuff), 1) > 0 && conf_stat&1)
                        {
                        fclose(msgfile);
                        fclose(idxfile);
                        switch_conf(stoi(stuff), 1);
                        read_next = 1;
                        has_read = 0;
                        num_at_offset = 0;
                        }
                    else
                        get_conf(stoi(confnum), 1);
                    }
                pointy = pointy + 2;
                }
       // For copying/moving messages:
       // we should: get other message base,
       // copy the data file
       // over in one shot (saving positions with ftell()) and then
       // copying over the index file's line (have to change start, end).

       // read line of IDX file, close
       // close msgfile, reopen other data file.  Copy to end, save all nec.
       // data (start, end).
       // (data is still in TMPFILE)
       // close data, call findlast(), if (0) then write header, increment,
       // goto end. Keep from old: status, date, to, from, subject, res
       //                  update: number, start, end, ref=0.
          else if (z == 'E' && priv != -1)
                {
                if (strcmpi(last_name, reader) == 0 || flags&2)
                  {
                    puts("^M^JTo: ", "0;32");
                    puts(temp2, "0");
                    puts("^M^JSubject: ", "0;32");
                    puts(last_subject, "0");
                    puts("^M^J(Enter=no change)", "0;0");
                    stuff = temp2;               // get new info here
                    input_strn("^M^JNew receiver: ", temp2, 25, 0, 1);
                    if (!temp2)
                       temp2 = stuff;
                    stuff = last_subject;
                    input_strn("New subject: ", last_subject, 25, 0, 1);
                    if (!last_subject)
                       last_subject = stuff;
                    fseek(idxfile, -MSG_LEN+17, 1);         // write to file
                    format(temp2, 25);
                    fwrite(temp2, 26, idxfile);
                    fseek(idxfile, 26, 1);
                    format(last_subject, 25);
                    fwrite(last_subject, 26, idxfile);
                    fseek(idxfile, 33, 1);  // skip reserved bytes
                    read_next = 0;
                    }
                if (strcmpi(temp2, reader) || strcmpi(last_name, reader) == 0 || flags&2)
                    {
                    puts("^M^JMessage is: ", "0;32");
                    if (priv&2)
                       puts("Deleted ", "31;1");
                    else
                       puts("Active ", "36;1");
    
                    if (priv&1)
                       puts("Private", "31;1");
                    else
                       puts("Public", "36;1");
                    if (yn('N', "^M^JChange Status"))
                       {
                        priv = priv^2;       // XOR to toggle
                        fseek(idxfile, -MSG_LEN, 1);
                        fputc(priv, idxfile);
                        fseek(idxfile, MSG_LEN-1, 1);
                        }
                     if (yn('N', "^M^JChange Security"))
                        {
                         priv = priv^1;         // XOR to toggle
                         fseek(idxfile, -MSG_LEN, 1);
                         fputc(priv, idxfile);
                         }
                    puts("^M^JMessage is now: ", "0;32");
                    if (priv&2)
                        puts("Deleted ", "31;1");
                    else
                        puts("Active ", "36;1");

                    if (priv&1)
                        puts("Private", "31;1");
                    else
                        puts("Public", "36;1");
                    print("^M^J");
                    }
                    new_num = new_num-direction;
                    ustamp("Edits message #", 1, 0);
                    ustamp(things, 0, 1);
                    pause();
                    pointy = 0;
                    read_next = 0;
                  }
          else if (z == 'C' && priv != -1)
                  prompt = !prompt;   // Toggle bit 1
          else if (stoi(stuff) >= 1 && stoi(stuff) <= stoi(last_msg))
              {
               itos(stoi(stuff), things);
               z = strlen(things);
               if (strlen(stuff) > z)
                  {
                   if ((z = subchr(stuff, strlen(stuff)-1)) == '-')
                        direction = -1;
                   else
                        direction = 1;
                   }
               new_num = stoi(stuff)-1;
               if (new_num < 0)
                   quit = 1;
               read_next = 1;
               }
          else if (z == 'L')
              {
              puts("^M^JThe last message you read is ", "0;32");
              itos(high_num, stuff);
              print(stuff);
              if (input_strn(NEW_VAL, stuff, 5, 0, 1))
                 if (stoi(stuff) >= 0)
                    {
                     high_num = stoi(stuff);
                     read_next = 0;
                     }
              }
          else if (z == 'W')
             {
              z = ftell(idxfile);
              fclose(idxfile);      // Close our file, since Editor will access it
              fclose(msgfile);
              write_msg("", "", 2, 0);
              itos(findlast(confnum, 0), last_msg);  // get last number again.
              msgfile = openf(mname, "r", 1);
              prep(stoi(confnum), ".IDX", stuff);
              idxfile = openf(stuff, "r+", 1);
              fseek(idxfile, z, 0);
              read_next = 0;
              pointy = 0;
             }
          else if (z == 'R' && priv != -1)
              {
               z = ftell(idxfile);
               fclose(idxfile);
               fclose(msgfile);
    
               format(last_name, 0);
               format(last_subject, 0);
    
               puts("^M^J (Enter=", "0;35");
               puts(last_subject, "0;0");
               input_strn(")^M^J What is its title? ", temp1, 25, 0, 1);
    
               if (!temp1)
                   temp1 = last_subject;
    
               if (write_msg(last_name, temp1, priv&1, stoi(ref)))
                   priv = priv | 8;
    
               itos(findlast(confnum, 0), last_msg);  // get last number again.
               msgfile = openf(mname, "r", 1);
               prep(stoi(confnum), ".IDX", stuff);
               idxfile = openf(stuff, "r+", 1);
               fseek(idxfile, z, 0);
               if (priv&8)
                   {
                   fseek(idxfile, -MSG_LEN, 1);
                   fputc(priv, idxfile);
                   fseek(idxfile, MSG_LEN-1, 1);
                   }
               read_next = 2;                    // Here, fix up altered vars.
               format(last_subject, 25);                    // ...
               format(last_name, 25);                       // ...
               pointy = 0;
               }
          else if (z == '?')
             {
              puts("^M^JAt the end of a message you can...", "0;36");
              print("^M^J^J^I^IRead the same message (A)gain");
              print("^M^J^I^Igo forward(+) or backward(-),");
              print("^M^J^I^Igo to another message (1-65536),");
              print("^M^J^I^Iread messages (C)ontinuously (non-stop),");
              print("^M^J^I^I(R)eply to this message,");
              print("^M^J^I^I(W)rite a new message,");
              print("^M^J^I^I(E)dit the message's header (if To/From you),");
              print("^M^J^I^I(J)oin another conference,");
              print("^M^J^I^I(S)can all conferences,");
              print("^M^J^I^Iset the (L)ast message pointer,");
              print("^M^J^I^I(Q)uit reading altogether,");
              print("^M^J^I^Ior read the next message (Enter).");
              pause();
              pointy = 0;
              read_next = 0;
             }
          }
       }

fclose(msgfile);
fclose(idxfile);
read = high_num;
fdelete(TMPFILE);
save_last_read(stoi(confnum));
if (quit > 0)
   return 1;
else
   return 0;
} 
///////////////////////////////////////////////////////////////////////////////
scan_msg( int start )
{
 int i, read_mess;
 str num[5], high[5], buf[1];

 pointy = 0;
 call_stat = call_stat | 64;

 if (!getarg1(buf, "YNQ"))
    {
     puts("Scan Conferences for messages (Enter=Quick)? ", "35;1");
     while (strchr("YNQ^M", 0, i = toupper(input(0))) == -1 && !(call_stat&8))
             ;                    // wait for key
     if (i == '^M')
         i = 'Q';
     puts_c(i);
     }
 else
    i = subchr(buf, 0);

 if (i == 'N')
    return;
 else if (i == 'Y')      // read messages ON
    read_mess = 1;

 num = confnum;

 for (i = start; i <= high_conf && !(call_stat&8);  ++i)
     {
      if (bitcheck(i, 0))
          if (get_conf(i, 1) > 0 && conf_stat&1)
             {
              itos(i, confnum);
              if (read_mess)
                 {
                  if (read_msg(1) == 0)
                      break;
                  }
              else
                 findlast(confnum, 1);
              if (nl() == 0)
                  break;
              }
      }
  confnum = "0";
  switch_conf(num, 0);
  pause();
}
///////////////////////////////////////////////////////////////////////////////
write_msg( str to, str subj, int type, int ref )
{
str things[25], temp1[25];
int k = 0, retval;

if (!to)
    input_strn("^M^J To whom do you address this message? ", things, 25, 0, 1);
else
    things = to;

if (!things || strcmpi(things, "all") == 0)
    {
    if (!things)
        puts(" A message to All.^M^J", "32;0");
    things = "All";
    }
make_nice(things);
if (!subj)
    input_strn(" What is its title? ", temp1, 25, 0, 1);
else
    temp1 = subj;

if (!temp1)
    return 0;

if (things == "All" && conf_stat&8)
   {
    puts("^M^JThis conference is for private messages.", "31;1");
    return 0;
    }
else if (things == "All")
    k = 0;
else if (type == 2)
   {
    if (!(conf_stat&8))
        k = yn('N', " Is this a private message");
    else
        k = 1;
    }
else k = 1;

if (call_stat&8)        // finished caller
    return -1;

puts("", "0");

cursor_onoff(1);
retval = calld("editor", current_caller, things, temp1, confnum, k,
         call_stat, timer_begin, confpath, ref);
if (!(sysbyte&16))
     screen();

status_line(-1);
return retval;
}
///////////////////////////////////////////////////////////////////////////////
// f //

// Switch_Conf

// conf_num  represents the number of the message base.
//
switch_conf( int conf_num, int log )
{
 int f;
 str s[12];

 if (conf_stat&1)      // if prev conf has messages
    save_last_read(stoi(confnum));

 if (conf_num < 1 || conf_num > high_conf || conf_num == stoi(confnum))
     return 0;

 if ((f = get_conf(conf_num, 1)) <= 0)     // load new conf
     {
      if (stoi(confnum) >= 1)
           get_conf(stoi(confnum), 1);
      return f;            // since switch failed 0 = not found, -1 = no access
      }

 itos(conf_num, confnum);  // update
 if (log)
    {
     ustamp("Joins conference ", 1, 0);
     ustamp(confnum, 0, 1);
                                        // load up first bulletin (NEWS file)
     if (GetObj(2, 1) && filetime(obj_path) > last_log)
        {
        delay(5);
        print("^M^J");
        call_stat = call_stat | 64;
        type_file(obj_path, 0, 1, 1);  // Send NEWS file (ASCII always)
        }
     }
 return 1;                          // allright! done!
}
///////////////////////////////////////////////////////////////////////////////


// *************************************************************************
// ************************ Modem Control Functions ************************
// *************************************************************************
// .mdm.

///////////////////////////////////////////////////////////////////////////////
determine_baud( )
{
 str baud_str[20];
 int stat, c, t1;
 int new_baud = 0, tmark;

 things = "Unable to determine baud!";
 if (!(call_stat&4))        // if not already_connected
    {
     track_free(0);                // clear all existing tracks
     t1 = track("CONNECT", 0);

     tmark = timer_start(30);      // wait up to 3 seconds for string

     while (!time_up(tmark))
      {
       if (!carrier())
          {
           track_free(0);            // clear all existing tracks
           return 0;
           }

       if (cinp_cnt())
          track_addchr(cgetc());

       stat = track_hit(0);

       if (stat == 0)
          continue;

       if (stat == t1)  // Found CONNECT
          {
           stat = 0;

           while((c = cgetc()) != '^M' && !time_up(tmark))
               {
               if (c > 0)
                  {
                  setchr(baud_str, stat, c);
                  ++stat;
                  }
               }
           break;                      // have baud rate, get out
           }
      }
      if (!baud_str)
         new_baud = 300;
      else
         {
          delchrs(baud_str, 0, 1); // remove space
          new_baud = stoi(baud_str);
          }

     track_free(0);              // clear all existing tracks
     }
 else
     new_baud = get_baud();

 if (new_baud < minbaud ||
    (set_cparams(new_baud, get_parity(), get_datab(), get_stopb()) == -1
    && !(sysbyte&1) ) )
    {
     print("Please call back at ");
     itos(minbaud, things);
     print(things);
     print(" baud.");
     kick_out();
     return 0;
     }

 conn_baud = new_baud;
 if (sysbyte&1)         // if locked
    set_cparams(baud, get_parity(), get_datab(), get_stopb());
 ustamp("Connect ", 1, 0);
 ustamp(Baud_Str, 0, 1);
 return 1;
}

///////////////////////////////////////////////////////////////////////////////
init_mdm( str init_str, int log )
{
  int retval = -1, c, t1;
// to be really efficient, we should count number of ^M in str, and wait for
// that number of OK's.

  flushbuf();
  cputs_tr(init_str);
  delay(5);

  t1 = track("OK", 0);

  while (cinp_cnt())
       {
        track_addchr(cgetc());
        if (track_hit(0) == t1)
           {
            retval = 1;
            delay(10);     // wait a while
            flushbuf();
            }
       }

if (retval == -1)
   prints("Modem init failure.");

 track_free(t1);
 }
///////////////////////////////////////////////////////////////////////////////

// *************************************************************************
// *************************** General Functions ***************************
// *************************************************************************

///////////////////////////////////////////////////////////////////////////////
era( int length, int color )
{
 str s[80];
 setchrs(s, 0, 8, length);

 if (color)
     puts(s, "36;1");
 else
     print(s);
}
///////////////////////////////////////////////////////////////////////////////
// Get_Next_Arg

// Description: Gets the next argument off the argument stack (Arg_List)
//              Which means that the next argument will be 'popped'

// Parameters: - dest: Destination string for the next argument

Get_Next_Arg( Str Dest )
{
 int x;

 if (!arg_list)
     {
     dest = "";
     return 0;
     }

 x = strchr(arg_list, 0, 32);

 if (x > strmaxlen(dest))       // can't do that
     {
      dest = "";
      return 0;
     }

 if (x == 0)
     {
      while (subchr(arg_list, 0) == 32)      // get rid of all spaces
           delchrs(arg_list, 0, 1);
      return get_next_arg(dest);        // a bit of recursing
      }
 else if (x == -1)
     {
      dest = arg_list;
      arg_list = "";
     }
 else if (x == strlen(arg_list) - 1)
      {
       delchrs(arg_list, strlen(arg_list)-1, 1);
       dest = arg_list;
       arg_list = "";
       }
 else
     {       
     substr(arg_list, 0, x, dest);
     delchrs(arg_list, 0, x+1);
     while (subchr(arg_list, 0) == 32)       // get rid of all spaces
         delchrs(arg_list, 0, 1);
     }
 return 1;
}
///////////////////////////////////////////////////////////////////////////////
GetArg1( str buf, str search )
{
int c;
c = toupper(subchr(arg_list, 0));

if (subchr(arg_list, 1) != 32 || strchr(search, 0, c) == -1 || c == 0)
    return 0;
else
   {
    setchr(buf, 0, c);
    delchrs(arg_list, 0, 2);
    }
return 1;
}
///////////////////////////////////////////////////////////////////////////////
load_opt( int option )
{
 if (option)
    {
     itos(option, things);
     pusharg(things);
     }
 return (option > 0);
}
///////////////////////////////////////////////////////////////////////////////
PushArg( str arg )
{
inschrs(" ", arg_list, 0, 1);
inschrs(arg, arg_list, 0, strlen(arg));
}
