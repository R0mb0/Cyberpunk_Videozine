// *************************************************************************
// ************************* Conference Functions **************************
// *************************************************************************
// .cf.

///////////////////////////////////////////////////////////////////////////////
// f //

// Get_Lvl

get_lvl( int num )
{
int c, zz;

str s[80], s1[10];

s = host_dir;
inschrs("LEVELS.DAT", s, strlen(s), 10);

c = openf(s, "r", 1);

fseek(c, (num-1)*2, 0);

zz = ctoi(2, c); // get offset of level

if (zz <= 0)
   {
    obj_name = "";
    ratio = 0;
    bytes = 0;
    fclose(c);
    return -1;
    }

fseek(c, zz, 0);  // go to that offset

// file format:New User                        s
// descr[30] time[2] bytes[4] ratio[1]

if (fread(obj_name, 30, c) < 30)
   {
    fclose(c);
    return -1;
   }
zz = ctoi(2, c)*600;

date(curtime(), s);
date(last_log, s1);

if (strcmpi(s1, s) != 0 || !last_log || sysbyte&2048)
   bytes = ctoi(4, c);
else
   ctoi(4, c);

ratio = fgetc(c);
fclose(c);
return zz;  // return time for this level
}
///////////////////////////////////////////////////////////////////////////////
// f //
// Prep

// Description: Prepares a string as a filename in the format nnn.ext

Prep( int num, str ext, str buf )
{
itos(num, buf);
inschrs("000", buf, 0, 3-strlen(buf));
inschrs(ext, buf, strlen(buf), strlen(ext));
}
///////////////////////////////////////////////////////////////////////////////
// f //
// GetObj
// Type = 1 File Dir
//        2 Text File
//        3 doors
// Num      Number of filedir/text/door

GetObj( int Type, int Num )
{
 int objf, objlen;
 str obj_fname[64];
 str param[10];

 objlen = 80;

 if (type == 1 && num <= high_dir)
    param = ".DIR";
 else if (type == 2 && num <= high_txt)
    param = ".TXT";
 else if (type == 3 && num <= high_door)
   {
    param = ".DOR";
    objlen = 131;
    }
 else
   {
    obj_path = "";
    return 0;
   }

 prep(stoi(confnum), param, obj_fname);
 inschrs(confpath, obj_fname, 0, strlen(confpath));

 objf = openf(obj_fname, "r", 1);

 if (objf == -1)
    {
     obj_path = "";
     return 0;
     }

 // type = 1 = dir
 // type = 2 = text
 // type = 3 = door
 // read 1 & 2 as same, only <do the right hops>, then door() for 3.

 fseek(objf, 317 + objlen*(num-1), 0);
 obj_name = "";

 if (fread(list1, objlen, objf) == objlen)
    {
     obj_lvl = subchr(list1, 0);
     obj_flag = subchr(list1, 1);
     subchrs(list1, 2, 30, obj_name);
     format(obj_name, 0);
     subchrs(list1, 32, 45, obj_path);
     format(obj_path, 0);
     if (type == 3)
         pos = subchr(list1, 127);
     }

 if (obj_lvl > access_level || obj_flag&flags != obj_flag || obj_name == "")
    {
     fclose(objf);
     obj_path = "";
     return 0;
     }

 fclose(objf);
 return (strlen(obj_name) > 0 && strlen(obj_path) > 1);

// - dir    [80]
// Level[1] Flag[1] Descr[30] Path[45] endbyte[1] [^M^J]
// - text files  [80]
// Level[1] Flag[1] Descr[30] Path[45] endbyte[1] [^M^J]
// - door  [131]
// Level[1] Flag[1] Descr[30] Path[45] endbyte[1] [^M^J]    -> 80
// Param[45] Time[2] Control[1] [1] [^M^J]                  -> 51
}
///////////////////////////////////////////////////////////////////////////////
list_obj( int type, int high )
{
 int i, corr;
 str s[12];

 prep(stoi(confnum), "", s);

 if (type == 1)
    inschrs("DIR", s, 0, 3);
 else if (type == 2)
    inschrs("TXT", s, 0, 3);
 else
    inschrs("DOR", s, 0, 3);

 call_stat = call_stat | 64;
 if (type_file(s, status&16, 0, 2) <= 0)
    {
     if (type == 1)
        title("File Directories");
     else if (type == 2)
        title("Text File Viewer");
     else
        title("Doors List");
 for (i = 1; i <= high/2 + high%2 && !(call_stat&8); ++i)  // Show all objects
     {
      if (getobj(type, i) > 0)
         {
          print("    ");
          itos(i, things);
          puts(things, "0;1");
          print(". ");
          format(obj_name, 30 - corr);
          puts(obj_name, "0");
          }

      if (i + high/2 + high%2 <= high && high/2 > 0)
          if (getobj(type, i + high/2 + high%2) > 0)
             {
              itos(i + high/2 + high%2, things);
              puts(things, "0;1");
              print(". ");
              puts(obj_name, "0");
             }

      if (nl() == 0)
          break;
      if (i >= 9)
         corr = 1;
      if (i >= 99)
         corr = 2;
      }
   }
}
///////////////////////////////////////////////////////////////////////////////
// f //

// Get_Conf

// Access Level[1] Flags[1] Conf_Status[1] ConfName[20] Path[45]
// FileDirNum[1] TextFileNum[1] DoorNum[1] MaxMsgs[2] MaxDays[1]
// MainMenu[1] reserved[2] Endbyte[1] Cr/Lf[2]

Get_Conf( int dir_num, int get_read )
{
int c, confrec;

if (dir_num < 1 || dir_num > high_conf)
    return 0;

newdir(host_dir);
c = openf("CONFS.DAT", "r", 1);

if (c <= 0)
   {
    fclose(c);
    confname = "";
    return 0;
    }

fseek(c, 80*(dir_num-1), 0);

if (fread(list1, 80, c) < 80)
    {
     confname = "";
     fclose(c);
     return 0;
     }
fclose(c);
conf_lvl = subchr(list1, 0);
conf_flag = subchr(list1, 1);
conf_stat = subchr(list1, 2);
subchrs(list1, 3, 20, confname);
subchrs(list1, 23, 45, confpath);
if (!confpath)
    confpath = host_dir;
high_dir = subchr(list1, 68);
high_txt = subchr(list1, 69);
high_door = subchr(list1, 70);

if (conf_lvl > access_level || (flags&conf_flag) != conf_flag ||
    (!bitcheck(dir_num, 1) && (conf_stat&2) ))
    {
     confname = "";
     return -1;
     }

if (conf_stat&1 && get_read)      // if this Conf has messages
     get_last_read(dir_num);

return (strlen(confname) > 0);
}
///////////////////////////////////////////////////////////////////////////////
list_conf( int check_extfile )
{
 int i, corr;
 puts("", "0");

 call_stat = call_stat | 64;
 if (check_extfile)
     if (type_file("CONFS", status&16, 0, 1) > 0)
        return;

     for (i = 1; i <= high_conf/2 + high_conf%2; ++i)
         {
          if (get_conf(i, 0) > 0)
             {
              itos(i, things);
              if (nl() == 0)
                  break;
              print("  ");
              if (bitcheck(i, 0))
                  print("*");
              else
                  print(" ");

              puts(things, "0");
              print(". ");
              format(confname, 20 - corr);
              print(confname);
              }
          if (i + high_conf/2 + high_conf%2 <= high_conf && high_conf/2 > 0)
              if (get_conf(i + high_conf/2 + high_conf%2, 0) > 0)
                 {
                  itos(i + high_conf/2 + high_conf%2, things);
                  print("  ");
                  if (bitcheck(i + high_conf/2 + high_conf%2, 0))
                      print("*");
                  else
                      print(" ");

                  puts(things, "0");
                  print(". ");
                  print(confname);
                 }
          if (i >= 9)
             corr = 1;
          }
      print("^M^J^J'*' indicates a scanned conference.");
}
///////////////////////////////////////////////////////////////////////////////
// 1 ext
// 2 List
// 3 extract
// 4 add
// 5 delete from
// 6 test

// Return values: 0 error
//                1 worked
//               -1 something not found
getarc( int command, str one, str two )
{
int f, x;
str ext[4];

if (one)
  fnstrip(one, 11, ext);

list1 = host_dir;
strcat(list1, "ARCS.CFG");

if ((f = openf(list1, "r", 1)) != -1)
   {
     if (command == 1)
        {
         fgets(defext, 4, f);
         fclose(f);
         return (strlen(defext)-4);
         }

     while (!feof(f))
         {
          if (fgets(list1, 80, f) > 0)
             {
              if (strcmpi(list1, ext) == 0)
                  {
                   for (x = 2; x <= command; ++x)
                        fgets(list1, 255, f);
                   fseek(f, 0, 2);      // got command, leave
                   fgetc(f);
                   }
              else
                  {                  // skip this arc definition
                   for (x = 1; x <= 5; ++x)
                        fgets(list1, 255, f);
                   }
               }
            else
                list1 = "";
          }
  fclose(f);
  }
else
   return -1;

if (!list1)
    {
    puts("^M^JUndefined archive format!^J", "0;32");
    return -1;
    }
things = list1;

list1 = one;
x = strlen(one);
setchr(list1, x, 1);

copystr(two, list1, x+1, strlen(two));
x = strlen(list1);
setchr(list1, x, 1);

params(things, 2);

if (command > 2)
   {
    substr(things, 0, strchr(things, 0, 32), list1);
    delchrs(things, 0, strchr(things, 0, 32)+1);
    x = run(list1, things, 0);
    }
else
    x = DOS(things, 0);

status_line(-1);
if (x > 0)
    x = 0;
else if (x < 0 && command == 6)
   {
    puts("^M^JFile could not be tested.", "0;32");
    x = -1;
   }
else
    x = 1;

return x;
}
