disptime( )
{
 str tim[8];
 date(curtime(), tim);
 pstraxy(tim, 7, 5, 7);
 time(curtime(), tim);
 delchrs(tim, strlen(tim)-3, 3);
 pstraxy(tim, 16, 5, 7);
}
///////////////////////////////////////////////////////////////////////////////
ClearDir( )
{
list1 = "*.*";
inschrs(temp_dir, list1, 0, strlen(temp_dir));

if (filefind(list1, 0))
	{
    inschrs("> NUL", list1, strlen(list1), 5);
    inschrs("ECHO Y | DEL ", list1, 0, 13);
    dos(list1, 0);
    status_line(-1);
	}
}
///////////////////////////////////////////////////////////////////////////////
Status_line( int opt )
{
 str tmp1[10];

 if (opt == 1)
HELP = "Alt-{A:Edit D:Display F:DOSFunc L:Cap O:Setup S:Sound X:Exit}  L:Local Q:Quick";
 else if (opt == 2)
    HELP = "Alt-{A:Edit E:Echo F:DOSFunc L:Cap H:HangUp X:Exit Y:Chat} ñ:ñLvl PgUp/Dn:ñ5min";
 else if (opt == 3)
    {
      HELP = "Lvl Baud Lastlog Time ";
      inspad(current_caller, 0, 26);
      itos(access_level, tmp1);
      inspad(tmp1, 30, 4);
      itos(conn_baud, tmp1);
      inspad(tmp1, 39, 7);
      date(last_log, tmp1);
      inspad(tmp1, 54, 9);
      itos((timer_begin - timer_total(tmark))/600, tmp1);
      inspad(tmp1, 68, 11);
   }
 else if (opt == 4)
    {
      HELP = "City: Bytes U: D: A: ";
      inspad(city, 5, 26);
      itos(bupld, tmp1);
      inspad(tmp1, 40, 10);
      itos(bdwnld, tmp1);
      inspad(tmp1, 53, 10);
      itos(bytes, tmp1);
      inspad(tmp1, 66, 10);
       }
 else if (opt == 0 && stat_line)
    {
     vputchrs(0, help_line, stat_line, 0, 80, stat_color);
     update_term();
     help = "";
     }
 if (help)
     vputchrs(0, help_line, HELP, 0, 80, stat_color);
}
///////////////////////////////////////////////////////////////////////////////
Inspad(str s, int pos, int len)
{
 str spaces[30];
 setchrs(spaces, 0, 32, 30);
 inschrs(spaces, help, pos, len - strlen(s));
 inschrs(s, help, pos, strlen(s));
}
///////////////////////////////////////////////////////////////////////////////
genpathfile( int option)
{
int x, f;

if ((f = openf("PATHS.LST", "w", 1)) > 0)
    {
    if (!(sysbyte&512) || access_level >= raw_level)
       {
        for (x = 1; x <= high_dir; ++x)
            {
            if (getobj(1, x))
                {
                 fwrite(obj_path, strlen(obj_path), f);
                 fwrite("^M^J", 2, f);
                 }
            }
         }
     fclose(f);
     }
else
    fdelete("PATHS.LST");
}
///////////////////////////////////////////////////////////////////////////////
RunScr( str script )
{
int retval;
status_line(0);
retval = calld(script);
_scr_chk_key = 0;
status_line(-1);
if (!(sysbyte&16))
    screen();
return retval;
}
///////////////////////////////////////////////////////////////////////////////
move( str start, str destd)
{
list1 = "COPY  ";
inschrs(start, list1, 5, strlen(start));
inschrs(destd, list1, strlen(list1), strlen(destd)-1);
dos(list1, 0);
status_line(-1);
fnstrip(start, 3, list1);
inschrs(destd, list1, 0, strlen(destd));
if (filefind(list1, 0))
    {
    fdelete(start);
    return 1;
    }
else
    {
     puts(ERROR, "31;1");
     return 0;
     }
}
///////////////////////////////////////////////////////////////////////////////
import_diz( str arcname )
{
int f, i, ctrlz;
// arcname -> complete path

if (getarc(2, arcname, "FILE_ID.DIZ") == 1)
    {
    if (f = openf("FILE_ID.DIZ", "r", 1))
       {
        i = 1;
        while ((fgets(things, 80, f) > 0) && i <= 10)
              {
              if ((ctrlz = strchr(things, 0, '^Z')) >= 0)
                  delchrs(things, ctrlz, 1);
              if (strlen(things) > 0)
                 {
                  if (i > 1)
                      strcat(listline, "^P");
                  setchr(things, 46, 0);
                  inschrs(things, listline, strlen(listline), strlen(things));
                  ++i;
                  }
              }
        }
      fclose(f);
      fdelete("FILE_ID.DIZ");
    }
}
