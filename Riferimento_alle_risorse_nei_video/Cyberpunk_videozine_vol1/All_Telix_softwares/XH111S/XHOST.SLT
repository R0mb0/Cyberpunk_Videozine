///////////////////////////////////////////////////////////////////////////////
// f //
// Params

// Procedure:
//            all parameters MUST be thrown into ONE large string, possibly
// LIST1, all separated by ^A (001).
//
params( str target, int num )
{
int x, pos = 0, old = 0, tpos = 0;
str nums[4];
for (x = 1; x <= num && old != -1; ++x)
     {
      itos(x, nums);
      inschrs("%", nums, 0, 1);
      pos = strchr(list1, old, 1);              // look for ^A
      if ( (tpos = strposi(target, nums, 0)) >= 0)
         {
          substr(list1, old, pos - old, temp);
          delchrs(target, tpos, strlen(nums));
          inschrs(temp, target, tpos, strlen(temp));
          }
      old = pos+1;
      }
}
///////////////////////////////////////////////////////////////////////////////
nl( )
{
int char;
str buf[1];
print("^M^J");
++pointy;
if (pointy < page_length-1 || !page_length)
    return 1;
pointy = 0;
if (!(call_stat&64))
   return 1;

if (!getarg1(buf, "YNC"))
    {
     puts("More? (Y)es, (n)o, (c)ontinuous: ", "0");
     while (strchr("YNC^M", 0, char = toupper(input(0))) == -1 && !(call_stat&8) )
             ;                    // wait for key
     }

else
    char = subchr(buf, 0);

if (char != '^M')
   puts_c(char);
era(34, 0);
if (char == 'N')
    return 0;
else if (char == 'C')
     call_stat = call_stat^64;
return 1;
}
///////////////////////////////////////////////////////////////////////////////
// f //

// BitCheck

// Check one of the bitmaps for TRUE/FALSE value

// parameters:  confn: number of conference to check
//              map:   bitmap to check (0 = scans, 1 = registrations)

// bitmaps is composed of the two maps, scans and registrations. The former
// occupies bytes 0-4, while the latter takes up bytes 5-9.

bitcheck( int confn, int map )
{
int checker = 1, x;
for (x = 1; x <= (confn-1)%8; ++x)
    checker = checker*2;

return ((subchr(bitmaps, map*5 + (confn-1)/8)&checker) == checker);
}
///////////////////////////////////////////////////////////////////////////////
emsg( int type )
{
puts("^M^J^G", "31;1");
if (type == 1)
   {
   ustamp("*Unable to open transfer log file!*", 1, 1);
   print("Uploads cannot proceed due to system error!");
   }
else if (type == 3)
    print("You can't do that.");
else if (type == 4)
    print("Off you go!");
else if (type == 5)
    print("This file is already available.");
else if (type == 6)
    print("That is not available.");
else if (type == 7)
    print("Transfer aborted!");
else if (type == 8)
    {
    print("Your time is up for today.");
    ustamp("*Time is up!*", 1, 1);
    }
else if (type == 9)
    ustamp("Carrier lost, transfer aborted", 1, 1);
else if (type == 10)
    print("Please use at least 10 characters.");
print("^M^J");
}
