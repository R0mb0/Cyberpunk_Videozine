 int save;
 save = strchr(current_caller, 0, 32);
 if (save == -1)
    save = strlen(current_caller);

 substr(current_caller, 0, save, things);
 ustamp("Chat initiated", 1, 1);
 save = timer_total(tmark);  // save his time .. let's be nice
 puts("^G^M^JHey ", "0");
 puts(things, "0;1");
 puts(", this is ", "0");
 puts(sysop_name, "32;1");
 puts("...^M^J", "0");
 chatmode(1);
 things = "Chat ended.";
 puts(things, "0;32");
 setchr(things, strlen(things)-1, 0);
 timer_begin = timer_begin - save;
 timer_restart(tmark, timer_begin);
 ustamp(things, 1, 1);
}

