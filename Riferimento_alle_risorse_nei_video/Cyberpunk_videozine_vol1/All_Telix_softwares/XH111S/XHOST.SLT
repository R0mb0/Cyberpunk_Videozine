 cursor_onoff(0);
 clear_scr();
 box(1, 3, 78, 18, 1, 0, 7);
 pstraxy(version, 40-strlen(version)/2, 1, 15);
 pstraxy("by Andras Pattantyus", 30, 2, 7);
 pstraxy("Ä´ System Status ÃÄ", 4, 3, 7);

 // 1 = startup_time          [4]
 // 2 = # of Calls since 1    [4]
 // 3 = Total # of Calls      [4]
 // 4 = Start of Last Call    [4]
 // 5 = End of Last Call      [4]
 // 6 = Last Call Status      [1]
 // 7 = Last Caller           [25]
 // [46]

 if (call_stat&128)
	pstraxy("Waiting for Call", 23, 5, 7);
 else
	pstraxy("Call in Progress", 23, 5, 7);

 time(startup_time, time_);
 date(startup_time, date_);

 pstraxy("Startup at: ", 7, 7, 7);
 pstra(date_, 7);
 pstra(", ", 7);
 pstra(time_, 7);
 pstraxy("Calls Since: ", 7, 8, 7);
 itos(callsi, time_);
 pstra(time_, 7);

 if (last_start)
    {
     time(last_start, time_);
     date(last_start, date_);
     }
 else
     {
      date_ = "";
      time_ = "Never";
      Current_Caller = "None";
      }
 pstraxy("Last/Current Caller: ", 7, 9, 7);
 pstra(current_caller, 7);
 pstraxy("At: ", 7, 10, 7);
 pstra(time_, 7);
 if (date_)
    {
     pstra(", ", 7);
     pstra(date_, 7);
     }
 pstraxy("Duration: ", 7, 11, 7);
 pstraxy("Sound: ", 7, 13, 7);
 pstraxy("Display: ", 7, 14, 7);
 pstraxy("Direct Connect: ", 7, 15, 7);
 pstraxy("Locked Rate: ", 7, 16, 7);
 vars();
}
