//////////////////////////////////////////////////////////////////////////////
//   S E T U P  0 . 0  -  For XHost                                       //
//   Configures the XHost script                                          //
//   by Andras Pattantyus...                                                 //
///////////////////////////////////////////////////////////////////////////////

str xhost_name[64],
    bbs_name[20],                 // BBS name
    temp_dir[64],
    host_dir[64],
    sysop_name[25],
    system_pass[12],
    protkeys[18],
    protdata[18],
    busystr[10],
    minbaud[6],

    confname[20],
    confpath[45],
    conf_lvl[3],
    confnum[3],

    obj_lvl[3],
    obj_flag[8],
    obj_name[30],
    obj_path[45],
    flags[8],

    chat1[2],
    chat0[2],

    params[45],
    control[8],

    ratio[3],
    bytes[9],                   // for things read off .DATs

    levels[2],

    first[80],     //Ä¿
    second[80],    // ³
    third[80],     // ³ Global vars to be eliminated
    fourth[80],    // ³
                   // ³
    temp[64],      // ³
    temp2[64],     //ÄÙ
                   
    tim[3];

str index[510];

int high_dir, high_txt, high_door, high_conf, high, maxmsgs, maxdays;
  // markers for last message base, file base, text file

str stat_save[80];
int stat_color, help_line;
int conf_stat,
    menu,
    sysbyte;

///////////////////////////////////////////////////////////////////////////////

main()
{
 int old_b, old_baud;
 
 _scr_chk_key = 0;
 
 old_baud = get_baud();
 old_b = _back_color;
 
 _back_color = 0;
 
 update_term();
 clear_scr();
 gethelpline();
 if (help_line != -1)
    {
     vgetchrs(0, help_line, stat_save, 0, 80);
     gotoxy(0, help_line);
     stat_color = vgetchr()/256;
     }
 if(read_config(xhost_name) != -1)
  {
  if (ask_syspass() == 1)
      setup(xhost_name);
  }
 pstraxy("Exiting XHost Setup.", 0, 23, 7);
 gotoxy(0, 23);   
 _back_color = old_b;
 update_term();
 cursor_onoff(1);
 set_cparams(old_baud, get_parity(), get_datab(), get_stopb());
 _scr_chk_key = 1;
}
///////////////////////////////////////////////////////////////////////////////

setup( str host_name)
{
 int key, screen1;
 
while(key != 27)
{
 draw_menu(0, 25, 5, 55, 17, 30, " XHost Setup ", 29);
 cursor_onoff(1);
 pstraxy(" ", 46, 16, 31);
 gotoxy(46, 16);
 
 key = -1;
 while(strchr("12345678^027", 0, key) == -1)
       key = inkeyw();
  
 vputchr(key+6912);

 if (key == '1')
    system();
 else if (key == '2')
    options();
 else if (key == '3')
    modem();
 else if (key == '4')
    conf();
 else if (key == '5')
    user();
 else if (key == '6')
    protos();
 else if (key == '7')
    menus();
 else if (key == '8')
   {
    save(host_name);
    key = 27;
    }
 stat_line(0);
 if (host_dir)
     newdir(host_dir);
 }
}
///////////////////////////////////////////////////////////////////////////////
system( )
{
 int pos, key, x;
 clear_scr();
 draw_menu(1, 34, 4, 64, 13, 127, " Paths & Names ", 112);
while(key != 27)
     {
     pstraxy(" ", 56, 12, 112);
     gotoxy(56, 12);
 
     cursor_onoff(1);
     key = -1;

     stat_line(0);
     while(strchr("12345^027", 0, key) == -1)
          key = inkeyw();

     vputchr(key+28672);

     cursor_onoff(0);

      stat_line(5);
      if (key == '1')
         {
          ed(second, 64, host_dir, " XHost Directory ");
          if (second)
             {
              strupper(second);
              if ( verify(second, 0))
                  host_dir = second;
              }
          }
      else if (key == '2')
         {
          ed(second, 64, temp_dir, " Temporary Directory ");
          if (second)
             {
              strupper(second);
              if (verify(second, 0))
                  temp_dir = second;
              }
           }
     else if (key == '3')
         ed(sysop_name, 25, sysop_name, " SysOp's Name ");
     else if (key == '4')
         ed(bbs_name, 20, bbs_name, " System Name ");
     else if (key == '5')
         {
          ed(system_pass, 12, system_pass, " System Password ");
          strupper(system_pass);
          }
   }
 stat_line(0);
}
///////////////////////////////////////////////////////////////////////////////
options( )
{
 int c, edity = 5, key, pos;
 str chaton[2], chatoff[2];

 chaton = chat1;
 chatoff = chat0;

 cursor_onoff(0);
 clear_scr();
 stat_line(6);

 box(20, 4, 54, 18, 1, 0, 127);
 pstraxy(" Options ", 33, 4, 126);
 pstraxy("Capture All Calls", 22, 5, 112);
 pstraxy("Closed System", 22, 6, 112);
 pstraxy("Monitor Call Progress", 22, 7, 112);
 pstraxy("Exit Telix after Call", 22, 8, 112);
 pstraxy("Lock Sound ON", 22, 9, 112);
 pstraxy("Lock Sound OFF", 22, 10, 112);
 pstraxy("Allow Aliases", 22, 11, 112);
 pstraxy("Do NOT Use File Lists", 22, 12, 112);
 pstraxy("Do NOT Test Uploads", 22, 13, 112);
 pstraxy("Do NOT keep User Records", 22, 14, 112);
 pstraxy("Use FILE_ID.DIZ files", 22, 15, 112);
 pstraxy("Sound Hours      On at:    :00", 22, 16, 112);
 pstraxy("Off at:    :00", 38, 17, 112);

 dispopt();

 while(c != -1)
   {
   cursor_onoff(1);
   if (edity <= 17)
	   vputchrs(21, edity, "", 0, 1, 112);

   if (edity <= 15)
	  {
	  gotoxy(50, edity);
      key = yn('Y', 7);

      if (key == 1 || key == 0)
         {
          pos = power2(edity - 3);
          sysbyte = sysbyte & (16777215 - pos);     // reset that bit
          sysbyte = sysbyte | (pos * key);
          c = 0;
          }
      else
          c = key;
      }
   else if (edity == 16)
           {
            c = edit_string(chaton, 47, 16, 2, 127);
            if (stoi(chaton) == 0)
                chaton = "00";
            if (stoi(chaton) > 24)
               {
                chaton = chat1;
                pstraxy(chaton, 47, 16, 127);
                }
            }
   else if (edity == 17)
           {
            c = edit_string(chatoff, 47, 17, 2, 127);
            if (stoi(chatoff) == 0)
                chatoff = "00";
            if (stoi(chatoff) > 24)
               {
                chatoff = chat0;
                pstraxy(chatoff, 47, 17, 127);
                }
            }

   if (edity <= 17)
      vputchrs(21, edity, " ", 0, 1, 112);

   if (c == 3)
     ++edity;
   else if (c == 2)
     --edity;

   if (edity < 5)
      edity = 17;
   if (edity > 17)
	  edity = 5;
   }

 chat1 = chaton;
 chat0 = chatoff;
}
///////////////////////////////////////////////////////////////////////////////
modem( )
{
int c, x, z, edity = 7;

 cursor_onoff(0);
 clear_scr();
 stat_line(5);

 box(38, 5, 65, 11, 1, 0, 127);
 pstraxy(" Modem Config ", 45, 5, 126);

 pstraxy("Minimum Baud", 41, 7, 112);
 pstraxy("Lock Rate?", 41, 8, 112);
 pstraxy("Null Modem?", 41, 9, 112);
 pstraxy("Busy String", 41, 10, 112);
 
 pstraxy(minbaud, 54, 7, 127);
 pstraxy(busystr, 54, 10, 127);

 second = "No";
 third = "No";

 if (sysbyte&1)          // locked rate
    second = "Yes";
 if (sysbyte&2)         // direct connects
    third = "Yes";

 vputchrs(54, 8, second, 0, strlen(second), 128-strlen(second)*2);
 vputchrs(54, 9, third, 0, strlen(third), 128-strlen(third)*2);

  while(c > -1)
   {
   if (edity <= 10)
       vputchrs(39, edity, "", 0, 1, 112);

   if (edity == 7)
          {
           first = minbaud;
           c = edit_string(minbaud, 54, 7, 6, 127);
           if (set_cparams(stoi(minbaud), 0, 8, 1) == -1)
               {
                setchrs(minbaud, 0, 0, 6);
                minbaud = first;
                vputchrs(54, 7, minbaud, 0, 6, 127);
                }
           }
   else if (edity == 8 || edity == 9)
           {
           gotoxy(54, edity);
           cursor_onoff(1);
           c = yn('N', 7);
           if (edity == 9)
              x = 2;
           else
              x = 1;
           if (c == 1 || c == 0)
               {
                sysbyte = sysbyte&(4095-x);      // turn bit off
                sysbyte = sysbyte | (c * x);    // OR to set
                c = 0;
               }
           cursor_onoff(0);
           }
   else if (edity == 10)
           c = edit_string(busystr, 54, 10, 10, 127);

  if (edity <= 10)
     vputchrs(39, edity, " ", 0, 1, 112);

   if (c == 3)
     ++edity;
   else if (c == 2)
     --edity;
   if (edity < 7)
      edity = 10;
   if (edity > 10)
      edity = 7;
   }
}
///////////////////////////////////////////////////////////////////////////////
conf( )
{
 int confer = 1, key, edity, video, editx;
 str tempx[64];

 cursor_onoff(0);

 if (!check_hd())
     return;
 clear_scr();
 box(21, 10, 75, 22, 1, 0, 93);

 pstraxy(" Conferences ", 42, 10, 95);

 pstraxy("Conf", 23, 11, 94);

 pstraxy("Name", 23, 13, 94);

 pstraxy("Level", 23, 14, 94);

 pstraxy("Flags", 23, 15, 94);

 pstraxy("Path", 23, 16, 94);

 pstraxy("Messages      Number       Days", 23, 17, 94);   // toggle on/off

 pstraxy("Private", 23, 18, 94);   // toggle on/off

 pstraxy("Files", 23, 19, 94);      // <C/R> to edit 'em

 pstraxy("Text Files", 23, 20, 94);  // <C/R> to edit 'em

 pstraxy("Doors", 23, 21, 94);  // <C/R> to edit 'em

 if (confer <= high_conf)
     disp_conf(confer);

 editx = 0;
while(confer != 0)
 {
 stat_line(1);
 cursor_onoff(0);
 key = 0;
 while(key == 0)
      key = inkeyw();

 if (key == 27)
    {
     confer = 0;
     continue;
     }
 else if (key == 13)
     {
      stat_line(2);
      first = confname;
      third = conf_lvl;
      second = flags;
      fourth = confpath;

      key = 0;
      edity = 13;

      while(key > -1)
        {
         if (edity <= 21)
             vputchrs(22, edity, "", 0, 1, 80);

         if (edity == 13)
             key = edit_string(first, 29, 13, 19, 80);
         else if (edity == 14)
             key = edit_string(third, 29, 14, 3, 80);
         else if (edity == 15)
             key = edit_string(second, 29, 15, 8, 80);
         else if (edity == 16)
             {
             key = edit_string(fourth, 29, 16, 45, 80);
             if (verify(fourth, 0))
                {
                 confpath = fourth;
                 strupper(fourth);
                 }
             }
         else if (edity == 17)
                 {
                 if (editx == 0)
                    {
                      cursor_onoff(1);
                      gotoxy(32, 17);
                      key = yn('Y', 5);

                      if (key == 1 || key == 0)
                         {
                         conf_stat = conf_stat & 254;
                         conf_stat = conf_stat | key;
                         key = 0;
                         }
                     }
                  else if (editx == 1)
                      {
                      itos(maxmsgs, temp);
                      key = edit_string(temp, 44, 17, 5, 80);
                      maxmsgs = stoi(temp);
                      }
                  else
                      {
                      itos(maxdays, temp);
                      key = edit_string(temp, 55, 17, 3, 80);
                      maxdays = stoi(temp);
                      }
                   }
         else if (edity == 18)
                 {
                  cursor_onoff(1);
                  gotoxy(32, 18);
                  key = yn('N', 5);
                  if (key == 1 || key == 0)
                     {
                     conf_stat = conf_stat & 253;
                     conf_stat = conf_stat | (2*key);
                     key = 0;
                     }
                  }
        else if ((edity == 19 || edity == 20 || edity == 21) && strlen(confpath))
                {
                cursor_onoff(0);
                vputchrs(34, edity, "(Enter) to edit", 0, 15, 80);
                key = inkeyw();
                setchrs(tempx, 0, 0, 15);
                vputchrs(34, edity, tempx, 0, 15, 80);
                if (key == 13)
                   {
                     temp = first;
                     temp2 = third;
                     tempx = second;
                     video = vsavearea(3, 8, 78, 16);
                     objects(confer, edity-18);
                     stat_line(2);
                     vrstrarea(video);
                     first = temp;
                     third = temp2;
                     second = tempx;
                    }
                 else if (key == 18432)
                     key = 2;
                 else if (key == 15360)     // save
                     key = -2;
                 else if (key == 27)
                     key = -1;
                 else
                     key = 3;
                }

       if (edity <= 21)
          vputchrs(22, edity, " ", 0, 1, 80);

        if (key == 3)
           {
            if (edity == 17 && editx < 2)
               ++editx;
            else
               ++edity;
            }
        else if (key == 2)
           {
           if (edity == 17 && editx > 0)
              --editx;
           else
              --edity;
            }

        if (edity < 13)
          {
           edity = 21;
           editx = 2;
           }
        if (edity > 21)
           {
           edity = 13;
           editx = 0;
           }
         }

     if (key == -2)
        {
         if (!first)
            {
             confname = "";
             confpath = "";
             conf_lvl = "1";
             setchrs(flags, 0, '0', 8);
             }
          else
            {
             confname = first;

             key = stoi(third);

             if (key >= 0 && key <= 255)
                itos(stoi(third), conf_lvl);     //get rid of junk
             else
                conf_lvl = "1";
             checkbs(second);
             flags = second;
             }
            save_conf(confer);
           }
       }
 else if (key == 7680)  // Alt-A to edit Confs.Dat
         {
          newdir(host_dir);
          cursor_onoff(1);
          run(_editor, "CONFS.DAT", 0);
          cursor_onoff(0);
          high_conf = FindHighConf();
          if (confer > high_conf)
             confer = high_conf;
          }
 else if (key == 21248)          // Delete conference
         {
          confname = "";
          save_conf(confer);
          }
 else if (key == 20736) // PgDn
       {
        if (confer > 1)
            --confer;
        }
 else if (key == '+' || key == 20011) // New Conference
      {
       if (high_conf < 40)
          ++high_conf;
       confer = high_conf;
       }
 else if (key == 18688) // PgUp
    {
     if (confer < high_conf)
         ++confer;
     }
 else if (key == 33792)  // Ctrl-PgUp
     {
      if (confer == high_conf)
         continue;
      else if (confer <= high_conf-10)
         confer = confer + 10;
      else
         confer = high_conf;
     }
 else if (key == 30208)  // Ctrl-PgDn
       {
        if (confer <= 1)
            continue;
        else if (confer > 10)
            confer = confer - 10;
        else
            confer = 1;
       }
  else
      continue;

  if (confer <= high_conf)
      disp_conf(confer);
  }
}
///////////////////////////////////////////////////////////////////////////////
objects( int conf_num, int type)
{
 int dir = 1, key, screen, i;

 str comline[127], temp1[12];
 cursor_onoff(0);

 if (!check_hd())
     return;

 itos(conf_num, confnum);
 if (type == 1)
    high = high_dir;
 else if (type == 2)
    high = high_txt;
 else if (type == 3)
    high = high_door;
 draw_screen(type, dir);

while(key != 27)
{
 stat_line(3);
 key = inkeyw();
 
if (key == 13 && dir <= high)
    {
     if (type == 3)
         vputchrs(6, 15, "Alt-O: More Door Options", 0, 24, 22);
     first = obj_name;
     second = obj_path;
     third = obj_lvl;
     fourth = obj_flag;

     if (edit_loop(12, 12, 12, 12, 29, 44, 3, 8) == -2)
        {
         if (!second || !first)
            {
             second = "";
             obj_name = "";
             obj_path = "";
             obj_lvl = "1";
             setchrs(obj_flag, 0, '0', 8);
             saveobj(type, dir);
             if (dir <= high)
                 disp_dir(type, dir);
            }

          if (type == 1)
             {
              if (!verify(second, 0))
                 {
                   if (dir <= high)
                       disp_dir(type, dir);
                   second = "";
                 }
              }
          else if (type == 2)
             {
              if (just_filename(second))
                  inschrs(confpath, second, 0, strlen(confpath));
              }

          if (second)
             {
              obj_path = second;
              obj_name = first;

              key = stoi(third);

              if (key >= 1 && key <= 255)
                 itos(stoi(third), obj_lvl);     //get rid of junk
              else
                  obj_lvl = "1";
              checkbs(fourth);
              obj_flag = fourth;

              if (type == 3)
                 {
                  if (stoi(tim) >= 0)
                     itos(stoi(tim), tim);     //get rid of junk
                  }
              saveobj(type, dir);
              }
          }
       if (type == 3)
          vputchrs(6, 15, "Alt-O: More Door Options", 0, 24, 30);
       cursor_onoff(0);
      }

 else if (key == '+' || key == 20011)          // Add dir
         {
         if (high < 255)
            {
             ++high;
             obj_name = "New!";
             if (type == 1)
                obj_path = _down_dir;
             else if (type == 2)
                obj_path = confpath;
             else if (type == 3)
                obj_path = _telix_dir;

             obj_lvl = "1";
             tim = "15";
             params = "";
             setchrs(control, 0, '0', 8);
             setchrs(obj_flag, 0, '0', 8);
             saveobj(type, high);
             dir = high;
            }
          }

 else if (key == 21248)          // Erase object
         {
          if (dir <= high)
            {
             obj_name = "";
             obj_path = "";
             saveobj(type, dir);
             --dir;
             if (dir < 1)
                dir = 0;
             disp_dir(type, dir);
             }
          continue;
          }
 else if (key == 6144 && type == 3)  // Alt-O for Doors
       {
         box(3, 8, 77, 15, 1, 1, 30);
         box(6, 11, 76, 14, 0, 0, 30);

         box(3, 1, 66, 6, 1, 0, 30);
         pstraxy(" Help on Status Flags ", 25, 1, 31);
         pstraxy("Flag order: 12345678  Status: 1 = On, 0 = Off", 15, 2, 23);
         pstraxy("1: Script       2: ANSI Req'd  3: DOOR.SYS   4: DORINFO1.DEF", 5, 4, 23);
         pstraxy("5: PCBOARD.SYS  6: CVT-1.SLC   7: CVT-2.SLC  8: CVT-3.SLC", 5, 5, 23);

         pstraxy(" More on Doors ", 34, 8, 29);

         pstraxy(obj_name, 12, 9, 31);

         pstraxy("Params", 6, 11, 31);
         pstraxy("Time", 6, 12, 31);
         pstraxy("Status", 6, 13, 31);
         first = params;
         second = tim;
         third = control;
         pstraxy(first, 13, 11, 23);
         pstraxy(second, 13, 12, 23);
         pstraxy(third, 13, 13, 23);

         if (edit_loop(13, 13, 13, 0, 44, 3, 8) == -2)
             {
               params = first;
               key = stoi(second);
               if (key >= 0 && key <= 999)
                   itos(stoi(second), tim);
               checkBS(third);
               control = third;
              }
          saveobj(type, dir);
          cursor_onoff(0);
          delay(15);
          box(3, 1, 66, 6, 1, 0, 0);
          draw_screen(type, dir);
          }
 else if (key == 7680)  // Alt-A to edit nnn.ttt
         {
          getext(comline, type);
          newdir(confpath);
          prep(conf_num, comline, temp1);
          cursor_onoff(1);
          run(_editor, temp1, 0);
          cursor_onoff(0);
          high = FindHigh(conf_num, type);
          if (dir > high)
             dir = high;
          }
 else if (key == 5120)  // Alt-T to edit Text Files
         {
           second = obj_path;

           if (!fnstrip(second, 3))      // if !(filename & extension)
                continue;

           if (strchr(second, 0, 46) == -1 && !filefind(second, 0))
               strcat(second, ".ASC");

            cursor_onoff(1);         // A restored cursor is helpful
            run(_editor, second, 0);
            cursor_onoff(0);
            if (dir <= high)
                disp_dir(type, dir);
            continue;
           }
 else if (key == 20736) // PgDn
       {
        if (dir > 1)
            --dir;
        }
 else if (key == 18688) // PgUp
    {
     if (dir < high)
         ++dir;
   }
 else if (key == 33792)  // Ctrl-PgUp
     {
      if (dir == high)
         continue;
      else if (dir <= high-10)
         dir = dir + 10;
      else
         dir = high;
     }
 else if (key == 30208)  // Ctrl-PgDn
       {
        if (dir <= 1)
            continue;
        else if (dir > 10)
            dir = dir - 10;
        else
            dir = 1;
       }
  else
      continue;

  if (dir <= high)
      disp_dir(type, dir);
  }

 if (type == 1)
     high_dir = high;
 else if (type == 2)
     high_txt = high;
 else if (type == 3)
     high_door = high;
}
///////////////////////////////////////////////////////////////////////////////
user( )
{
 int key, i;
 int dir = 1;

 cursor_onoff(0);

 if (!check_hd())
     return;

 if (!filefind("LEVELS.DAT", 0))
     create();

while(key != 27)
{
 draw_menu(2, 10, 7, 46, 14, 112, " User Setup ", 127);
 stat_line(0);
 cursor_onoff(1);
 pstraxy(" ", 29, 13, 112);
 gotoxy(29, 13);

 key = -1;
 while (strchr("123^027", 0, key) == -1)
        key = inkeyw();
  
 cursor_onoff(0);
 vputchr(key+32512);

 if (key == '1')
	{
	 box(3, 8, 45, 15, 1, 0, 30);

	 pstraxy(" Edit Levels ", 18, 8, 29);
	 pstraxy("Lvl ", 6, 9, 30);
	 itos(dir, second);
	 if (strlen(second) == 1)
		 inschrs(" ", second, 1, 1);
	 pstraxy(second, 10, 9, 31);
	 pstraxy("Name", 6, 11, 31);
	 pstraxy("Time", 6, 12, 31);
	 pstraxy("Bytes", 6, 13, 31);
	 pstraxy("Ratio", 6, 14, 31);

	 dir = 1;

	 get_lvl(dir);

	 while(key != 0)
		 {
		  stat_line(4);
		  cursor_onoff(0);
		  disp_lvl(dir);
		  key = 0;

		  while (!key)
			 key = toupper(inkeyw());

		  if (key == 27)
			  key = 0;
		  else if (key == 13)
			 {
			  first = obj_name;
			  second = tim;
			  third = bytes;
			  fourth = ratio;
              if(edit_loop(12, 12, 12, 12, 29, 3, 9, 3) == -2)
				{
				  if (!first)
					 {
					  obj_name = "";
					  tim = "0";
					  bytes = "0";
					  ratio = "1";
					 }
				   else
					  {
					   obj_name = first;
					   i = stoi(second);
                       if (i >= 0 && i <= 999)
                           itos(i, tim);
					   i = stoi(third);
					   if (i >= 0)
                         itos(i, bytes);
					   i = stoi(fourth);
					   if (i >= 0 && i <= 255)
                          itos(i, ratio);
						}
				  save_lvl(dir);
				  }
		   }
		  else if (key == 18176)   // Home
			   {
			   if (dir != 1)
				  {
				   dir = 1;
				   get_lvl(dir);
				   }
			   }
		  else if (key == 20224)   // End
			   {
			   if (dir != 255)
				  {
				   dir = 255;
				   get_lvl(dir);
				  }
				continue;
			   }

		  else if (key == 20736)
			{
			if (dir > 1)
			   {
				--dir;
				get_lvl(dir);
				}
			 }
		  else if (key == 18688)
			  {
			   if (dir < 255)
				  {
				   ++dir;
				   get_lvl(dir);
				   }
			  }
		  else if (key == 20992 && dir > 0) 	   // Insert level
				  {
				   obj_name = "User";
				   tim = "0";
				   bytes = "0";
				   ratio = "1";
				   key = fopen("LEVELS.DAT", "r+");
				   fseek(key, 508, 0);
				   i = ctoi(2, key);		// inserted level takes space of level
											// being 'pushed' out.
				   fseek(key, (dir-1)*2, 0);
				   fread(index, (255-dir)*2, key);
				   fseek(key, (dir-1)*2, 0);
				   itoc(i, 2, key);
				   fwrite(index, (255-dir)*2, key);
				   fclose(key);
				   key = 1;
				   save_lvl(dir);
				   }
		  else if (key == 21248)		  // Delete level
				  {
				   key = fopen("LEVELS.DAT", "r+");
				   fseek(key, 2 * dir, 0);
				   fread(index, (255-dir)*2, key);
				   fseek(key, (dir-1)*2, 0);
				   fwrite(index, (255-dir)*2, key);
				   fputc(0, key);
				   fputc(0, key);
				   fclose(key);
				   key = 1;
				   get_lvl(dir);
				  }
		  else if (key == 33792)  // Ctrl-PgUp
			  {
				if (dir == 255)
					continue;
				else if (dir <= 245)
					dir = dir + 10;
				else
					dir = 255;
				get_lvl(dir);
				}
		  else if (key == 30208)  // Ctrl-PgDn
			   {
				if (dir == 1)
					continue;
				else if (dir > 10)
					dir = dir - 10;
				else
					dir = 1;
				get_lvl(dir);
			   }
		}
  }
else if (key == '2' || key == '3')
    {
	  itos(subchr(levels, key-50), second);
	  ed(second, 3, second, "Enter the Level");
	  if (second)
		 {
		 if (stoi(second) <= 255 && stoi(second) > 0)
			 setchr(levels, key-50, stoi(second));
		  }
     }
   }
}
///////////////////////////////////////////////////////////////////////////////
protos( )
{
 int c, edity = 5, editx, key, pos;

 cursor_onoff(0);
 box(4, 0, 19, 23, 1, 0, 112);
  pstraxy("K     B  E  B", 6, 1, 112);
  pstraxy("e  O  a  x  i", 6, 2, 112);
  pstraxy("y  n  t  t  m", 6, 3, 112);
pstraxy("ÃÄÄÁÄÄÁÄÄÁÄÄÁÄÄ´", 4, 4, 112);

 disp_prot();   // show all
 editx = 6;
 edity = 5;

 while(c != -1)
   {
   cursor_onoff(1);

   if (edity <= 22)
       vputchrs(5, edity, "", 0, 1, 112);

// edity == protocol, editx == option

   gotoxy(editx, edity);

// key is at x = 6

   if (editx == 6)
      {
      key = toupper(inkeyw());

      if (key <= 255 && key >= 33)
         {// search for duplicate
         c = subchr(protkeys, edity-5);
         setchr(protkeys, edity-5, '^A');
         if (strchr(protkeys, 0, key) >= 0)
            {
             tone(659, 14);
             setchr(protkeys, edity-5, c);
             }
         else
            {
             setchr(protkeys, edity-5, toupper(key));
             vputchr(toupper(key) + 28672);
             }
          c = 0;
         }
      else
         {
          if (key == 19200)
             c = -4;
          else if (key == 19712)
             c = 4;
          else if (key == 27)
             c = -1;
          else if (key == 18432)
             c = 2;
          else if (key == 20480)
             c = 3;
          }
      }
   else
      {
       if (editx <= 9 || strchr("XYZ1GSETMKAC ", 0, subchr(protkeys, edity-5))
            == -1)
           {
           key = ynp('Y');

           if (key == 1 || key == 0)
              {
               pos = power2((editx - 9)/3);
               c = subchr(protdata, edity - 5);
               c = c & (255 - pos);     // reset that bit
               c = c | (pos * key);
               setchr(protdata, edity-5, c);
               c = 0;
              }
           else
               c = key;
           }
        else c = -4;
        }

   if (edity <= 22)
      vputchrs(5, edity, " ", 0, 1, 112);

   if (c == 3)
      ++edity;
   else if (c == 2)
      --edity;
   else if (c == 4)
      editx = editx + 3;
   else if (c == -4)
      editx = editx - 3;

   if (editx < 6)
       editx = 18;
   if (editx > 18)
       editx = 6;

   if (edity < 5)
      edity = 22;
   if (edity > 22)
      edity = 5;
   }
}
///////////////////////////////////////////////////////////////////////////////
menus( )
{
int key, editx = 0, edity = 1, c, x2;
str mkey[1], cmd[3], opt[3];
menu = 0;

if (!check_hd())
     return;

if ((menu = pickmenu()) == -1)
    return;

pstraxy("Key Lvl Flags    Cmd Opt ³ Key Lvl Flags    Cmd Opt ", 0, 0, 112);
load_menudef(menu);
disp_menu();
if (menu == 256)
    obj_name = "Global Commands";
stat_line(8);
cursor_onoff(0);

while (menu > -1)
    {
      if (edity <= 23)
          vputchrs(editx, edity, "", 0, 0, 112);

      key = inkeyw();

      if (key == 13)        // edit
         {
          // key = 1, lvl = 4, flags = 7, Cmd = 16, Opt = 20;
          // + 23 for next row;
          c = 0;
          x2 = (editx/27) * 110 + (edity - 1) * 5;

          setchr(mkey, 0, subchr(index, x2+2));
          itos(subchr(index, x2), obj_lvl);
          itobs(subchr(index, x2+1), obj_flag);
          itos(subchr(index, x2+3), cmd);
          itos(subchr(index, x2+4), opt);


          x2 = 1;
          while (c > -1)
                {
                if (x2 == 1)
                    c = edit_string(mkey, editx+1, edity, 1, 112);
                else if (x2 == 2)
                    c = edit_string(obj_lvl, editx+4, edity, 3, 112);
                else if (x2 == 3)
                    c = edit_string(obj_flag, editx+8, edity, 8, 112);
                else if (x2 == 4)
                    c = edit_string(cmd, editx+17, edity, 3, 112);
                else if (x2 == 5)
                    c = edit_string(opt, editx+21, edity, 3, 112);

               if (c == 1 || c == 3)
                  ++x2;
               else if (c == 2)
                  --x2;

               if (x2 < 1)
                   x2 = 5;
               if (x2 > 5)
                   x2 = 1;
               }
            // gotta save here...

          x2 = (editx/27) * 110 + (edity - 1) * 5;
          setchr(index, x2, stoi(obj_lvl));
          setchr(index, x2+1, bstoi(obj_flag));
          setchr(index, x2+2, subchr(mkey, 0));
          setchr(index, x2+3, stoi(cmd));
          setchr(index, x2+4, stoi(opt));
          cursor_onoff(0);
         }
      else if (key == 19200)    // left
         c = -4;
      else if (key == 19712)   // right
         c = 4;
      else if (key == 27)      // ESCape
         menu = -1;
      else if (key == 18432)   // Up
         c = 2;
      else if (key == 20480)   // Down
         c = 3;
      else if (key == 15360)   // Save
        {
          save_menudef(menu);
          c = 0;
          }

      else if (key == 11776)  // Alt-C  Clear Menu
         {
          index = "";
          disp_menu();
          c = 0;
          editx = 0;
          edity = 1;
          }
                              // Alt-P  Pick Menu 6400
      else if (key == 6400)   // Pick
          {
          if ((c = pickmenu()) >= 0)
             {
              menu = c;
              load_menudef(menu);
              disp_menu();
              if (menu == 256)
                  obj_name = "Global Commands";
              stat_line(8);
              cursor_onoff(0);
              editx = 0;
              edity = 1;
              }
           c = 0;
          }
                              // Alt-N  Name      12544
       else if (key == 12544)
          {
          edit_string(obj_name, 11, help_line, 25, stat_color);
          gotoxy(editx, edity);
          cursor_onoff(0);
          c = 0;
          }

   if (edity <= 23)
      vputchrs(editx, edity, " ", 0, 0, 112);

   if (c == 3)
      ++edity;
   else if (c == 2)
      --edity;
   else if (c == 4)
      editx = editx + 27;
   else if (c == -4)
      editx = editx - 27;

   if (editx < 0)
       editx = 27;
   if (editx > 27)
       editx = 0;
   if (edity < 1)
      edity = 27;
   if (edity > 23)
      edity = 1;
   }
}
///////////////////////////////////////////////////////////////////////////////
pickmenu( )
{
str input[3];
int mnu;
cursor_onoff(1);
stat_line(7);
mnu = -2;
while (mnu == -2)
    {
    if (getsxy(input, 3, 13, help_line, stat_color) == -1)
        mnu = -1;
    else if (!input)
        listmenus();
    else if (toupper(subchr(input, 0)) == 'G')        // global menu
        mnu = 256;
    else
        mnu = stoi(input);
    }
cursor_onoff(0);
return mnu;
}
