///////////////////////////////////////////////////////////////////////////////
save_menudef( int mnu )
{
int x, fudge, end;
if (mnu == 256)
    end = 19;
// parse menu list,  delete all null keys
for (x = 0; x <= end; ++x)       // 50 commands in all
    {
    if (subchr(index, (x - fudge) * 5 + 2) == 0)
       {
       delchrs(index, (x - fudge) * 5, 5);
       ++fudge;
       }
    }
int mfile;
newdir(host_dir);
if ((mfile = fopen("MENU.DEF", "r+")) > 0)
    {
    if (mnu < 256)
        {
        fseek(mfile, mnu * 255 + 100, 0);
        fwrite(obj_name, 25, mfile);
        fwrite(index, 230, mfile);
        }
    else
        fwrite(index, 100, mfile);
    }
fclose(mfile);
}
///////////////////////////////////////////////////////////////////////////////
load_menudef( int mnu )
{
int mfile, pos, x;
str name[12];
newdir(host_dir);

if ((mfile = fopen("MENU.DEF", "r")) > 0)
    {
    if (mnu < 256)
       {
       fseek(mfile, mnu*255 + 100, 0);
       if (fread(obj_name, 25, mfile) == 25)
            fread(index, 230, mfile);
       }
    else fread(index, 100, mfile);
    }
fclose(mfile);
}
///////////////////////////////////////////////////////////////////////////////
disp_menu( )
{
str dispstr[23] = "                       ", temp[8];
int x = 0;

 box(0, 1, 51, 23, 0, 0, 112);
 while (x <= 225 && subchr(index, x+2) > 0)
    {
    setchr(dispstr, 0, subchr(index, x+2));

    itos(subchr(index, x), temp);
    copychrs(temp, dispstr, 3, strlen(temp));

    itobs(subchr(index, x+1), temp);
    copychrs(temp, dispstr, 7, 8);

    itos(subchr(index, x+3), temp);
    copychrs(temp, dispstr, 16, strlen(temp));

    itos(subchr(index, x+4), temp);
    copychrs(temp, dispstr, 20, strlen(temp));

    if (x <= 110)
       vputchrs(1, x/5 + 1, dispstr, 0, 23, 112);
    else
       vputchrs(24, (x - 110)/5, dispstr, 0, 23, 112);
    setchrs(dispstr, 0, 32, 23);
    x = x + 5;
    }
}
///////////////////////////////////////////////////////////////////////////////
disp_prot( )
{
int x, dat, i;

str disp[13];

setchrs(disp, 0, 32, 33);

for (x = 0; x <= 17; ++x)
    {
     setchr(disp, 0, subchr(protkeys, x));
     dat = subchr(protdata, x);

     for (i = 3; i <= 12; i = i+3)
         setchr(disp, i, 'N');

     if (dat&1)
        setchr(disp, 3, 'Y');
     if (dat&2)
        setchr(disp, 6, 'Y');
     if (dat&4)
        setchr(disp, 9, 'Y');
     if (dat&8)
        setchr(disp, 12, 'Y');
     vputchrs(6, x+5, disp, 0, 13, 112);
    }
}

///////////////////////////////////////////////////////////////////////////////

save( str host_name)
{
 int x, host_handle, screen;
  
 if ((host_handle = fopen(host_name, "r+")) <= 0)
      {
       second =  "Can't open ";
       strcat(second, host_name);
       strcat(second, ".");
       status_wind(second, 10);
       fclose(host_handle);
       return -1;
      }
  cursor_onoff(0);
  pstraxy("Saving...", 0, 23, 7);

  fseek(host_handle, 15, 0);
  format(host_dir);
  fwrite(host_dir, 64, host_handle);

  fseek(host_handle, 82, 0);
  format(bbs_name);
  fwrite(bbs_name, 20, host_handle);

  fseek(host_handle, 105, 0);
  format(system_pass);
  fwrite(system_pass, 12, Host_handle);

  fseek(host_handle, 120, 0);
  format(sysop_name);
  fwrite(sysop_name, 25, host_handle);

  fseek(host_handle, 148, 0);
  format(temp_dir);
  fwrite(temp_dir, 64, host_handle);

  fseek(host_handle, 214, 0);
  for (x = 0 ; x <= 1; ++x)
   {
   fputc(subchr(levels, x), host_handle);
   fseek(host_handle, 4, 1);
   }

  itoc(high_conf, 4, host_handle);
  fseek(host_handle, 1, 1);

  itoc(stoi(chat1), 4, host_handle);
  fseek(host_handle, 1, 1);

  itoc(stoi(chat0), 4, host_handle);
  fseek(host_handle, 1, 1);

  itoc(sysbyte, 4, host_handle);
  fseek(host_handle, 1, 1);

  itoc(stoi(minbaud), 4, host_handle);

  fseek(host_handle, 275, 0);

  fwrite(protkeys, 18, host_handle);

  fseek(host_handle, 3, 1);

  fwrite(protdata, 18, host_handle);

  fseek(host_handle, 3, 1);
  while((x = strchr(busystr, 0, '|')) >= 0)
       setchr(busystr, x, '^M');

  fwrite(busystr, 10, host_handle);
  fclose(host_handle);
  fnstrip(host_name, 12, first);
  strcat(first, "ADD.SLC");
  if ((host_handle = fopen(first, "r+")) > 0)
     {
    //15 81
     fseek(host_handle, 15, 0);
     fwrite(host_dir, 64, host_handle);
     fseek(host_handle, 81, 0);
     fputc((sysbyte&4096)/4096, host_handle);
     }
  fclose(host_handle);

  vrstrarea(screen);
  pstraxy("Configuration saved...", 0, 22, 7);

 }
///////////////////////////////////////////////////////////////////////////////
read_config( str host_name)
{
 int c, x, host_handle;

 if (!host_name || !filefind(host_name, 0))
  {
   host_name = _script_dir;
   if (subchr(_script_dir, strlen(_script_dir)-1) != '\')
       setchr(_script_dir, strlen(_script_dir), '\');
   strcat(host_name, "XHOST.SLC");
   strupper(host_name);
   }
   
  box(6, 10, 74, 12, 1, 0, 27);
  
  pstraxy(" File to Update ", 32, 10, 30);
  pstraxy(host_name, 8, 11, 23);
  c = edit_string(host_name, 8, 11, 64, 23);
  if (c == -1)
      return -1;

  strupper(host_name);

  if (!filefind(host_name, 0))
     {
      status_wind("File not found.", 10);
      gotoxy(0, 23);
      return -1;
     }
  else
    {
     if (_script_dir)
         newdir(_script_dir);
     if (x = fopen("SETUP.SLC", "r+"))  // update
      {
       fseek(x, 15, 0);
       fputs(host_name, x);
       fputc(0, x);
       }   
     fclose(x);
     }

 host_handle = fopen(host_name, "r");
 
 if (!host_handle || ferror(host_handle))
   {
    status_wind("Unable to open file.", 10);
    fclose(host_handle);
    return -1;
    } 
    
  cursor_onoff(0);
  
  pstraxy("Loading...", 0, 23, 7);
    
  fseek(host_handle, 15, 0);
  fread(host_dir, 64, host_handle);

  fseek(host_handle, 82, 0);
  fread(bbs_name, 20, host_handle);

  fseek(host_handle, 105, 0);
  fread(system_pass, 12, host_handle);

  fseek(host_handle, 120, 0);
  fread(sysop_name, 25, host_handle);

  fseek(host_handle, 148, 0);
  fread(temp_dir, 64, host_handle);

  fseek(host_handle, 214, 0);

  for (x = 0 ; x <= 1; ++x)
      {
       setchr(levels, x, fgetc(host_handle));
       fseek(host_handle, 4, 1);
       }

  high_conf = ctoi(4, host_handle);

  fseek(host_handle, 1, 1);

  itos(ctoi(4, host_handle), chat1);

  fseek(host_handle, 1, 1);

  itos(ctoi(4, host_handle), chat0);

  inschrs("00", chat1, 0, 2-strlen(chat1));
  inschrs("00", chat0, 0, 2-strlen(chat0));

  fseek(host_handle, 1, 1);

  sysbyte = ctoi(4, host_handle);

  fseek(host_handle, 1, 1);
  itos(ctoi(4, host_handle), minbaud);

  fseek(host_handle, 275, 0);
  fread(protkeys, 18, host_handle);
  fseek(host_handle, 3, 1);

  fread(protdata, 18, host_handle);

  fseek(host_handle, 3, 1);
  fread(busystr, 10, host_handle);
  while((x = strchr(busystr, 0, '^M')) >= 0)
       setchr(busystr, x, '|');
  fclose(host_handle);

  if (host_dir)
     newdir(host_dir);
}  

///////////////////////////////////////////////////////////////////////////////

ask_syspass()
{
 clear_scr();
 
 if (system_pass)
    {
   box (17, 10, 62, 12, 1, 0, 27);
   
   pstraxy(" System Password Check ", 28, 10, 31);
   cursor_onoff(1);
   getsxy(first, 16, 19, 11, 17);
   if (strcmpi(first, system_pass) != 0)
      {
       pstraxy("Access has been denied!", 0, 22, 7);
       return -1;
       }
   else pstraxy("Access has been achieved.", 0, 22, 7);
    }
   return 1;
}
///////////////////////////////////////////////////////////////////////////////

format( str string)
{
  while(subchr(string, strlen(string)-1) == 32)
     delchrs(string, strlen(string)-1, 1);
}
///////////////////////////////////////////////////////////////////////////////

yn( int def, int b_color)
{
int c = -1;

int UP = 18432, 
    DOWN = 20480;

while(strchr("YN^027^013", 0, c) == -1 && c != UP && c != DOWN)
      c = toupper(inkeyw());

if (c == 27)
   return -1;
else if (c == 13)
    c = def;
if (c == 'Y')
  {
   pstraxy("Yes", getx(), gety(), b_color*16+10);
   return 1;
  }
else if (c == 'N')
   {
   pstraxy("No ", getx(), gety(), b_color*16+12);
   return 0;
   }
else if (c == UP)
     return 2;
else if (c == 15360)
     return -2;
else return 3;
}    
///////////////////////////////////////////////////////////////////////////////


edit_string( str String, int X, int Y, int Length, int Color)
{

int scrn;

int UP = 18432, 
    DOWN = 20480, 
    HOME = 18176, 
    END = 20224,
    LEFT = 19200, 
    RIGHT = 19712,
    F2 = 15360,
    EDIT = 9, 
    HELP = 15104, 
    EXIT = 27;
    
 str Backup[80], // backup of string to edit.
     Temp[80];

 int X2,        // current x.pos of cursor
     Char,      // the char from keyboard
     Ins = 0,   // insert mode toggle
     EndX,      // pos of last character
     TempX = 0, // temporary spaces at end of string
     RetVal = 0;
 
 X2 = X;
 gotoxy(X2, Y);
 EndX = X+strlen(String);
 if (Length < strlen(String))
   setchr(String, length-1, 0);
 Backup = String;
 setchrs(String, strlen(String), 0, length-strlen(String));
 vputchrs(X, Y, String, 0, length, color);

 cursor_onoff(1);
 
 while(retval == 0)
  {
  Char = inkeyw();

  if (Char == 8)       // BackSpace
    {
     if (TempX)
        {
          --TempX;
          --X2;
          }
     else if (X2 > X)
        {
         Temp =  "";
         vgetchrs(X2, Y, Temp, 0, Endx-X2);
         vputchrs(X2-1, Y, Temp, 0, Endx-X2+1, color);
         --X2;
         --EndX;
         }
     gotoxy(X2, Y);
     continue;
     }
     
 if (Char == 21248)     // Delete char
     {
       if (!TempX && X2 < Endx)
            {
             vgetchrs(X2+1, Y, Temp, 0, Endx-X2-1);
             setchr(temp, endx-x2-1, 0);
             vputchrs(X2, Y, Temp, 0, Endx-X2, color);
              --EndX;
              gotoxy(X2, Y);
             }
      continue;
      }
  
  if (Char > 31 && Char < 256)
     {
       if (Ins && X2 < EndX && x2 < X+Length-1)
         {
          Temp =  "";
          vgetchrs(X2, Y, Temp, 0, Endx-X2);
          if (Endx <= X+Length-1)
              vputchrs(X2+1, Y, Temp, 0, Endx-x2, color);
          else
              vputchrs(X2+1, Y, Temp, 0, Endx-x2-1, color);

          }
        vputchr(Char+color*256);

        if (Char == 32)  // if space
            {
             if (X2 < EndX)
                 {
                  if (Ins)
                     ++EndX;
                  }
             else if (X2 == EndX-1 && !Ins)
                  {
                  --EndX;
                  Tempx = 1;
                  }
             else if (X2 < X+Length-1)
                  ++TempX;

             if (X2 < X+Length-1)
                  ++X2;

             if (EndX > X+Length)
               EndX = X+Length;

             gotoxy(X2, Y);
             continue;
             }

         if (X2 >= EndX || (Ins && EndX < X+Length))
            {
             if (TempX)  // if we were past the end of string
              {
               EndX = EndX+TempX;  // add the amount we were past by
               TempX = 0;          // reset amount
               }
             ++EndX;          // Move end pointer
             }

          if (EndX > X+Length)
              EndX = X+Length;
          if (X2 < X+Length-1)
              ++X2;
         gotoxy(X2, Y);
         continue;
        }

  if (Char == LEFT)
     {
      if (X2 > X)
         {
          --X2;
          if (TempX)
            --TempX;
          gotoxy(X2, Y);
          }
       else
           retval = 2;
      continue;
      }
      
  if (Char == RIGHT)
    {
      if (X2 < X+Length-1)
         {
          ++X2;
          if (X2 > EndX)
             ++TempX;
          gotoxy(X2, Y);
         }
       else
         retval = 1;
     continue;
     }

  if (Char == END)
      {
       if (X2 == EndX || Endx == X)
          continue;
       X2 = EndX;
       if (X2 > X+Length-1)
         --X2;
       TempX = 0;
       gotoxy(X2, Y);
       continue;
       }

  if (Char == HOME)
     {
      X2 = X;
      tempX = 0;
      gotoxy(X2, Y);
      continue;
      }

  if (Char == 13 || Char == UP || Char == DOWN || Char == F2)
    {
     String = "";
     vgetchrs(X, Y, String, 0, EndX-X);
     setchr(String, EndX-X, 0);
     if (Char == 13 || Char == DOWN)
        retval = 3;
     if (Char == UP)
        retval = 2;
     if (char == F2)
        retval = -2;        // save on exit
     continue;
     }

  if (Char == 29952)    // Ctrl-End
    {
    if (!TempX)
     {
      setchrs(Temp, 0, 0, Length);
      vputchrs(X2, Y, temp, 0, EndX-X2, color);
      EndX = X2;
      gotoxy(X2, Y);
      }
     continue;
     }

  if (Char == EXIT)  // exit
     {
      String = Backup;
      retval = -1;              // don't save on exit
      continue;
      }

  if (Char == 30464)    // Ctrl-Home
     {
      EndX = strlen(Backup)+X;
      String = Backup;
      setchrs(String, strlen(String), 0, Length-strlen(String));
      vputchrs(X, Y, String, 0, Length, color);
      X2 = X;
      TempX = 0;
      gotoxy(X2, Y);
      continue;
     }

  if (Char == 20992)   // Toggles insert
     {
      Ins = !Ins;
      continue;
      }

  if (Char == HELP)   // HELP!!!
     {
      cursor_onoff(0);

      scrn = vsavearea(19, 3, 62, 21);

      box(19, 3, 61, 20, 2, 0, 127);

      pstraxy(" Help ", 37, 3, 124);

      pstraxy("Editing functions:", 21, 4, 112);

      pstraxy("Use   and  ", 21, 6, 112);
      pstraxy("^[", 25, 6, 122);
      pstraxy("^Z", 31, 6, 122);
      pstraxy("to move along the line.", 33, 6, 112);

      pstraxy("Home", 21, 7, 122);
      pstraxy("goes to the start of the line.", 26, 7, 112);

      pstraxy("End", 21, 8, 122);
      pstraxy("goes to the end of the line.", 25, 8, 112);

      pstraxy("Use  ,   and", 21, 9, 112);
      pstraxy("^X", 25, 9, 122);
      pstraxy("^Y", 28, 9, 122);
      pstraxy("^QÙ", 34, 9, 122);

      pstraxy("to change lines, ", 37, 9, 112);
      pstraxy("or to save and exit.", 26, 10, 112);

      pstraxy("Escape", 21, 11, 122);
      pstraxy("exits using the default string.", 28, 11, 112);

      pstraxy("Backspace", 21, 12, 122);
      pstraxy("erases the previous character", 31, 12, 112);
      pstraxy("on the line.", 26, 13, 112);

      pstraxy("Delete", 21, 14, 122);
      pstraxy("erases the current character.", 28, 14, 112);

      pstraxy("Control-Home", 21, 15, 122);
      pstraxy("restarts the line with the", 34, 15, 112);
      pstraxy("default string.", 26, 16, 112);

      pstraxy("Control-End", 21, 17, 122);
      pstraxy("deletes from the current", 33, 17, 112);
      pstraxy("character to the end of the line.", 26, 18, 112);

      pstraxy("Insert", 21, 19, 122);
      pstraxy("toggles insert mode.", 28, 19, 112);
      inkeyw();
      vrstrarea(scrn);
      cursor_onoff(1);
      }
   }
   if (retval > 0)
     {
      String = "";
      vgetchrs(X, Y, String, 0, EndX-X);
      setchr(String, EndX-X, 0);
      }
 format(string);
 return retval;
}
///////////////////////////////////////////////////////////////////////////////
disp_dir( int type, int dir)
{
 str temp[45];
 itos(dir, temp);
 inschrs("  ", temp, strlen(temp), 3-strlen(temp));
 pstraxy(temp, 9, 9, 31);

 itos(high, temp);
 pstraxy(temp, 19, 8, 31);
 if (dir >= 1)
     getobj(type, dir);
 else
     {
     obj_name = "";
     obj_path = "";
     obj_lvl = "";
     setchrs(obj_flag, 0, '0', 8);
     }

 setchrs(temp, 0, 32, 64);
 pstraxy(obj_name, 12, 11, 23);
 vputchrs(12+strlen(obj_name), 11, temp, 0, 30-strlen(obj_name), 23);
 strupper(obj_path);
 pstraxy(obj_path, 12, 12, 23);
 vputchrs(12+strlen(obj_path), 12, temp, 0, 45-strlen(obj_path), 23);
 pstraxy(obj_lvl, 12, 13, 23);
 setchr(temp, 2, 0);
 pstraxy(temp, 12+strlen(obj_lvl), 13, 23);
 pstraxy(obj_flag, 12, 14, 23);
}
///////////////////////////////////////////////////////////////////////////////
create()
{
int f;
str s[30];
f = fopen("LEVELS.DAT", "w");
setchrs(index, 0, 0, 510);
setchr(index, 0, 254);
setchr(index, 1, 1);
fwrite(index, 510, f);            // simply create index
s = "New User";
fwrite(s, 30, f);            // add on one record (new user)
itoc(15, 2, f);              // it is the only one explicitly referenced
itoc(0, 4, f);               // by xHost
fputc(1, f);
fclose(f);
}
///////////////////////////////////////////////////////////////////////////////
verify( str dir, int runs)
{
 int screen, ret;
 str s[64];
 s = dir;

 if(subchr(dir, strlen(dir)-1) == '\')
    delchrs(dir, strlen(dir)-1, 1);

 if (newdir(dir) == 0 && runs == 0)
     {
      fnstrip(s, 14, s);
      screen = vsavearea(16, 10, 64, 13);
      box(16, 10, 63, 12, 1, 0, 28);
      pstraxy(" Warning! ", 35, 10, 157);

      if (s == dir)
          {
          pstraxy("That drive doesn't exist!", 27, 11, 31);
          vrstrarea(screen);
          return 0;
          }

      pstraxy("That directory doesn't exist. Create it? ", 18, 11, 31);
      cursor_onoff(1);

      if (yn('Y', 1) == 1)
         {
          s = "md ";
          strcat(s, dir);
          dos(s, 0);
          delchrs(s, 0, 3);
          strcat(dir, "\");
          ret = verify(s, 1);
          }

      cursor_onoff(0);
      vrstrarea(screen);
      return ret;
      }
  else if (runs == 1 && !newdir(dir))
         return 0;
  strcat(dir, "\");
  return 1;
 }
///////////////////////////////////////////////////////////////////////////////

get_lvl(int num)
{
int c, zz;

str s[64], temp[37];

s = host_dir;
inschrs("LEVELS.DAT", s, strlen(s), 10);

c = fopen(s, "r");

fseek(c, (num-1)*2, 0);

zz = ctoi(2, c); // get offset of level

if (zz <= 0)
   {
    obj_name = "";
    ratio = "1";
    bytes = "0";
    tim = "0";
    fclose(c);
    return;
    }

fseek(c, zz, 0);  // go to that offset
// file format:New User                        s
// descr[30] time[2] bytes[4] ratio[1]

if (fread(temp, 37, c) < 37)
   {
    fclose(c);
    return -1;
   }
fclose(c);

subchrs(temp, 0, 30, obj_name);
itos(get_int(temp, 30, 2), tim);
itos(get_int(temp, 32, 4), bytes);
itos(subchr(temp, 36), ratio);
}
///////////////////////////////////////////////////////////////////////////////

disp_lvl( int dir)
{
 str temp[30];
 itos(dir, temp);
 inschrs("  ", temp, strlen(temp), 3-strlen(temp));
 pstraxy(temp, 10, 9, 31);

 pstraxy(obj_name, 12, 11, 23);
 setchrs(temp, 0, 32, 30);
 vputchrs(12+strlen(obj_name), 11, temp, 0, 30-strlen(obj_name), 23);

 pstraxy(tim, 12, 12, 23);
 vputchrs(12+strlen(tim), 12, temp, 0, 3-strlen(tim), 23);

 pstraxy(bytes, 12, 13, 23);
 vputchrs(12+strlen(bytes), 13, temp, 0, 9-strlen(bytes), 23);

 pstraxy(ratio, 12, 14, 23);
 setchr(temp, 3, 0);
 pstraxy(temp, 12+strlen(ratio), 14, 23);
}
///////////////////////////////////////////////////////////////////////////////

save_lvl( int num)
{
int c, zz;

str s[64], temp[37];

s = host_dir;
inschrs("LEVELS.DAT", s, strlen(s), 10);

c = fopen(s, "r+");

fseek(c, (num-1)*2, 0);

zz = ctoi(2, c); // get offset of level

if (zz <= 0)
   {
    fseek(c, 0, 2);
    zz = ftell(c);
    fseek(c, (num-1)*2, 0);
    itoc(zz, 2, c);          // Save offset to file
    fclose(c);
    c = fopen(s, "a");
    }

fseek(c, zz, 0);  // go to that offset

// file format: New User                        s
// descr[30] time[2] byte[4] ratio[1]

copychrs(obj_name, temp, 0, 30);
put_int(stoi(tim), temp, 30, 2);
put_int(stoi(bytes), temp, 32, 4);
setchr(temp, 36, stoi(ratio));
fwrite(temp, 37, c);
fclose(c);
return;         // return time for this level
}

///////////////////////////////////////////////////////////////////////////////

ctoi(int num, int fcb)
{
 str buf[4];
 fread(buf, num, fcb);
 return (get_int(buf, 0, num));
}
///////////////////////////////////////////////////////////////////////////////

itoc( int src, int num, int file)
{
 str digits[4];
 int i, ma, mz, my;

if (num == 4)
  mz = 16777216;
else
  mz = 256;

 my = src;

 for (ma = 1; ma <= num; ++ma)
   {
    i = my/mz;
    setchr(digits, num-ma, i);
    my = my%mz;
    mz = mz/256;
    }
 fwrite(digits, num, file);
 return;
}
///////////////////////////////////////////////////////////////////////////////

just_filename(str filespec)
{
   if (strpos(filespec, ":", 0) != -1)
       return 0;
   if (strpos(filespec, "\", 0) != -1)
       return 0;
   if (strpos(filespec, "/", 0) != -1)
       return 0;

   return 1;
}
///////////////////////////////////////////////////////////////////////////////

edit_loop( int x1, int x2, int x3, int x4, int l1, int l2, int l3, int l4)
 {
  int val = 0, next = 1;

  stat_line(2);

  while(val > -1)
     {
      if (next == 1)
          val = edit_string(first, x1, 11, l1, 23);
      else if (next == 2)
         {
          val = edit_string(second, x2, 12, l2, 23);
          strupper(second);
          }
      else if (next == 3)
           val = edit_string(third, x3, 13, L3, 23);
      else if (next == 4 && x4)
          {
           val = edit_string(fourth, x4, 14, L4, 23);
           if (val == 3)
               val = -2;
           }
      else if (next == 4 && !x4)
              {
               if (val == 2)
                  next = 3;
               else
                  next = 1;
               }
// 3 down  2 up

      next = next + val*2 - 5;
      if (next <= 0)
          next = 4;
      if (next > 4 || (next > 3 && !x4))
          next = 1;
     }
   return val;
 }
///////////////////////////////////////////////////////////////////////////////
save_conf( int dir_num)
{
int c, x;

if (dir_num <= 0 || dir_num > 40)
    return 0;

newdir(host_dir);

c = fopen("CONFS.DAT",  "r+");

if (c <= 0)
   {
    fclose(c);
    c = fopen("CONFS.DAT", "w");
    }

fseek(c, 0, 2);

if (80*(dir_num - 1) >= ftell(c))
   {
    fclose(c);
    c = fopen("CONFS.DAT",  "a");
    }
fseek(c, 80*(dir_num-1), 0);

fputc(stoi(conf_lvl), c);
bstoc(flags, c);
fputc(conf_stat, c);
fwrite(confname, 20, c);
fwrite(confpath, 45, c);
fputc(high_dir, c);
fputc(high_txt, c);
fputc(high_door, c);
itoc(maxmsgs, 2, c);
fputc(maxdays, c);
fwrite(temp, 3, c);
fwrite("^001^M^J", 3, c);
fclose(c);
if (dir_num > high_conf)
    high_conf = dir_num;
return;
}
///////////////////////////////////////////////////////////////////////////////
Get_Conf( int dir_num )
{
int c;
str temp[80];

if (dir_num < 1 || dir_num > high_conf)
    return 0;

newdir(host_dir);

c = fopen("CONFS.DAT",  "r");

if (c <= 0)
   {
    fclose(c);
    confname = "";
    return 0;
    }

fseek(c, 80*(dir_num-1), 0);

if (fread(temp, 80, c) == 80)
    {
    itos(subchr(temp, 0), conf_lvl);
    itobs(subchr(temp, 1), flags);
    conf_stat = subchr(temp, 2);
    subchrs(temp, 3, 20, confname);
    subchrs(temp, 23, 45, confpath);
    if (!confpath)
        confpath = host_dir;
    high_dir = subchr(temp, 68);
    high_txt = subchr(temp, 69);
    high_door = subchr(temp, 70);
    maxmsgs = get_int(temp, 71, 2);
    maxdays = subchr(temp, 73);
    }
else
    confname = "";

fclose(c);
if (ConfName)
  return 1;
return 0;
}
///////////////////////////////////////////////////////////////////////////////
disp_conf( int num )
{
 str tmp[45];

 if (!get_conf(num) && num > 0)
    {
     confname = "Empty";
     conf_lvl = "1";
     confpath = host_dir;
     setchrs(flags, 0, '0', 8);
     conf_stat = 1;     // messages ON
     high_dir = 0;
     high_txt = 0;
     high_door = 0;
     maxmsgs = 0;
     maxdays = 0;
    }
 else if (num <= 0)
     return 0;

 itos(num, tmp);
 inschrs("  ", tmp, 0, 3-strlen(tmp));
 pstraxy(tmp, 28, 11, 95);

 setchrs(temp, 0, 32, 30);

 pstraxy(confname, 29, 13, 80);
 vputchrs(29+strlen(confname), 13, temp, 0, 20-strlen(confname), 80);

 pstraxy(conf_lvl, 29, 14, 80);
 vputchrs(29+strlen(conf_lvl), 14, temp, 0, 3-strlen(conf_lvl), 80);

 pstraxy(flags, 29, 15, 80);

 pstraxy(confpath, 29, 16, 80);
 vputchrs(29+strlen(confpath), 16, temp, 0, 45-strlen(confpath), 80);

 second = "No";
 if (conf_stat&1)        // Messages on/off
     second = "Yes";

 vputchrs(34, 17, " ", 0, 1, 95);
 vputchrs(32, 17, second, 0, strlen(second), 96-strlen(second)*2);

 itos(maxmsgs, tmp);

 pstraxy(tmp, 44, 17, 80);
 vputchrs(44+strlen(tmp), 17, "     ", 0, 5-strlen(tmp), 80);

 itos(maxdays, tmp);
 pstraxy(tmp, 55, 17, 80);
 vputchrs(55+strlen(tmp), 17, "   ", 0, 3-strlen(tmp), 80);

 second = "No";
 if (conf_stat&2)        // Private yes/no
     second = "Yes";

 vputchrs(34, 18, " ", 0, 1, 95);
 vputchrs(32, 18, second, 0, strlen(second), 96-strlen(second)*2);
}
