     pstraxy("3.   Level to access any path", 13, 11, 127);
     pstraxy("Which option? ", 15, 13, 117);
     }
}
///////////////////////////////////////////////////////////////////////////////
FindHigh(int conf, int Type)
{
int x, f, reclen;
str fname[12], dump[4];
getext(dump, type);
prep(conf, dump, fname);
newdir(confpath);

if (type == 3)
    reclen = 131;
else
    reclen = 80;
x = (filesize(fname)-304)/reclen; // start at last record
while (Getobj(type, x) != 1 && X > 0)
        --x;
return x;
}
///////////////////////////////////////////////////////////////////////////////
FindHighConf( )
{
int x, f;
newdir(host_dir);
x = filesize("CONFS.DAT")/80; // start at last record
high_conf = 40; // need to set for get_conf()
while (get_conf(x) != 1 && x >= 1)
       --x;
return x;
}
///////////////////////////////////////////////////////////////////////////////
GetExt( str buf, int type )
{
  if (type == 1)
     buf = ".DIR";
  else if (type == 2)
     buf = ".TXT";
  else if (type == 3)
     buf = ".DOR";
}
