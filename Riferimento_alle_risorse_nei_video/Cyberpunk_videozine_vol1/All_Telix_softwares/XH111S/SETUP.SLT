{
 if (host_dir)
    {
     if (newdir(host_dir))
        return 1;
     }
 box(9, 11, 70, 13, 1, 0, 30);
 pstraxy("Please define the XHost Directory first (System).", 11, 12, 28);
 delay_scr(20);
 return 0;
 }
///////////////////////////////////////////////////////////////////////////////

itobs( int num, str dest)
{
int x, num2;
num2 = num;

for (x = 0; x <= 7; ++x)
     {
      setchr(dest, x, num2%2+48);
      num2 = num2/2;
      }
}

///////////////////////////////////////////////////////////////////////////////
ed( str s, int len, str init, str head)
{
 int x;
 x = (80-len)/2;
 if (strlen(head) > len)
    x = (80-strlen(head))/2;

 box(x-2, 16, 81-x, 18, 1, 0, 27);

 pstraxy(head, 39-strlen(head)/2, 16, 30);
 pstraxy(init, x, 17, 23);

 s = init;
 edit_string(s, x, 17, len, 23);
 box(x-2, 16, 82-x, 19, 1, 0, 0);
}

///////////////////////////////////////////////////////////////////////////////
SaveObj( int Type, int Num )
{
 int objf, objlen, xx;
 str obj_fname[64], exte[4];

 getext(exte, type);

 if (type == 3)
     objlen = 131;
 else
     objlen = 80;

 prep(stoi(confnum), exte, obj_fname);
 inschrs(confpath, obj_fname, 0, strlen(confpath));

 objf = fopen(obj_fname, "r+");

 if (objf <= 0)
    {
     fclose(objf);
     objf = fopen(obj_fname, "w");
     }

 // type = 1 = dir
 // type = 2 = text
 // type = 3 = door

 fseek(objf, 0, 2);

 xx = ftell(objf);
 if (317 + objlen*(num-1) >= xx)
    {
     if (xx > 0)
        {
         fclose(objf);
         objf = fopen(obj_fname, "a");
         }
     else
         comment(objf);
     }

 fseek(objf, 317 + objlen * (num - 1), 0);

 fputc(stoi(obj_lvl), objf);
 bstoc(obj_flag, objf);
 fwrite(obj_name, 30, objf);
 fwrite(obj_path, 45, objf);
 fputc(1, objf);
 fwrite("^M^J", 2, objf);

 if (type == 3)        // doors only
    {
     fwrite(params, 45, objf);
     itoc(stoi(tim), 2, objf);
     bstoc(control, objf);
     fwrite("^001^M^J", 3, objf);
     }
 fclose(objf);
// - dir    [80]
// Level[1] Flag[1] Descr[30] Path[45] endbyte[1] [^M^J]
// - text files  [80]
// Level[1] Flag[1] Descr[30] Path[45] endbyte[1] [^M^J]
// - door  [131]
// Level[1] Flag[1] Descr[30] Path[45] endbyte[1] [^M^J]     -> 80
// Params[45] Time[2] Control[1] endbyte[1] [^M^J]           -> 51

// [Control = 00000000]
//               AIIIS      Ansi, Info:3, Script = 1 | Prog = 0

}
///////////////////////////////////////////////////////////////////////////////
// f //
// GetObj

// Type = 1 File Dir
//        2 Door
//        3 Text File
// Num      Number of filedir/text/door

GetObj( int type, int num )
{
 int objf, objlen;
 str obj_fname[64], temp[131], param[12];
 if (num < 1)
    return 0;
 getext(param, type);

 if (type == 3)
     objlen = 131;
 else
     objlen = 80;

 prep(stoi(confnum), param, obj_fname);
 inschrs(confpath, obj_fname, 0, strlen(confpath));

 objf = fopen(obj_fname, "r");
 obj_lvl = -1;
 if (objf > 0)
    {
 // type = 1 = dir
 // type = 2 = text
 // type = 3 = door

     fseek(objf, 317 + objlen*(num-1), 0);

     if (fread(temp, objlen, objf) == objlen)
         {
         itos(subchr(temp, 0), obj_lvl);
         itobs(subchr(temp, 1), obj_flag);
         subchrs(temp, 2, 30, obj_name);
         format(obj_name);
         subchrs(temp, 32, 45, obj_path);
         format(obj_path);

         if (type == 3)
            {
             subchrs(temp, 80, 45, params);
             format(params);
             itos(get_int(temp, 125, 2), tim);
             itobs(subchr(temp, 127), control);
             }
         fclose(objf);
         return 1;
         }
    }
 obj_lvl = "";
 setchrs(obj_flag, 0, '0', 8);
 setchrs(control, 0, '0', 8);
 params = "";
 tim = "";
 obj_name = "";
 obj_path = "";
 fclose(objf);
 return 0;
}

// - dir    [80]
// Level[1] Flag[1] Descr[30] Path[45] endbyte[1] [^M^J]
// - text files  [80]
// Level[1] Flag[1] Descr[30] Path[45] endbyte[1] [^M^J]
// - door  [131]
// Level[1] Flag[1] Descr[30] Path[45] endbyte[1] [^M^J]    -> 80
// Params[45] Time[2] Control[1] [1] [^M^J]                 -> 51
// [Control = 00000000]
//               AIIIS      Ansi, Info:3, Script = 1 | Prog = 0
///////////////////////////////////////////////////////////////////////////////
bstoc( str s, int f )
{
int x, sum, factor = 1;
for (x = 0; x <= 7; ++x)
    {
    sum = sum + (subchr(s, x)-48)*factor;
    factor = factor * 2;
    }
fputc(sum, f);
}
///////////////////////////////////////////////////////////////////////////////
bstoi( str s)
{
int x, sum, factor = 1;
for (x = 0; x <= 7; ++x)
    {
    sum = sum + (subchr(s, x)-48)*factor;
    factor = factor * 2;
    }
return sum;
}
///////////////////////////////////////////////////////////////////////////////
stat_line( int opt)
{
 str line[80];

 if (opt == 1)
     line = "Esc: Quit  Enter: Edit  PgUp/Dn: ñ1  Ctrl-Pg: ñ10  +: Add  (Del)ete";
  else if (opt == 2)
     line = "Esc: Cancel  F1: Help on Edit  F2: Save  ^X^Y to change fields";
  else if (opt == 3)
     line = "Esc:Quit  PgUp/Dn:ñ1  Ctrl-Pg:ñ10  +:Add  (Del)ete  Enter:Edit  Alt-A:Editor";
  else if (opt == 4)
     line = "Esc: Quit  PgUp/Dn: ñ1  Ctrl-Pg: ñ10  Home  End  (Ins)ert  (Del)ete  Enter: Edit";
  else if (opt == 5)
     line = "Esc: Cancel  F1: Help on Edit";
  else if (opt == 6)
     line = "Esc: Quit  (Y)es (N)o  ^X^Y to change fields";
  else if (opt == 7)
     line = "Select Menu:";
  else if (opt == 8)
    {
     itos(menu, line);
     inschrs("  ", line, 0, 3-strlen(line));
     inschrs(": ", line, strlen(line), 2);
     inschrs("Menu #", line, 0, 6);
     inschrs(obj_name, line, strlen(line), strlen(obj_name));
     setchrs(line, strlen(line), 32, 37-strlen(line));
     inschrs("³ F2:Save Enter:Edit Alt-{Pick Name Clear}", line, strlen(line), 42);
     }
  else
      {
       vputchrs(0, help_line, stat_save, 0, 80, stat_color);
       return;
       }
  vputchrs(0, help_line, line, 0, 80, stat_color);
}
///////////////////////////////////////////////////////////////////////////////
Prep( int num, str ext, str buf )
{
itos(num, buf);
inschrs("000", buf, 0, 3-strlen(buf));
inschrs(ext, buf, strlen(buf), strlen(ext));
}
