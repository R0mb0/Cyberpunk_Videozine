 pstraxy("Level", 6, 13, 31);
 pstraxy("Flags", 6, 14, 31);

 if (dir <= high)
    disp_dir(type, dir);
}
///////////////////////////////////////////////////////////////////////////////
CheckBS( str s )
{
 int i, char;
 setchrs(s, strlen(s), 32, 8-strlen(s));
 for (i = 0; i <= 7; ++i)
     {
      char = subchr(s, i);
      if (char != 48 && char != 32)
          setchr(s, i, 49);  // set flag to 1
      else
          setchr(s, i, 48); // else 0
      }
}
///////////////////////////////////////////////////////////////////////////////
GetHelpLine( )
{
int x, y;
x = getx();
y = gety();
str list0[] = "00244249", things[2];
help_line = -1;
while (strlen(list0) > 0)
      {
        substr(list0, 0, 2, things);
        delchrs(list0, 0, 2);
        gotoxy(16, stoi(things));
        if (vgetchr()%256 == '³')
           help_line = stoi(things);
        }
gotoxy(x, y);
}
///////////////////////////////////////////////////////////////////////////////
get_int( str src, int pos, int num )
{
int i, x, mult = 1;
for (x = 0; x < num; ++x)
  {
   i = subchr(src, pos + x) * mult + i;
   mult = mult * 256;
  }
return i;
}
///////////////////////////////////////////////////////////////////////////////
put_int( int src, str target, int pos, int num)
{
 int x, div, source;

if (num == 4)
    div = 16777216;
else
    div = 256;

 source = src;

 for (x = num - 1; x >= 0; --x)
    {
     setchr(target, pos + x, source/div);
     source = source%div;
     div = div/256;
     }
}
///////////////////////////////////////////////////////////////////////////////
ynp( int def)
{
int c = -1;

int UP = 18432,
    DOWN = 20480;

while(strchr("YN^027^013", 0, c) == -1 && c != UP && c != DOWN)
      c = toupper(inkeyw());

if (c == 27)
   return -1;
else if (c == 13)
    c = def;
if (c == 'Y')
  {
   vputchr('Y' + 28672);
   return 1;
  }
else if (c == 'N')
   {
   vputchr('N' + 28672);
   return 0;
   }
else if (c == UP)
     return 2;
else if (c == 15360)        // save
     return -2;
else if (c == 19200)    // left
     return -4;
else if (c == 19712)       // right
     return 4;
else return 3;      // down
}    
