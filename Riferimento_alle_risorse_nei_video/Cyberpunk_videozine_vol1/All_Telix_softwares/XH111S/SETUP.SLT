        vputchrs(50, x + 3, "Yes", 0, 3, 122);
    else
        vputchrs(50, x + 3, "No ", 0, 3, 124);
    }
pstraxy(chat1, 47, 16, 127);
pstraxy(chat0, 47, 17, 127);
}
