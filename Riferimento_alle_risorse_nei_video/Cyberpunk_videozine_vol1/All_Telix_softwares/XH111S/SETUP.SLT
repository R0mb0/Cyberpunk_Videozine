 str second[30];

 box(3, 8, 77, 15, 1, 0, 30);
 pstraxy("Conf:", 5, 8, 30);
 pstraxy(confnum, 10, 8, 31);

 pstraxy("High:", 14, 8, 30);

 second = " Files Setup ";
 if (type == 2)
    second = " Text Files ";
 else if (type == 3)
    {
    second = " Doors Setup ";
    vputchrs(6, 15, "Alt-O: More Door Options", 0, 24, 30);
