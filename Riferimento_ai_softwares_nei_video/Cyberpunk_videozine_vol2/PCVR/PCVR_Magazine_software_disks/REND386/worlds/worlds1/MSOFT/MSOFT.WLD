loadpath r386w\wld\worlds1\msoft

worldscale 1.0          # 1.0 mm per unit

hither            10    # anything closer than this gets clipped
yon          1000000    # anything farther than this doesn't get rendered

options a   # camera angles are tilt,pan,roll

#start 5391,10,2890 90,0,0 2
camera 1 5391,10,2890 0,90,0 2
camera 2 2335 7210 3554 58.593750 114.414062 0.000000 2.000000

ambient 76

# A collection of buildings
object b5=bldg     5,5,5        0,0,0     0,0,0   0
object b6=bldg     5,5,5        0,0,0     0,0,3300   0
object b4=bldg     5,5,5        0,0,0     2600,0,1400   0
object b3=bldg     5,5,5        0,0,0     5400,0,-500   0
object b2=bldg     5,5,5        0,0,0     5400,0,3000   0
object b6=bldg     5,5,5        0,0,0     8100,0,1200   0

object lkbill=lakebill 22,5,10    0,0,0     5600,0,1800   0

# End of msoft.wld

title The Microsoft "Campus"
title by Wendell Joost
title wendellj@microsoft.com
title memory

