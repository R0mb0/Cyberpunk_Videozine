animation 10    # This animation added by Dave Stampe
 state closed
  do sensor(-3500,x,-6500 3500,x,6500)[][state=opening]
 state opening
  do door=step(x,x,x x,30,x)[]
  do door=rotlimit(x,x,x x,90,x)[state=open][]
 state open
  do sensor(-3500,x,-6500 3500,x,6500)[state=closing][]
 state closing
  do door=step(x,x,x x,-30,x)[]
  do door=rotlimit(x,0,x x,x,x)[state=closed][]


