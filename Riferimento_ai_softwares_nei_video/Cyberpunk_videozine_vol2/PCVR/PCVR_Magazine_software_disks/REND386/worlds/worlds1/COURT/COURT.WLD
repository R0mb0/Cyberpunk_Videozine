#
# COURT.WLD
#
# A Medieval Court
#
# Created by Randy Shedden (randysh@microsoft.com)
# for "Virtual World Creations", published by the Waite Group
#

loadpath r386w\wld\worlds1\court

options a   # camera angles are tilt,pan,roll

#start 0,1600,-4000 0,0,0 2  # starting location, orientation and zoom
camera 1  0,1600,-4000 0,0,0 2  # starting location, orientation and zoom
camera 2 -26238 7800 8226 32.226562 107.421875 0.000000 2.661957

# Surface definitions:

surfacedef plaster   0x1fd8
surfacedef brick     0x11ff
surfacedef wood      0x12df
surfacedef painted   0x13f8
surfacedef carpet    0x4a
surfacedef greypaint 239
surfacedef grain     0x14e8
surfacedef artwork   4
surfacedef marble    0x1Df8
surfacedef steel2    0x25eF
surfacedef mirror    0x2a00
surfacedef black     0x1000

# Surface mappings:

surfacemap single1
surface 1 plaster

surfacemap single3
surface 1 wood

surfacemap double2
surface 1 brick
surface 2 painted

surfacemap floorgrey
surface 1 carpet

surfacemap ceilgrey
surface 1 greypaint

surfacemap piccolors
surface 1 grain
surface 2 artwork
surface 3 mirror
surface 4 marble
surface 5 steel2

# Court Splits and Walls:
# splits added by Dave Stampe to fix visibility errors

split 0,0,0 0,0,1
polyobj 4 plaster 6400,0,0  6400,4800,0 1420,4800,0 1420,0,0
polyobj 4 plaster 6400,0,0  1420,0,0 1420,4800,0 6400,4800,0
polyobj 4 plaster -6400,0,0  -1420,0,0 -1420,4800,0 -6400,4800,0
