polyobj 4 plaster -1420,3200,0 1420,3200,0 1420,4800,0 -1420,4800,0
polyobj 4 plaster -1420,4800,0 1420,4800,0 1420,3200,0 -1420,3200,0 

split -6400,0,0 1,0,0
polyobj 4 plaster -6400,0,0 -6400,4800,0 -6400,4800,17200 -6400,0,17200
polyobj 4 plaster -6400,0,0 -6400,0,17200 -6400,4800,17200 -6400,4800,0

split -6400,0,17200 0,0,1
polyobj 4 plaster -6400,0,17200 -6400,4800,17200 6400,4800,17200 6400,0,17200
polyobj 4 plaster -6400,0,17200 6400,0,17200 6400,4800,17200 -6400,4800,17200

split 6400,0,0 -1,0,0
polyobj 4 plaster 6400,0,17200 6400,4800,17200 6400,4800,0 6400,0,0
polyobj 4 plaster 6400,0,17200 6400,0,0 6400,4800,0 6400,4800,17200

split 0,4800,0 0,-1,0
polyobj 4 plaster -6400,4800,0 -6400,4800,17200 6400,4800,17200 6400,4800,0
polyobj 4 plaster 6400,4800,0 6400,4800,17200 -6400,4800,17200 -6400,4800,0

