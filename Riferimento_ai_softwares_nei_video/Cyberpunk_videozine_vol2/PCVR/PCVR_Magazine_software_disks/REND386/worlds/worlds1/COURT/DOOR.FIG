comment = A wooden door figure file, made of planks
comment = Created by Randy Shedden, November 1992;

{
    name = plank1;
    plgfile = drplank1.plg scale 1,1,1 shift 0,0,0;
    pos = 0,0,0;
    {
        name = plank2;
        plgfile = drplank2.plg scale 1,1,1 shift 0,0,0;
        pos = 55,0,0;
        {
            name = plank3;
            plgfile = drplank2.plg scale 1,1,1 shift 0,0,0;
            pos = 105, 0, 10;
            rot = 0,180,0;
            {
		name = plank4;
                plgfile = drplank1.plg scale 1,1,1 shift 0,0,0;
                pos = -55,0,0;
           }
        }
    }
    {
        name = clasp1;
        plgfile = clasp.plg scale 1,1,1 shift 0,0,0;
        pos = 10, 40, 0;
    }
    {
        name = clasp2;
        plgfile = clasp.plg scale 1,1,1 shift 0,0,0;
        pos = 10, 150, 0;
    }
}
