worldscale 1.0	        # 1.0 mm per unit

hither            10    # anything closer than this gets clipped
yon         20000000    # anything farther than this doesn't get rendered

start  -3237,3151,-1061 52,23,0 1.5

ambient 76

object chopper 1,1,1  0,0,0  0,0,0 256
object rotor=rotor 1,1,1  0,0,0  -30,1800,1400 256
object vrotor=vrotor 1,1,1  0,0,0  50,1255,3980 256

task sculspin 15 rotor;0,25,0
task sculspin 15 vrotor;55,0,0