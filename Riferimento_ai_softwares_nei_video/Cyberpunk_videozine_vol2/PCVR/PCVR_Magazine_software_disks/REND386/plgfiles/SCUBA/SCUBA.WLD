#sails----------------------------------------------------------------------
object ss=sail    50,30,15   0,90,0      80000,30000,30000  0  .   
animation 2              
   state a
      do ss=userep(1)[state=b]
   state b
      do ss=userep(2)[state=c]
   state c
      do ss=userep(3)[state=d]
   state d
      do ss=userep(2)[state=a]
object ss=sail  20,40,50   0,90,0      40000,60000,-5000  0  .   
animation 2              
   state a
      do ss=userep(1)[state=b]
   state b
      do ss=userep(2)[state=c]
   state c
      do ss=userep(3)[state=d]
   state d
      do ss=userep(2)[state=e]    
   state e
      do ss=userep(1)[state=a]
object ss=sail  10,40,100  0,90,0      80000,80000,-5000  0  .   
animation 1.5            
   state a
      do ss=userep(1)[state=b]
   state b
      do ss=userep(2)[state=c]
   state c
      do ss=userep(3)[state=d]
   state d
      do ss=userep(2)[state=e]    
   state e
      do ss=userep(1)[state=a]
#------------------------------------------------------------------------
#----------------------------------SEAWEED-------------------------------
#-------------------------------------------------------------------------
object sw=seaweed  10,60,30   0,-90,0  48000,-30000 47000  0 .
animation 2.5          
   state a
      do sw=userep(2)[state=b]
   state b
      do sw=userep(3)[state=c]
   state c
      do sw=userep(4)[state=d]
   state d
      do sw=userep(3)[state=e]    
   state e
      do sw=userep(4)[state=f]    
   state f
      do sw=userep(3)[state=g]    
   state g
      do sw=userep(1)[state=a]    
object sw=seaweed  10,50,40   0,-90,0  50000,-30000 50000  0 .
animation 2            
   state a
      do sw=userep(1)[state=b]
   state b
      do sw=userep(2)[state=c]
   state c
      do sw=userep(3)[state=d]
   state d
      do sw=userep(4)[state=e]    
   state e
      do sw=userep(3)[state=f]    
   state f
      do sw=userep(2)[state=g]    
   state g
      do sw=userep(1)[state=a]    
object sw=seaweed  5,40,20   0,-90,0  52000,-30000 48000  0 .
animation 1.5          
   state a
      do sw=userep(1)[state=b]
   state b
      do sw=userep(2)[state=c]
   state c
      do sw=userep(3)[state=d]
   state d
      do sw=userep(2)[state=e]    
   state e
      do sw=userep(3)[state=f]    
   state f
      do sw=userep(2)[state=g]    
   state g
      do sw=userep(1)[state=a]    
#-------------------------------------------------------------------------
#-------------------------------BUBBLES-------------------------------------
#--------------------------------------------------------------------------
object bb=bubble        3,3,3     0,0,0      20000,-30000,-30000     0 .  
animation 50
   state a
      do bb=abstep(10,50,x 259,309,-119)[]
      do bb=postest(x,x,x  x,20000,x)[state=b][]
   state b
      do bb=moveto(20000,-30000,-30000  x,x,x)[state=a]
object bb=bubble       2,2,1     0,0,0       20000,-30000,-30000     0 .
animation 50
   state a
      do bb=abstep(20,70,x 259,319,-219)[]
      do bb=postest(x,x,x  x,10000,x)[state=b][]
   state b
      do bb=moveto(20000,-30000,-30000  x,x,x)[state=a]
object bb=bubble       1,1,1     0,0,0       20000,-30000,-30000     0 .
animation 50
   state a
      do bb=abstep(15,90,x 259,309,-119)[]
      do bb=postest(x,x,x  x,60000,x)[state=b][]
   state b
      do bb=moveto(20000,-30000,-30000  x,x,x)[state=a]
object bb=bubble      1,1,1      0,0,0       20000,-30000,-30000     0 .
animation 50
   state a
      do bb=abstep(20,120,x 259,309,-119)[]
      do bb=postest(x,x,x  x,50000,x)[state=b][]
   state b
      do bb=moveto(20000,-30000,-30000  x,x,x)[state=a]
object bb=bubble      3,3,3      0,0,0       20000,-30000,-30000     0 .
animation 50
   state a
      do bb=abstep(10,40,x 259,309,-119)[]
      do bb=postest(x,x,x  x,40000,x)[state=b][]
   state b
      do bb=moveto(20000,-30000,-30000  x,x,x)[state=a]
object bb=bubble      2,2,2      0,0,0       20000,-30000,-30000     0 .
animation 50
   state a
      do bb=abstep(20,60,x 259,309,-119)[]
      do bb=postest(x,x,x  x,40000,x)[state=b][]
   state b
      do bb=moveto(20000,-30000,-30000  x,x,x)[state=a]

