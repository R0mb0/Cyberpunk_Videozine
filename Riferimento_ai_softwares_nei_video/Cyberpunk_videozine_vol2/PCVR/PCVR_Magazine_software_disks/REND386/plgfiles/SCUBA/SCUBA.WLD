#Scubaland

version 5

loadpath scuba

hither10
yon 1000000


options a

camera 1   -100000 50000 0   25 90 0  2    #start       

#amera 2    75000 35000 -185000   0 0 0      2    #side view
#amera 3    280000 21000 0        0 270 0    2    #back view
#amera 4    -75000 0 0            0 90 0     2    #front      
#cameras and currents don't mix

options  cfp 

stepsize  50
anglestep 1

ambient 90
mlight 150000,50000,40000 spot 30 sun=reef3 0

groundcolor 0x10bb
skycolor 0x10bb

split         50000,-5001,0       0,1,0
split         10000,0,0           0,-1,0 
#------------------------------------------------------------------------
#-------------------------------BOTTOM-------------------------------------
#-------------------------------------------------------------------------
object shelf        1,1,1       0,0,0         0,0,0                 2 .   
#object torso       3,3,3       180,90,0      130000,-28000,10000   2 .      
#object skull       3,3,3       0,-90,180     130425,-24950,10000   2 .    
