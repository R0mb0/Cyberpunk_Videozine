#------------------------------AT REEF 2----------------------------------
#fish red   3--------------------
object mt=fishr 200,100,100   0,-90,0  45000,40500,13000 0 . reef2
animation 3
   state a
      do mt=userep(1)[state=b]
   state b
      do mt=userep(2)[state=c]
   state c
      do mt=userep(3)[state=d]
   state d
      do mt=userep(2)[state=a]
object mt=fishr 175,100,100   0,-90,0  47000,42000,14000 0 . reef2
animation 3
   state a
      do mt=userep(3)[state=b]
   state b
      do mt=userep(2)[state=c]
   state c
      do mt=userep(1)[state=d]
   state d
      do mt=userep(2)[state=a]
object mt=fishr 200,100,100   0,-90,0  46000,45000,13000 0 . reef2
animation 3
   state a
      do mt=userep(2)[state=b]
   state b
      do mt=userep(3)[state=c]
   state c
      do mt=userep(2)[state=d]
   state d
      do mt=userep(1)[state=a]
#orange angel------------------------------------
object f1=fish1 1,1,1  -90,-90,90 25000,0,5000 0 . reef2    
animation 3
   state a      
      do f1=step(40,x,20 x,x,x)[state=b]
   state b
      do f1=step(-40,x,-20 x,x,x)[state=a]
