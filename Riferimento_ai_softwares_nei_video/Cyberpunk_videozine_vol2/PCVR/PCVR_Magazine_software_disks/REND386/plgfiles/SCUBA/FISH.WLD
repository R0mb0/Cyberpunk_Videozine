#manta------------------------------
object mr=manta1  2,2,2   90,-180,0  50000,500,0 0 . reef3         
animation 2
   state a
      do mr=userep(1)[state=b]
   state b
      do mr=userep(2)[state=c]
   state c
      do mr=userep(3)[state=d]
   state d
      do mr=userep(4)[state=e]
   state e
