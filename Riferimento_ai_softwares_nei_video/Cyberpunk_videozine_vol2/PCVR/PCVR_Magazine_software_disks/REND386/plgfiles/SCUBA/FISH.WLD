#-----------------------------OTHER---------------------------------------
object cb=crab   2,2,2      0,-60,0     80000,-29500,-25000    0  .    
animation 5
   state a
      do cb=step(80,x,x   x,30,x)[] 
      do cb=postest(0,x,x  x,x,x)[state=c][state=b] 
   state b
      do cb=step(-400,x,x   x,-30,x)[]   
      do cb=postest(0,x,x  x,x,x)[state=c][state=a]
   state c
      do cb=moveto( 80000,-29500,-25000)[state=a]
