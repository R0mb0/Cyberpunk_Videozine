object wh=whale 20,20,20  0,0,180 -400000,100000,0 0 .    reef5       
animation 1.5
   state a
      do wh=step(x,-250,x -2,0,0)[state=b]
     
   state b
      do wh=step(x,250,x 2,0,0)[state=a]
#------------------------------------------------------------------------     
#------------------------------SCHOOL------------------------------------
#-------------------------------------------------------------------------
object sc=cube .01,.01,.01    0,0,0     50000,-20000,-30000 0 .
animation 20
   state a
      do sc=abstep(-100,5,-20 x,x,x)[][]
      do sc=postest(-15000,x,x x,x,x)[state=b][]
   state b
      do sc=abstep(x,x,x x,30,x)[][]
      do sc=rotlimit(x,x,x x,90,x)[state=c][]
   state c
      do sc=abstep(x,5,100 x,x,x)[][]
      do sc=postest(x,x,x x,x,47000)[state=d][]  #around rock
   state d
      do sc=abstep(x,x,x x,30,x)[][]
      do sc=rotlimit(x,x,x x,180,x)[state=e][]   #
   state e
      do sc=abstep(100,-20,x x,x,x)[][]
      do sc=postest(x,x,x 46000,x,x)[state=f][]
   state f
      do sc=abstep(10,x,x x,x,x)[][]
      do sc=postest(x,x,x 50000,x,x)[state=g][]    # at seaweed
   state g
      do sc=abstep(x,x,x x,-45,x)[][]
      do sc=rotlimit(x,135,x x,x,x)[state=h][]    #zig
   state h
      do sc=abstep(500,x,500 x,x,x)[][]
      do sc=postest(x,x,x 65000,x,x)[state=i][]
   state i
      do sc=abstep(x,x,x x,45,x)[][]
      do sc=rotlimit(x,x,x x,225,x)[state=j][]   #zag
   state j
      do sc=abstep(500,x,-500 x,x,x)[][]
      do sc=postest(x,x,x 80000,x,x)[state=k][]    #first jag ends
   state k
      do sc=abstep(x,x,x x,-45,x)[][]
      do sc=rotlimit(x,135,x x,x,x)[state=l][]      #zig
   state l
      do sc=abstep(500,x,500 x,x,x)[][]
      do sc=postest(x,x,x 95000,x,x)[state=m][]
   state m
      do sc=abstep(x,x,x x,45,x)[][]
      do sc=rotlimit(x,x,x x,225,x)[state=n][]          #zag
   state n
      do sc=abstep(500,x,-500 x,x,x)[][]              #second jag ends
      do sc=postest(x,x,x 100000,x,x)[state=o][]
   state o
      do sc=abstep(x,x,x x,45,x)[][]
      do sc=rotlimit(x,x,x x,270,x)[state=p][]          #zag
   state p
      do sc=abstep(x,50,-35 x,x,x)[][]              #up to ship
      do sc=postest(x,x,x x,5000,x)[state=q][]
   state q
      do sc=abstep(x,x,-50 x,x,x)[][]
      do sc=postest(x,x,-30000 x,x,x)[state=r][]
   state r
      do sc=moveto(x,x,x x,0,x)[state=s][]              #home
   state s
      do sc=abstep(-100,-60,x x,x,x)[][]
      do sc=postest(50000,x,x x,x,x)[state=a][]
