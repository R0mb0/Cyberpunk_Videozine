#------------------------------REEFS--------------------------------------
#inside ship--------------------------------------------------------------
object reef1=cube .01,.01,.01    0,0,0     30000,-25000,0 0 .   #shark in boat
animation 10
   state a
      do reef1=abstep(250,x,x  x,x,x)[][]
      do reef1=postest(x,x,x  120000,x,x)[state=b][]
   state b
      do reef1=abstep(x,x,x  x,5,x)[][]
      do reef1=rottest(x,x,x  x,180,x)[state=c][]
   state c
      do reef1=abstep(-250,x,x  x,x,x)[][]
      do reef1=postest(20000,x,x  x,x,x)[state=d][]
   state d
      do reef1=abstep(x,x,x  x,180,x)[state=a][]   
#central mast--------------------------------------------------------------      
object reef2=cube 1,1,1    0,0,0     80000,10000,0 0 .
animation 20
   state a
      do reef2=step(x,x,x  x,4,x)[]
#port rock-----------------------------------------------------------------
object reef3=cube 1,1,1    0,0,0    112000,-25000,-80000 0 .
animation 10
   state a
      do reef3=step(x,x,x  0,-4,0)[]
#lee rock-------------------------------------------------------------------
object reef4=cube 1,1,1    0,0,0    152000,-30000,80000 0 .
animation 20
   state a
      do reef4=step(x,x,x  x,2,x)[]
#whale-------------------------------------------------------------------
object reef5=cube 1,1,1    0,0,0    122000,-30000,250000 0 .
animation 20
   state a
      do reef5=step(x,x,x  x,-1.5,x)[]
