#marker-black cube 1'x 1'x 1'
#centered x,z    sets on ground
marker  8 6

-150 0 150   #front face
150 0 150    #counter clockwise
150 300 150
-150 300 150

-150 0 -150   #back  face
150 0 -150    #clockwise
150 300 -150
-150 300 -150

0x1fcc 4  0 1 2 3
0x1fcc 4  1 5 6 2
0x1fcc 4  2 6 7 3
0x1fcc 4  1 0 4 5
0x1fcc 4  7 6 5 4
0x1fcc 4  0 3 7 4


