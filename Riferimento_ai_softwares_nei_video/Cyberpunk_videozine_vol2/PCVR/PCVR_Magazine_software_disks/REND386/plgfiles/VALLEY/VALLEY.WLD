#--------------------------------------------------------------------------
# xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
#
#                        THE RIDE DOWN
#  this needs work!!!!
#
#  xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#-------------------------------------------------------------------------
object ca=marker1  .10,.10,.10       0,0,0       450300,89500,126600   0 .    
animation 100      
   state ready
       do sensor(430300,69500,106600  470300,1095000,146600)[exit][state=off1]
   state off1
       do core=attach(0)[state=down]
   state down
       do ca=attach(1)[state=whee]
   state whee
       do ca=gravity(x,-500,x  x,50,x)[]   
       do ca=poslimit(x,x,x  x,1000,x)[][state=off]
   state off   
       do ca=attach(0)[]
       do sensor(430300,0,106600 470300,1000,146600)[][exit]
