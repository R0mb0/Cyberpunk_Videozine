#---------------------------------------------------------------------------
#-----------------------------THE TOWER-------------------------------------
#---------------------------------------------------------------------------
#tower--------------------------- 
object tower.plg     10,30,10    0,0,0     237000,1,-230500 0 .
object db=gate       10,20,5     0,90,0    232300,0,-230000 0 . # drawbridge
object hole          10,20,5     0,90,0    232350,0,-230000 2 .
animation 10
   state a
      do sensor (225000,0,-231000   231000,1000,-229000)[exit][state=b]
   state b
      do db=step(x,x,x 0,8,0)[]
      do db=rotlimit(x,x,x x,210,x)[][exit]
#spires--------------------------
object spire1=cube   .01,.01,.01    0,0,0     237000,0,-230500 0 .
animation 10
   state a
      do spire1=step(x,x,x  0,2,0)[]
object spire2=cube   .01,.01,.01     0,0,0    237000,0,-230500 2 .
animation 10
   state a
      do spire2=step(x,x,x  0,-3,0)[]
#steps---------------------------------
object stp=cube   50,2,20   0,0,0     4000,100,0 0 .  spire2   
animation 4
   state attach
      do sensor(238000,0,-231500  241000,2000,-229500)[exit][state=stairs]
   state stairs
      do stp=attach(1)[]
      do stp=step(x,.5,x x,x,x)[]
      do stp=poslimit(x,35000,x  x,38000,x)[][state=sensor]
   state sensor
      do sensor(x,34000,x  x,38500,x)[][state=off]
   state off
      do stp=attach(0)[exit]
#****************************needs fixed********************************
#star ride from tower------------------------   
object core=marker1 .01,.01,.01    0,0,0   237000,1000,-230500 0 .  spire1
animation 1      
   state ready
       do sensor(236000,0,-231500  238000,2000,-229500)[exit][state=whee]
   state whee
       do core=attach(1)[]
       do core=moveto(-180000,89500,-230500  x,x,x)[exit]
