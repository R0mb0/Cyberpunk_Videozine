#------------------------------------
#boat ride---------------------------
object mt=boat      3,3,1      0,90,0      130000,1,-107000 0 . 
animation 50
    state dock
       do mt=abstep(x,x,10 x,x,x)[]
       do mt=poslimit(x,x,x x,x,-86000)[state=wait][]
    state wait
       do mt=attach(0)[]
       do timer(5)[state=wait][]
       do sensor(129000,x,-88000 131000,x,-84000)[state=island][state=ride1]
    state ride1
       do mt=attach(1)[state=island]
    state island
       do mt=abstep(x,x,-10 x,x,x)[]
       do mt=poslimit(x,x,-107000 x,x,x)[state=wt][]
     state wt
        do mt=attach(0)[]
        do timer(5)[state=wt][]
        do sensor(129000,x,-109000 131000,x,-105000)[state=dock][state=ride2]
     state ride2
        do mt=attach(1)[state=dock]
