#-------------------------------- VALLEY ---------------------------------
#all the rides having to do with the tower need work
#--------------------------------------------------------------------------                               

loadpath valley

hither10
yon 10000000


options a
camera 1 -140000 1000 -230500     0 90 0    2   #at entrance
camera 2 -180000 112000 -230500   10 90 0   2   #above entrance(spin tower)
camera 3 250000 550000 -250000    90 0 0    2    #high above tower
camera 4 128000 1000 -120000       0 0 0    2    #at island
#camera 5  
camera 6 200000 1000 -230500       0 90 0   2    #tower      
camera 7  470000,1000,-300000      0 90 0   2    #cottage
camera 8 383000 1000 -150000       0 90 0   2    #spark

option cfp 

stepsize  20
anglestep 1

ambient 90
mlight  0,7000,0  spot 10  bulb=cloud   

groundcolor 2
skycolor 11

split 0,1,0  0,1,0 0
#-------------------------------------------------------------------------
