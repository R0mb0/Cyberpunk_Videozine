N NEWKEYS.COM
A
JMP	013A		;Jmp initialize
DW	0,0
CMP	AH,00		;NewInt16:
JZ	0115		;Jmp GetKey
CMP	AH,01
JZ	0121		;Jmp GetStatus
CS:
JMP	FAR [0102]	;Jmp OldInt16
MOV	AH,10		;GetKeY:
PUSHF
CS:
CALL	FAR [0102]	;Call OldInt16
CALL	0131		;Call Fixup
IRET
MOV	AH,11		;GetStatus
PUSHF
CS:
CALL	FAR [0102]	;Call OldInt16
JZ	012E
CALL	0131		;Call FixUp:
RETF	0002
CMP	AL,E0		;FixUp
JNZ	0139
SUB	AL,AL
CMP	AL,01
RET
MOV	AX,3516		;Initialize
INT	21		;Get OldInt16
MOV	[0102],BX	;Save it
MOV	[0104],ES
MOV	DX,0106
MOV	AX,2516
INT	21		;Set NewInt16
MOV	DX,013A
INT	27		;Stay Resident

RCX
54
W
Q

