//
////////////////////////////////////////////////////////////////////////
//                                                                    //
//  Function to wait for user to hit a key                            //
//                                                                    //
////////////////////////////////////////////////////////////////////////

wait_for_key()
 {
  int v_handle;

  v_handle = vsavearea(50,23,79,23);        // save screen image
  pstraxy("***Hit any key to continue***",50,23,48);
  inkeyw();
  vrstrarea(v_handle);
 }

//
////////////////////////////////////////////////////////////////////////
//                                                                    //
//  Function to dial a number and exit                                //
//                                                                    //
////////////////////////////////////////////////////////////////////////

dial_phone()
 {
  str prefix[4];
  str number[25];

  while (1)
     {
      clear_scr();
      prints("(T) for tone, (P) for pulse dialing and (Enter)...");
      gotoxy(0,2);
      gets(prefix,1);
      if (prefix == "t" or prefix == "T")
         {
          prefix = "ATDT";
          break;
         }
      if (prefix == "p" or prefix == "P")
         {
          prefix = "ATDP";
          break;
         }
      tone(450,50);
     }

  gotoxy(0,5);
  prints("Type desired telephone number and (Enter)");
  gotoxy(0,7);
  gets(number,25);
  gotoxy(0,9);
  hangup();
  prints("Exiting TLX_HST and dialing......");
  cputs(prefix);
  cputs(number);
  cputs("^M");
  Global_Status = TERMINATE;
  return();
 }

