////////////////////////////////////////////////////////////////////////
//                                                                    //
//  Function to write to NRAM                                         //
//                                                                    //
////////////////////////////////////////////////////////////////////////

write_nram()
 {
  int input;

  clear_scr();
  input = show_yn("Write NRAM",
          "Writing changes to NRAM may change your power-up modem defaults!",
          "","");
  if (input != 'y' and input != 'Y')
     return(OK);

  cputs("AT&W^M");
  if (not waitfor("OK",10)) return(TIMEOUT);
  return(nram_set());
 }

