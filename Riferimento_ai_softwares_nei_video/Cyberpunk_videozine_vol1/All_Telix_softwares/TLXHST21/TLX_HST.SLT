         call("menu_mgr","ga",Regs_Menu,buffer,3,o1,o2,o3,o4,o5,o6,o7);
         call("menu_mgr","pa",Regs_Menu,buffer,3,'O',o2,o3,56,o5,o6,o7);
        }
     Regs_Menu_Loaded = 1;
    }

 while (! done and Global_Status == OK)   // display submenu loop
  {
  choice = call("menu_mgr","d",Regs_Menu,buffer,0,1,0,0);
  call("menu_mgr","r");
