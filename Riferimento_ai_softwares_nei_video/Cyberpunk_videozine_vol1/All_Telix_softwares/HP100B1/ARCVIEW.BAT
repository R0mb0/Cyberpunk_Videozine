ECHO OFF
IF %1==Z GOTO ZIP
IF %1==A GOTO ARC

:ZIP
IF %2==X GOTO ZIPX
IF %2==V GOTO ZIPV
IF %2==L GOTO ZIPL
IF %2==M GOTO ZIPM
IF %2==T GOTO ZIPT

:ZIPT
PKXZIP -T %3
ECHO.
ECHO.
ECHO.
ECHO.
IF ERRORLEVEL = 1 ECHO ZipFile has WARNING ERRORS!! (Bad CRC, etc).
IF ERRORLEVEL = 2 ECHO ZipFile has ERRORS!!
GOTO END

:ZIPV
PKXZIP -C %3 %4 > ABCDVIEW.XYZ
GOTO END

:ZIPX
PKXZIP -X %3 %4 %5
GOTO END

:ZIPM
PKZIP -A %3 %4
GOTO END

:ZIPL
PKXZIP -V %3  > ABCDEFGH.XYZ
GOTO END

:ARC
IF %2==X GOTO ARCX
IF %2==V GOTO ARCV
IF %2==L GOTO ARCL
IF %2==M GOTO ARCM
IF %2==T GOTO ARCT

:ARCV
PKXARC -C %3 %4 > ABCDVIEW.XYZ
GOTO END

:ARCX
PKXARC -X %3 %4 %5
GOTO END

:ARCM
PKXARC -A %3 %4
GOTO END

:ARCL
PKXARC -V > ABCDEFGH.XYZ
GOTO END

:ARCT
PKXZIP -T %3
ECHO.
ECHO.
ECHO.
ECHO.
IF ERRORLEVEL = 1 ECHO ARC File has WARNING ERRORS!! (Bad CRC, etc).
IF ERRORLEVEL = 2 ECHO ARC File has ERRORS!!
GOTO END

:END


