;Telix 3.10 Logitech Mouse Menu
;By Robert F. Rapp
;Sun  10-16-1988  12:41:54

BEGIN  LeftB,MidB,RightB,LeftM,RightM,UpM,DownM,25,25
CHORDS  LMB, LRB, MRB, ALLB

LeftB:  TYPE ENTER
MidB:   MATCH 2,27,,"Telix ",MAIN,CHECK1
Check1: MATCH 1,5,,"Dialing",SPACE,Z
RightB: TYPE ESC
Leftm:  TYPE 0,75
RightM: TYPE 0,77
UpM:    TYPE 0,72
DownM:  TYPE 0,80

;*****CHORDS
LMB:    Type "Y"
LRB:    MATCH 1,5,,"Dialing",PGUP,S
MRB:    Type "N"
ALLB:   MATCH 1,5,,"Dialing",PGDN,R

;*****MAIN MENU OVERLAY -
MAIN:  POPUP 6, 2,BOLD
text " Dialing directory..Alt-D  Queue Redial #s....Alt-Q ³ Local echo........Alt-E"
text " Send files.........Alt-S  Receive files......Alt-R ³ DOS command.......Alt-V"
text " Exit Telix.........Alt-X  Run script (Go)....Alt-G ³ Run editor........Alt-A"
text " Comm Parameters....Alt-P  cOnfigure Telix....Alt-O ³ Screen Image......Alt-I"
text " Key defs./macros...Alt-K  Terminal emulation.Alt-T ³ Printer on/off...Ctrl-@"
text " Capture on/off.....Alt-L  Scroll Back........Alt-B ³ Chat Mode.........Alt-Y"
text " DOS Functions......Alt-F  Jump to DOS shell..Alt-J ³ Translate Table...Alt-W"
text " Hang-up modem......Alt-H  Clear screen.......Alt-C ³ Add LF on/off.....S-Tab"
text " Usage Log on/off...Alt-U  Misc. functions....Alt-M ³ Send BREAK........C-End"
text "                                                                             "
text "                       EXIT  Menu Screen & Session Timer                     "

select  1, 2,24,D
select  2, 2,24,S
select  3, 2,24,X
select  4, 2,24,P
select  5, 2,24,K
select  6, 2,24,L
select  7, 2,24,F
select  8, 2,24,H
select  9, 2,24,U
select  1,28,24,Q
select  2,28,24,R
select  3,28,24,G
select  4,28,24,O
select  5,28,24,T
select  6,28,24,B
select  7,28,24,J
select  8,28,24,C
select  9,28,24,M
select  1,55,23,E
select  2,55,23,V
select  3,55,23,A
select  4,55,23,I
select  5,55,23,Ctl2
select  6,55,23,Y
select  7,55,23,W
select  8,55,23,ShTab
select  9,55,23,CtrlEnd
select 11,23,35,Z
pend


;*****KEY BOARD DEFINITIONS

D:      TYPE 0,32
P:      TYPE 0,25
S:      TYPE 0,31
Y:      TYPE 0,21
F:      TYPE 0,33
O:      TYPE 0,24
PGUP:   TYPE 0,73
H:      TYPE 0,35
V:      TYPE 0,47
E:      TYPE 0,18
L:      TYPE 0,38
C:      TYPE 0,46
R:      TYPE 0,19
M:      TYPE 0,50
Q:      TYPE 0,16
J:      TYPE 0,36
B:      TYPE 0,48
X:      TYPE 0,45
PGDN:   TYPE 0,81
A:      TYPE 0,30
I:      TYPE 0,23
G:      TYPE 0,34
CtrlEND: TYPE 0,117
ShTAB:  TYPE 0,67
Ctl2:   TYPE 0,0            ;ACTUALLY DOES NOTHING - TELIX USES SCAN CODE NOT
HOME:   TYPE 0,71                                  ;SUPPORTED BY MOUSE DRIVER
Z:      TYPE 0,44
END:    TYPE 0,79
K:      TYPE 0,37
T:      TYPE 0,20
U:      TYPE 0,22
W:      TYPE 0,17
NOTHING: NOTHING
SPACE:  TYPE 32

;*****END OF TELIX DEF FILE
