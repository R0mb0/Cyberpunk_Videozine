;Telix 3.00 Logitech Mouse Menu
;By Robert F. Rapp
;Sun  07-03-1988 12:18:48

BEGIN  LeftB,MidB,RightB,LeftM,RightM,UpM,DownM,25,25
CHORDS  LMB, LRB, MRB, ALLB

LeftB:  TYPE ENTER
MidB:   MATCH 2,27,,"Telix ",MAIN,CHECK1
RightB: TYPE ESC
Leftm:  TYPE 0,75
RightM: TYPE 0,77
UpM:    TYPE 0,72
DownM:  TYPE 0,80

;*****CHORDS
LMB:    Type "Y"
LRB:    MATCH 1,5,,"Dialing",CK1,S
CK1:    MATCH 3,3,,"  1",END,PGUP  ;For Pgup/Pgdn functions in dialing directory
MRB:    Type "N"
ALLB:   MATCH 1,5,,"Dialing",CK2,R
CK2:    MATCH 3,3,,"136",HOME,PGDN ;

;*****MAIN MENU OVERLAY -
MAIN:  POPUP 6, 2,BOLD
text " Dialing directory..Alt-D  Queue Redial #s....Alt-Q ³ Local echo........Alt-E"
text " Send files.........Alt-S  Receive files......Alt-R ³ DOS command.......Alt-V"
text " Exit Telix.........Alt-X  Run script (Go)....Alt-G ³ Run editor........Alt-A"
text " Comm Parameters....Alt-P  cOnfigure Telix....Alt-O ³ Screen Image......Alt-I"
text " Key defs./macros...Alt-K  Terminal emulation.Alt-T ³ Printer on/off...Ctrl-@"
text " Capture on/off.....Alt-L  Scroll Back........Alt-B ³ Chat Mode.........Alt-Y"
text " DOS Functions......Alt-F  Jump to DOS shell..Alt-J ³ Translate Table...Alt-W"
text " Hang-up modem......Alt-H  Clear screen.......Alt-C ³ Add LF on/off.....S-Tab"
text "                           Usage Log on/off...Alt-U ³ Send BREAK........C-End"
text "                                                                             "
text "                       EXIT  Menu Screen & Session Timer                     "

select  1, 2,24,D
select  2, 2,24,S
select  3, 2,24,X
select  4, 2,24,P
select  5, 2,24,K
select  6, 2,24,L
select  7, 2,24,F
select  8, 2,24,H
select  1,28,24,Q
select  2,28,24,R
select  3,28,24,G
select  4,28,24,O
select  5,28,24,T
select  6,28,24,B
select  7,28,24,J
select  8,28,24,C
select  9,28,24,U
select  1,55,24,E
select  2,55,24,V
select  3,55,24,A
select  4,55,24,I
select  5,55,24,Ctl2
select  6,55,24,Y
select  7,55,24,W
select  8,55,24,ShTab
select  9,55,24,CtrlEnd
select 11,23,35,Z
pend

;*****DIALING MENU OVERLAYS
CHECK1:   execute CHECKMATCH1
                ;THIS MAY NEED TO BE MODIFIED IF ANY BOMBS SHOW UP, TO CHECK FOR
                ;DIALING, EDIT, AND OTHER DIAL MENU FUNCTIONS IN TELIX.
                ;SO FAR NONE HAVE SHOWED THEMSELVES, BUT HERE IS THE FIX AREA.

;*****SELECT PAGE CHECKS
CHECKMATCH1:    MATCH 3,3,,"  1",DD1,CHECKMATCH2
CHECKMATCH2:    MATCH 3,3,," 16",DD2,CHECKMATCH3
CHECKMATCH3:    MATCH 3,3,," 31",DD3,CHECKMATCH4
CHECKMATCH4:    MATCH 3,3,," 46",DD4,CHECKMATCH5
CHECKMATCH5:    MATCH 3,3,," 61",DD5,CHECKMATCH6
CHECKMATCH6:    MATCH 3,3,," 76",DD6,CHECKMATCH7
CHECKMATCH7:    MATCH 3,3,," 91",DD7,CHECKMATCH8
CHECKMATCH8:    MATCH 3,3,,"106",DD8,CHECKMATCH9
CHECKMATCH9:    MATCH 3,3,,"121",DD9,CHECKMATCH0
CHECKMATCH0:    MATCH 3,3,,"136",DD0,Z

;*****Dial Select Pages
;*****Select From Page 1
