;*****KEY BOARD DEFINITIONS

D:      TYPE 0,32
P:      TYPE 0,25
S:      TYPE 0,31
Y:      TYPE 0,21
F:      TYPE 0,33
O:      TYPE 0,24
PGUP:   TYPE 0,73
H:      TYPE 0,35
V:      TYPE 0,47
E:      TYPE 0,18
L:      TYPE 0,38
C:      TYPE 0,46
R:      TYPE 0,19
M:      TYPE 0,50
Q:      TYPE 0,16
J:      TYPE 0,36
B:      TYPE 0,48
X:      TYPE 0,45
PGDN:   TYPE 0,81
A:      TYPE 0,30
I:      TYPE 0,23
G:      TYPE 0,34
CtrlEND: TYPE 0,117
ShTAB:  TYPE 0,67
Ctl2:   TYPE 0,0
HOME:   TYPE 0,71
Z:      TYPE 0,44
END:    TYPE 0,79
K:      TYPE 0,37
T:      TYPE 0,20
U:      TYPE 0,22
W:      TYPE 0,17
NOTHING: NOTHING

;*****DIALING SELECTION DEFINITIONS
        ;"-" EXECUTES DEFINED PREFIX AS A DEFAULT. IGNORED IF NOT DEFINED.
        ;SPACE AFTER NUMBER ENABLES QUEUE TO BE DEVELOPED. COULD REPLACE WITH
        ;,(comma)ENTER IF SINGLE NUMBER ONLY IS USED, TO BYPASS DOUBLE CLICK.
A1:      Type "-1 "
A2:      Type "-2 "
A3:      Type "-3 "
