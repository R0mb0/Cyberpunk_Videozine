///////////////////////////////////////////////////////////////////////////////
// Shell_Sort()
//
// Fastest way of sorting elements yet!

// parameters:  length:  length of an element

// variables:   gap:     size of gap
//              swap:    swap flag
//              potr:    a pointer to a pos in the list

shell_sort(int length)
{
int gap, swap, potr;
int pos, pty;

str s1[length],s2[length];

gap = strlen(file_list)/(length*2) - 1;   //  get number of elements
                              // get first gap (half of number of elements)

while(gap >= 1)
     {
      swap = 0;
      while (swap == 0)
       {
        swap = 1;

       for (potr = 1; potr <= strlen(file_list)/length-gap; ++potr)
           {
            substr(file_list,(potr-1)*length,length,s1);
            substr(file_list,(potr-1)*length+(gap*length),length,s2);

            if (s1 > s2)
                  {
                   copychrs(s1,file_list,(potr-1)*length+(gap*length),length);
                   copychrs(s2,file_list,(potr-1)*length,length);
                   swap = 0;
                   }
              }
           }
         gap = gap/2;
        }
}
///////////////////////////////////////////////////////////////////////////////
// Here is a qsort() function, based on qsort.c:
// (obtained as RG_QSORT.C in SNIP1091.ZIP - Snippets from C echo)
// qsort.c  --  ANSI Quicksort function                           //
// Public domain by Raymond Gardner, Englewood CO  February 1991  //
// Sorts an array starting at base, of length nbr_elements, each  //
// element of size width_bytes, ordered via compare_function,     //
// which is called as  (*compare_function)(ptr_to_element1,       //
// ptr_to_element2) and returns < 0 if element1 < element2,       //
// 0 if element1 = element2, > 0 if element1 > element2.          //
// Most refinements are due to R. Sedgewick. See "Implementing    //
// Quicksort Programs", Comm. ACM, Oct. 1978, and Corrigendum,    //
// Comm. ACM, June 1979.                                          //
int size = 12; // Size is the width of an element
str s1[12], s2[12];     // These two strings must have length
                        // SIZE. Here SIZE is 12 for an array of
                        // filenames.
// Qsort()
// Public domain by Andras Pattantyus, 12/31/92
// This will sort a SALT pseudo-array (a SALT string with "elements"
// padded to the same length with spaces). The LIST array must be
// global. SIZE and the length of S1 and S2 must be changed to reflect
// the list that you are sorting. This function can handle a maximum of
// 255 elements [due to the way the stack is saved; this can easily be
// changed if you know your SALT]. At last count, this function is 3
// times faster than my best Shell sort. Worth it.

qsort( ){
   str stack[40];               // stack and stack pointer
   int i, j, limit, sp;        // scan and limit pointers
   int thresh;                 // size of T elements in bytes
   int base = 0;
   thresh =  7 * size;  // Threshold. The 7 here is arbitrary, and
   // other values may be more efficient. It must be at least 3.
   limit = strlen(list);// pointer past end of array
   while (1) {                 // repeat until break...
      if ( limit - base > thresh ) {  // if more than 7 elements
    swap( (limit-base)/size/2*size + base, base);//swap base with middle
         i = base + size;             // i scans left to right
         j = limit - size;            // j scans right to left
         comp(i, j, 1);          // Sedgewick's three-element sort
         comp(base, j, 1);       // sets things up so that
         comp(i, base, 1);       // i <= base <= j
         while (1){             // loop until break
            do i = i + size;                  // move i right
            while ( comp(i, base, 0) < 0 );   // until i >= pivot
            do j = j - size;                   // move j left
            while ( comp(j, base, 0) > 0 );    // until j <= pivot
            if ( i > j ) break; // if pointers crossed, break
            swap(i, j);        // else swap elements, keep scanning
            }
         swap(base, j);         // move pivot into correct place
         if ( j - base > limit - i ) {  // if left subfile larger
            setchr(stack, sp, base/size);  // stack left subfile base
            setchr(stack, sp+1, j/size);   //    and limit
            base = i; }                    // sort the right subfile
         else {                         // else right subfile larger
            setchr(stack, sp, i/size);  // stack right subfile base
            setchr(stack, sp+1, limit/size);   //    and limit
            limit = j; }              // sort the left subfile
         sp = sp + 2; }                   // increment stack pointer
      else {      // else subfile is small, use insertion sort
         j = base;
         i = j + size;
         while (i < limit)   {
              for ( ; comp(j, j+size, 0) > 0; j = j - size ) {
                   swap(j, j + size);
                   if ( j == base )
                       break;}
              j = i;
              i = i + size; }
         if ( sp != 0 ) {         // if any entries on stack
            sp = sp - 2;                  // pop the base and limit
            base = subchr(stack, sp)*size;
            limit = subchr(stack, sp+1)*size; }
         else break; }}}                // else stack empty, done
comp( int one, int two, int swap) {
subchrs(list, one, size, s1); subchrs(list, two, size, s2);
if (s1 > s2) {
    if (swap) {
        copychrs(s2, list, one, size);
        copychrs(s1, list, two, size);  }
    return 1; }
else if (s2 > s1)
    return -1;
else return 0;}
swap(int one, int two) {
subchrs(list, one, size, s1); subchrs(list, two, size, s2);
copychrs(s1, list, two, size); copychrs(s2, list, one, size); }

