//////////////////////////////////////////////////////////////////////////////
// ED 1.0  - (Hopefully everybody has a 286 by now!)                        //
// A Full-Screen ANSI Message Editor for xHost                              //
//////////////////////////////////////////////////////////////////////////////
//[line][] pad to 74      not yet: [ | ] [Soft | Hard return]

str text          [7400],
    HELP          [80],
    current_caller[26];

int finished_caller,        // if end of call
    exit_requested,
    last_line_done,         //  last line processed by word-wrap func
    help_line,              //  position of help line
    pointx,                 //  x coord
    pointy,                 //  y coord
    endx,                   //  number of chars on current line
    high_line,              //  last line edited
    line_num,               //  beginning of current line in TEXT
    last_mark,              //
    check_carrier,          //
    local_mode,             //
    timer_begin,            //
    private,                //  status byte
    insert = 1,             //
    exit = 0,
    lps, // lines per screen
    tols,   // top of last screen linenumber
    tps,    // text per screen
    tmark;
    
int time_on_screen;

str destin[26], subj[26], host_dir[64], mnum[3];

int abort = 0,
    full,
    char = 0;
int msglen = 128;
int ref, page_length = 24;

//////////////////////////////////////////////////////////////////////////////

main( str from, str to, str subject, str msg_num, int pvt, int
      call_st, int t_start, str c_dir, int refer)
{
int rval = 1;
_scr_chk_key = 0;

time_on_screen = 0;

host_dir = c_dir;
mnum = msg_num;
ref = refer;
destin = to;
subj = subject;
private = pvt&3;    // drop all other bits
current_caller = from;
check_carrier = call_st&2;
timer_begin = t_start;
local_mode = call_st&1;

tmark = timer_start(timer_begin); 
// Supported Codes:

// 18176  Home		  ^[[H
// 18432  Up		  ^[[A
// 20480  Down		  ^[[B
// 19712  Right 	  ^[[C
// 19200  Left        ^[[D
// 20224  End		  ^[[K
// 21248  Del                 ESC[P
// 20992  Insert Mode  ^V      ESC[4h = On,  ESC[4l = Off
//     8  BS           ^H
//    25  Del line     ^Y      ESC[M
//    26  Help         ^Z
//
// ^c               PageDown
// ^r               PageUp
// ^d               CursorRight
// ^e               CursorUp
// ^s               CursorLeft
// ^x               CursorDown
// ^o               Quote

 puts("^L^M^JLoading...");
 gethelpline();
 init();

 puts("^M^JDo you want to use the Full Screen Editor");

 full = yn('Y');
 if (!finished_caller)
    {
     while (rval == 1)
           {
            if (full)
                rval = full_scr();
            else
                {
                insert = 0;
                rval = ttyed();
                }

            if (rval == 1)
               rval = menu();
            }
     if (rval == 2)
         save();
     }
 // so 0 = no save, 2 = save
 call_st = call_st | (8 * finished_caller);
 call_st = call_st | (exit_requested * 16);
 call_st = call_st&254;
 call_st = call_st | local_mode;
 timer_free(tmark);
 return rval;
 }
//////////////////////////////////////////////////////////////////////////////
full_scr( )
 {
int c, x, new_mark;

str temp         [255];
pointx = 1;
lps = page_length - 2;
tps = (lps-1) * 74;
tols = (99-lps) * 74;

if (line_num > tols)
    pointy = (line_num-tols)/74 + 1;
else
    pointy = 1;

redraw();
// Total of 99 lines @ 72 characters/line (72 allowed, 1 buffer, 1 EOL)
// 22 lines on screen
// Start x = 1, y = 1
// Max x = 72, y = 22
//
// Here goes main loop!
exit = 0;
last_mark = timer_total(tmark);
        
disptime();
while (!exit)  // exit is on when we want to quit (no consideration to
     {         // other facts)
      c = 0;
      if (char = inkey())
         {
         if(char > 255)
            char = check_action();
          }
      else if (cinp_cnt() && !local_mode)  // if any chars in buffer
           char = cgetc();     // get first

      if (char > 0)
          last_mark = 0;
                              // endx = number of chars on line
 if ((char >=28 && char <= 255) && char != 127) // don't allow control chars
     {
      ++pointx;          // move x axis up by one

      if (!local_mode)
         cputc(char);
      printc(char);     // don't have to worry about translation

      if (pointx > endx+1)  // increment our End pointer if necessary
         {
          setchr(text, line_num + endx, 32);  // get rid of old EOL marker
          endx = pointx - 1;
          }
      else if (insert)    // we have to shift text somehow
         {
          substr(text, line_num + pointx - 2, endx - pointx + 2, temp);
          copychrs(temp, text, line_num + pointx - 1, endx - pointx + 2);
          ++endx;
          }

      setchr(text, line_num + pointx - 2, char); // save char

      if (endx < 73)      // if less than 73 chars on line, then we're ok.
          continue;

          if (pointx == 74)
              {
               pointx = reformat(line_num, endx, pointy, ""); // this will do it

               if (line_num < 7252)
                   down();
               else
                  {
                   puts_c(7);
                   puts_c(8);
                   pointx = strchr(text, line_num, 17) - line_num + 1;
                   }
               xy(pointy, pointx);
               endx = strchr(text, line_num, 17) - line_num;
               check_user();
               continue;
               }
          else
              {
                setchr(text, line_num + 73, 17);    // set end marker

                if (line_num > high_line)
                    high_line = line_num;
                x = endx;
                //  start reformat
                //  if text won't fit on line... look for space
                temp = "";
                endx = line_num + 72;

                while (subchr(text, endx) != 32 && endx > line_num)
                       --endx;
                setchr(text, line_num + 73, 32);

                if (subchr(text, endx) == 32)
                    {
                    new_mark = endx;
                    while (subchr(text, endx-1) == 32 && endx > line_num)
                           --endx;
                    setchr(text, endx, 17);     // set new eol marker
                    substr(text, new_mark + 1, 72 - new_mark + line_num, temp);
                    }
                 else                       // if no space was found
                    {
                     new_mark = line_num + 72;
                     endx = new_mark;
                     substr(text, endx, 1, temp);
                     setchr(text, endx, 17);     // set new eol marker
                     }

                 if (!temp) // meaning nothing done
                   {
                     check_user();
                     setchr(text, line_num + x, 17);
                     endx = strchr(text, line_num, 17) - line_num;
                     continue;
                     }
                 xy(pointy, strchr(text, line_num, 17) - line_num + 1);
                 puts("^[[K");       // except wrapped word(s).

                 inschrs(" ", temp, strlen(temp), 1);
                 reformat(line_num + 74, endx - line_num, pointy + 1, temp);     // this will do it

                 if (new_mark - line_num < pointx - 2)     // next line
                    {
                      if (line_num < 7252)
                         {
                          pointx = pointx - new_mark + line_num - 1;
                          down();
                          }
                      else
                           pointx = strchr(text, line_num, 17) - line_num + 1;
                    }
               }
        xy(pointy, pointx);
        endx = strchr(text, line_num, 17) - line_num;
        check_user();
        continue;
      }
check_user();
if (char <= 0)
   continue;
else if (char == 27)    // if we have ESCape
    {
      c = -1;
      if (!local_mode)
         {
         if ((c = cgetct(5)) == '[') // get ANSI code sequence
              c = cgetct(5);
         }

      if (c == -1)          // quit to menu
          {
           save_line();
           exit = 1;
           continue;
          }
     }
    
if (c == 'A' || char == 18432 || char == '^E')  // Cursor Up
 {       
   save_line();
   if (line_num > 0)
      {
       up();
       xy(pointy, pointx);
       endx = strchr(text, line_num, 17) - line_num;
      }
   continue;
  }
else if (c == 'B' || char == 20480 || (char == '^M' && insert == 0) || char == '^X')
    {                                 // Cursor Down or CR w/no insert
      if (line_num < 7252)
           {
            save_line();
            down();
            xy(pointy, pointx);
            endx = strchr(text, line_num, 17) - line_num;
           }
      continue;
    }
else if (c == 'C' || char == 19712 || char == '^D')  // Cursor Right
   {
    if (pointx < 72)
       {
        ++pointx;
        puts("^[[C");
        }
    else if (line_num < 7252 && pointy <= lps)
        {
        save_line();
        ++pointy;

        pointx = 1;     // go to beginning of next line
        line_num = line_num + 74;
        xy(pointy, pointx);
        endx = strchr(text, line_num, 17) - line_num;
        }
    continue;
   }
else if (c == 'D'|| char == 19200 || char == '^S')  // cursor left
     {
      if (pointx > 1)
         {
          --pointx;
          puts("^[[D");
          }
      else if (line_num > 0 && pointy > 1)
         {
          save_line();
          line_num = line_num - 74;
          --pointy;
          endx = strchr(text, line_num, 17) - line_num;
          pointx = endx+1;
          xy(pointy, pointx);
          }
      continue;
     }
else if (c == 'H' || char == 18176)         // Home
  {
  if (pointx > 1)
     {
       xy(pointy, 1);
       pointx = 1;
      }
   continue;
  }
else if (c == 'K' || char == 20224)         // End
 {
  while (subchr(text, line_num + endx - 1) == 32 && endx > 0)
         --endx;
  if (pointx != endx + 1)
      {
      pointx = endx + 1;
      xy(pointy, pointx);
      }
   continue;
  }             
else if (char == 18688 || char == '^R')     // Page Up
    {
    if (line_num == 0)
        continue;

    save_line();
    if (line_num - pointy * 74 - tps > 0)  // If can't reach Top of text
       {
        show(line_num - pointy * 74 - tps, line_num - pointy * 74, 1, 1);
        line_num = line_num - tps - 74;
       }
    else if (line_num - (pointy-1) * 74 == 0)
        {
        line_num = 0;
        pointy = 1;
        }
    else
       {
        show(0, tps, 1, 1);
        line_num = line_num - tps - 74;
        if (line_num < 0)
           line_num = 0;
        pointy = line_num/74 + 1;
        }
    xy(pointy, pointx);
    endx = strchr(text, line_num, 17) - line_num;
    continue;
    }
else if (char == 20736 || char == '^C')     // Page Down
    {
    if (line_num == 7252)
        continue;
    save_line();

    if (line_num + (lps - pointy + 1) * 74 + tps < 7252)     // if won't reach bottom
       {
        show(line_num + (lps - pointy + 1) * 74, line_num +
        (lps - pointy + 1) * 74 + tps, 1, 1);
        line_num = line_num + tps + 74;
        }
    else if (line_num + (lps - pointy) * 74 == 7252)
       {
        pointy = lps;
        line_num = 7252;
        }
    else
       {
        show(tols, 7252, 1, 1);
        line_num = line_num + tps + 74;
        if (line_num > 7252)
           line_num = 7252;
        pointy = (line_num-tols)/74 + 1;
        }
    xy(pointy, pointx);
    endx = strchr(text, line_num, 17) - line_num;
    continue;
    }
else if (char == '^M' && insert && line_num < 7252)
  {
    save_line();
    if (line_num <= high_line)
     {
      temp = "";
      if (pointx < endx + 1) // if not past end of text
         {
          substr(text, line_num + pointx - 1, endx + 1 - pointx, temp);
          setchrs(text, line_num + pointx - 1, 32, endx + 1 - pointx);
          puts("^[[K");                            // erase to EOL on screen
          endx = pointx - 1;
          while (subchr(text, line_num + endx - 1) == 32 && endx > 0)
                 --endx;
          setchr(text, line_num + endx, 17); // Set EOL marker in memory
          }

      high_line = high_line + 74;

      setchr(temp, strlen(temp), 17);
                                     // if not last line of text
      if (line_num < high_line - 74) // then insert new line
         {
          setchrs(temp, strlen(temp), 32, 74-strlen(temp));
          inschrs(temp, text, line_num + 74, 74);
          if (pointy < lps)
              {
              puts("^J"); // insert line
              if (pointy < lps - 1)
                 puts("^[[L");
              else
                 puts("^[[2K"); // erase line
              }
          else
             {
              puts("^[D");
              --pointy;
              }
          show(line_num + 74, line_num + 74, pointy + 1, 0);
          }
      else if (strlen(temp) > 1)      // or just copy over
          {
          copychrs(temp, text, line_num+74, strlen(temp));
          if (pointy == lps)
             {
              puts("^[D");
              --pointy;
              }
          show(line_num + 74, line_num + tps - (pointy-1) * 74, pointy + 1, 0);
          }

      down();
      pointx = 1;
      xy(pointy, pointx);
      endx = strchr(text, line_num, 17) - line_num;
    }
   else
       {
        down();
        xy(pointy, pointx);
        endx = strchr(text, line_num, 17) - line_num;
       }
   continue;
  }
else if (char == '^H')   // good ole BS
    {
    if (endx > 0 && line_num > high_line)
        high_line = line_num;

    if (pointx > 1)  // Case delete char
      {
       puts("^H");
       if (insert && pointx < endx+1)  // w/insert
          {
           substr(text, line_num + pointx - 1, endx - pointx + 2, temp);
           copychrs(temp, text, line_num + pointx - 2, endx - pointx + 2);
           --endx;
           puts("^[[P");
          }
       else
          {
           setchr(text, line_num + pointx - 1, 32);
           if (pointx == endx+1)
              --endx;
            }
       --pointx;
       }
    // Case join lines
    else if (line_num > 0 && line_num <= high_line && pointy > 1 && insert)
      {
       save_line();
       x = endx;
       line_num = line_num - 74;
       endx = strchr(text, line_num, 17) - line_num;
       --pointy;
       pointx = endx + 2;
       if (endx > 0 && x > 0)
          {
           substr(text, line_num, endx, temp);
           inschrs(" ", temp, strlen(temp), 1);
           del_line(line_num);
           high_line = high_line + 74; // undo what del_line did, since we don't
                                   // really know if the text will be a line
                                   // shorter
           new_mark = high_line;
           reformat(line_num, x, pointy, temp);
         
           if (last_line_done < new_mark)  // if last line wasn't displayed
              {
               show(last_line_done + 74, last_line_done + tps - 74, (last_line_done - line_num)/74 + pointy + 1, 1);
               if (strchr(text, new_mark, 17) == new_mark) // if last line is empty
                    high_line = new_mark - 74;
               }
         }
      else
          {
           if (x > 0)
             {
              puts("^[[A");
              del_line(line_num);
              }
           else del_line(line_num + 74);
           puts("^[[M"); // up and del line
           show(line_num + (lps - pointy) * 74, line_num + (lps - pointy) * 74,
                lps, 1);
           --pointx;
           }
       endx = strchr(text, line_num, 17) - line_num;
       xy(pointy, pointx);
       }
    else if (line_num > 0 && pointy > 1)
        {
         line_num = line_num - 74;
         --pointy;
         endx = strchr(text, line_num, 17) - line_num;
         pointx = endx + 1;
         xy(pointy, pointx);
        }
    continue;
    }
else if (char == ''|| char == 21248)    // delete char
    {
     if (pointx < endx + 1) // case delete char
      {
       substr(text, line_num + pointx, endx - pointx + 1, temp);
       copychrs(temp, text, line_num + pointx - 1, endx - pointx + 1);
       --endx;
       puts("^[[P");
       }
      continue;
     }
else if (char == '^I')
   {
    if (pointx <= 64)
       pointx = pointx + 8;
    else
       pointx = 72;
    xy(pointy, pointx);
   }
else if (char == '^Y')   // Delete line
    {
    // FIX using scrolls

     if ((line_num <= high_line || (endx > 0)) && !(endx == 0 && high_line == 0))
        {
         del_line(line_num);
         if (high_line < 0)
            high_line = 0;
         puts("^[[M"); // Delete line
         // display last line of text
         show(line_num + (lps - pointy) * 74, line_num + (lps - pointy) * 74, lps, 0);
         pointx = 1;
         xy(pointy, pointx);
         endx = strchr(text, line_num, 17) - line_num;
         }
      continue;
     }
else if (char == '^L')   // Redraw screen
       {
        save_line();
        redraw();
        }
else if (char == '^Z')      // Help
       {
        save_line();
        SendHelp();
        }
else if (char == '^V' || char == 20992)   // Insert mode on or off
   {
     insert = !insert;
     dispinsmode();         // DispInsMode will set insert mode on (ESC[4h)
    }
else if (char == '^U')      // Read from file
       {
        save_line();
        if (!local_mode)
            {
            fdelete("XHTMP.$$$");
            scrollm(0);
            puts("^[[4l^LReady to receive...");
            receive('A', ".\XHTMP.$$$");         // notice different tmp name
            Readin("XHTMP.$$$");
            fdelete("XHTMP.$$$");
            puts("^M^JDone...");
            }
        else
           {
            scrollm(0);
            puts("^[[4l^LEnter filename to import: ");
            input_strn(temp, 64);
            if (temp)
              {
               readin(temp);
               puts("^M^JDone...");
               }
            }
        delay(7);
        redraw();
        }
else if (char == '^O' && ref > 0)
      {
       save_line();
       quote();
       delay(10);
       redraw();
       }
  }

// return codes: 
//  1 = Goto menu
// -1 = Sysop exit (user was terminated)
if (insert)
    puts("^[[4l"); // insert off
scrollm(0);
return exit;
}
//////////////////////////////////////////////////////////////////////////////
ttyed( )
{
int c;
str temp[255];
puts("^M^JPlease enter your text below. Press Escape for command prompt.");
puts("^M^J  Ö");
setchrs(temp, 0, 'Ä', 72);
puts(temp);
puts("·");
line_num = high_line - 74;
if (line_num >= 0)
    endx = strchr(text, line_num, 17) - line_num;
else
    endx = -1;
newline();
exit = 0;
while (!exit && line_num <= 7252)
     {
       if (char = inkey())
          {
          if (char > 255)
             char = check_action();
          }
       else if (cinp_cnt() && !local_mode)  // if any chars in buffer
            char = cgetc();     // get first
       if (char > 0)
         last_mark = 0;
  
     if ((char >=28 && char <= 255) && char != 127) // don't allow control chars
        {
         if (!local_mode)
             cputc(char);
         printc(char);     // don't have to worry about translation
         setchr(text, line_num + endx, char); // save char
         ++endx;
         if (endx == 73)      // if less than 73 chars on line, then we're ok.
             reform();
         continue;
         }
     check_user();
     if (char <= 0)
        continue;

     else if (char == 27)
        {
        setchr(text, line_num + endx, 17);
        exit = 1;
        }

     else if (char == '^H')   // good ole BS
        {
         if (endx > 0)
            {
             puts("^H");
             setchr(text, line_num + endx, 32);
             --endx;
            }
         else if (line_num >= 74)
             {
              puts("^M^JBack to previous line.");
              high_line = high_line - 74;
              line_num = line_num - 148;
              endx = -1;
              newline();
              if (endx > 0)
                 {
                  substr(text, line_num, endx, temp);
                  puts(temp);
                  }
              }
           continue;
          }
     else if (char == '^M')
         newline();
     else if (char == '^I')
         {
          if (endx <= 64)
             {
              endx = endx + 8;
              puts("        ");
              }
          else
             {
              temp = "";
              setchrs(temp, 0, 32, 72-endx);
              puts(temp);
              endx = 72;
              }

        }
}

// return codes: 
//  0 = Exit requested to Terminal
//  1 = Goto menu
// -1 = Sysop exit (user was terminated)

if (endx)
   high_line = line_num;
else if (line_num >= 74)
   high_line = line_num-74;
else high_line = 0;
if (exit_requested == 1)
   return 0;
return exit;
}
//////////////////////////////////////////////////////////////////////////////
puts( str outstr )
{
printsc_trm(outstr);
if (!local_mode)
    cputs(outstr);
}			    
//////////////////////////////////////////////////////////////////////////////
getchar( )
{
 int c, stat, tm;

 tm = timer_total(tmark);

 do
   {
    if ((check_carrier && !carrier()) || timer_total(tmark)-tm >= 3000 || time_up(tmark))
        stat = -1;

    if ((c = inkey()) > 0)
       {
        if (c > 255)
           {
            if (stat = check_action(c))
                c = -1;
            }
        else
            stat = 1;
       }
    else if (cinp_cnt() && !local_mode)  // if any chars in buffer
        {
         c = cgetc();     // get first
         stat = 1;
         }
    }
  while (!stat);

 if (stat > 0)
    return c;

 if (timer_total(tmark)-tm >= 3000)
      puts("^L^GYou must have fallen asleep!");
 else if (time_up(tmark))
        puts("^M^J^JUnfortunately, your time is up for today.^M^J");
 else if (finished_caller)
       return -1;
 else if (check_carrier && !carrier())
       prints("^M^JCarrier lost, call terminated.^M^J");
 kick_out();
 return -1;
}
//////////////////////////////////////////////////////////////////////////////
// This is our function to locate ourselves on the screen.
// While I called it xy(), the first variable is actually Y.
// (I wanted to keep row, column).  Too lazy to change it.

xy( int row, int column)
{
 str ansiseq[20], tmp[20];
 
 ansiseq = "^[[";
 itos(row, tmp);
 inschrs(tmp, ansiseq, strlen(ansiseq), strlen(tmp));
 inschrs(";", ansiseq, strlen(ansiseq), 1);
 itos(column, tmp);
 inschrs(tmp, ansiseq, strlen(ansiseq), strlen(tmp));
 inschrs("H", ansiseq, strlen(ansiseq), 1);
 puts(ansiseq);
}
///////////////////////////////////////////////////////////////////////////////
// Shows message from start to end, starting at start_y
// Note that this can't be used to show more than one screen-full.

// ERASE is set if the remaining lines are to be erased.

show( int start, int end, int start_y, int erase)
{
 int t, y, mark;
 str tmp[80];
 y = start_y;
 
 if (insert)
    puts("^[[4l");

 xy(y, 1);
  
 for (t = start; t <= end && t <= high_line && y <= lps; t = t + 74)
    {
    if ((mark = strchr(text, t, 17) - t) > 0)
        {
        substr(text, t, mark, tmp);
        puts(tmp);
        }
    puts("^[[K");
    if (y < lps)
       puts("^M^J");
    ++y;
   }

if (erase)
   {
      for (; y <= lps; ++y)           // erase remaining lines
        {
         puts("^[[K");
         if (y < lps)
             puts("^M^J");
        }

   }
if (insert)
  puts("^[[4h");
}
///////////////////////////////////////////////////////////////////////////////
// This function puts all of our EOL markers (for some reason, a Ctrl-Q).
init( )
{
 int x;
 setchrs(text, 0, 32, 7400);
 for (x = 0; x <= 7326; x = x + 74)
    setchr(text, x, 17);
}
///////////////////////////////////////////////////////////////////////////////
// Sets the EOL marker and blanks out to EOL
// Also updates time on screen
save_line( )
{
 setchr(text, line_num + endx, 17);
 setchrs(text, line_num + endx + 1, 32, 73-endx);
 if (line_num > high_line && endx)
     high_line = line_num;
}
///////////////////////////////////////////////////////////////////////////////
// The word-wrappping function

reformat( int c_l, int x, int y, str f_w)
{
int good_x,
    cur_line,                // current line
    spacenum,                // number of spaces used to 'push' words to next
    save_ins,
                             // line

    gap,                     // distance between current & next line
    mpos,                    // position of EOL marker
    ptr,                     // position of last good space on line
    pty,
    new_mark,                // first space found
    quit = 0,
    len;                     // size of overall offset (spacenum - gap)
                             // initially length of (F_W).

str tmp[80], spaces[74];

pty = y;             // pty is our row pointer
tmp = f_w;

setchrs(spaces, 0, 32, 74);
cur_line = c_l;

                     // Mpos is real position of the current line's end marker.

                     // Good_x is the column number that shows where the
                     //  cursor should be placed after all is done.

                     // Ptr points to the space where we'll start wrapping.

save_ins = insert;
if (insert)
   puts("^[[4l");       // set insert mode off
insert = 0;

setchr(text, line_num + x, 17);    // set end marker

if (line_num > high_line)
    high_line = line_num;

len = strlen(tmp);

inschrs(tmp, text, cur_line, len);

while (!quit && (cur_line <= high_line + 74) && (cur_line <= 7252))
   {
    len = len + spacenum - gap;
    spacenum = 0;
    mpos = strchr(text, cur_line, 17);         // look for EOL marker
    gap = 73 + len - mpos + cur_line;
                                              
//  if text won't fit on line... look for space

    if (mpos - cur_line >= 73)
        {
        new_mark = -1;
        ptr = cur_line+72;
        while (subchr(text, ptr) != 32 && ptr > cur_line)
              --ptr;
        if (subchr(text, ptr) == 32)
           {
            setchr(text, mpos, 32);
            spacenum = cur_line + 73 - ptr;
            new_mark = ptr;
            }
        else     // if no space was found
           {
            new_mark = cur_line + 72;
            ptr = new_mark;
            spacenum = 2;
            }

        while (subchr(text, ptr-1) == 32 && ptr > cur_line)
               --ptr;

       if (new_mark - cur_line == 72 && mpos - new_mark == 1)
          {
           good_x = 1;
           quit = 1;
           setchr(text, ptr, 17);     // set new eol marker
           continue;
           }
       }
            
//  else if fits (and no text already)
    else if (mpos == cur_line+len)
         {
          if (high_line < cur_line)
              high_line = cur_line;

          delchrs(text, mpos-1, 1); // remove space
          --len;

          if (cur_line < high_line) // and in middle of text then insert new line
              {
              if (len < 74)
                {
                 inschrs(spaces, text, cur_line + 74, 74 - len);  // insert into text
                 len = 0;
                }
              else
                 {
                 len = len - 74;
                 inschrs(spaces, text, cur_line + 74, 74);  // insert into text
                 }
              setchr(text, cur_line + 74, 17);
              high_line = high_line + 74;
              if (pty < lps)
                  {
                  puts("^J"); // insert line
                  if (pty < lps - 1)
                     puts("^[[L");
                  else
                     puts("^[[2K"); // erase line
                  }
              //    show(cur_line+74, cur_line+tps+74, pty+1, 0);
              }
          ptr = strchr(text, cur_line, 17);         
          quit = 1;
          }   
// else if it fits with text already, then we can quit
    else
         {
          ptr = strchr(text, cur_line, 17);
          quit = 1;
         }
          
     if (pty <= lps)               // if we're still on screen, print
         {
          if ((len == 0 && !quit) && cur_line == c_l)
             {
               xy(pty, new_mark - cur_line + 1);
               puts("^[[K");       // except wrapped word(s).
               }
           else
              {
               substr(text, cur_line, ptr - cur_line, tmp);
        // *** wouldn't it be faster to simply insert the wrapped segment?
        // how to figure out the wrapped segment?
               xy(pty, 1);
               puts(tmp);
               puts("^[[K");
              }
          ++pty;
          }

    if (quit)
       continue;

    inschrs(spaces, text, new_mark + 1, spacenum);
    delchrs(text, mpos + spacenum, gap);

    if (cur_line == c_l)
        good_x = mpos - new_mark;

    setchr(text, ptr, 17);
    cur_line = cur_line + 74;
   }
   
 delchrs(text, strchr(text, cur_line, 17) + 1, len);
 insert = save_ins;
 if (insert)
    puts("^[[4h");       // set insert mode on
 last_line_done = cur_line;
 return good_x;
}
///////////////////////////////////////////////////////////////////////////////
dispinsmode( )
{
puts("^[[s^[[4l");       // save pos
xy(page_length, 40);
if (insert)
    puts("On ^[[4h");
else puts("Off");
puts("^[[u");       // restore pos
}
///////////////////////////////////////////////////////////////////////////////
disptime( )
{
 if (!full)
     return;

 str tmp[11];

 if ((timer_begin - timer_total(tmark))/600 != time_on_screen)
     {
       time_on_screen = (timer_begin - timer_total(tmark))/600;
       if (insert)
         puts("^[[4l");
       itos(page_length, tmp);
       inschrs("^[[s^[[", tmp, 0, 5);
       inschrs(";51H", tmp, strlen(tmp), 4);
       puts(tmp);
       itos(time_on_screen, tmp);
       puts(tmp);
       puts("   ^[[u");
       if (insert)
          puts("^[[4h");       // set on
       }
}
///////////////////////////////////////////////////////////////////////////////
newline( )
{
  str num[3];

  if (endx != -1)
      {
       while (subchr(text, line_num + endx - 1) == 32 && endx > 0)
             --endx;
       setchr(text, line_num + endx, 17); // Set EOL marker in memory
      }

  line_num = line_num + 74;
  endx = strchr(text, line_num, 17) - line_num;
  itos(line_num/74 + 1, num);
  puts("^M^J");
  inschrs(" ", num, 0, 2-strlen(num));
  inschrs("º", num, strlen(num), 1);
  puts(num);
}
///////////////////////////////////////////////////////////////////////////////
// Basically redraws our screen
redraw( )
{
int x;
str s[73];
x = insert;
puts("^[[2J^[[0;0m");      // clear, goto top, insert off
if (insert)
    puts("^[[4l");
insert = 0;
scrollm(0);
show(line_num - (pointy - 1) * 74, high_line, 1, 1);        // send text
xy(page_length, 1);
puts("Escape for menu, ^^Z for Help.  Insert:      Time: ");
time_on_screen = -1;
disptime();
insert = x;
dispinsmode();         // this will set insert on if necessary.
scrollm(1);
xy(pointy, pointx);
endx = strchr(text, line_num, 17) - line_num;
}
///////////////////////////////////////////////////////////////////////////////
reform( )
{
int spacenum,                // number of spaces used to 'push' words to next
    ptr,                     // position of last good space on line
    new_mark = -1;                // equal to ptr

str spaces[74], word[72];

setchr(text, line_num + 73, 17);    // set end marker

ptr = line_num+72;
while (subchr(text, ptr) != 32 && ptr > line_num)
      --ptr;
if (subchr(text, ptr) == 32)
   {
    spacenum = line_num + 73 - ptr;
    new_mark = ptr;
    while (subchr(text, ptr-1) == 32 && ptr > line_num)
            --ptr;
    setchr(text, ptr, 17);     // set new eol marker
    endx = ptr;
   }
if (new_mark == -1)      // if no space was found
   {
    new_mark = line_num + 72;
    setchr(text, new_mark, 17);
    spacenum = 2;
   }
substr(text, new_mark + 1, line_num + 72 - new_mark, word);

setchrs(spaces, 0, 8, line_num + 72 - new_mark);     // send backspaces
setchr(spaces, line_num + 72 - new_mark, 0);
puts(spaces);

setchrs(spaces, 0, 32, spacenum);
inschrs(spaces, text, new_mark + 1, spacenum);
delchrs(text, line_num + 74 + spacenum, spacenum);
newline();
puts(word);
}
///////////////////////////////////////////////////////////////////////////////
kick_out( )
{
 if (insert)
    puts("^[[4l");
 if (!finished_caller)
    puts("^M^JGoodbye!^M^J");
 if (check_carrier && carrier())
    {
     hangup();
     delay(5);
     if (carrier())
        {
        cputs_tr(_mdm_hang_str, 0);
        delay(10);
        flushbuf();
        }
     }
 finished_caller = 1;
 exit = -1;
}
///////////////////////////////////////////////////////////////////////////////

Prep(int num, str ext, str buf)
{
itos(num, buf);
inschrs("000", buf, 0, 3-strlen(buf));
inschrs(ext, buf, strlen(buf), strlen(ext));
}
///////////////////////////////////////////////////////////////////////////////

format(Str string, int length)
{
if (length > strlen(string))
 setchrs(string, strlen(string), 32, length-strlen(string));
}
///////////////////////////////////////////////////////////////////////////////
save( )
{
 int x;
 str tmp[100], tmp2[255];
 int ndxfile, datfile, num;

// see PLAN for format

 newdir(host_dir);
 tmp = mnum;
 prep(stoi(mnum), ".", tmp);
 tmp2 = tmp;
 strcat(tmp, "IDX");

 num = fl(tmp);          // get last message in conference

 strcat(tmp2, "MSG");

 datfile = fopen(tmp2, "a");

 if (!datfile || ferror(datfile))
    {
     puts("Error opening data file.");
     fclose(datfile);
     return -1;
     }
 fseek(datfile, 0, 2);
 if (filefind(tmp, 0))
    tmp2 = "r+";
 else 
    tmp2 = "w";

 ndxfile = fopen(tmp, tmp2);

 if (!ndxfile || ferror(ndxfile))
    {
      puts("Error opening index file.");
      fclose(ndxfile);
      fclose(datfile);
      return -1;
     }

 fseek(ndxfile, 0, 2);

 if (ftell(ndxfile) == 0)   // if we're at beginning, then we must write header
    {
     tmp2 = "";
     fwrite(tmp2, 128, ndxfile);
     }
 fclose(ndxfile);
 ndxfile = fopen(tmp, "a");     // reopen to write at end

 if (!ndxfile || ferror(ndxfile))
    {
      puts("Error on appending to index file.");
      fclose(ndxfile);
      fclose(datfile);
      return -1;
     }
 
 if (strcmpi(destin, "all") == 0)
    private = private | 32;
 fputc(private, ndxfile);
 itoc(num+1, 2, ndxfile);
 itoc(curtime(), 4, ndxfile);
 num = ftell(datfile);
 itoc(num, 4, ndxfile);
 tmp2 = "";

 for (x = 0; x <= high_line; x = x+74)
  {
  tmp = "";
  substr(text, x, strchr(text, x, 17)-x, tmp);
  if (tmp)
     {
      if (tmp2)
         {
          fputs(tmp2, datfile);
          tmp2 = "";
          }
      fputs(tmp, datfile);
      fputs("^M^J", datfile);
     }
  else
     inschrs("^M^J", tmp2, strlen(tmp2), 2);
  }

 itoc(ftell(datfile), 4, ndxfile);
 itoc(ref, 2, ndxfile);

 format(destin, 25);
 fwrite(destin, 26, ndxfile);
 format(current_caller, 25);
 fwrite(current_caller, 26, ndxfile);
 format(subj, 25);
 fwrite(subj, 26, ndxfile);
 tmp2 = "";
 fwrite(tmp2, 33, ndxfile);     // write reserved bytes
 fclose(datfile);
 fclose(ndxfile);
 puts("^M^JYour message has been saved.");
 return;
 }

///////////////////////////////////////////////////////////////////////////////
itoc( int src, int num, int file)
{
 str digits[4];
 int i, ma, mz, my;

if (num == 4)
  mz = 16777216;
else
  mz = 256;

 my = src;

 for (ma = 1; ma <= num; ++ma)
   {
    i = my/mz;
    setchr(digits, num-ma, i);
    my = my%mz;
    mz = mz/256;
    }
 fwrite(digits, num, file);
}
///////////////////////////////////////////////////////////////////////////////
yn(int def)
{
int c;

puts(" (Enter=");
puts_c(def);
puts(")? ");
while (c != 13 && c != 'Y' && c != 'N' && !finished_caller)
    c = toupper(getchar());

if (finished_caller)
   {
    exit = -1;
    return 0;
   }
if (c == 13)
    c = def;

if (c == 'Y')
  {
  puts("Yes");
  return 1;
  }
else if (c == 'N')
   {
   puts("No");
   return 0;
   }
 else
   return 0;
}    
///////////////////////////////////////////////////////////////////////////////
fl( str msg_index, int scan_through, int last_read )
{
 int first, last, file;

 file = fopen(msg_index, "r");

 if (file)
     {
       fseek(file, 1-msglen, 2);
       if (ftell(file) > msglen-1)
           last = fgetc(file) + fgetc(file)*256;
        else last = 0;
      }
  else
      last = 0;   // if file doesn't exist, return no msgs
 fclose(file);

 return last;
}
///////////////////////////////////////////////////////////////////////////////
check_action( )
{
 int save;

 Str tmp1[20] = "^G­Please Wait!";
 if (char == 11264 && Help_line != -1)      // *Alt-Z* Toggle through helps
    {
     if (subchr(help, 26) == ':')   //In help, goto First Info
        {
        setchrs(HELP, 0, 32, 80);
        copychrs(current_caller, HELP, 0, strlen(current_caller));

        copychrs("Time", HELP, 26, 4);
        itos ((timer_begin - timer_total(tmark))/600, tmp1);
        copychrs(tmp1, HELP, 31, strlen(tmp1));
        }
     else
        HELP = "Alt-{ F:DOSFunc H:HangUp X:Exit Y:Chat } Ctrl-PgUp/PgDn:ñ5min";

    vputchrs(0, help_line, HELP, 0, 80, 112);
    return 0;
    }
 else if (char == 8448)     // *Alt-F* Dos Functions
    {
      save = timer_total(tmark); // Aren't we $%@!* generous to save his time
      if (full)
         {
          xy(page_length-1, 34);
          puts("^[[5m");
          if (insert)
              puts("^[[4l");
          }

      save_line();
      puts(tmp1);
      if (full)
         puts("^[[0m");
      dosfunction();
      newdir(host_dir);
      timer_begin = timer_begin - save;
      timer_restart(tmark, timer_begin);

      if (full)
        {
         xy(page_length-1, 34);
         puts("^[[K");
         xy(pointy, pointx);
         }
      else
        {
         line_num = line_num - 74;
         endx = -1;
         newline();
         substr(text, line_num, strchr(line_num, 0, 17)-line_num, tmp1);
         puts(tmp1);
         }
      return 0;
     }              
  else if (char == 33792)     // *PgUp* Add 5 minutes to time
     {
      timer_begin = timer_begin - timer_total(tmark) + 3000;
      timer_restart(tmark, timer_begin);
      if (full)
         disptime();
      return 0;
     }
  else if (char == 30208)     // *PgDn* -5 minutes
      {
      timer_begin = timer_begin - timer_total(tmark) - 3000;
      timer_restart(tmark, timer_begin);
      if (full)
          disptime();
      return 0;
      }
 else if (char == 5376)
     {                                 // *Alt-Y* force chat
      if (full && insert)
          puts("^[[4l");
      save_line();
      scrollm(0);
      puts("^G^M^JHey ");
      puts(current_caller);
      puts(", this is the SysOp...");
      chatmode(1);
      puts("^M^JChat ended.");
      delay(20);
      if (full)
          redraw();
      else
         {
         setchr(text, line_num + endx, 17);
         line_num = line_num - 74;
         endx = -1;
         newline();
         substr(text, line_num, strchr(line_num, 0, 17)-line_num, tmp1);
         puts(tmp1);
         }
      return 0;
     }
else if (char == 11520)
    {                      // *Alt-X* sysop wants to exit
    exit_requested = 1;
    kick_out();
    exit = 1;
    return 0;
    }
else if (char == 8960)                   // *Alt-H* Terminate User
     {
      kick_out();
      return -1;
     }
return char;
}
////////////////////////////////////////////////////////////////////////////////
GetHelpLine( )
{
int x, y;
x = getx();
y = gety();
str list0[] = "00244249", things[2];
help_line = -1;
while (strlen(list0) > 0)
      {
        substr(list0, 0, 2, things);
        delchrs(list0, 0, 2);
        gotoxy(16, stoi(things));
        if (vgetchr()%256 == '³')
           help_line = stoi(things);
        }
gotoxy(x, y);
}
////////////////////////////////////////////////////////////////////////////////
Menu( )
{
 int quit = 0, c;
 str com[2], temp[74];

while (!quit && !finished_caller)
     {
  // allow: Save, Quit, Continue, Delete line, Insert line, Edit Line, List
      if (full)
         xy(page_length, 1);
      puts("^M^J^JWhat is your command? (?=help) ");
      c = -1;
      while (strchr("SQCFLDIR?", 0, c) == -1 && !finished_caller)
              c = toupper(getchar());

      if (!local_mode)
         cputc(c);
      printc(c);     // don't have to worry about translation

      puts("^M^J");

      if (c == 'Q' || !c)
         {
          puts("Are you sure you want to quit");
          if (yn('N'))          // confirm
             {
              puts("^L");
              quit = -1;
              }
           }
      else if (c == '?')          // HELP
           {
            puts("^M^JYou can: ");
            puts("^M^J (S)ave your message, (Q)uit back to XHost,");
            puts("^M^J (C)ontinue your message, use the (F)ull Screen Editor,");
            puts("^M^J (L)ist your message, (D)elete a line,");
            puts("^M^J (I)nsert a line, (R)eplace a line.");
            continue;
            }
      else if (c == 'S')
          quit = 2;
      else if (c == 'Q')
          quit = -1;
      else if (c == 'C')
         {
          full = 0;
          if (high_line >= 7252)
               puts("^JYour message can't be longer than 99 lines.");
          else
            {
             if (strchr(text, high_line, 17) > high_line)
                  high_line = high_line + 74;
             quit = 1;
             }
         }
      else if (c == 'L')
           showmsg();
      else if (c == 'F')
            {
            full = 1;
            quit = 1;
            }
      else if (c == 'D')
            {
            puts("Delete which line? ");
            input_strn(com, 2);
            if (stoi(com) >= 1 && stoi(com) <= (high_line+74)/74)
               {
                del_line((stoi(com)-1));
                puts("Done...");
                }
            }
      else if (c == 'I')
            {
            puts("Insert before which line? ");
            input_strn(com, 2);
            if (stoi(com) >= 1 && stoi(com) <= (high_line+74)/74 && high_line
                <= 7178)
               {
                setchrs(temp, 0, 32, 74);
                inschrs(temp, text, (stoi(com)-1)*74, 74);
                high_line = high_line + 74;
                setchr(text, (stoi(com)-1) * 74, 17);
                puts("Done...");
                }
            }
      else if (c == 'R')
            {
            puts("Replace which line? ");
            input_strn(com, 2);
            c = stoi(com);
            if (c >= 1 && c <= (high_line+74)/74)
               {
                c = (c-1)*74;
                substr(text, c, strchr(text, c, 17)-c, temp);
                inschrs(" ", com, 0, 2-strlen(com));
                puts("^M^JType in new line (Enter=no change):^M^J");
                puts(com);
                puts("º");
                puts(temp);
                puts("^M^J");
                puts(com);
                puts("º");
                input_strn(temp, 74);
                if (temp)
                    {
                     copychrs(temp, text, c, strlen(temp));
                     setchr(text, c+strlen(temp), 17);
                     puts("Done...");
                     }
                }
            }
      }
 return quit;
}
////////////////////////////////////////////////////////////////////////////////
showmsg( )
{
 int t, y = 2, pause = 1, mark;
 str tmp[74];

 puts("^M^JListing message:^M^J  Ö");
 setchrs(tmp, 0, 'Ä', 72);
 puts(tmp);
 puts("·^M^J");

 for (t = 0; t <= high_line; t = t + 74)
   {
    itos(t/74 + 1, tmp);
    inschrs(" ", tmp, 0, 2-strlen(tmp));
    inschrs("º", tmp, strlen(tmp), 1);
    puts(tmp);
    if ((mark = strchr(text, t, 17) - t) > 0)
        {
        substr(text, t, mark, tmp);
        puts(tmp);
        }
    if (nl(y, pause) == 0)
        break;
   }
}
////////////////////////////////////////////////////////////////////////////////
nl( int pointy, int pause )
{
int char;
str s[34];
puts("^M^J");
++pointy;
if (pointy < page_length-1)
    return;
pointy = 0;
if (!pause)
   return 1;
puts("More? (Y)es, (n)o, (c)ontinuous: ");
char = -1;
while (strchr("YNC^M", 0, char) == -1 && !finished_caller)
          Char = toupper(getchar());
if (char != '^M')
    {
      if (!local_mode)
         cputc(char);
      printc(char);     // don't have to worry about translation
     }
setchrs(s, 0, 8, 34);
puts(s);
if (char == 'N')
    return 0;
else if (char == 'C')
    pause = 0;
return 1;
}
////////////////////////////////////////////////////////////////////////////////
input_strn( str buf, int maximum )
 {
  int i = 0, key, finish = 0;

  while (!finish)
     {
      key = 0;
      key = getchar();

      if (key >= 33 && key <= 255)
          {
           if (i < maximum)
               {
                setchr(buf, i, key);
                if (!local_mode)
                    cputc(key);
                 printc(key);     // don't have to worry about translation
                ++i;
                }
           }
       else if (key == 32)    // if space
          {
           if (i > 0 && i < maximum)
              {
                setchr(buf, i, key);
                if (!local_mode)
                    cputc(key);
                 printc(key);     // don't have to worry about translation
                ++i;
               }
           }
       else if (key == 127 || key == 8)
           {
            if (i)
              {
               --i;
               puts_c(key);
               }
            }
       else if (key == '^M')
          {
           puts("^M^J");
           finish = 1;
           }
       else if (key == -1 || finished_caller)
          {                           // timeout or user disconnect
           setchr(buf, 0, 0);         // set string to empty to
           finish = 1;                // indicate end of call
          }
   }
   setchr(buf, i, 0);

   if (strlen(buf) <= 0)
      return 0;
      
   if (subchr(buf, 0))
       return 1;
  return 0;
}
///////////////////////////////////////////////////////////////////////////////
puts_c(int key)
{
str tmp[1];
setchr(tmp, 0, key);
puts(tmp);
}
///////////////////////////////////////////////////////////////////////////////
SendHelp()
{
if (insert)
    puts("^[[4l");
xy(11, 20);
puts("ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ Help ÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿^[[12;20H");
puts("³ You can type 99 lines at 72 characters  ³^[[13;20H");
puts("³ per line. Use the cursor keys and:      ³^[[14;20H");
puts("³                                         ³^[[15;20H");
puts("³  ^^V  Insert Mode       ^^Y  Delete Line  ³^[[16;20H");
puts("³  ^^R  Page up           ^^C  Page down    ³^[[17;20H");
puts("³  ^^S  Cursor Left       ^^D  Cursor Right ³^[[18;20H");
puts("³  ^^E  Cursor Up         ^^X  Cursor Down  ³^[[19;20H");
puts("³  ^^U  Upload Text       ^^O  Quote        ³^[[20;20H");
puts("³                                         ³^[[21;20H");
puts("³  Escape for menu   Any key to continue. ³^[[22;20H");
puts("ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ");
getchar();
show(line_num + (11-Pointy)*74, 7252, 11, 1);
dispinsmode();
xy(pointy, pointx);
return;
}
///////////////////////////////////////////////////////////////////////////////
Check_User( )
{
 if (!last_mark)
     last_mark = timer_total(tmark);

 if (timer_total(tmark)-last_mark >= 1200)
     {
      puts("^L^GYou must have fallen asleep!");
      kick_out();
      }
 else if (time_up(tmark))
      {
      puts("^L^M^JUnfortunately, your time is up for today.");
      kick_out();
      }
 else if (check_carrier && !carrier() && !finished_caller)
      {
       prints("^L^M^JCarrier lost, call terminated.");
       finished_caller = 1;
       kick_out();
      }
 else
      disptime();
}
///////////////////////////////////////////////////////////////////////////////
Down( )
{
  line_num = line_num + 74;
  if (pointy < lps)     // go to next line
      ++pointy;
  else
    {
     puts("^[D");  // scroll up
     show(line_num, line_num, lps, 0);
     }
}
///////////////////////////////////////////////////////////////////////////////
Up( )
{
line_num = line_num - 74;
if (pointy > 1)
    --pointy;
else
  {
   puts("^[M");
   show(line_num, line_num, 1, 0);
   }
}
///////////////////////////////////////////////////////////////////////////////
Del_Line( int pos )
{
 delchrs(text, pos, 74);
 setchr(text, 7326, 17);
 setchrs(text, 7327, 32, 73);
 if (pos <= high_line)
     high_line = high_line - 74;
}
///////////////////////////////////////////////////////////////////////////////
ReadIn( str fname )
{
int f, c;
str line[74];
f = fopen(fname, "r");

while (fgets(line, 80, f) > 0 && line_num <= 7252)
     {
     while ((c = strchr(line, 0, 9)) != -1) // remove Tabs
           setchr(line, c, 32);
     setchr(line, 72, 0);
     copychrs(line, text, line_num, strlen(line));
     setchr(text, line_num + strlen(line), 17);
     line_num = line_num + 74;
     }
 if (line_num > high_line)
    high_line = line_num;

 if (line_num >= tols)
     pointy = 1 + (line_num - tols)/74;
 else
     pointy = 1;
 fclose(f);
}
///////////////////////////////////////////////////////////////////////////////
scrollm( int on )
{
str out[7];
if (on)
   {
    itos(lps, out);
    inschrs("^[[1;", out, 0, 4);
    inschrs("r", out, strlen(out), 1);
    puts(out);
    }
else
    puts("^[[0r");
}
///////////////////////////////////////////////////////////////////////////////
Quote( )
{
 str tmp2[128];
 str tmp[80];
 int idxfile, datfile, insline;
 int t, y = 2, pause = 1, start, end, begquote, endquote, c;
 int stext, etext;
 stext = line_num;

// see PLAN for format
 newdir(host_dir);
 tmp = mnum;
 prep(stoi(mnum), ".", tmp);
 tmp2 = tmp;
 strcat(tmp, "IDX");

 strcat(tmp2, "MSG");

 datfile = fopen(tmp2, "r");

 if (!datfile || ferror(datfile))
    {
     puts("Error opening data file.");
     fclose(datfile);
     return -1;
     }
 fseek(datfile, 0, 0);

 idxfile = fopen(tmp, "r");

 if (!idxfile || ferror(idxfile))
    {
      puts("Error opening index file.");
      fclose(idxfile);
      fclose(datfile);
      return -1;
     }

 fseek(idxfile, 129, 0);      // skip header
 start = ctoi(2, idxfile);
 fseek(idxfile, (ref - start + 1) * 128, 0);
 fread(tmp2, 128, idxfile);
 fclose(idxfile);
 // get start and end of message in datfile
 start = get_int(tmp2, 7, 4);
 end   = get_int(tmp2, 11, 4);
 fseek(datfile, start, 0);

 scrollm(0);
 puts("^LListing message:^M^J  Ö");
 setchrs(tmp, 0, 'Ä', 72);
 setchr(tmp, 72, 0);
 puts(tmp);
 puts("·^M^J");

 t = 1;
 while (ftell(datfile) < end)
   {
    itos(t, tmp);
    inschrs(" ", tmp, 0, 2-strlen(tmp));
    inschrs("º", tmp, strlen(tmp), 1);
    puts(tmp);
    if (fgets(tmp, 74, datfile) >= 0)
        puts(tmp);
    ++t;
    if (nl(y, pause) == 0)
        break;
   }

 puts("^M^JStarting line: ");
 input_strn(tmp, 2);
 begquote = stoi(tmp);
 if (begquote < 1)
     return;
 puts("^M^JEnding line: ");
 input_strn(tmp, 2);
 endquote = stoi(tmp);
 if (endquote < begquote || endquote-begquote + 1 > 99 - high_line/74)
       return;

 fseek(datfile, start, 0);
 puts("Quoting...");
 setchrs(tmp2, 0, 32, 74);
 line_num = line_num + 74;
 stext = line_num;
 if (line_num <= high_line)
     insline = 1;
 else insline = 0;
 t = 1;
 while (fgets(tmp, 80, datfile) > 0 && line_num <= 7252)
      {
      if (t >= begquote && t <= endquote)
         {
          while ((c = strchr(tmp, 0, 9)) != -1) // remove Tabs
                setchr(tmp, c, 32);
          setchr(tmp, 72, 0);
          if (insline)
             {
             inschrs(tmp2, text, line_num, 74);
             high_line = high_line + 74;
             }
          copychrs(tmp, text, line_num, strlen(tmp));
          setchr(text, line_num + strlen(tmp), 17);
          line_num = line_num + 74;
          }
       else if (t > endquote)
          break;
      ++t;
      }
  if (line_num > high_line)
      high_line = line_num - 74;

  etext = line_num - 74;

  if (line_num >= tols)
      pointy = 1 + (line_num - tols)/74;
  else if (line_num >= 4 * 74)
      pointy = 5;
  else pointy = line_num/74 + 1;

  fclose(datfile);

  for (line_num = stext; line_num <= etext; line_num = line_num + 74)
       {
        end = strchr(text, line_num, 17) - line_num;
        if (end > 0)
            reformat(line_num, strchr(text, line_num, 17) - line_num, lps+1, "> ");
        else
            copychrs("> ^017", text, line_num, 3);
        if (last_line_done > line_num)  // to account for wraps
            etext = etext + 74;
        }
  return;
}
///////////////////////////////////////////////////////////////////////////////
ctoi( int num, int fcb )
{
  str tmp[4];
  fread(tmp, num, fcb);
  return get_int(tmp, 0, num);
}
///////////////////////////////////////////////////////////////////////////////
get_int( str src, int pos, int num )
{
int i, x, mult = 1;
for (x = 0; x < num; ++x)
  {
   i = subchr(src, pos + x) * mult + i;
   mult = mult * 256;
  }
return i;
}
