str out[280];
main()
{
int f;
f = fopen("d:\and\menu.def", "w");

fwrite(out, 100, f);

out = "";
fwrite(out, 255, f);

out = "The Main Menu";
fwrite(out, 25, f);

//1    x? Send menu
//2    xG Goodbye
//3    xC Chat
//10   xZ Shut XHost down
//11 !#xT Text Files
//14   xL Read Log
//15   xS DOS Command
// <H>elp <F>iles <T>ype <U>pload <D>ownload <S>hell <C>hat <G>oodbye
//44   xU Upload
//45   xD Download
//46 !#xF Raw (DOS) directory

fputc(1, f);     // goodbye
fputc(0, f);
fputc('G', f);
fputc(2, f);
fputc(0, f);

fputc( 1, f);    // chat
fputc( 0, f);
fputc('C', f);
fputc( 3, f);
fputc( 0, f);

fputc( 1, f);
fputc( 0, f);
fputc('?', f);
fputc( 1, f);
fputc( 0, f);

fputc(1, f);     // default protocol
fputc(0, f);
fputc('D', f);
fputc(56, f);
fputc(0, f);

fputc(1, f);    // type a file
fputc(0, f);
fputc('T', f);
fputc(11, f);
fputc(0, f);

fputc(1, f);        //file list (raw)
fputc(0, f);
fputc('F', f);
fputc(46, f);
fputc(0, f);

fputc( 1, f);      // shut down host
fputc( 1, f);
fputc('Z', f);
fputc( 10, f);
fputc( 0, f);

fputc(1, f);     // download
fputc(0, f);
fputc('D', f);
fputc(45, f);
fputc(0, f);

fputc(1, f);        // upload
fputc(0, f);
fputc('U', f);
fputc(44, f);
fputc(0, f);

fputc(1, f);        // read usage log
fputc(1, f);
fputc('L', f);
fputc(14, f);
fputc(0, f);

fputc(1, f);        // dos command/shell
fputc(1, f);
fputc('S', f);
fputc(15, f);
fputc(0, f);

out = "";

fwrite(out, 175, f);
fclose(f);
}
