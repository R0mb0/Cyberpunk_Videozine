                endm

parse           macro   string,fcb
                mov     si,offset string
                mov     di,offset fcb
                push    es
                push    ds
                pop     es
                mov     ax,290FH        ;;bits 0, 1, 2, 3 on
                int     21H
                pop     es
                endm

