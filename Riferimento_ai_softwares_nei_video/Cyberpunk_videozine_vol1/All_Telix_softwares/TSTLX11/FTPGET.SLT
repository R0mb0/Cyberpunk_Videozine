// FTPGET.SLT Telix script by Prof. Timo Salmi, University of
// Vaasa, Finland. All rights reserved.    Mon 28-December-1992
//
// This is to download a file from Garbo or other FTP archives
// to your Unix host
//
// To make this script operative you need to compile it applying
// CS ftpget

// ----------------------------------------
// Definition section, the global variables
// Edit these every time as you need
// For dir and file the case is important

str host[]    = "garbo.uwasa.fi";
str dir[]     = "/pc";
str file[]    = "INDEXTS.ZIP";
str type[]    = "binary";
// Put your own email address in below
str your_id[] = "id@host.domain";

// Examples of other alternatives (commented away)
//str host[]    = "WSMR-SIMTEL20.Army.Mil";
//str dir[]     = "pd1:<msdos.pgmutl>";
//str file[]    = "tsbase11.zip";

//str host[]    = "OAK.Oakland.Edu";
//str dir[]     = "/pub/msdos/batutl";
//str file[]    = "tsbat40.zip";

// ----------------------------
// The main program starts here

main()

{
  int t1, t2, t3;           // Auxiliary variables
  int st;                   // A status variable
  int tmark;                // For timing
  int n = 0;                // Counter for attempts
  int gotit = 0;            // False (has get file been got)
  while (n < 10)            // Try repeatedly up to ten times
   {
    loop:                   // A label for goto statements
    n = n + 1;              // Increase the counter
    //
    // --- Try to connect ---
    t1 = track ("Name (", 0);
    t2 = track ("unknown host", 0);
    t3 = track ("not reachable", 0);
    tmark = timer_start(300);         // Allow thirty seconds
    cputs ("ftp ");
    cputs (host);
    cputs ("^M");
    while (not time_up(tmark))
     {
      terminal();                     // Don't suspend things
      st = track_hit(0);
      if (st == t1)                   // We are in
       {
        timer_free (tmark);           // Free the timer
        track_free (t1);              // Look for no more matches
        track_free (t2);
        track_free (t3);
        break;                        // Exit the inner while
       }
      else if (st == t2)              // Unknown host
       {
        timer_free (tmark);           // Free the timer
        track_free (t1);              // Look for no more matches
        track_free (t2);
        track_free (t3);
        waitfor ("ftp>", 2);          // Slow down a bit
        cputs ("quit^M");             // Exit FTP
        goto final;                   // No use in continuing
       }
      else if (st == 3)               // Host not reachable
       {
        timer_free (tmark);           // Free the timer
        track_free (t1);              // Look for no more matches
        track_free (t2);
        track_free (t3);
        waitfor ("ftp>", 2);          // Slow down a bit
        cputs ("quit^M");             // Exit FTP
        delay_scr (300);              // Wait for half a minute
        goto loop;                    // Try again
       }
     } // end while
    cputs ("anonymous^M");
    //
    // --- Giving the password ---
    if (not waitfor ("Password:", 30))   // Thirty second
     {
      cputs ("quit^M");     // Exit FTP
      delay_scr (20);       // Wait for two seconds
      goto loop;            // Try again
     }
    cputs (your_id);
    cputs ("^M");
    //
    // --- Did we get in? ---
    t1 = track ("Guest login ok", 0);
    t2 = track ("User ANONYMOUS logged in", 0);
    tmark = timer_start(300);         // Allow thirty seconds
    while (not time_up(tmark))
     {
      terminal();                     // Don't suspend things
      st = track_hit(0);
      if (st == t1 || st == t2)       // Either will do
       {
        timer_free (tmark);           // Free the timer
        track_free (t1);              // Look for no more matches
        track_free (t2);
        track_free (t3);
        goto gogetit;
       }
     } // end while
    timer_free (tmark);               // Free the timer
    track_free (t1);                  // Look for no more matches
    track_free (t2);
    track_free (t3);
    waitfor ("ftp>", 2);              // Slow down a bit
    cputs ("quit^M");                 // Exit FTP
    delay_scr (20);                   // Wait for two seconds
    goto loop;                        // Try again
    //
    // --- Getting the file ---
    gogetit:
    waitfor ("ftp>", 2);              // Slow down a bit
    cputs (type);                     // binary or ascii
    cputs ("^M");
    //
    waitfor ("ftp>", 2);              // Slow down a bit
    cputs ("cd ");                    // change directory
    cputs (dir);
    cputs ("^M");
    //
    waitfor ("ftp>", 2);              // Slow down a bit
    t1 = track ("received", 0);
    t2 = track ("No such file or directory", 0);
    t3 = track ("File not found", 0);
    cputs ("get ");
    cputs (file);
    cputs ("^M");
    tmark = timer_start(6000);     // Allow ten minutes
    while (not time_up(tmark))
     {
      terminal();                  // Don't suspend things
      st = track_hit(0);           
      if (st == t1)                // File succesfully received
       {
        gotit = 1;
        break;                     // Exit the (inner) while loop
       }
      if (st == t2 || st == t3)    // No such file or directory
       {
        break;                     // Exit the (inner) while loop
       }
     } // end of while
    timer_free (tmark);            // Free the timer
    track_free (t1);               // Look for no more matches
    track_free (t2);
    track_free (t3);
    //
    // --- Closing up ---
    waitfor ("ftp>", 2);           // Slow down a bit (whooa! :-)
    cputs ("close");
    cputs ("^M");
    waitfor ("ftp>", 2);           // Slow down a bit
    cputs ("quit");
    cputs ("^M");
    //
    // End the loop since we got this far
    break;
   } // end of while

  //
  // Wake up the bemused user :-)
  final:
  waitfor (">", 2);
  alarm(1);
  prints ("");
  prints ("");
  if (gotit)
   {
    printsc ("File ");
    printsc (dir);
    printsc ("/");
    printsc (file);
    prints  (" succesfully received");
   }
  else prints ("Could not get the file, sorry!");
  cputs ("^M");

} // end of main()
