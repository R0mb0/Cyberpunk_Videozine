// UNIXHOST.SLT Telix script by Prof. Timo Salmi, University of
// Vaasa, Finland. All rights reserved.    Sun 27-December-1992
//
// This is to log to a Unix host through a server
//
// To make this script operative you need to compile it applying
// CS unixhost

// ----------------------------------------
// Definition section, the global variables
// (The password will be taken directly from the dialing directory)

str my_userid[]   = "ts",        // Put your user id in here
    my_lastname[] = "salmi",     // Put your id to the server in here
    host_name[]   = "Chyde";     // Put the target computer name in here


// ----------------------------
// The main program starts here

main()         // Each program must have at least this "main" function

{              // The scope is contained by the brackets { }

 int status;   // Define a local variable

 // We have a carrier, alert the user
 //
 if (carrier()) alarm (1);

 // Check that the dialing directory has a password for this system
 // If not, you'll first have to enter it there (start by alt-D)
 //
 if (not _entry_pass)
  {
   printsc ("Error, there is no password for ");   // no CR
   printsc (host_name);                     // From definition section
   prints  (" in your dialing directory");  // with CR
   wait(5);                                 // Wait half a second
   tone(440,30);                            // Emit a short beep
   return;                                  // Exit the main program
  }  // end of if

 // Try to establish an error correcting connection
 //
 if (not waitfor ("RELIABLE", 30))          // Max half a minute
  {
   prints ("A reliable connection has not been established");
   tone(440,30);                            // Emit a short beep
   return;                                  // Exit the main program
  }

 cputs ("^M");                              // Send a carriage return

 // We have a carrier, next establish a connection to the server
 //
 if (not waitfor ("Enter username>", 10))   // This is what we wait for
  {
   prints ("The server does not respond");
   tone(440,30);                            // Emit a short beep
   return;                                  // Exit the main program
  }
 cputs (my_lastname);
 cputs ("^M");                              // Send a carriage return

 // Select the desired host
 //
 if (not waitfor ("dialup>", 10))   // This is what we wait for
  {
   printsc (host_name);
   prints (" cannot be connected to");
   tone(440,30);                            // Emit a short beep
   return;                                  // Exit the main program
  }
 cputs ("c ");
 cputs (host_name);
 cputc ('^M');     // Another way to send a carriage return

 // Logging in
 //
 if (not waitfor ("login:", 10))            // This is what we wait for
  {
   prints ("The login prompt not encountered");
   tone(440,30);                            // Emit a short beep
   return;                                  // Exit the main program
  }
 cputs (my_userid);
 cputs ("^M");                              // Send a carriage return

 // Giving the password
 //
 if (not waitfor ("Password:", 10))   // This is what we wait for
  {
   prints ("The Password prompt not encountered");
   tone(440,30);                            // Emit a short beep
   return;                                  // Exit the main program
  }
 cputs (_entry_pass);  // Password from the dialing directory
 cputs ("^M");         // Send a carriage return

 if (waitfor ("Terminal recognized ", 10))
  {
  status = call("TRANSOFF");                // Call another script
  if (status == -1)
    prints("Translation tables could not be set off");
  else
    alarm(1);                     // We've made it, alert the user
  }

}  // end of main()


// ----------------------------------------------------
// This demonstrates how to write a subroutines in Salt
// You could, of course, use the delay function instead

wait(int duration)
{
  int t;                     // Define a local variable
  t = timer_start(duration); // Tenths of a second
  while (not time_up(t))     // Loop until time is up
  {;}                        // Just to prevent a compiler warning
  timer_free(t);             // Free the timer variable
}
