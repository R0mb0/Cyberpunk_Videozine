// TIMER.SLT Telix script by Prof. Timo Salmi, University of
// Vaasa, Finland. All rights reserved.    Mon 28-December-1992
//
// This is to altert you when a certain amount of time has run
//
// To make this script operative you need to compile it applying
// CS timer

// ----------------------------------------
// Definition section, the global variables
// Customize timeMax to your own preference

int timeMax = 6000;  // Time to run in tenth's of a second
int tmark;           // Auxiliary variable for timing
str timeStr[79];     // Auxiliary string for output

// ----------------------------
// The main program starts here

main()         // Each program must have at least this "main" function

{              // The scope is contained by the brackets { }

 //
 // --- timing ----
 tmark = timer_start(timeMax);
 while (not time_up(tmark))
  {
   terminal();                     // Don't suspend things
  }
 timer_free (tmark);               // Free the timer

 //
 // --- the time is up ---
 prints ("");
 prints ("");
 pstra ("Your own alarm time is up", 12);    // 12 is LightRed
 prints ("");
 itos ((timeMax/10), timeStr);
 strcat (timeStr, " seconds have elapsed");
 pstra (timeStr, 12);
 prints ("");
 alarm(3);

} // end of main()
