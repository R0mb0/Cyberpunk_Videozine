// 9600E.SLT Telix script by Prof. Timo Salmi, University of Vaasa,
// Finland. All rights reserved.               Sat 26-December-1992
//
// This is to initialize a MultiTech MultiModem V32 for a 9600 baud
// rate connection with Error correction
//
// To make this script operative you need to compile it applying
// CS 9600e

// ----------------------------------------
// Definition section, the global variables

int t,             // Variable for timing
    port = 1;      // Port number (change this, if necessary)

// ----------------------------
// The main program starts here

main ()    // Each program must have at least this "main" function
  {

  // Turn on the communications port
  //
  if (not set_port (port))
    {
    alarm (3);
    printsc ("Failed to set the COM");
    printn  (port);
    prints  (" port");
    return;
    }
  printsc ("Port ");
  printn  (port);
  prints  (" selected");

  // Set baud rate 9600, parity none, 8 data bits, 1 stop bits
  //
  if (not set_cparams (9600, 0, 8, 1))
    {
    alarm (3);
    prints ("Failed to set the port settings");
    return;
    }
  printsc ("Port ");
  printn  (port);
  prints  (" succesfully set at 9600 baud");

  t = timer_start(10);           // Initialize the timer variable
  while (not time_up(t)){};      // Wait for one second, {} is a dummy
  timer_free(t);                 // Free the timer variable
  cputs ("AT X4 M1 &E2 &E4 &E7 &E12 &G2 &E14 &BS1 #F0 #A0 $R1 $BA0^M");
  if (not waitfor ("OK", 5))     // Will the modem respond
    {
    alarm (3);
    printsc ("Failed to set modem init strings: Modem off or ");
    printsc ("not connected to port ");
    printn  (port);
    prints  ("");
    return;
    }

  t = timer_start(10);           // Initialize the timer variable
  while (not time_up(t)){};      // Wait for one second, {} is a dummy
  timer_free(t);                 // Free the timer variable
  cputs ("AT $MB9600 $SB9600 S0=0 S10=7 S11=80^M");
  if (not waitfor ("OK", 5))     // Will the modem respond
    {
    alarm (3);
    prints ("Failed to set the rest of the modem init strings");
    return;
    }

  }
