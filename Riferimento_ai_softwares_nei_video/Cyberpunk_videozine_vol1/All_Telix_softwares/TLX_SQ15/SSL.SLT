//-----------------------------------------------------------
// SSL.SL? Save Status Line.

// Please look at the comments through the whole file, and modify to
// suit your needs, BEFORE you use it. Then recompile with CS SSL.

// If you have suggestions for improving this script, please suggest
// improvements to me via old-fashioned snail-mail to:

//   Inge Vabekk
//   Hamangskogen 108
//   N-1300 SANDVIKA
//   NORWAY                   
//-----------------------------------------------------------

str sline[90]                        // Save status line here.
   ,temp  [4]                        // Temporary
   ,global []="GLOBAL"               // Name of global script.
   ,status []="STATUS"               // Status line number.
   ;

//-----------------------------------------------------------
// Script starts here.
//-----------------------------------------------------------

main()
{
int number;                          // Line number.

  if (call (global,"R",status,temp) < 0)
  { for (number=0; number<54;++number)   // Find status line.         
    { vgetchrs(0,number,sline,0,90);
      if (strposi(sline,"ALT-Z",0)>0) 
      { itos (number,temp);              // Write status line number
        call (global,"W",status,temp);   // into global var.
        vgetchrsa(0,number,sline,0,90);  // Save it.
        break;
      }
      else if (number==0)                // Skip lines 1-23.
        number = 23;
    }
  }
  number = stoi (temp);
  vputchrsa (0,number,sline,0,90);       // Restore status line.
  return (number);                       // Return line number.
}
