//-----------------------------------------------------------
// EXIT.SL? Toggle Auto Exit setting.
//
// This script is executed if you press Alt-X while being online.


// Please look at the comments through the whole file, and modify to
// suit your needs, BEFORE you use it. Then recompile with CS LOGOFF.

// If you have suggestions for improving this script, please suggest
// improvements to me via old-fashioned snail-mail to:

//   Inge Vabekk
//   Hamangskogen 108
//   N-1300 SANDVIKA
//   NORWAY                   
//-----------------------------------------------------------

str exit  [20]
   ,global[]="GLOBAL"
   ,read[]="R"                 // To READ from Global script.
   ,write[]="W"                // To WRITE to Global script.
   ;

//-----------------------------------------------------------
// Script starts here.
//-----------------------------------------------------------

main()
{
  if (!carrier()) 
    exittelix (0,1);

  call (global,read,"EXIT",exit);        // Nothing defined?

  if (strposi (exit,"YES",0) >= 0)       // EXIT?
    call (global,write,"EXIT","NO");     // Toggle to NO.
  else
    call (global,write,"EXIT","YES");    // Toggle to YES.

  call (global,write,"CHANGE","YES");    // Status changed.
  call ("display");
  return (0);
}

