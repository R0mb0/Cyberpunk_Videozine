//-----------------------------------------------------------
// MAILUP.SL? Automatic ASCII upload.
//
// Please look at the comments through the whole file, and modify to
// suit your needs, BEFORE you use it. Then recompile with CS MAILUP.


// Note: Lines commented out with //!! are not used in this script,
// but in other, related ones. Please don't delete them; they may
// become useful later.
//-----------------------------------------------------------

int LIMIT = 999;                  // Max. no. of lines for messages.

str bbs_type  [32]                // BBS type.
   ,codename   [8]                // This BBS's codename
   ,maildir   [64] = ""           // Mail directory
   ,input    [144]                // Input line.
   ,input1   [144]                // Help line.
   ,filespec  [64]                // File specification.
   ,shortname [10]                // Shortened name for this BBS.
   ,PrevConf  [20]                // Previous conference.
   ,file      [64]                // Filename for upload.
   ,allfiles [100]                // File *numbers* for upload.
   ,command   [10]="Command:"     // Command prompt.
   ,temp       [4]                // Short temporary string.
                                  // For the Global storage:
   ,global      []="GLOBAL"       // Global script.
   ,join        []="JOINCONF"     // Join Conference script
   ,bbstype     []="BTYPE"        // BBS type.
   ,short       []="SHORT"        // Short BBS name.
   ,code        []="CNAME"        // Codename for this BBS.
   ,graph       []="GRAPH"        // Graphics
   ,version     []="PCBVER"       // PCB version number
   ,conf        []="CONF"         // Current conference.
   ,prompt      []="PROMPT"       // Current command prompt.
   ;     

int tol = 300                            // No activity for 30 sec.
   ,stat, tmark                          // makes script time out. 
   ,mbbs, pcb, rbbs, opus, fido, crcs 
   ,PCBver                               // PCBoard version.
   ,first
   ,graphics
   ;

//-----------------------------------------------------------   
// Script starts here.
//-----------------------------------------------------------   

main()
{
int c, i, j, k, l, m;

  update_term();                         // Update status bar. 

// Only if online.

  if (!carrier())  
  { failtone();
    status_wind ("THIS SCRIPT ONLY WORKS IF YOU'RE ONLINE!",20);
    return (-1);
  }

  read (bbstype,bbs_type);               // Get BBS type. 
  read (short,shortname);                // Shortened BBS name.
  read (conf,PrevConf);                  // Previous conference.
  read (prompt,command);                 // Command prompt.

  mbbs = pcb = rbbs = opus = fido = crcs = 0;
  if      (bbs_type == "MBBS") mbbs = 1;
  else if (bbs_type == "PCB" )
  { pcb = 1;
    read (version,temp);
    PCBver = stoi (temp);                // Get PCB version. 
  }
  else if (bbs_type == "RBBS") rbbs = 1;
  else if (bbs_type == "OPUS") opus = 1;
  else if (bbs_type == "FIDO") fido = 1;
  else if (bbs_type == "CRCS") crcs = 1;
  else                                          
  { wrongBBS();                          // Doesn't match script!
    return (-1);
  }

// Search for the upload specifications.

  if (read (code,codename) <= 0)         // Get BBS ID-code.
    codename = "MAIL";                   // Set default.
  if (getenv ("XBOARD",maildir))         // Get XBoard dir.
    get_id_code();                       // Get correct ID-code.
  else if (m=fopen("XBOARD.DIR","r") >0) // Try open XBoard.DIR file.
  { fgets (maildir,64,m);                // Read dir.name.
    fclose (m);
    get_id_code();
  }
  else
    maildir = _up_dir;                   // If no XBoard, use MailDir.

  if (codename=="MAIL")
    strcat (maildir,shortname);          // Use short name.
  else
    strcat (maildir,codename);           // Use codename.
  strcat (maildir,"\");    

  filespec = maildir;                    // Get mail dir.
  strcat (filespec,codename);            // Add codename again.
  strcat (filespec,".m*");               // Add extension.
  setchrs (allfiles,0,' ',100);          // Init. all files to 0.

  while (filefind(filespec,0,file))      // For each file found:
  { filespec = "";               
    k = strposi (file,".M",0);           // Find number.
    setchrs(file,0,' ',k+2);
    setchr (allfiles,stoi(file),'!');    // Mark this file number.
  }

  while ((k=strposi(allfiles,"!",0)) > 0)// For each file found
  { setchr (allfiles,k,' ');             // earlier:
    itos (k,file);
    filespec=codename;                   // Build name.
    strcat(filespec,".M");
    strcat(filespec,file);
    message_up(filespec);                // Send message.
  }
  return(0);
}

//-----------------------------------------------------------
// Upload one message to the BBS.
//-----------------------------------------------------------

message_up (str fname)
{
int f, i, l, lineno, FSE, again          // File handle etc.
   ,RO, WT  
   ,t1, t2, t3, t4, t5, t6, t7, t8, t11  // Variables for tracking.
   ,SendOK
   ,empty, hide, number
   ;
str fullname [64]                        // Full file name.
   ,include  [64]                        // Include file name.
   ,conf     [20]                        // Conference name.
   ,towhom   [24]                        // To whom.
   ,reply     [6]                        // Reply to which mess.number
   ,subj     [26]                        // What subject?
   ,echo      [4]                        // Echo to other BBSes?
   ,priv      [4]                        // Private?
   ,help      [6]                        // Help string
   ,sline    [80]                        // Line read back from screen.
   ,quote     [4]                        // Previous
   ,nextq     [4]                        // and next quote.
   ;

  fullname = maildir;                    // Build full filename.
  strcat(fullname,fname);

  f=fopen(fullname,"r");                 // Open file,
  if (f < 0) return (0);                 // check for error.

// Read these before starting to send mail.

  if (fgets(input,144,f) <0) goto error; // Read conference.
  conf = input;
  if (fgets(input,144,f) <0) goto error; // Read name.
  towhom = input;
  if (fgets(input,144,f) <0) goto error; // Read reference
  reply = input;
  if (fgets(input,144,f) <0) goto error; // Read subject.
  subj = input;
  if (fgets(input,144,f) <0) goto error; // Echo to other systems (Yes/no)
  echo = input;
  strcat (echo,"^M");                    // Add a CR.      
  if (fgets(input,144,f) <0) goto error; // Read private (Yes/no)
  priv = input;
  goto OK;

error:
  fclose(f);
  fdelete (fullname);
  return (0);

OK:
  if (subchr(echo,0)=='Y')               // Answer to echo question
    echo = "y^M";                        // must be Y
  else                                   // or
    echo = "n^M";                        // N.

  if (subchr(priv,0)=='Y')               // Private?
    RO = 1;                              // Yes
  else                                   // or
    RO = 0;                              // No.

  if (call (Join,conf) < 0)              // Join conference.
    return (0);                          // Return if error.
  again = 0;

// Send the mail. Maildir contains directory, Filespec contains
// wildcard name of the files to be uploaded.

enter:                                   // Start entering message.
  WT = 1;                                // Wait time initially 1 sec.
  if (reply == "0")  
  { cputs("e ");
    if (pcb)                             // PCBoard won't have
    { cputs ("^M");                      // the name on the
      help = ":";
      if (PCBver>144) help="`ALL'?";
      if (!waitfor (help,WT))
        ++WT;                            // same line!
      else if (WT > 2)
        --WT;
    }
    cputs(towhom);
  }
  else
  { cputs("reply ");                     // Answer to previous message.
    cputs(reply);
  }
  cputs("^M");

  priv = "^M";
  SendOK = 1;
  if (pcb)                       // PCBoard:
  { SendOK = FSE = 0;
    if (PCBver>144)              // PCBoard > 14.4: Send is OK at first
      SendOK = 1;                // trigger.
    LIMIT = 96;
    t1 = track("=abort? ",0);    // Subject : (Blank)=abort?
                                 // or Subject (Enter)=abort?
    t11= track("hange? (",0);    // or Subject (Enter)=no change?

    t2 = track("Security",0);    // Security:? (R)eceiver only, (Enter)=none?
    if (RO) priv = "r^M";        // If private message.  
    t3 = track("Echo",0);        // Echo to Other Systems:? (Enter)=yes? 
                                 // 'Echo' Message, (Enter)=Y? (y)
    t4 = track("Editor",0);      // Use Visual Editor: (Enter)=yes?
                                 // Use Full Screen Editor? (n)
    if (PCBver < 145)
      t5 = track("(-------",0);  // Start sending.
    else
      t5 = track("nd mode)",0);  // Start sending.
    t6 = track("(C)ontin",0);    // Unknown name.
    t7 = track("ply to M",0);    // Message unknown.
    t8 = 0;                      // Command not understood.
  }
  else if (mbbs)  
  { FSE = 1;
    t1 = track("essage: ",0);      // Subject of message:
    t2 = track("Private ",0);      // Private message (Enter=N): 
    if (RO) priv = "y^M";          // If private message.
    t3 = track("Include ",0);      // Include original message (Enter=N): 
    echo = "n^M";                  // (This is the answer to that!)
    t4 = track("ter> key",0);      // Not FSE: Enter key twice to end!
    t5 = track("+----7->",0);      // Start sending.
    t6 = track("istered!",0);      // Sorry, that name is not registered!
    t7 = track("availabl",0);      // Message is not available for reply.
    t8 = track("lid comm",0);      // Command not understood.
    t11= 0;
  }

  tmark = timer_start (tol);
  lineno = 0;                            // Preset line number.

  while ((stat=trig()) > 0)
  { if (stat == t11)                     // Subject (PCBoard 14.5)?
    { t1 = t11;                          // t11 is same as t1, except
      t11 = 0;                           // it's for PCBoard 14.5
      PCBver = 145;                      // and later (???)
      itos (PCBver,temp);
      write (version,temp);              // Save PCB version.
    }
    if (stat == t1)                      // Subject?
      subject(reply,subj);               // Update subject.

    else if (stat == t2)                 // Private?
    { cputs(priv);                       // YEs or NO.
      SendOK = 1;                        // OK to send message now.
    }
    else if (stat == t3)                 // Echo to other systems:?
      cputs(echo);                       // YES or NO.

    else if (stat == t4)                 // Use Visual Editor?
    { if (pcb)                           // PCBoard?
      { if (PCBver < 145)
          cputs("n^M");                  // No.
        else
          cputs("U^M");                  // No echo for version >= 14.5
      }
      FSE = 0;
      SendOK = 1;                        // OK to send message now.
    }
    else if (stat == t5 && SendOK)       // Start entering message.
    { if (pcb)                           // PCB: Limited length.
      { i = gety()-1;                    // Read previous line from
        vgetchrs(0,i,sline,0,80);        // screen.
        i = strposi(sline,"/line, ",0);  // Get position of number.
        if (i > 40) 
        { substr (sline,i+6,5,help);     // Move the number string.
          LIMIT = stoi (help) - 2;
        }
        if (pcb && echo == "y^M")        // PCBoard and echo? Limit the
          if (LIMIT > 96) LIMIT = 96;    // length to 97 lines (starts on 0).
      }
      break;                             // Ready to send!
    }
    else if (stat == t6)
    { if (PCBver > 144) cputs ("C");
      cputs("^M");                       // Insist on that name!
    }
    else if (stat == t7)                 // Not available for reply
    { release();                         // Wrong conference or 
      reply = "0";                       // message deleted. Try again.
      goto enter;
    }
    else if (stat == t8)                 // Command not understood:
    { release();                         // Try
      goto enter;                        // again.
    }
  }
  release();                             // Free all tracks.

// Enter lines into either Full Screen Editor, or the line
// oriented editor. Both should work equally well.

  hide = 0;
repeat:
  empty = 0;
  
  while (fgets (input,144,f) >= 0)       // Get next line. 
  { if (again)
    { cputs ("<<<<-------- continued from previous message! --------^M");
      again = 0;
      lineno = 1;
    }

check:
    l = strchr(input,0,26);              // Find control-Z in string. 
    if (l >= 0) setchr(input,l,0);       // If found, replace by 0. 
    l = strchr(input,0,255);             // Find 'FF' in line. 
    if (l >= 0)                          // If using PCWrite, replace 
    { for (l=strip(input); l >=0; --l)
        if (subchr(input,l)==255)        // artificial spaces 
          setchr(input,l,' ');           // with normal spaces. 
    }

    if (!hide)
    { if (strposi (input,"!END",0) >= 0) // !END signals stop.
        break;
      if (strposi (input,"!TAG",0) >= 0) // !TAG trigs tagline. 
      { call ("Tagline");
        break;
      }
                                         // !INCLUDE includes another file.
      if ((i=strposi(input,"!INCL",0)) >= 0)
      { l = strip (input);
        for (i=i+5; i < l; ++i)
          if (subchr(input,i)==' ') break;
        if (++i < l-2)
        { hide = f;
          substr (input,i,l-i,include);
          f=fopen (include,"r");         // Open include file,
          if (f < 0) 
          { f = hide;                    // Failure.
            hide = 0;
          }
          goto repeat;
        }
      }
      if (strposi (input,"!SPLIT",0) >= 0) // !SPLIT splits message. 
      { cputs (" ------ message split here - continues next message!");
        cputs (" ------>>>>^M");
        again = 1;
        lineno = LIMIT+1;                // Set high line no. 
        goto endmes;       
      }
    }

    l = strip (input);
    if (l>71)
    { l = 72;
      while ( l > 50)
      { if (subchr(input,--l) <= ' ')    // Split the line by space. 
          goto split;
      }
      l = 71;                            // No space found after 50. 
split:
      substr (input,l+1,144,input1);     // Save second half. 
      setchr (input,l,0);                // End input here. 

      l = strip (input1);                // Delete trailing spaces.
      l = strip (input);
    }
    if (mbbs && !FSE)                    // MBBS: Line editor can't take
      waitfor (":",2);                   // full speed.

    if (l > 0)
    { if (PCBver > 144) prints (input);
      cputs (input);                     // Write current line. 
    }
    else
    { if (PCBver > 144) prints ("");
      cputs (" ");                       // No line; write space. 
    }
    if (l!=72) cputs ("^M"); 

    if (empty)                           // Add empty line?
    { empty = 0;
      if (PCBver > 144) prints ("");
      cputs (" ^M");                     // Do it.
      ++lineno;
    }

    terminal();                          // Update screen.
    ++lineno;                            // Next line.
    if (strlen(input1))                  // Did we split the line? 
    { first = strpos (input,"³ ",0);     // Quote found?
      if (first < 0)
        first = 0;
      else
        ++first;                         // Yes,
      setchr (input,first,0);            // keep it in input line.

      substr (input,0,3,quote);          // Remember quote. 
      l = strip (input);                 // Delete trailing spaces.
      if (l)
      { if (subchr(input1,0) != ' ')     // If first char. of "input1"
          strcat (input," ");            // is not space, add one.
      }
      strcat (input,input1);             // Add next line.
      setchr (input1,0,0);               // Line empty now.
      l = subchr (input,strlen(input)-1);// Get last character. 
      if (!isalnum(l)                    // Alphanumeric? 
        && l < '@') goto check;          // "sign"? 

      input1 = "";
      if (fgets (input1,144,f) < 0)      // No, read next line. 
        goto check;                      // Stop when exhausted. 

      l = strip (input1);                // Cut trailing spaces. 
      if (l==0)
      { empty = 1;                       // This line empty?
        goto check;
      }
      else
      if (strposi(input1,quote,0) == 0)  // Same quote? 
      { substr (input1,first,l,input1);  // Yes, add the line 
        l = strip (input);               // Cut trailing spaces. 
        if (subchr(input1,0) != ' ')     // If first char. of "input1"
          strcat (input," ");            // is not space, add one.
        strcat (input,input1);           // Add next line.
        setchr (input1,0,0);             // Delete the rest. 
        goto check;
      }
    }
  }                                      // Continues till file exhausted. 
  fclose (f);
  if (hide)                              // Included file?
  { f = hide;                            // So return.
    hide = 0;
    goto repeat;
  }
  f = -1;                                // Signal that file is closed.  

endmes:
  if (FSE)                               // Full Screen Editor:    
    cputs("^Z");                         // Ctrl-Z to end.
  else
    cputs("^MS^M");                      // (Enter) alone to end, then SAve.

  t1 = track (command, 0);               // Await next command.
  t2 = track("(Enter", 0);     // Reply to what message number: (Enter)=none?
                               // MBBS: Carbon copies? (Enter=N):
  t3 = track("Mail Co",0);     // Old PCBoard version?

  tol = 150;
  number = 0;                            // Set message number to 0.
  tmark = timer_start (tol);             // Wait only 15 seconds.

  while ((stat=trig()) > 0)
  { if (stat==t1)  
    { if (!number)
        number = readit();               // Read message number.
      break;                             // Command makes us exit.
    }
    else if (stat == t2) 
    { number = readit();                 // Read message number.
      cputs ("^M");                      // Enter ENTER.
    }
    else if (stat == t3)                 // Old PCB version: QUit.      
      cputs ("qu");
  }
  release();
  tol = 300; 
  if (f > 0) goto enter;                 // Had to cut message -
  fdelete (fullname);                    // Done - Delete the file.
  if (mbbs && number)
  { itos (number,input);
    cputs ("M ");                        // Mark last message.
    cputs (input);
    cputs ("^M");
    waitfor (command,2);
  }
  if (mbbs && !FSE)
  { prints("");
    _back_color = 4;
    _fore_color = 15;
    update_term();
    tone (660,20);
    tone (440,20);
    prints ("You should switch to the SCREEN EDITOR for faster upload!");
    prints ("(Use the U)tility M)ode command).");
    _back_color = 1;
    _fore_color = 14;
    update_term();
  }
}                                        // Continue in next message.

//-----------------------------------------------------------
// Get ID-code of this BBS, based on the XBOARD.BBS 
// configuration file.
//-----------------------------------------------------------

get_id_code ()
{
str input [144];                         // Input line (from file).
int xb                                   // File handle.
   ,i, j, k, l, m                        // Temporaries
   ;

  k = strlen(maildir)-1;
  if (subchr(maildir,k)!='\')           // Append "\" if  
    strcat (maildir,"\");               // necessary.

  filespec = maildir;
  strcat (filespec,"XBOARD.BBS");        // Make full filename.
  xb = fopen (filespec,"r");             // Try to open XBOARD.BBS file.
  if (xb <=0)                            // Found?
    return;                              // No.

  while (fgets (input,144,xb) >=0)       // Yes, so read each line.
  { if (strlen(input)<3) goto next;      // Nothing useful here.
    i = firstp (input);                  // Find first printing char.
    if (subchr(input,i) == ';')          // Semicolon:
      goto next;                         // Skip comment line.
    if ((j=strchr(input,0,'='))<=0)      // No equal sign? Ignore.
      goto next;
    for (k=-1; i<j; ++i)                 // Check the name.
    { m =toupper(subchr(input,i));
      if (isalpha(m))                    // Alpha: Check this character.
      { l = subchr(shortname,++k); 
        if (l < 'A') goto match;         // End of shortname: Match!
        if (l != m) goto next;           // No match: Next line.
      }
    }
    goto match;                          // No discrepancies: MATCH!
next:
    input = "";                          // End of "one line" loop.
  }
  fclose (xb);                           //  Not found.
  return;

// The BBS description is found in the file XBOARD.BBS.
// Isolate the part to the right of the equal sign, which
// contains the board's codename.

match:
  fclose (xb);
  for (++j; subchr(input,j)<=' '; ++j) ; // Find next non-space
                                         // after the equal sign.
  for (i=-1; (k=subchr(input,j))>0; ++j) // Move this part of the
    setchr(codename,++i,k);              // string to the BBS ID
  setchr(codename,++i,0);                // (codename).

  write (code,codename);                 // Set the codename.
}

//-----------------------------------------------------------
// Find first non-space of a string.
//-----------------------------------------------------------

firstp (str s) 
{
int x, c;
  if (subchr(s,0)==0) return (-1);       // No string: return -1.
  for (x=0; subchr(s,x)==' '; ++x) ;     // Search for non-space.
  return (x);
}

//-----------------------------------------------------------
// This routine updates the subject line when replying to messages.
//-----------------------------------------------------------

subject(str type, str new)
{
int i;
str Sline[80];

  if (type!="0")                         // This is not a reply.
  { flush();
    vgetchrs(0,gety(),Sline,0,80);       // Get last line from screen.
    if (strpos(Sline,new,0) > 0)         // Same subject?
    { cputs ("^M");
      return;
    }
                                         // Not PCB, or
    if (PCBver < 145)                    // PCB version prior to 14.5:
    { delay(1);
      terminal();
      for(i=0; i<30; ++i)                // Backspace over text already
        cputc (8);                       // written.
    }
  }
  setchr(new,25,0);                      // No more than 25 characters.
  cputs (new);                           // Display new subject.
  cputs ("^M");
}

//-----------------------------------------------------------
// Read message number on previous line (MBBS).
//-----------------------------------------------------------

readit()
{
int i, l;
  if (!mbbs) return (0);
  for (i = gety()-1; i>=0; --i)
  { vgetchrs(0,i,input,0,32);
    if ((l=strposi (input,"ge number ",0)) > 0)
    { substr (input,l+10,5,input);       // Isolate number.
      return (stoi (input));             // Read, then return number.
    }
  }
}

//-----------------------------------------------------------
// Wrong BBS type.
//-----------------------------------------------------------

wrongBBS()
{
str help[32];

    failtone();                          // Alarm.    
    help = "Illegal BBS type (or not found): ";
    strcat (help,bbs_type);
    strcat (help,"!");
    status_wind (help,20);               // Display message for 2 sec.
}

//-----------------------------------------------------------
// Flush incoming text from BBS.
//-----------------------------------------------------------

flush()
{
  do  
  { terminal();
    delay(2);                            // Process all echo
  } while (cinp_cnt() > 0);              // from the BBS.
}

//-----------------------------------------------------------
// Play fail tone.
//-----------------------------------------------------------

failtone()
{
  int n;
  for (n=140; n > 10; n = 100*n/120) 
  { tone(n*10,12);                       // Fail tone!!
    terminal();                          // Process text.
  }
}

//-----------------------------------------------------------
//  Trig loop. Waits here until either one "trig string" is
//  found, ro we have a time-out, or carrier is lost.
//-----------------------------------------------------------

trig()
{
int i;
  do
  { terminal();
  }  while (!time_up (tmark)             // Loop until time-out
          && carrier()                   // or carrier lost
          && (i=track_hit(0))==0);       // or we trigged.
  if (i==0) 
    i = -1;                              // Error!
  else
    timer_restart (tmark,tol);           // Restore timer.
  return (i);
}

//-----------------------------------------------------------
// Free timer and tracking functions.
//-----------------------------------------------------------

release()
{
  timer_free (tmark);                    // free timer channel
  track_free (0);                        // and all track channels.
}

//-----------------------------------------------------------
// Strip trailing spaces from string.
//-----------------------------------------------------------

strip (str string)                       // Strip strailing spaces,
{                                        // return length.
int l;
  for (l=strlen(string); l>=0; --l)
  { if (subchr(string,l) > ' ') return (++l);
    setchr(string,l,0);
  }
  return (0);
}

//-----------------------------------------------------------
// Read a global variable.
//-----------------------------------------------------------

read (str name, str varname)
{
  return (call (global,"R",name,varname));
}

//-----------------------------------------------------------
// Write a global variable.
//-----------------------------------------------------------

write(str name, str varname)
{ 
  return (call (global,"W",name,varname));
