//-----------------------------------------------------------
// PASSWORD.SL? Send password.
//
// Please look at the comments through the whole file, and modify to
// suit your needs, BEFORE you use it. Then recompile with CS PASSWORD.
//-----------------------------------------------------------

// If you have suggestions for improving this script, please suggest
// improvements to me via old-fashioned snail-mail to:

// Author:  Inge Vabekk
//          Hamangskogen 108
//          N-1300 SANDVIKA
//          NORWAY
//          tel. (472) 546 396

str global[]="GLOBAL"
   ,passw []="PASSW"
   ;

//-----------------------------------------------------------
// Script starts here.
//-----------------------------------------------------------

main()
{
int i;
str line[20];

  call (global,"R",passw,line);          // Get password.
  i = strlen (line)-1;
  if (subchr (line,i)<=' ')              // Delete any trailing CR.
  setchr (line,i,0);
  cputs (line);                          // Send it.
  cputs ("^M");
}

